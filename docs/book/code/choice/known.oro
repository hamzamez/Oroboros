export fn first_is_true(c) { case { true -> 1; c -> 2; else -> 3 } }

export fn first_is_false(c) { case { false -> 1; c -> 2; else -> 3 } }

export fn only_else() { case { else -> 3 } }

fn sign(n) {
    case {
        n < 0 -> 0 - 1
        0 < n -> 1
        else  -> 0
    }
}

export fn sign_of_five() { sign(5) }

export fn sign_of(n) { sign(n) }
