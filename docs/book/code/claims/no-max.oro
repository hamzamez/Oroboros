use io

fn max(a ∈ Array(Int)) (r ∈ Int)
    where len(a) >= 1
    ensure ∀ k ∈ 0..len(a)-1 : a[k] <= r
{
    loop i = 1, m = a[0] invariant ∀ j ∈ 0..i-1 : a[j] <= m {
        i < len(a) -> again(i + 1, if a[i] > m { m } else { a[i] })
        else -> m
    }
}

export fn main() { io.print_int(max(array { 3, 1, 4, 1, 5, 9, 2, 6 })) }
