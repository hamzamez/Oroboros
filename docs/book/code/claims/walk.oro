use io

export fn walk(board ∈ Array(0..9), turns ∈ 0..100) (Int) where len(board) == 201 {
    loop i = 0, s = 0 invariant 0 <= s && s <= 2 * i {
        i >= turns -> s
        board[s] > 4 -> again(i + 1, s + 2)
        else -> again(i + 1, s + 1)
    }
}

export fn main() {
    board = array { k % 10 : k ∈ 0..200 }
    io.print_int(walk(board, 7))
    io.print_int(walk(board, 100))
}
