export fn search(t ∈ Array(Int), x ∈ Int) (Int) where len(t) <= 10^9 {
    loop lo = 0, hi = len(t) {
        lo < 0 || hi > len(t) || lo >= hi -> -1
        t[lo + (hi - lo) / 2] < x -> again(lo + (hi - lo) / 2 + 1, hi)
        t[lo + (hi - lo) / 2] > x -> again(lo, lo + (hi - lo) / 2)
        else -> lo + (hi - lo) / 2
    }
}
