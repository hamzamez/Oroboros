fn half(lo, hi) { lo + (hi - lo) / 2 }

export fn search(t ∈ Array(Int), x ∈ Int) (Int) where len(t) <= 10^9 {
    loop lo = 0, hi = len(t), m = len(t) / 2 {
        lo >= hi -> -1
        lo < 0 || m < lo || m >= hi || hi > len(t) -> -1
        t[m] < x -> again(m + 1, hi, half(m + 1, hi))
        t[m] > x -> again(lo, m, half(lo, m))
        else -> m
    }
}
