use io

set Square = record { side ∈ 0..9, area ∈ 0..81 }

fn total(t) {
    loop i = 0, s = 0 {
        i < len(t) -> again(i + 1, s + t[i].area)
        else -> s
    }
}

export fn main() {
    squares = array { record { side : k, area : k * k } : k ∈ 0..9 }
    io.print_int(squares[7].area)
    io.print_int(total(squares))
}
