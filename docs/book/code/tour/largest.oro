fn max(a, b) { if a > b { a } else { b } }

fn largest(t, lo) {
    loop i = 0, m = lo {
        i < len(t) -> again(i + 1, max(m, t[i]))
        else       -> m
    }
}

export fn top_byte(t ∈ Array(0..255)) (Int) { largest(t, 0) }

export fn top_ratio(t ∈ Array(set { x ∈ F64 : 0.0 <= x && x <= 1.0 })) (F64) { largest(t, 0.0) }
