use io

primes = array { 2, 3, 5, 7, 11 }

export fn sum_squares(n ∈ 0..1000) (Int) {
    sq = array { k * k : k ∈ 0..n-1 }
    loop i = 0, acc = 0 {
        i < n -> again(i + 1, acc + sq[i])
        else  -> acc
    }
}

export fn main() {
    io.print_int(primes[2])
    io.print_int(sum_squares(10))
}
