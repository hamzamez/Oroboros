// K(ℕ*), THE INTEGERS ON A TARGET WITH NO BIGNUM (ADR 0099).
//
// ℕ* is the positional numerals in base B = 2^64, each m ∈ ℕ one numeral with
// a nonzero top digit; ℤ is K(ℕ*), the group completion over them, a sign and
// a magnitude with one zero. A value is one table t:
//   - digit i at t[i], for i < len t − 1;
//   - the last entry the header h = 2m + s, m = 1 + the index of the top
//     nonzero digit, or 0, and s the sign, 1 for a negative value; s is 0 when
//     m is, so h = 0 is the one zero;
//   - every slot from m to len t − 2 holds 0;
//   - d(t) = (−1)^s · Σ_{i < len t − 1} t[i]·B^i.
// EVERY ENTRY IS IN [0, B): a table is a function [0, len) → [0, B), and its
// codomain is its element type, derived by the IR from the stores (each one
// proven in [0, B)) and read back as every digit's fact. The header lies in it
// iff m < 2^31, which `room` makes the machine's bound beside max_len.
// len t is a capacity each operation computes from its operands' sizes. Every
// build writes [0, len t) at its counter, so a result is born full (ADR 0097).
//
// B = 2^64, THE MACHINE'S OWN DIGIT (ADR 0105, M4c): a digit is a natural of
// the unsigned word, and every step is an intermediate of the double word,
// read back by its two halves, t & (B − 1) and t >> 64, which are rax and rdx:
// Algorithm M's u·v + w + k ≤ B^2 − 1 = 2^128 − 1 read unsigned, A's
// x + y + c < 2^65, S's x − y − b ∈ [−B, B) read signed. B itself is no word,
// so it is written 2^62 · 4, and B − 1 is `dm`, a constant of the unsigned
// word.
// The operations are Knuth's (TAOCP 2 §4.3.1), each checked once as a theory
// (ADR 0035), the large ones functions of the program (ADR 0101).

// B − 1, the largest digit, the unsigned word's top
dm = 18446744073709551615

// THE READS, each stating the representation's invariant as its mask, as the
// fixed limbs' `at` does: a digit is in [0, B), the size in [0, len t − 1].
fn hdr(t) { n = len(t); if n < 1 { 0 } else { t[n - 1] } }
fn sgn(t) { if hdr(t) % 2 == 1 { 1 } else { 0 } }
fn size(t) {
    n = len(t)
    h = hdr(t) / 2
    m = if h > n - 1 { n - 1 } else { h }
    if m < 0 { 0 } else { m }
}
fn dig(t, i) {
    v = if i < 0 { 0 } else if i >= len(t) - 1 { 0 } else { t[i] }
    v
}
// a digit of a buffer being built, read back
fn rd(o linear, i) {
    v = if i < 0 { 0 } else if i >= len(o) { 0 } else { o[i] }
    v
}
// the header 2m + s, in [0, B) by the machine's bound m < 2^31, stated where it
// is written: room makes it true, and this makes it the stored value's fact
fn signed(s, m) {
    case {
        m < 1 -> 0
        m > 2^31 - 1 -> abandon("out of memory: an integer longer than the largest table")
        s == 1 -> 2 * m + 1
        else -> 2 * m
    }
}

// THE LENGTH READ ONCE. A table's length is fixed at its birth and the table
// is immutable, so len(t) is a pure function of the value: bound once before
// a loop, it is the same number at every digit (β), and the loop reads no
// header. dg is dig with n1 = len t − 1 given, pg pdig with n = len t, rg rd
// with n = len o.
fn dg(t, n1, i) {
    v = if i < 0 { 0 } else if i >= n1 { 0 } else { t[i] }
    v
}
fn pg(t, n, i) {
    v = if i < 0 { 0 } else if i >= n { 0 } else { t[i] }
    v
}
fn rg(o linear, n, i) {
    v = if i < 0 { 0 } else if i >= n { 0 } else { o[i] }
    v
}
fn wg(r, nr, d, i) { if i == 0 { d } else { pg(r, nr, i - 1) } }

// THE MACHINE'S BOUND. No machine represents ℤ: a numeral is held only while
// its table fits, len t ≤ ml, the target's max_len, which is each definition's
// first argument. A capacity past it is a crash, as a host bignum's allocation
// failure is, never a numeral cut short; on the path that continues, c ≤ ml.
fn room(ml, c) { if c > ml || c > 2^31 { abandon("out of memory: an integer longer than the largest table") } else { c } }

// a word of either sign: the digits of |v|, taken as −(r % B) and r / B, both
// truncated: every word is one digit, since |v| ≤ 2^63 < B, and |−2^63| is the
// unsigned word's
fn of(ml, v) {
    var o := array { 0 : _ ∈ 0..2 }
    loop i = 0 {
        i >= 3 -> o
        i == 2 -> { o[i] := signed(if v < 0 { 1 } else { 0 }, if v == 0 { 0 } else { 1 }); again(i + 1) }
        i == 1 -> { o[i] := 0; again(i + 1) }
        else -> { o[i] := if v < 0 { 0 - v } else { v }; again(i + 1) }
    }
}

// THE RETRACTION r : ℤ ⇀ S onto the signed word, the partial inverse of `of`
// (ADR 0079 item 4): called only where the decision proves |a| inside S, so a
// is at most one digit d, and a = ±d; the reads state S as their masks
fn word(ml, a) {
    // the digit's invariant, d ∈ [0, B), stated where its table's element
    // type does not carry it (a numeral built by an inlined loop)
    d = dig(a, 0) & dm
    // nested, so each arm's guard is a conjunct its π narrows: the negation
    // of a conjunction is a disjunction, which narrows nothing
    if sgn(a) == 1 {
        if d > 9223372036854775807 { 0 - 9223372036854775807 - 1 } else { 0 - d }
    } else {
        d % 9223372036854775808
    }
}

// |a| against |b|: the size first, which the normal form makes decisive, then
// the digits from the top
fn mcmp(ml, a, b) {
    ma = size(a)
    mb = size(b)
    case {
        ma < mb -> 0 - 1
        ma > mb -> 1
        else -> {
            la = len(a) - 1
            lb = len(b) - 1
            loop i = ma - 1 {
                i < 0 -> 0
                dg(a, la, i) < dg(b, lb, i) -> 0 - 1
                dg(a, la, i) > dg(b, lb, i) -> 1
                else -> again(i - 1)
            }
        }
    }
}

// ALGORITHMS A AND S, EACH ITS OWN LOOP. The group completion's case is on the
// signs, and only a difference needs its operands ordered: x + y = y + x, so A
// takes the longer first for nothing, and S the larger, |x| ≥ |y|. The choice
// is in which tables are passed, so no table is chosen by an `if`, and the one
// allocation stays before the case, where a dead region's token reaches it
// (ADR 0100). The loops write through a borrow, as macrow does.

// THE DIGIT'S REDUCTION, one form for A, S, M and D: t mod B = t & (B − 1),
// since ℤ's & is 2-adic, and the carry ⌊t / B⌋ = t >> 64, for any t a step
// makes: x + y + c < 2^65, x − y − b ∈ [−B, B), u·v + w + k < B^2.

// A's and S's second loops, over [my, mx), each a call borrowing o, the
// state the first fold ends in its arguments: the carry or borrow, in {0, 1}
// by its set (a claim each call discharges), and S's size so far. Each loop
// bounds what it reads once, as its caller does.
fn addhi(o linear, x, j0, mx0, c0, s) {
    lx = len(x) - 1
    n2 = len(o) - 2
    m1 = if mx0 > lx { lx } else { mx0 }
    mx = if m1 > n2 { n2 } else { m1 }
    j = if j0 < 0 { 0 } else { j0 }
    loop i = j, c = c0 {
        i >= mx -> { wr(o, mx, c); wr(o, mx + 1, signed(s, mx + c)) }
        else -> {
            t = x[i] + c
            o[i] := t & dm
            again(i + 1, t >> 64)
        }
    }
}
fn subhi(o linear, x, j0, mx0, b0, top0, s) {
    lx = len(x) - 1
    n2 = len(o) - 2
    m1 = if mx0 > lx { lx } else { mx0 }
    mx = if m1 > n2 { n2 } else { m1 }
    j = if j0 < 0 { 0 } else { j0 }
    loop i = j, bw = b0, top = top0 {
        i >= mx -> { wr(o, mx, 0); wr(o, mx + 1, signed(s, top)) }
        else -> {
            t = x[i] - bw
            d = t & dm
            o[i] := d
            again(i + 1, if t < 0 { 1 } else { 0 }, if d != 0 { i + 1 } else { top })
        }
    }
}
// a digit of a buffer being built, written where it is in the table: the dual
// of rd, the identity off its domain
fn wr(o linear, i, v) { if i >= 0 && i < len(o) { o[i] := v } else { () } }

// A: x + y with mx ≥ my. The index domain splits at my, [0, my) ⊔ [my, mx),
// and A is a fold over it, so it is two loops in sequence, the carry passed
// from the first to the second: a fold over a concatenation is the composite
// of the folds, End(S)'s product. Each loop's step is then one full adder,
// with no clause testing i < my at every digit (carry-2026-11-13: one loop
// with that test is no faster with the machine's carry, two are 2×). Every
// read is in bounds by its loop's own guard. Its size is mx + c by the final
// carry: x is normal, so with no carry out digit mx − 1 is at least x's top
// digit, which is not 0. The carry goes at mx and the header at mx + 1.
fn addlp(o linear, x, mx0, y, my0, s) {
    // the sizes against what the loop reads and writes, once: the identity on
    // every numeral (its size is below its length), and each read's bound a
    // path fact
    lx = len(x) - 1
    ly = len(y) - 1
    n2 = len(o) - 2
    m1 = if mx0 > lx { lx } else { mx0 }
    mx = if m1 > n2 { n2 } else { m1 }
    k1 = if my0 > ly { ly } else { my0 }
    my = if k1 > mx { mx } else { k1 }
    loop i = 0, c = 0 {
        i >= my -> addhi(o, x, my, mx, c, s)
        else -> {
            t = x[i] + y[i] + c
            o[i] := t & dm
            again(i + 1, t >> 64)
        }
    }
}

// S: x − y with |x| ≥ |y|, the same split into two loops, the borrow in
// {0, 1} and never out of the top. A difference's size is not its operands':
// the size is the index past its last nonzero digit, tracked as it goes.
fn sublp(o linear, x, mx0, y, my0, s) {
    // the sizes against what the loop reads and writes, once: the identity on
    // every numeral (its size is below its length), and each read's bound a
    // path fact
    lx = len(x) - 1
    ly = len(y) - 1
    n2 = len(o) - 2
    m1 = if mx0 > lx { lx } else { mx0 }
    mx = if m1 > n2 { n2 } else { m1 }
    k1 = if my0 > ly { ly } else { my0 }
    my = if k1 > mx { mx } else { k1 }
    loop i = 0, bw = 0, top = 0 {
        i >= my -> subhi(o, x, my, mx, bw, top, s)
        else -> {
            t = x[i] - y[i] - bw
            d = t & dm
            o[i] := d
            again(i + 1, if t < 0 { 1 } else { 0 }, if d != 0 { i + 1 } else { top })
        }
    }
}

// x ± y over the magnitudes into one table of max(ma, mb) + 2 entries: σ = −1
// when neg, and then sw says |b| > |a|. The capacity is the case's guard, so
// mx + 1 < cap is a path fact (render's form).
fn addsub(ml, a, b, sw, neg, s) {
    ma = size(a)
    mb = size(b)
    mx = if ma > mb { ma } else { mb }
    case {
        mx + 2 > ml || mx + 2 > 2^31 -> abandon("out of memory: an integer longer than the largest table")
        else -> {
            var o := array { 0 : _ ∈ 0..mx + 1 }
            case {
                !neg && ma >= mb -> addlp(o, a, ma, b, mb, s)
                !neg -> addlp(o, b, mb, a, ma, s)
                sw -> sublp(o, b, mb, a, ma, s)
                else -> sublp(o, a, ma, b, mb, s)
            }
            o
        }
    }
}

// the group completion's sum: equal signs add the magnitudes, different ones
// subtract the smaller from the larger, whose sign the result takes
fn add(ml, a, b) {
    sa = sgn(a)
    sb = sgn(b)
    sw = sa != sb && mcmp(ml, a, b) < 0
    addsub(ml, a, b, sw, sa != sb, if sw { sb } else { sa })
}
// a − b = a + (−b)
fn sub(ml, a, b) {
    sa = sgn(a)
    sb = sgn(b)
    sw = sa == sb && mcmp(ml, a, b) < 0
    addsub(ml, a, b, sw, sa == sb, if sw { 1 - sb } else { sa })
}

// ALGORITHM M's row: o += |a| · y · B^j. Column i + j is t = u·y + w + k ≤
// B^2 − 1; the row's last carry goes to column ma + j, which no earlier row
// reached, so it is written, not added.
// THE ROW'S INDICES ARE AN INTERVAL, [j, j + ma], so its stores are inside o iff
// 0 <= j and j + ma < len(o): two comparisons on the ends, checked once a row
// rather than once a digit (a store owes its index since the book's finding
// 70). It holds, len(o) = ma + mb + 1 with j < mb, but the copies of ma and mb
// the row sees are not related to the length the caller built, so the check is
// a missing proof, its arm never taken (store-2026-11-16). Per digit it cost the
// 32-word product 8%.
fn macrow(ml, o linear, no, a, la, ma, y, j) {
    case {
        j < 0 || j + ma >= len(o) -> ()
        else -> {
            loop i = 0, k = 0 {
                i >= ma -> { o[i + j] := k; () }
                else -> {
                    t = dg(a, la, i) * y + rg(o, no, i + j) + k
                    o[i + j] := t & dm
                    again(i + 1, t >> 64)
                }
            }
        }
    }
}
// THE PRODUCT: Karatsuba's where both factors are long and of one size within
// a factor of two, Algorithm M otherwise (karatsuba-research.md).
fn mul(ml, a, b) {
    ma = size(a)
    mb = size(b)
    if ma >= kt && mb >= kt && ma <= 2 * mb && mb <= 2 * ma { kmul(ml, a, b) } else { mulm(ml, a, b) }
}

// ALGORITHM M: the rows into a zero table of ma + mb digits, then the header.
// The product's size is ma + mb, or one less when its top digit is 0, and 0
// when either factor is.
fn mulm(ml, a, b) {
    ma = size(a)
    mb = size(b)
    cap = room(ml, ma + mb + 1)
    la = len(a) - 1
    lb = len(b) - 1
    var o := array { 0 : _ ∈ 0..cap-1 }
    loop j = 0 {
        // A NUMERAL'S TABLE HOLDS ITS SIGNED SIZE, so cap = ma + mb + 1 >= 1 and
        // the size's store at cap - 1 is inside o. That needs size's result
        // >= 0, which the refinement layer loses where size joins its branches,
        // so it is checked here (a store owes its index since the book's
        // finding 70). Never taken; it goes when the carrier {t : len t >= 1}
        // is a set and the join keeps size's hull (store-2026-11-16).
        j >= mb && cap < 1 -> abandon("not a numeral: a numeral's table holds its signed size")
        j >= mb -> {
            m = if ma == 0 || mb == 0 { 0 } else if rd(o, ma + mb - 1) == 0 { ma + mb - 1 } else { ma + mb }
            o[cap - 1] := signed((sgn(a) + sgn(b)) % 2, m)
            o
        }
        else -> { macrow(ml, o, cap, a, la, ma, dg(b, lb, j), j); again(j + 1) }
    }
}


// KARATSUBA (karatsuba-research.md). A numeral is its polynomial at B, and a
// product is μ₂'s bilinear algorithm of rank 3, W((Ua) ⊙ (Ub)), evaluation at
// 0, 1, ∞ and interpolation by the unimodular W, exact over ℤ. D levels are the
// D-th tensor power, which factors into one pass a level (I ⊗ U ⊗ I, then
// I ⊗ W ⊗ I), so the algorithm is three loops: down, the leaves by Algorithm M,
// up. A level is one table of 3^L slots of one size s_L, s_{L+1} = ⌈s_L/2⌉ + 1
// (§5): lo, hi and lo + hi each fit s_{L+1} digits, a node's product its 2s_L,
// so the combine's last carry is 0.

// the threshold T, a leaf's largest size (measured: carry-2026-11-13's C model
// at 64–128, karatsuba-2026-11-13)
kt = 64
// the levels' node count is held below 3^12, so every offset j·s is a word:
// a product past that size takes longer leaves, which is exact
kn = 177147

// a digit of a frozen table, 0 off its domain: a slot's zero extension
fn kat(t, i) {
    v = if i < 0 { 0 } else if i >= len(t) { 0 } else { t[i] }
    v
}
// digit i of the slot of w digits at b, 0 off it
fn kslot(t, b, w, i) { if i < 0 || i >= w { 0 } else { kat(t, b + i) } }

// THE DOWN PASS, one level: nodes slots of s digits to 3·nodes slots of
// s2 = ⌈s/2⌉ + 1, each node's lo, lo + hi and hi, lo + hi by the full adder
// (ADR 0108). ONE LOOP over the level's nodes × digits, (j, i) its state and
// the carry reset at each node's start: the product of the two index domains is
// one domain, so the pass is one fold, not a fold of folds, and the decision
// analyses no loop inside another.
fn kdown(ml, x, nodes, s) {
    h = (s + 1) / 2
    s2 = h + 1
    n = room(ml, 3 * nodes * s2)
    var y := array { 0 : _ ∈ 0..n - 1 }
    loop j = 0, i = 0, c = 0 {
        j >= nodes -> y
        i >= s2 -> again(j + 1, 0, 0)
        else -> {
            bx = j * s
            by = 3 * j * s2
            lo = kslot(x, bx, h, i)
            hi = kslot(x, bx + h, s - h, i)
            t = lo + hi + c
            wr(y, by + i, lo)
            wr(y, by + s2 + i, t & dm)
            wr(y, by + 2 * s2 + i, hi)
            again(j, i + 1, t >> 64)
        }
    }
}

// THE LEAVES: Algorithm M's rows at the slots' offsets, u·v + w + k < B^2.
// The row bounds what it reads and writes once (the library's idiom): the
// identity on every node, since a slot lies inside its level's table (§5), so
// every access is proven by the loop's guard and none is tested per digit.
fn kmac(o linear, x, ox0, m0, y, oo0) {
    ox = if ox0 < 0 { 0 } else { ox0 }
    oo = if oo0 < 0 { 0 } else { oo0 }
    lx = len(x) - ox
    lo = len(o) - oo - 1
    m1 = if m0 > lx { lx } else { m0 }
    m = if m1 > lo { lo } else { m1 }
    loop i = 0, k = 0 {
        i >= m -> wr(o, oo + m, k)
        else -> {
            t = x[ox + i] * y + o[oo + i] + k
            o[oo + i] := t & dm
            again(i + 1, t >> 64)
        }
    }
}
// the leaves' rows, (node j, row r) one loop
fn kleaves(ml, xa, xb, nodes, m) {
    n = room(ml, 2 * nodes * m)
    var o := array { 0 : _ ∈ 0..n - 1 }
    loop j = 0, r = 0 {
        j >= nodes -> o
        r >= m -> again(j + 1, 0)
        else -> { kmac(o, xa, j * m, m, kslot(xb, j * m, m, r), 2 * j * m + r); again(j, r + 1) }
    }
}

// THE UP PASS, one level: 3·nodes products of 2s2 digits to nodes of 2s.
// Digit i of node j is the coefficient of B^i in P₀ + (P₁ − P₀ − P₂)·B^h +
// P₂·B^2h: three terms add and two subtract, so with the carry in [−2, 2] each
// step is in [−2B, 3B) and its carry ⌊t / B⌋ again in [−2, 2] (§6). One loop
// over nodes × digits, as the down pass.
fn kup(ml, q, nodes, s) {
    h = (s + 1) / 2
    w2 = 2 * (h + 1)
    w = 2 * s
    n = room(ml, nodes * w)
    var p := array { 0 : _ ∈ 0..n - 1 }
    loop j = 0, i = 0, c = 0 {
        j >= nodes -> p
        i >= w -> again(j + 1, 0, 0)
        else -> {
            b0 = 3 * j * w2
            b1 = b0 + w2
            b2 = b1 + w2
            t = kslot(q, b0, w2, i) + kslot(q, b2, w2, i - 2 * h) + kslot(q, b1, w2, i - h) - kslot(q, b0, w2, i - h) - kslot(q, b2, w2, i - h) + c
            wr(p, j * w + i, t & dm)
            again(j, i + 1, t >> 64)
        }
    }
}

// s_L, from s_0 by L halvings
fn klev(s0, l0) { loop l = l0, s = s0 { l <= 0 -> s; else -> again(l - 1, (s + 1) / 2 + 1) } }

// THE UP PASS FROM THE LEAVES, then the numeral of mm digits or one fewer,
// with sign sg: kmul's and ksqr's
fn kfin(ml, leaves, d, nodes, s0, mm, sg) {
    p = loop l = d - 1, q = leaves, k = nodes / 3 {
        l < 0 -> q
        else -> again(l - 1, kup(ml, q, k, klev(s0, l)), k / 3)
    }
    cap = room(ml, mm + 1)
    m = if kat(p, mm - 1) == 0 { mm - 1 } else { mm }
    h = signed(sg, m)
    alloc(array { if i == cap - 1 { h } else { kat(p, i) } : i ∈ 0..cap - 1 })
}

// THE THREE PHASES IN SEQUENCE, each a loop over levels whose values are
// frozen tables (only a pass's own buffer is written), so no phase's loop is
// analysed inside another's
fn kmul(ml, a, b) {
    ma = size(a)
    mb = size(b)
    s0 = room(ml, if ma > mb { ma } else { mb })
    la = len(a) - 1
    lb = len(b) - 1
    x0 = alloc(array { dg(a, la, i) : i ∈ 0..s0 - 1 })
    y0 = alloc(array { dg(b, lb, i) : i ∈ 0..s0 - 1 })
    (d, s, nodes, xa, xb) = loop d = 0, s = s0, nodes = 1, xa = x0, xb = y0 {
        s <= kt || nodes >= kn -> (d, s, nodes, xa, xb)
        else -> again(d + 1, (s + 1) / 2 + 1, 3 * nodes, kdown(ml, xa, nodes, s), kdown(ml, xb, nodes, s))
    }
    kfin(ml, kleaves(ml, xa, xb, nodes, s), d, nodes, s0, ma + mb, (sgn(a) + sgn(b)) % 2)
}

// SQUARING (karatsuba-research.md §12). The square is the product's quadratic
// form, q(a) = μ(a, a), and polarization writes it with half the products:
//     a² = Σ_i a_i² B^{2i} + 2 Σ_{i<j} a_i a_j B^{i+j}.
// The schoolbook square: the triangle T = Σ_{i<j} a_i a_j B^{i+j} by rows, row i
// a_i times digits i + 1.. at offset 2i + 1, frozen; then one pass from T and
// the digits to a new table, 2T + the diagonal, two digits a step: t = 2w +
// (a_i² mod B) + c and t' = 2w' + ⌊a_i²/B⌋ + ⌊t/B⌋, each below 3B, the carry in
// [0, 2]. Both passes read only frozen tables (a guarded read of a live buffer
// copies the step into the guard's arms, and an arm the facts decide is dead,
// its values untyped: W14's). The square has 2m digits or one fewer, by its top
// digit, and its sign is 0.
fn sqtri(ml, a, la, ma, n) {
    var o := array { 0 : _ ∈ 0..n - 1 }
    loop i = 0 {
        i >= ma -> o
        else -> { kmac(o, a, i + 1, ma - i - 1, dg(a, la, i), 2 * i + 1); again(i + 1) }
    }
}
fn sqrm(ml, a) {
    ma = size(a)
    cap = room(ml, 2 * ma + 1)
    la = len(a) - 1
    tr = sqtri(ml, a, la, ma, cap)
    var o := array { 0 : _ ∈ 0..cap - 1 }
    loop i = 0, c = 0, top = 0 {
        i >= ma -> {
            m = if ma == 0 { 0 } else if top == 0 { 2 * ma - 1 } else { 2 * ma }
            wr(o, cap - 1, signed(0, m))
            o
        }
        else -> {
            x = dg(a, la, i)
            p = x * x
            t = 2 * kat(tr, 2 * i) + (p & dm) + c
            wr(o, 2 * i, t & dm)
            u = 2 * kat(tr, 2 * i + 1) + (p >> 64) + (t >> 64)
            wr(o, 2 * i + 1, u & dm)
            again(i + 1, u >> 64, u & dm)
        }
    }
}

// THE SQUARE'S KARATSUBA: the three children of a square are squares,
// (lo, lo), (lo + hi, lo + hi), (hi, hi), so the tree is the tensor power's
// diagonal: one operand table down, squaring leaves, the same up pass. The
// leaves are the schoolbook square's two passes over every slot, each one loop
// over nodes × digits.
fn ksqtri(ml, x, nodes, m, n) {
    var o := array { 0 : _ ∈ 0..n - 1 }
    loop j = 0, i = 0 {
        j >= nodes -> o
        i >= m -> again(j + 1, 0)
        else -> { kmac(o, x, j * m + i + 1, m - i - 1, kslot(x, j * m, m, i), 2 * j * m + 2 * i + 1); again(j, i + 1) }
    }
}
fn ksqleaves(ml, x, nodes, m) {
    n = room(ml, 2 * nodes * m)
    tr = ksqtri(ml, x, nodes, m, n)
    var o := array { 0 : _ ∈ 0..n - 1 }
    loop j = 0, i = 0, c = 0 {
        j >= nodes -> o
        i >= m -> again(j + 1, 0, 0)
        else -> {
            b = 2 * j * m
            v = kslot(x, j * m, m, i)
            p = v * v
            t = 2 * kslot(tr, b, 2 * m, 2 * i) + (p & dm) + c
            wr(o, b + 2 * i, t & dm)
            u = 2 * kslot(tr, b, 2 * m, 2 * i + 1) + (p >> 64) + (t >> 64)
            wr(o, b + 2 * i + 1, u & dm)
            again(j, i + 1, u >> 64)
        }
    }
}
fn ksqr(ml, a) {
    ma = size(a)
    s0 = room(ml, ma)
    la = len(a) - 1
    x0 = alloc(array { dg(a, la, i) : i ∈ 0..s0 - 1 })
    (d, s, nodes, xa) = loop d = 0, s = s0, nodes = 1, xa = x0 {
        s <= kt || nodes >= kn -> (d, s, nodes, xa)
        else -> again(d + 1, (s + 1) / 2 + 1, 3 * nodes, kdown(ml, xa, nodes, s))
    }
    kfin(ml, ksqleaves(ml, xa, nodes, s), d, nodes, s0, 2 * ma, 0)
}

// THE SQUARE: Karatsuba's above the threshold, the schoolbook square below
fn sqr(ml, a) { if size(a) >= kt { ksqr(ml, a) } else { sqrm(ml, a) } }

// BY A WORD k ∈ [0, B): one pass, the carry below B, each step in the double
// word. The index domain is
// [0, ma) ⊔ {ma, ma + 1}: on [0, ma) a digit is read by the arm's guard, ma
// being below a's length (the identity on every numeral, a path fact here);
// at ma the last carry, at ma + 1 the header. THE SIZE IS THE CARRY'S: for a
// normal a and 1 ≤ k < B, B^(ma−1) ≤ a ≤ a·k < B^(ma+1), so a·k has ma digits,
// or ma + 1 exactly when the last carry is not 0, and none when k or a is 0.
// The capacity is the case's guard, so the table's length is ma + 2.
fn mul_small(ml, a, k) {
    m0 = size(a)
    la = len(a) - 1
    ma = if m0 > la { la } else { m0 }
    s = sgn(a)
    case {
        ma + 2 > ml || ma + 2 > 2^31 -> abandon("out of memory: an integer longer than the largest table")
        // len(a) >= 1 for a numeral, so ma >= 0: room's carrier, checked here
        ma < 0 -> abandon("not a numeral: a numeral's table holds its signed size")
        else -> {
            var o := array { 0 : _ ∈ 0..ma + 1 }
            loop i = 0, c = 0 {
                i >= ma -> {
                    o[ma] := c
                    o[ma + 1] := signed(s, if k == 0 || ma == 0 { 0 } else if c != 0 { ma + 1 } else { ma })
                    o
                }
                else -> {
                    t = a[i] * k + c
                    o[i] := t & dm
                    again(i + 1, t >> 64)
                }
            }
        }
    }
}

// by a word k ∈ [1, B), truncated: the quotient's sign is a's. Its size is
// known first: for a normal a and k < B, ⌊a / k⌋ has ma digits when a's top
// digit is at least k, and ma − 1 otherwise, since then the next quotient
// digit is at least B / k > 1. So the descending build writes its header first,
// at the counter.
fn div_small(ml, a, k) { qsmall(ml, a, k, sgn(a)) }
// |a| / k with the sign s, k ∈ [1, B)
fn qsmall(ml, a, k, s) {
    ma = size(a)
    cap = ma + 1
    m = if ma == 0 { 0 } else if dig(a, ma - 1) >= k { ma } else { ma - 1 }
    la = len(a) - 1
    var o := array { 0 : _ ∈ 0..cap-1 }
    loop i = cap - 1, r = 0 {
        i < 0 -> o
        i == cap - 1 -> { o[i] := signed(s, m); again(i - 1, r) }
        else -> { cur = r * 4611686018427387904 * 4 + dg(a, la, i); o[i] := cur / k; again(i - 1, cur % k) }
    }
}
// the remainder by a word k ∈ [1, B), the dividend's sign
fn rem_small(ml, a, k) {
    la = len(a) - 1
    r = loop i = size(a) - 1, r = 0 {
        i < 0 -> r
        else -> again(i - 1, (r * 4611686018427387904 * 4 + dg(a, la, i)) % k)
    }
    if sgn(a) == 1 { 0 - r } else { r }
}

// order by sign, then by magnitude, reversed when both are negative
fn lt(ml, a, b) {
    sa = sgn(a)
    sb = sgn(b)
    case { sa != sb -> sa == 1; sa == 0 -> mcmp(ml, a, b) < 0; else -> mcmp(ml, a, b) > 0 }
}
fn le(ml, a, b) {
    sa = sgn(a)
    sb = sgn(b)
    case { sa != sb -> sa == 1; sa == 0 -> mcmp(ml, a, b) <= 0; else -> mcmp(ml, a, b) >= 0 }
}
fn gt(ml, a, b) { lt(ml, b, a) }
fn ge(ml, a, b) { le(ml, b, a) }
fn eq(ml, a, b) { hdr(a) == hdr(b) && mcmp(ml, a, b) == 0 }

// RENDER BY 10^18, eighteen decimal digits per division of |a| (10^19 is past
// the signed word, no literal divisor), the quotient and
// the remainder carried together in one table (qrem), one pass per chunk. A value below B^m has at most
// ⌊64m·log10 2⌋ + 1 ≤ 19.2660m + 1 decimal digits, and m ≤ len a − 1, so a
// field of n = 20·len a + 18 entries holds them, digit k at n − 1 − k for
// k < n − 1. The numeral's length is found on the frozen field by a scan
// descending from n − 1 to the first slot not '0' (or to 1, for 0), and the
// sign and the digits are copied once, in the scan's exits, where the length
// is the scan's variable, in [1, n − 1] by its start and its guard. The machine's bound is the case's guard:
// room's crash with the let commuted into the arm that continues (ADR 0090),
// so n ≤ ml is a path fact.
// the last t digits of the field f (n entries), after a sign when s = 1, as
// text of w = t + s characters; s is a constant at each call
fn numeral(f, n, w, s) {
    var o := array { 45 : _ ∈ 0..w - 1 }
    loop i = 0 {
        i >= w -> ascii(o, 0, w)
        else -> { o[i] := if i < s { 45 } else { f[n - w + i] }; again(i + 1) }
    }
}

// QUOTIENT AND REMAINDER IN ONE PASS. A short division is a Mealy machine
// whose final state is the remainder, so one fold gives both. They are packed
// in one table, [r, q_0, …, q_{m−1}, header]: the division runs from the top
// digit down, and the descending build writes slot 0 last, when r is known,
// so the table is born full. The dividend's digit j is at a[off + j], off 0
// for a numeral and 1 for a packed quotient; its size is its header's either
// way. The quotient's size m2 is known first, as qsmall's.
fn qrem(ml, a, off, k) {
    m = size(a)
    la = len(a)
    m2 = if m == 0 { 0 } else if pg(a, la, off + m - 1) >= k { m } else { m - 1 }
    cap = room(ml, m + 2)
    var o := array { 0 : _ ∈ 0..cap-1 }
    loop i = cap - 1, r = 0 {
        i < 0 -> o
        i == cap - 1 -> { o[i] := signed(0, m2); again(i - 1, r) }
        i == 0 -> { o[i] := r; again(i - 1, r) }
        else -> { cur = r * 4611686018427387904 * 4 + pg(a, la, off + i - 1); o[i] := cur / k; again(i - 1, cur % k) }
    }
}

// RENDER, the change of basis to β = 10^18 (radix-research.md, ADR 0111): by
// the tree of divisions from rt words, by repeated short division below
rt = 32
fn render(ml, a) { if size(a) >= rt { render2(ml, a) } else { render1(ml, a) } }

fn render1(ml, a) {
    n = 20 * len(a) + 18
    case {
        n > ml -> abandon("out of memory: an integer longer than the largest table")
        else -> {
            f = {
                var b := array { 48 : _ ∈ 0..n - 1 }
                loop k = 0, q = a, off = 0, r = 0 {
                    k >= n - 1 -> b
                    k % 18 == 0 -> {
                        q2 = qrem(ml, q, off, 1000000000000000000)
                        d = pg(q2, len(q2), 0)
                        b[n - 1 - k] := 48 + d % 10
                        again(k + 1, q2, 1, d / 10)
                    }
                    else -> {
                        b[n - 1 - k] := 48 + r % 10
                        again(k + 1, q, off, r / 10)
                    }
                }
            }
            neg = sgn(a) == 1
            loop l = n - 1 {
                l <= 1 -> if neg { numeral(f, n, 2, 1) } else { numeral(f, n, 1, 0) }
                f[n - l] != 48 -> if neg { numeral(f, n, l + 1, 1) } else { numeral(f, n, l, 0) }
                else -> again(l - 1)
            }
        }
    }
}

// ------------------------------------------------------------ Algorithm D
//
// LONG DIVISION IS A MEALY MACHINE over the dividend's digits from the top:
// its state is the partial remainder r ∈ [0, v), the window W = r·B + d, the
// output q = ⌊W / v⌋ and the next state W − q·v, the Euclidean step folded
// over the digits. Knuth's D (TAOCP 2 §4.3.1) computes the output cheaply:
// with v normalized by f = 2^s so its top digit is at least B/2, the estimate
// q̂ = min(⌊(W_n·B + W_{n−1}) / v_{n−1}⌋, B − 1) satisfies q̂ − 2 ≤ q ≤ q̂
// (Theorem B), and D3's test q̂·v_{n−2} > r̂·B + W_{n−2} removes every q̂ two
// too large when q̂ is not capped. So each step adds v back at most twice, and
// usually never. Every intermediate is below B^2 = 2^64, so all of it is
// U64's. Normalizing leaves the quotient alone and scales the remainder by f,
// which it divides by at the end. A divisor of one digit is the same machine:
// v_{n−2} = W_{n−2} = 0, and q̂ is exact.

// a digit of a plain table, no header: the remainder's and the window's
fn pdig(t, i) {
    v = if i < 0 { 0 } else if i >= len(t) { 0 } else { t[i] }
    v
}
// W = r·B + d: digit 0 is d, digit i the remainder's digit i − 1
fn wdig(r, d, i) { if i == 0 { d } else { pdig(r, i - 1) } }

// s, the least shift that puts v's top digit vt at or above B/2 = 2^63, so
// f = 2^s, the unsigned word's at s = 63; s ≤ 63 is the loop's measure, rising
// by one toward its guard
fn nshift(vt) { loop s = 0, t = vt { s >= 63 -> s; t > 9223372036854775807 -> s; else -> again(s + 1, t * 2) } }

// D3. q̂ = ⌊top / vt⌋ when below B, with r̂ = top mod vt, so r̂ < vt; then
// lowered while q̂·v_{n−2} > r̂·B + W_{n−2}, twice at most, the second time
// only while r̂ + vt < B: after it q̂ − q ∈ {0, 1}. Capped at B − 1, it is
// within 2 of q. vt is at least B/2 for a normalized v; a vt of 0 is outside
// the theory's domain, and answers 0.
fn qhat(v, n, r, d) {
    vt = pdig(v, n - 1)
    v2 = pdig(v, n - 2)
    wn = wdig(r, d, n)
    w1 = wdig(r, d, n - 1)
    w2 = wdig(r, d, n - 2)
    // q̂ ≥ B exactly when wn ≥ vt: then B − 1. Otherwise the window's top two
    // digits over vt have a one-digit quotient (the two-digit lemma), the
    // triple's 2-by-1 division
    case {
        vt < 1 -> 0
        wn >= vt -> dm
        else -> {
            top = wn * 4611686018427387904 * 4 + w1
            q0 = top / vt
            rh = top % vt
            case {
                q0 >= 1 && q0 * v2 > rh * 4611686018427387904 * 4 + w2 -> {
                    q1 = q0 - 1
                    rh1 = rh + vt
                    if rh1 <= dm && q1 >= 1 && q1 * v2 > rh1 * 4611686018427387904 * 4 + w2 { q1 - 1 } else { q1 }
                }
                else -> q0
            }
        }
    }
}

// D4: T = W − q·v over the window's n + 1 digits, the product's carry and the
// subtraction's borrow apart, in B^{n+1}'s complement; entry n + 1 is the
// sign, 1 when T < 0, which is when q was too large. THE INDEX DOMAIN SPLITS
// by what each index reads, [0, n + 2) = {0} ⊔ [1, n) ⊔ {n} ⊔ {n + 1}: the new
// digit d at 0, r_{i−1} and v_i on [1, n), r_{n−1} alone at n (v_n = 0), the
// sign at n + 1; so no read is guarded.
fn msub(ml, v, n, r, d, q) {
    nv = len(v)
    nr = len(r)
    case {
        n + 2 > ml -> abandon("out of memory: an integer longer than the largest table")
        // the divisor's table holds its n digits, its zero carry and its
        // header, and the window's its n digits: every call's, so the reads
        // below are in bounds by the loop's own guard
        n < 1 || n + 2 > nv || n > nr -> abandon("internal: Algorithm D's divisor or window is shorter than its size")
        else -> {
            var o := array { 0 : _ ∈ 0..n + 1 }
            p0 = q * v[0]
            t0 = d - (p0 & dm)
            o[0] := t0 & dm
            loop i = 1, pc = p0 >> 64, bw = if t0 < 0 { 1 } else { 0 } {
                i >= n -> {
                    // v_n = 0: a normalized divisor carries nothing out
                    t = r[n - 1] - pc - bw
                    o[n] := t & dm
                    o[n + 1] := if t < 0 { 1 } else { 0 }
                    o
                }
                else -> {
                    p = q * v[i] + pc
                    t = r[i - 1] - (p & dm) - bw
                    o[i] := t & dm
                    again(i + 1, p >> 64, if t < 0 { 1 } else { 0 })
                }
            }
        }
    }
}

// D6, for a T < 0: T + v over n + 1 digits; the carry out is what cancels T's
// complement, so the sign entry is 1 − carry, still 1 when T + v < 0
fn addv(ml, t, v, n) {
    case {
        n + 2 > ml -> abandon("out of memory: an integer longer than the largest table")
        else -> {
            nt = len(t)
            nv = len(v)
            var o := array { 0 : _ ∈ 0..n + 1 }
            loop i = 0, c = 0 {
                i >= n + 2 -> o
                i == n + 1 -> { o[i] := if c > 0 { 0 } else { 1 }; again(i + 1, c) }
                else -> { x = pg(t, nt, i) + pg(v, nv, i) + c; o[i] := x & dm; again(i + 1, x >> 64) }
            }
        }
    }
}

// the step's corrections, at most two by Theorem B: T, then T + v, then
// T + 2v, each taken only while the sign entry says the last was negative
fn fix1(ml, t, v, n) { if pdig(t, n + 1) == 1 { addv(ml, t, v, n) } else { t } }
fn back(t, n) { if pdig(t, n + 1) == 1 { 1 } else { 0 } }

// u's n digits from j against v's, from the top
fn topcmp(u, v, n, j) {
    lu = len(u) - 1
    nv = len(v)
    loop i = n - 1 {
        i < 0 -> 0
        dg(u, lu, j + i) < pg(v, nv, i) -> 0 - 1
        dg(u, lu, j + i) > pg(v, nv, i) -> 1
        else -> again(i - 1)
    }
}

// k digits of u from lo, a plain table: the machine's first state
fn slice(u, lo, k) {
    lu = len(u) - 1
    var o := array { 0 : _ ∈ 0..k }
    loop i = 0 { i >= k + 1 -> o; else -> { o[i] := if i < k { dg(u, lu, lo + i) } else { 0 }; again(i + 1) } }
}

// D8: the normalized remainder r over n digits divided by f = 2^sh, in K(ℕ*)
// with the sign s: digit i of ⌊r / f⌋ is ((r_{i+1}·B + r_i) >> sh) & (B − 1),
// a shift of the double word by a word
fn unnorm(ml, r, n, sh, s) {
    nr = len(r)
    var o := array { 0 : _ ∈ 0..n }
    loop i = 0, top = 0 {
        i >= n + 1 -> o
        i == n -> { o[i] := signed(s, top); again(i + 1, top) }
        else -> {
            x = ((pg(r, nr, i + 1) * 4611686018427387904 * 4 + pg(r, nr, i)) >> sh) & dm
            o[i] := x
            again(i + 1, if x != 0 { i + 1 } else { top })
        }
    }
}

// TRUNCATED DIVISION BY A NUMERAL: |a| div |b| with the product of the signs
// (0 at zero, by the header). u = |a|·f and v = |b|·f; the machine starts in
// u's top n − 1 digits, and the kq = m_u − n + 1 quotient digits are its
// outputs, written from the top by a descending build whose header goes
// first: the quotient's size is kq when u's top n digits are at least v, and
// kq − 1 otherwise.
fn div(ml, a, b) {
    n = size(b)
    s = (sgn(a) + sgn(b)) % 2
    case {
        n < 1 -> abandon("division by zero")
        mcmp(ml, a, b) < 0 -> of(ml, 0)
        else -> {
            sh = nshift(dig(b, n - 1))
            v = mul_small(ml, b, 1 << sh)
            u = mul_small(ml, a, 1 << sh)
            kq = size(u) - n + 1
            case {
                kq < 1 -> of(ml, 0)
                else -> {
                    mq = if topcmp(u, v, n, kq - 1) < 0 { kq - 1 } else { kq }
                    lu = len(u) - 1
                    var o := array { 0 : _ ∈ 0..kq }
                    loop i = kq, r = slice(u, kq, n - 1) {
                        i < 0 -> o
                        i == kq -> { o[i] := signed(s, mq); again(i - 1, r) }
                        else -> {
                            d = dg(u, lu, i)
                            q = qhat(v, n, r, d)
                            t0 = msub(ml, v, n, r, d, q)
                            t1 = fix1(ml, t0, v, n)
                            // q̂ − b, b ∈ {0, 1, 2} corrections, and q̂ ≥ b whenever b > 0
                            // (Theorem B). Split on a constant, which intervals see: for
                            // q̂ ≥ 2 the difference is in [0, B), and below 2 a word, whose
                            // clamp at 0 is the identity on every execution
                            b = back(t0, n) + back(t1, n)
                            o[i] := case {
                                q >= 2 -> q - b
                                else -> { qs = q - b; if qs < 0 { 0 } else { qs } }
                            }
                            again(i - 1, fix1(ml, t1, v, n))
                        }
                    }
                }
            }
        }
    }
}

// THE TREE OF DIVISIONS (radix-research.md §4). Printing is ε_β⁻¹ ∘ ε_B, β =
// 10^18, and with P_j = β^(2^j), x = q·P_j + r splits x's base-β digits in
// two: r's the low 2^j, q's the high. Recursing gives a balanced tree whose
// shape is x's size's alone, so it is a loop over levels (ADR 0014): level L
// is one table of 2^L slots, each node below P_{J−L}², split by P_{J−L} with
// Algorithm D in place (below), the low child the remainder and the high the
// quotient. The last level splits nodes below β² by
// β, one 2-by-1 division a node. The powers come by squaring (ADR 0110).

// β = 10^18, the largest power of 10 below 2^62: a constant divisor the
// double word takes directly (10^19 is above it, a word for the 2-by-1
// division, whose premise a rule's body did not carry)
kb = 1000000000000000000

// the powers P_0 … P_J, each in a slot of w words: its size, then its digits
fn kpows(ml, jt, w) {
    n = room(ml, (jt + 1) * w)
    var o := array { 0 : _ ∈ 0..n - 1 }
    loop j = 0, p = of(ml, kb) {
        j > jt -> o
        else -> { kput(o, p, j * w, w); again(j + 1, sqr(ml, p)) }
    }
}
fn kput(o linear, p, b0, w) {
    m = size(p)
    b = if b0 < 0 { 0 } else { b0 }
    loop i = 0 {
        i > m || i >= w -> ()
        else -> { wr(o, b + i, if i == 0 { m } else { dig(p, i - 1) }); again(i + 1) }
    }
}
// P_j's size, from its slot, against the slot's width once
fn ksz(pt, j, w) { m = kat(pt, j * w); if m > w - 1 { w - 1 } else { m } }
// P_j as a numeral, from its slot
fn kpow(pt, j, w) {
    m = ksz(pt, j, w)
    alloc(array { if i == m { signed(0, m) } else { kat(pt, j * w + 1 + i) } : i ∈ 0..m })
}

// ALGORITHM D IN PLACE, a level at a time (radix-research.md §4). A node u of
// level j is below P_j² ≤ P_j·B^k, k = size(P_j), so u′ = u·2^s < v·B^k for the
// normalized divisor v = P_j·2^s: u′'s word 2k is 0, the quotient has k digits,
// positions k − 1 down to 0, and the window of step jq is U[jq .. jq + k]. After
// the step the window is below v < B^k, so its top word U[jq + k] is 0, and the
// quotient digit is stored there: at the node's end its slot holds the
// remainder·2^s in words 0 .. k − 1 and the quotient in words k .. 2k − 1. No
// step allocates. D4 leaves the window in (−2v, v), so in k + 1 words of
// complement it is negative exactly when its top word is not 0: D6 adds v back
// while it is, at most twice (Theorem B). Word 2k, 0 in u′ and below every
// window, holds q̂ while D6 counts it down, (q̂ − 1) mod B, so no loop variable
// carries a digit (one in [0, 2^64) is no `Int`).

// the normalized node: u′_i = ((u_i·B + u_{i−1}) >> (64 − s)) mod B, pointwise,
// the slot's digits 0 off it
fn kun(t, w, w2, sh, i) {
    b = (i / w2) * w
    p = i % w2
    hi = kslot(t, b, w, p) & dm
    lo = kslot(t, b, w, p - 1) & dm
    ((hi * 4611686018427387904 * 4 + lo) >> (64 - sh)) & dm
}

// D3: q̂ from the window's top three words and v's top two, at most B − 1,
// refined twice; the reads state the digit's invariant as their mask
fn kq4(u2, u1, u0, v, k) {
    vt = pdig(v, k - 1) & dm
    v2 = pdig(v, k - 2) & dm
    w2 = u2 & dm
    w1 = u1 & dm
    w0 = u0 & dm
    case {
        vt < 1 -> 0
        w2 >= vt -> dm
        else -> {
            top = w2 * 4611686018427387904 * 4 + w1
            q0 = top / vt
            rh = top % vt
            case {
                q0 >= 1 && q0 * v2 > rh * 4611686018427387904 * 4 + w0 -> {
                    q1 = q0 - 1
                    rh1 = rh + vt
                    if rh1 <= dm && q1 >= 1 && q1 * v2 > rh1 * 4611686018427387904 * 4 + w0 { q1 - 1 } else { q1 }
                }
                else -> q0
            }
        }
    }
}

// D4: U[b .. b + k] −= q·v, the borrow chained into the top word. The row bounds
// what it reads and writes once (kmac's idiom), the identity on every node.
fn kmsubrow(o linear, b0, v, k0, q) {
    b = if b0 < 0 { 0 } else { b0 }
    lo = len(o) - b - 1
    lv = len(v) - 1
    k1 = if k0 > lo { lo } else { k0 }
    k = if k1 > lv { lv } else { k1 }
    loop i = 0, pc = 0, bw = 0 {
        i >= k -> if b + k >= 0 { t = o[b + k] - pc - bw; o[b + k] := t & dm } else { () }
        else -> {
            p = q * v[i] + pc
            t = o[b + i] - (p & dm) - bw
            o[b + i] := t & dm
            again(i + 1, p >> 64, if t < 0 { 1 } else { 0 })
        }
    }
}

// D6: U[b .. b + k] += v, the carry into the top word, mod B there: it cancels
// the complement
fn kaddrow(o linear, b0, v, k0) {
    b = if b0 < 0 { 0 } else { b0 }
    lo = len(o) - b - 1
    lv = len(v) - 1
    k1 = if k0 > lo { lo } else { k0 }
    k = if k1 > lv { lv } else { k1 }
    loop i = 0, c = 0 {
        i >= k -> if b + k >= 0 { o[b + k] := (o[b + k] + c) & dm } else { () }
        else -> {
            t = o[b + i] + v[i] + c
            o[b + i] := t & dm
            again(i + 1, t >> 64)
        }
    }
}

// the next level from the divided one: slot 2j node j's remainder, unnormalized,
// ((r′_{i+1}·B + r′_i) >> s) mod B, r′'s word k being 0; slot 2j + 1 its quotient
fn kout(u, w2, k, sh, w1, i) {
    j = i / (2 * w1)
    x = i % (2 * w1)
    b = j * w2
    case {
        x < w1 && x < k -> {
            cur = kslot(u, b, w2, x) & dm
            nxt = if x + 1 < k { kslot(u, b, w2, x + 1) & dm } else { 0 }
            ((nxt * 4611686018427387904 * 4 + cur) >> sh) & dm
        }
        x < w1 -> 0
        x - w1 < k -> kslot(u, b, w2, k + x - w1) & dm
        else -> 0
    }
}

// a node's significant length L, from the frozen level: u′ < B^(L+1) and v ≥
// B^(k−1)·2^63, so q < B^(L−k+2), and the steps above jq₀ = min(k − 1, L + 1 − k)
// are of a zero window, q̂ = 0, their digit's word already 0: the first step
// of node j is jq₀, and jq₀ < 0 is a node below P_j, its quotient 0
fn knlen(t, b, w) {
    loop i = w - 1 {
        i < 0 -> 0
        (kslot(t, b, w, i) & dm) != 0 -> i + 1
        else -> again(i - 1)
    }
}
fn kst(sz, j, k) {
    l = if j >= 0 && j < len(sz) { sz[j] } else { 2 * k }
    s = l + 1 - k
    if s > k - 1 { k - 1 } else { s }
}

// ONE LEVEL: every node of t (slots of 2k words) divided by P_j, whose
// normalized form is v (k ≥ 2 digits, shift s), into 2·nodes slots of w1 words.
// One loop over nodes × quotient digits, each step D3 and D4 then D6 until the
// window's top word is 0, then the digit stored there.
fn kdlevel(ml, t, nodes, v, k, sh, w0) {
    // w0 = 2·size(P_{j−1}) ≥ 2: the clamp is the identity, stated for kout's /
    w1 = if w0 < 1 { 1 } else { w0 }
    w = 2 * k
    w2 = 2 * k + 1
    n = room(ml, nodes * w2)
    sz = alloc(array { knlen(t, j * w, w) : j ∈ 0..room(ml, nodes) - 1 })
    u = {
        var o := array { kun(t, w, w2, sh, i) : i ∈ 0..n }
        // the slot's base sb = j·w2 is carried, so every index is linear in
        // it: sb + w2 ≤ n and jq ≤ k − 1 put the window's top, sb + jq + k ≤
        // sb + w2 − 2, inside the buffer, and k ≥ 2 (P_j ≥ β² > B) its
        // bottom, sb + jq + k − 2 ≥ 0
        loop j = 0, sb = 0, jq = kst(sz, 0, k), ph = 0 {
            k < 2 || sb + w2 > n -> o
            jq < 0 -> again(j + 1, sb + w2, kst(sz, j + 1, k), 0)
            ph == 0 -> {
                tp = sb + jq + k
                qh = kq4(o[tp], o[tp - 1], o[tp - 2], v, k)
                o[sb + w] := qh
                kmsubrow(o, sb + jq, v, k, qh)
                again(j, sb, jq, 1)
            }
            o[sb + jq + k] != 0 -> {
                o[sb + w] := (o[sb + w] - 1) & dm
                kaddrow(o, sb + jq, v, k)
                again(j, sb, jq, 1)
            }
            else -> {
                o[sb + jq + k] := o[sb + w] & dm
                again(j, sb, jq - 1, 0)
            }
        }
    }
    n1 = room(ml, 2 * nodes * w1)
    alloc(array { kout(u, w2, k, sh, w1, i) : i ∈ 0..n1 - 1 })
}

// THE LAST LEVEL: nodes below β² (slots of 2 words) split by β, the 2-by-1
// division: digit 2j the remainder, digit 2j + 1 the quotient, so the table is
// x's base-β digits, least significant first. Each read states the digit's
// invariant as its mask (the reads' idiom above), since the level loop's
// table carries no element bound across its iterations; and a node below β²
// has hi < β, the 2-by-1 division's domain (the two-digit lemma), stated as
// the guard qhat states it, its other arm unreached by any node
fn kdlast(ml, t, nodes) {
    n = room(ml, 2 * nodes)
    alloc(array {
        {
            hi = kslot(t, 2 * (i / 2), 2, 1) & dm
            lo = kslot(t, 2 * (i / 2), 2, 0) & dm
            case {
                hi >= kb -> 0
                else -> {
                    u = hi * 4611686018427387904 * 4 + lo
                    q = u / kb
                    r = u % kb
                    if i % 2 == 0 { r } else { q }
                }
            }
        }
        : i ∈ 0..n - 1 })
}

// x's base-β digits, least significant first, by the tree of divisions
fn kdigits(ml, a) {
    m = size(a)
    // the base-β digits number at most m + m/14 + 1 (log_β B = 64/59.79 <
    // 1 + 1/14), and x < P_J² once 2^(J+1) reaches it
    lim = m + m / 14 + 1
    jt0 = loop t = 0, p = 1 { p >= lim || t >= 40 -> t; else -> again(t + 1, 2 * p) }
    jt = if jt0 < 1 { 0 } else { jt0 - 1 }
    pw = room(ml, m + 2)
    pt = kpows(ml, jt, pw)
    kj = ksz(pt, jt, pw)
    t0 = alloc(array { dg(a, len(a) - 1, i) : i ∈ 0..2 * kj - 1 })
    loop j = jt, t = t0, nodes = 1 {
        // the machine's bound, as room's: 2^24 nodes are 2^24 base-β digits
        nodes > 16777216 -> abandon("out of memory: an integer longer than the largest table")
        j < 1 -> kdlast(ml, t, nodes)
        else -> {
            p = kpow(pt, j, pw)
            k = size(p)
            sh = nshift(dig(p, k - 1))
            v = mul_small(ml, p, 1 << sh)
            cw = 2 * ksz(pt, j - 1, pw)
            again(j - 1, kdlevel(ml, t, nodes, v, k, sh, cw), 2 * nodes)
        }
    }
}

// the text of x from its base-β digits: 18 characters a digit, most
// significant first, then render1's stripping of leading zeros and the sign
fn render2(ml, a) {
    dt = kdigits(ml, a)
    n = 18 * len(dt) + 20
    case {
        n > ml -> abandon("out of memory: an integer longer than the largest table")
        else -> {
            f = {
                var b := array { 48 : _ ∈ 0..n - 1 }
                loop k = 0, r = 0 {
                    k >= n - 1 -> b
                    k % 18 == 0 -> {
                        d = kat(dt, k / 18)
                        b[n - 1 - k] := 48 + d % 10
                        again(k + 1, d / 10)
                    }
                    else -> {
                        b[n - 1 - k] := 48 + r % 10
                        again(k + 1, r / 10)
                    }
                }
            }
            neg = sgn(a) == 1
            loop l = n - 1 {
                l <= 1 -> if neg { numeral(f, n, 2, 1) } else { numeral(f, n, 1, 0) }
                f[n - l] != 48 -> if neg { numeral(f, n, l + 1, 1) } else { numeral(f, n, l, 0) }
                else -> again(l - 1)
            }
        }
    }
}

// a copy of a numeral: a function's result is born in it (W13, ADR 0101), so
// one that would answer its argument answers this
fn copy(ml, a) {
    n = len(a)
    var o := array { 0 : _ ∈ 0..n - 1 }
    loop i = 0 { i >= n -> o; else -> { o[i] := a[i]; again(i + 1) } }
}

// THE REMAINDER: the machine's last state, divided by f, with the dividend's
// sign
fn rem(ml, a, b) {
    n = size(b)
    case {
        n < 1 -> abandon("division by zero")
        mcmp(ml, a, b) < 0 -> copy(ml, a)
        else -> {
            sh = nshift(dig(b, n - 1))
            v = mul_small(ml, b, 1 << sh)
            u = mul_small(ml, a, 1 << sh)
            kq = size(u) - n + 1
            case {
                kq < 1 -> copy(ml, a)
                else -> {
                  lu = len(u) - 1
                  loop i = kq - 1, r = slice(u, kq, n - 1) {
                    i < 0 -> unnorm(ml, r, n, sh, sgn(a))
                    else -> {
                        d = dg(u, lu, i)
                        t0 = msub(ml, v, n, r, d, qhat(v, n, r, d))
                        again(i - 1, fix1(ml, fix1(ml, t0, v, n), v, n))
                    }
                  }
                }
            }
        }
    }
}

// ------------------------------------------------------------ the one set
//
// A BOUNDED SET ON K(ℕ*) (ADR 0029): a program whose set is N_k or Z_k, moved
// to K(ℕ*) because the fixed limbs lack an operation it uses, is enforced by
// the set's two observables, the sign and the bit length, read off the header
// and the top digit: bitlen = 64·(m − 1) + bitlen(top digit).
fn blen(x) { loop b = 0, y = x { b >= 64 -> b; y < 1 -> b; else -> again(b + 1, y / 2) } }
fn bitlen(a) {
    m = size(a)
    if m < 1 { 0 } else { 64 * (m - 1) + blen(dig(a, m - 1)) }
}
// N_k = [0, 2^k): a when 0 ≤ a < 2^k, the bound's crash otherwise
fn fit(ml, a, k) {
    case { sgn(a) == 1 || bitlen(a) > k -> abandon("bignum overflow: the declared range is too small"); else -> a }
}
// Z_k = (−2^k, 2^k): a when |a| < 2^k
fn fit_signed(ml, a, k) {
    case { bitlen(a) > k -> abandon("bignum overflow: the declared range is too small"); else -> a }
}
