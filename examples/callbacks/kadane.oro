// kadane: THE MAXIMUM SUBARRAY, BY THE JVM'S forEachOrdered.
//
// WHAT IT IS. For a table a, the maximum subarray sum is
//     M(a) = max over 0 ≤ i ≤ j ≤ n of a[i] + … + a[j − 1],
// the empty subarray included, so M(a) ≥ 0. Kadane's algorithm (Bentley,
// Programming Pearls, 1984) computes it in one pass, by the recurrence
//     c_0 = 0,  c_{k+1} = max(0, c_k + a[k]),   M = max_k c_k,
// c_k the best sum of a subarray ending at k. The recurrence is a fold of a
// function that is not commutative: c depends on the order of the elements
// ({4, −5, 4} has M = 4, {4, 4, −5} has M = 8). So the λ that steps it writes
// two cells, c and m, whose final values depend on the order of its calls,
// and the JDK fixes that order: a long[]'s stream is ORDERED, and
// forEachOrdered keeps "encounter order". The claim is `ordered`, and the
// cells are threaded in it (ADR 0143, Theorem T₁).
//
// The program checks Kadane by the host against the quadratic search of its
// own over every (i, j), on a hundred tables, and prints Bentley's example
// {−2, 1, −3, 4, −1, 2, 1, −5, 4}, whose answer is 6, then how many of the
// hundred agree: 100.
//
// THE GUARDS are the analysis's: the host promises no bound on its calls, so
// the λ reads as a loop of unknown trip count, and the claim's domain is Int,
// not the table's elements, so c + x is proven inside the word only under a
// bound on c and on x.
use io
use java/Arrays

// Kadane's pass, by the host's traversal
fn by_host(a ∈ long_array) (Int) {
    var c := 0
    var m := 0
    Arrays.forEachOrdered(a, fn(x) {
        if -1000000 < x && x < 1000000 && -1000000000 < c && c < 1000000000 {
            c := if c + x > 0 { c + x } else { 0 }
        }
        if c > m { m := c }
    })
    m
}

// every subarray, by two loops of the program's own
fn by_search(a ∈ Array(-9..9)) (Int) {
    loop i = 0, best = 0 {
        i < len(a) -> {
            b = loop j = i, s = 0, top = best {
                j < len(a) -> again(j + 1, s + a[j], if s + a[j] > top { s + a[j] } else { top })
                else -> top
            }
            again(i + 1, b)
        }
        else -> best
    }
}

export fn main() {
    io.print_int(by_host(array { -2, 1, -3, 4, -1, 2, 1, -5, 4 }))
    loop k = 0, agree = 0 {
        k < 100 -> {
            a = alloc(array { (i * 7 + k * 13) % 19 - 9 : i ∈ 0..11 })
            same = by_host(a) == by_search(a)
            again(k + 1, if same && agree < 100 { agree + 1 } else { agree })
        }
        else -> io.print_int(agree)
    }
}
