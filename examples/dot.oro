; The thesis, runnable. Two targets, one program — now across two FILES.
;
;   oro -target=blas examples/dot.oro   ⟶  (dot p q)
;   oro -target=go   examples/dot.oro   ⟶  a loop
;
; Nothing distinguishes the targets except which names they call primitive, and
; nothing distinguishes an imported definition from a local one.

(use num/vec)

; Bound, so the term is closed and the residual check has nothing to report.
(fn (p q) (vec.dot p q))
