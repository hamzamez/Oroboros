; Sum of the positive elements. Written as a pipeline over a push collection —
; a collection represented as its own fold (docs/spec/q5b-filter.md).
;
; The residual duplicates (aindex a i): once in the predicate and once in the
; accumulation, because beta substitutes unconditionally and call-by-need is
; not implemented. docs/spec/concerns.md claims that costs "a silent 2x on the
; hot loop". This file exists to find out.

(target go (prim add alen aindex fold-range if gt))

(def push-of-array (fn (a)   (fn (step z) (fold-range z (alen a) (fn (acc i) (step acc (aindex a i)))))))
(def push-filter   (fn (p c) (fn (step z) (c (fn (acc x) (if (p x) (step acc x) acc)) z))))
(def push-sum      (fn (c)   (c (fn (acc x) (add acc x)) 0.0)))

(def positive (fn (x) (gt x 0.0)))

(fn (a) (push-sum (push-filter positive (push-of-array a))))
