; The first Oroboros program that produces a binary.
;
;   build -target=go -o hello examples/hello.oro
;
; The entry point is an export named `main` taking no arguments — build.md §2.
; Its body may be impure because the λ makes it a VALUE, which is what ADR 0010
; requires of a definition body; the effects happen when the emitted entry
; applies it.
;
; Note what is NOT here: no runtime, no prelude, no support library. The emitted
; Go is a `package main` with one function, and the binary is whatever `go build`
; makes of it.

(use io)
(use num/int)

(export main)

(def main (fn ()
  (seq (io.print-line "hello from oroboros")
       (io.print-line (twice 21)))))

(def twice (fn (n) (int.add n n)))
