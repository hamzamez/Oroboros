// Euclid's algorithm — the textbook size-change case.
//
// Neither variable descends on its own: x' is y, and y' is x mod y. What
// terminates the loop is that `x mod y < y`, which is an arc from y to y through
// an expression y does not head. Lee, Jones & Ben-Amram use this shape to
// motivate the principle.
use go

export fn gcd(a ∈ Int, b ∈ Int) (Int) where (0 <= a && a < 1000000) && 0 <= b && b < 1000000 {
    loop x = a, y = b { go.`==`(y, 0) -> x; else -> again(y, go.`%`(x, y)) }
}
