// The plainest bounded accumulator there is: sum of 0..n-1.
//
// Nothing guards `s`. Its bound comes entirely from the trip count times the
// largest step, which is the mechanism size change added.
use go

export fn sum_range(n ∈ Int) (Int) where 0 <= n && n < (2^16) {
    loop i = 0, s = 0 { go.`>=`(i, n) -> s; else -> again(go.`+`(i, 1), go.`+`(s, i)) }
}
