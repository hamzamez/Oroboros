; THE STORE'S LAW, ON EVERY HOST THAT HAS THE PORTABLE `os`.
;
; ReadFile and WriteFile are get and put on the store F : Path ⇀ B*, and after
; a put succeeds, a get of the same path gives what was put: the put-get law of
; a lens (Foster et al., 2007). This program states the law once and prints its
; evidence. It writes a file named on the command line, reads it back, and
; prints the text, the variable ORO_ROUNDTRIP, and the length in bytes.
;
; IT CALLS EVERY NAME `os` AND `io` DECLARE, and cmd/build's
; TestEveryPortableNameRunsOnEveryHost builds it on Go, JavaScript and Java,
; runs each, and requires one output, byte for byte. Until it existed nothing
; ran WriteFile off Go, and it compiled on neither other host
; (libos-2026-09-30). The three tools beside it never write a file.
;
; The bytes are `hi €` and a newline: ASCII and one three-byte scalar, so the
; JVM's widening on the way in and narrowing on the way out both meet a byte
; above 127.
;
; AND THE KINDS AGREE (spec/errors.md §6): a path that is not there fails as
; `not-found` on every host, through Go's os.IsNotExist, Node's ENOENT and Java's
; NoSuchFileException, each classified by the one h in lib/os.oro. A failure is
; a value of lib/result's sum (ADR 0040), so each call is a `case`, and no value
; of a failed call can be read (oskinds-2026-10-06).
(use os)
(use io)
(use result)

(export main)

(def kind-name (k)
  (case k
    os.not-found   "not-found"
    os.exists      "exists"
    os.permission  "permission"
    (os.other e)   "other"))

(def main ()
  (let av (os.Args)
    (if (< (len av) 2)
        (seq (io.print-line "usage: roundtrip FILE") 1)
        (let path (av 1)
          (case (os.WriteFile path (array 104 105 32 226 130 172 10))
            (result.err k)
              (seq (io.print-line (concat "roundtrip: cannot write that file: " (kind-name k))) 1)
            (result.ok _)
              (case (os.ReadFile path)
                (result.err k)
                  (seq (io.print-line (concat "roundtrip: cannot read that file: " (kind-name k))) 1)
                (result.ok src)
                  (seq (io.print (os.text-of src))
                       (io.print-line (os.Getenv "ORO_ROUNDTRIP"))
                       (io.print-int (len src))
                       (io.print-line
                         (case (os.ReadFile (concat path ".missing"))
                           (result.ok b)  "found"
                           (result.err k) (kind-name k)))
                       0)))))))
