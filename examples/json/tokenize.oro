; A JSON TOKENISER OVER A TABLE OF BYTES, WITH AN EXPLICIT STACK.
;
; ADR 0014 says recursion is not in the language, and the standing counter-claim
; is that recursive data is a flat table plus indices. A JSON document is the
; case that claim has to survive: it nests to a depth the INPUT decides, and
; every textbook treatment of it is a recursive-descent parser.
;
; So this is the control half of that claim, written with `loop`, `again` and a
; stack in a `build` buffer. It tokenises, classifies, and bracket-matches --
; the part of parsing that recursion is normally for.
;
; Three clauses here exist because the REFINEMENT layer demanded them, and each
; one is marked. That is the interesting result: they are not noise, they are
; the parser being made to state what it does at its limits.
;
; Returns  ntokens * 1000 + maxdepth * 10 + ok.

(use go)
(export run)

(def cap (fn () 32))

; --- character classes ------------------------------------------------------

(def space? (fn (c) (or (= c 32) (or (= c 9) (or (= c 10) (= c 13))))))
(def digit? (fn (c) (and (go.>= c 48) (go.<= c 57))))
(def alpha? (fn (c) (and (go.>= c 97) (go.<= c 122))))
(def numeric? (fn (c)
  (or (digit? c) (or (= c 45) (or (= c 43) (or (= c 46) (or (= c 101) (= c 69))))))))

(def opener? (fn (c) (or (= c 123) (= c 91))))
(def closer? (fn (c) (or (= c 125) (= c 93))))
(def punct?  (fn (c) (or (= c 58) (= c 44))))

; --- scanners: each returns the index just past what it consumed ------------

(def scan-string (fn (src i)
  (loop ((j (go.+ i 1)))
    ; REFINEMENT 1. `j >= i + 1` is a RELATIONAL fact, and the interval analysis
    ; is non-relational (decidability-map.md), so `j >= 0` does not follow from
    ; `i >= 0` and has to be stated. This clause is where it comes from.
    (go.< j 0)           j
    (go.>= j (len src))  j
    (= (src j) 92)       (again (go.+ j 2))     ; an escape: skip the next byte
    (= (src j) 34)       (go.+ j 1)             ; the closing quote
    else                 (again (go.+ j 1)))))

(def scan-run (fn (src i pred)
  (loop ((j i))
    (go.< j 0)           j
    (go.>= j (len src))  j
    (pred (src j))       (again (go.+ j 1))
    else                 j)))

; --- the tokeniser ----------------------------------------------------------

(def tokens (fn (src)
  (build (cap) (fn (stk)
    (loop ((stk stk) (i 0) (nt 0) (sp 0) (mx 0) (ok 1))

      ; REFINEMENT 2. A scanner's result is opaque to the analysis -- it is a
      ; loop's value, not an expression it can bound -- so `i` is not provably
      ; non-negative once it comes back from one. One compare per token buys it.
      (go.< i 0)  0

      (go.>= i (len src))
        (go.+ (go.* nt 1000) (go.+ (go.* mx 10) (if (= sp 0) ok 0)))

      ; REFINEMENT 3, AND THE ONE WORTH READING. Depth is finite and the
      ; compiler MAKES THE PARSER SAY SO. The stack is a table of `cap`
      ; elements, `(set stk sp ...)` carries `sp < cap` as an obligation, and
      ; nothing here can discharge it, because `sp` grows with the input. So the
      ; program must answer the question "what happens when the nesting is
      ; deeper than the stack".
      ;
      ; A recursive-descent parser has exactly the same limit -- the C stack --
      ; and is never asked. That is the trade this file exists to show: the
      ; explicit stack does not make the limit exist, it makes it VISIBLE.
      ;
      ; AND ITS POSITION IS LOAD-BEARING, which is the day's other finding.
      ; Moving this clause ABOVE the end-of-input clause takes the program from
      ; 80 of 124 integer operations bounded and 12 of 16 loops proven
      ; terminating to 36 and 0 -- same guards, same answers on these four
      ; documents, one clause swapped (json-2026-08-26 §4).
      (go.>= sp (cap))  (go.* nt 1000)


      (space? (src i))   (again stk (go.+ i 1) nt sp mx ok)

      ; an opener: push the closer we expect, and record the depth
      (opener? (src i))
        (again (set stk sp (if (= (src i) 123) 125 93))
               (go.+ i 1) (go.+ nt 1) (go.+ sp 1)
               (if (go.> (go.+ sp 1) mx) (go.+ sp 1) mx) ok)

      ; a closer: it must match the top of the stack. A closer with nothing open
      ; is unbalanced, and the index is CLAMPED rather than guarded so that the
      ; indexing obligation holds on both sides of the test.
      (closer? (src i))
        (again stk (go.+ i 1) (go.+ nt 1)
               (if (go.< sp 1) 0 (go.- sp 1)) mx
               (if (go.< sp 1) 0
                   (if (= (stk (if (go.< sp 1) 0 (go.- sp 1))) (src i)) ok 0)))

      (punct? (src i))   (again stk (go.+ i 1) (go.+ nt 1) sp mx ok)
      (= (src i) 34)     (again stk (scan-string src i) (go.+ nt 1) sp mx ok)
      (numeric? (src i)) (again stk (scan-run src i numeric?) (go.+ nt 1) sp mx ok)
      (alpha? (src i))   (again stk (scan-run src i alpha?) (go.+ nt 1) sp mx ok)

      else (again stk (go.+ i 1) nt sp mx 0))))))

; --- documents, selected by k ----------------------------------------------

; {"a":[1,2],"b":true}          13 tokens, depth 2, valid
(def d0 (array 123 34 97 34 58 91 49 44 50 93 44 34 98 34 58 116 114 117 101 125))
; [[[1]]]                        7 tokens, depth 3, valid
(def d1 (array 91 91 91 49 93 93 93))
; {"a":1                         4 tokens, depth 1, UNTERMINATED
(def d2 (array 123 34 97 34 58 49))
; ]                              1 token, a closer with nothing open
(def d3 (array 93))

(sig run ((k int)) int)
(def run (fn (k)
  (if (= k 0) (tokens d0)
    (if (= k 1) (tokens d1)
      (if (= k 2) (tokens d2) (tokens d3))))))
