; BUILT WITH `-checked` -- `go run ./cmd/build -checked …`.
;
; ADR 0019 makes an integer operation the compiler cannot bound a compile
; error, and 36 of this program's 464 cannot be bounded. Every one chains off
; a value read out of the frozen node table, whose stores are genuinely
; unbounded inside the `build` lambda because `src` is free there
; (frozen-2026-08-28). That is the honest limit of a non-relational domain and
; not something a declaration here can fix, so this program takes ADR 0019's
; second escape: the trap instead of the proof.
;
; A JSON TREE AS A FLAT TABLE PLUS INDICES — parsed, linked, and WALKED.
;
; examples/json/tokenize.oro settled the CONTROL half of the standing claim that
; recursive data is a flat table plus indices: nesting to an input-decided depth
; needs no recursion, only a stack in a table. It deliberately did not settle the
; VALUE half, because it produces counts and not a tree.
;
; This is the value half. It builds the document as a node table, links parent
; to child and sibling to sibling with indices, and then TRAVERSES it — because
; building a tree and never walking it would prove nothing, and the walk is
; where a tree normally recurses.
;
; THE NODE TABLE. Node k occupies four slots, stride 4:
;
;   4k+0  tag    1 number, 2 string, 3 literal, 4 array, 5 object
;   4k+1  val    a scalar's length in bytes; 0 for a container
;   4k+2  kid    first child, 0 = none
;   4k+3  sib    next sibling, 0 = none
;
; NODE 0 IS THE `none` SENTINEL, so its own four slots are free and hold the
; header: slot 0 is the node count and slot 1 is ok. That is why `none` can be
; 0 rather than -1, and why every index in the program is non-negative — which
; the refinement layer cares about a great deal.
;
; AND `build` ZERO-FILLS (tables.md §14.3), so `kid` and `sib` never need
; initialising: a leaf writes neither and reads 0 for both. That one guarantee
; removes two stores per node and is the reason the sentinel is free.
;
; THE PARSE STACK is a second buffer, stride 2, indexed by depth:
;
;   2d+0  the open container's node index
;   2d+1  its LAST CHILD so far, 0 = none yet
;
; The second slot is what a recursive parser does not need. A recursive descent
; RETURNS its subtree and the caller appends it; here nothing returns, so the
; parser has to remember where to point next. That is the whole difference, and
; it costs one machine word per level of depth.

(use go)
(export run)

; `measure` is exported for benchmarking: it takes its source as a PARAMETER,
; which is what stops reduction from folding the whole parse away. `run` feeds
; it constants and is what the differential suite checks.
(export measure)
; THE CONTRACT IS WHAT EARNS THE REPRESENTATION. The element range says what a
; source byte is; the `where` bounds the document, which is what bounds a token
; LENGTH stored into the node table — and nothing inside the `build` can know
; that. ADR 0003 puts declarations at boundaries for exactly this reason, and
; the node table becomes 16-bit slots because of this one line
; (fixpoint-2026-08-27 §13).
(sig measure ((src (array (int 0 255)))) int (where (go.< (len src) 1024)))

; The caps. A `build` needs its length UP FRONT, so a flat node table is sized
; for the largest document it will accept rather than for the one it gets. That
; is the cost of having no growable buffer (tables.md §14.3's `append`), and it
; is a real one: a 20-byte document allocates the same table as a 6 KB one.
(def nmax (fn () 512))  ; nodes, including the sentinel
(def dmax (fn () 32))   ; nesting depth

; --- byte classes -----------------------------------------------------------

(def space? (fn (c) (or (= c 32) (or (= c 9) (or (= c 10) (= c 13))))))
(def digit? (fn (c) (and (go.>= c 48) (go.<= c 57))))
(def alpha? (fn (c) (and (go.>= c 97) (go.<= c 122))))
(def numeric? (fn (c)
  (or (digit? c) (or (= c 45) (or (= c 43) (or (= c 46) (or (= c 101) (= c 69))))))))
(def opener? (fn (c) (or (= c 123) (= c 91))))
(def closer? (fn (c) (or (= c 125) (= c 93))))
(def punct?  (fn (c) (or (= c 58) (= c 44))))
(def scalar? (fn (c) (or (= c 34) (or (numeric? c) (alpha? c)))))

; --- addressing -------------------------------------------------------------
;
; TWO ADDRESSING FORMS, and which one a site uses is a statement about what is
; KNOWN there.
;
;   nsl / ssl / ssl2   the index came from a guarded loop variable, so the
;                      bound is PROVEN and the address is bare
;   nslc               the index was read out of a table and is opaque, so it
;                      is CLAMPED into range
;
; The first version clamped everywhere, which was 1.35x slower and left the
; analysis with MORE undischarged obligations rather than fewer — 110 against
; 40 — because a clamp hides the fact instead of establishing it. What made the
; proven form possible is one Farkas multiplier in the decision procedure: a
; strided index `(go.* 4 k)` has a coefficient the guard bounding `k` does not,
; so `k < nmax` could not discharge `4k < 4*nmax` until `entails` learned to
; scale a fact (json-tree-bench-2026-08-26).
;
; The clamps that remain are real. A node index read out of the table is not
; bounded by anything the compiler can see, and no guard would help, because
; the value is data.

(def cn (fn (k) (if (go.< k 0) 0 (if (go.>= k (nmax)) 0 k))))
(def cd (fn (d) (if (go.< d 0) 0 (if (go.>= d (dmax)) 0 d))))
(def nsl (fn (k o) (go.+ (go.* 4 k) o)))
(def nslc (fn (k o) (go.+ (go.* 4 (cn k)) o)))
(def ssl (fn (d o) (go.+ (go.* 2 d) o)))

; --- scanners ---------------------------------------------------------------

(def scan-string (fn (src i)
  (loop ((j (go.+ i 1)))
    ; `j >= i + 1` is relational and the interval analysis is not, so
    ; non-negativity is stated (json-2026-08-26 §2).
    (go.< j 0)           j
    (go.>= j (len src))  j
    (= (src j) 92)       (again (go.+ j 2))
    (= (src j) 34)       (go.+ j 1)
    else                 (again (go.+ j 1)))))

(def scan-run (fn (src i pred)
  (loop ((j i))
    (go.< j 0)           j
    (go.>= j (len src))  j
    (pred (src j))       (again (go.+ j 1))
    else                 j)))

; --- linking ----------------------------------------------------------------
;
; LINKING IS EXACTLY WHAT A RECURSIVE PARSER GETS FOR FREE. `link` points the
; parent at its new child, or the previous sibling at its next one; `mark`
; records the new child so the following one knows where to attach; `push` opens
; a level. A recursive parser expresses all three by returning a value.

(def link (fn (nodes stk sp k)
  (if (go.< sp 1) nodes
    (let (stk (ssl (go.- sp 1) 1)) (fn (lc)
      (if (= lc 0)
        (set nodes (nslc (stk (ssl (go.- sp 1) 0)) 2) k)
        (set nodes (nslc lc 3) k)))))))

(def mark (fn (stk sp k)
  (if (go.< sp 1) stk (set stk (ssl (go.- sp 1) 1) k))))

(def push (fn (stk sp k) (set (set stk (ssl sp 0) k) (ssl sp 1) 0)))

; --- the parser -------------------------------------------------------------

(def parse (fn (src)
  (build (go.* 4 (nmax)) (fn (nodes)
    (build (go.* 2 (dmax)) (fn (stk)
      (loop ((nodes nodes) (stk stk) (i 0) (nn 1) (sp 0) (ok 1))

        ; A scanner's result is opaque to the analysis (json-2026-08-26 §2).
        (go.< i 0)  (set (set nodes 0 nn) 1 0)

        (go.>= i (len src))
          (set (set nodes 0 nn) 1 (if (= sp 0) ok 0))

        ; THE TWO LIMITS THE COMPILER MAKES THE PARSER STATE. `(set nodes …)`
        ; carries an obligation nothing can discharge, because both `nn` and
        ; `sp` grow with the input — so the program has to say what happens when
        ; a document has more nodes than the table, or nests deeper than the
        ; stack. A recursive-descent parser has both limits too; the heap and
        ; the C stack. It is never asked about either.
        (go.>= nn (nmax))  (set (set nodes 0 nn) 1 0)
        (go.>= sp (dmax))  (set (set nodes 0 nn) 1 0)

        (space? (src i))  (again nodes stk (go.+ i 1) nn sp ok)
        (punct? (src i))  (again nodes stk (go.+ i 1) nn sp ok)

        ; An opener allocates a container, attaches it, and opens a level. The
        ; order is forced: `mark` records it as the last child at the CURRENT
        ; depth, and only then does `push` move down.
        (opener? (src i))
          (again (link (set (set nodes (nsl nn 0) (if (= (src i) 123) 5 4))
                            (nsl nn 1) 0)
                       stk sp nn)
                 (push (mark stk sp nn) sp nn)
                 (go.+ i 1) (go.+ nn 1) (go.+ sp 1) ok)

        ; A closer pops, and checks that what it closes is what was opened —
        ; read back out of the node table, which is the first time the parser
        ; reads a node it wrote earlier.
        (closer? (src i))
          (again nodes stk (go.+ i 1) nn
                 (if (go.< sp 1) 0 (go.- sp 1))
                 (if (go.< sp 1) 0
                     (if (= (nodes (nslc (stk (ssl (go.- sp 1) 0)) 0))
                            (if (= (src i) 125) 5 4))
                         ok 0)))

        ; ONE CLAUSE FOR ALL THREE SCALARS, and ADR 0015 is why. `again` may not
        ; go under an `if`, so three clauses would each have to repeat the whole
        ; link-and-allocate expression. Computing the tag and the next index
        ; with `let` first — which ADR 0015 does permit above `again` — leaves
        ; one copy. That is the rule choosing the better shape, and it was not
        ; the first thing tried.
        (scalar? (src i))
          (let (if (= (src i) 34) 2 (if (numeric? (src i)) 1 3)) (fn (tg)
          ; Scanning starts PAST the byte the guard already matched: identical
          ; answers, and it is what makes the loop provable. Starting at `i` a
          ; scanner may return `i`, so monotonicity gives only `i' >= i` and
          ; there is no strict descent (monotone-2026-08-27).
          (let (if (= (src i) 34) (scan-string src i)
                (if (numeric? (src i)) (scan-run src (go.+ i 1) numeric?)
                                       (scan-run src (go.+ i 1) alpha?))) (fn (ni)
            (again (link (set (set nodes (nsl nn 0) tg) (nsl nn 1) (go.- ni i))
                         stk sp nn)
                   (mark stk sp nn)
                   ni (go.+ nn 1) sp ok)))))

        else (again nodes stk (go.+ i 1) nn sp 0))))))))

; --- the walk ---------------------------------------------------------------
;
; A worklist depth-first traversal: pop a node, push its sibling, then push its
; child one level deeper. This is the part a tree normally recurses for, and it
; is the reason the tree is built at all — a linking bug that a parse-only test
; cannot see shows up here as a wrong count.
;
; `steps` is a hard bound, and it is not defensive padding. Nothing in the
; language can prove this loop terminates, because progress depends on links
; read out of a table; the trip bound is what makes it a program rather than a
; hope. It is also honest about the same thing the parse limits are: a cyclic
; table would spin, so the walk says what it does about that.

; The worklist is indexed by SLOT, not by depth, and it can hold one entry per
; node — a tree shaped like a list pushes a sibling at every step.
(def cw (fn (k) (if (go.< k 0) 0 (if (go.>= k (nmax)) 0 k))))
(def ssl2 (fn (k o) (go.+ (go.* 2 k) o)))

(def walk (fn (nodes)
  (build (go.* 2 (nmax)) (fn (wl)
    (loop ((wl (set (set wl 0 1) 1 1)) (sp 1) (seen 0) (acc 0) (steps 0))
      (go.>= steps (go.* 2 (nmax)))  (go.+ (go.* seen 1000) acc)
      (go.< sp 1)                    (go.+ (go.* seen 1000) acc)
      ; The worklist has the same shape of limit the parser's two do, and for
      ; the same reason: `sp` grows with the tree and nothing can bound it, so
      ; the program has to say what it does when the worklist fills.
      (go.>= sp (nmax))              (go.+ (go.* seen 1000) acc)
      else
        (let (wl (ssl2 (go.- sp 1) 0)) (fn (n)
        (let (wl (ssl2 (go.- sp 1) 1)) (fn (d)
        (let (nodes (nslc n 3)) (fn (sb)
        (let (nodes (nslc n 2)) (fn (kd)
        (let (go.- sp 1) (fn (s1)
        (let (if (= sb 0) wl (set (set wl (ssl2 s1 0) sb) (ssl2 s1 1) d)) (fn (w1)
        (let (if (= sb 0) s1 (go.+ s1 1)) (fn (s2)
        (let (if (= kd 0) w1 (set (set w1 (ssl2 s2 0) kd) (ssl2 s2 1) (go.+ d 1))) (fn (w2)
        (let (if (= kd 0) s2 (go.+ s2 1)) (fn (s3)
          (again w2 s3 (go.+ seen 1)
                 (go.+ acc (go.* (nodes (nslc n 0)) d))
                 (go.+ steps 1)))))))))))))))))))))))))

; --- documents --------------------------------------------------------------
;
; Answers computed BY HAND before running, which is the only way the walk tests
; anything. The packed result is
;
;   nodes * 1000000 + seen * 10000 + tagdepth * 10 + ok
;
; where `nodes` counts everything but the sentinel, `seen` is how many the walk
; reached, and `tagdepth` is the sum of tag x depth. seen == nodes is the check
; that every node is reachable exactly once.

; [1,2]                 array(4)@1, num@2, num@2       tagdepth 4+2+2 = 8
(def d0 (array 91 49 44 50 93))
; {"a":1}               object(5)@1, str(2)@2, num(1)@2  tagdepth 5+4+2 = 11
(def d1 (array 123 34 97 34 58 49 125))
; [[1],2]               4@1, 4@2, 1@3, 1@2             tagdepth 4+8+3+2 = 17
(def d2 (array 91 91 49 93 44 50 93))
; {"a":[1,2],"b":true}  5@1 2@2 4@2 2@2 3@2 1@3 1@3    tagdepth 5+4+8+4+6+3+3 = 33
(def d3 (array 123 34 97 34 58 91 49 44 50 93 44 34 98 34 58 116 114 117 101 125))

(def report (fn (src)
  (let (parse src) (fn (nodes)
    (go.+ (go.* (go.- (nodes 0) 1) 1000000)
      (go.+ (go.* (walk nodes) 10)
            (nodes 1)))))))

(def measure (fn (src) (walk (parse src))))

(sig run ((k int)) int)
(def run (fn (k)
  (if (= k 0) (report d0)
    (if (= k 1) (report d1)
      (if (= k 2) (report d2) (report d3))))))
