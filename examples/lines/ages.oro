// ages: HOW MANY PEOPLE, THEIR MEAN AGE, AND THE OLDEST.
//
//   ages < FILE        each line: NAME AGE, separated by white space
//
// It prints one line, `N people, mean age M, oldest NAME (AGE)`, then how many
// lines it skipped: a line is skipped when it does not scan as a name and an
// integer, or its age is outside 0 … 150.
//
// WHAT IT IS. One fold over the lines ℓ₁ … ℓₖ, with the state
//
//     (n, sum, best, skipped) ∈ ℕ × ℕ × (Σ* × ℕ + 1) × ℕ
//
// and the step on a line that scans as (name, a) with a ∈ [0, 150]:
// n + 1, sum + a, and best ← (name, a) when a exceeds best's age (the first of
// equals is kept); on any other line, skipped + 1. The mean is ⌊sum / n⌋ for
// n ≥ 1. best's 1 is the age −1, which every age exceeds.
//
// THE STATE IS FIVE CELLS (spec/local.md §3), each written where the step says,
// in program order. THE PARSE IS GO'S fmt.Sscan into two cells for the one call,
// (out go.bytestring) and (out int) (spec/local.md §6): Go stores through their
// addresses, and the call's value is the two cells' values, then Sscan's own
// result, a partial success (fmt.oro): how many items scanned, and the error
// that says why it was fewer than two.
//
// THE LIMITS ARE STATED, as wc's and lines' are: at most 2^24 lines, so n and
// skipped stay below 2^24 and sum below 2^24 · 150 < 2^32.
use go
use go/os as gos
use go/bufio
use go/bufio/Scanner
use go/fmt
use result

cap_lines = 2^24
cap_age = 150

// Whether a partial success's error is absent.
fn ok?(r) { case r { result.'ok(u) -> true; result.'err(e) -> false } }

fn report(in, n, sum, best_name, best_age, skipped) {
    case Scanner.Err(in) {
        result.'err(e) -> { fmt.Println("ages: cannot read standard input"); 1 }
        result.'ok(u) -> {
            if n == 0 { fmt.Println("no people") } else {
                fmt.Printf("%d people, mean age %d, oldest %s (%d)\n", n, sum / n, best_name,
                    best_age)
            }
            fmt.Printf("%d lines skipped\n", skipped)
            0
        }
    }
}

fn run() {
    in = bufio.NewScanner(gos.Stdin())
    var n := 0
    var sum := 0
    var best_name := ""
    var best_age := -1
    var skipped := 0
    loop k = 0 {
        !Scanner.Scan(in) -> report(in, n, sum, best_name, best_age, skipped)
        k >= cap_lines -> { fmt.Println("ages: more than 16777216 lines"); 1 }
        else -> {
            (name, age, got, e) = fmt.Sscan(Scanner.Text(in), out go.bytestring, out Int)
            if ok?(e) && age >= 0 && age <= cap_age && n < cap_lines {
                n := n + 1
                sum := sum + age
                if age > best_age { best_name := name; best_age := age }
            } else if skipped < cap_lines { skipped := skipped + 1 }
            again(k + 1)
        }
    }
}

export fn main() {
    status = run()
    gos.Exit(status)
}
