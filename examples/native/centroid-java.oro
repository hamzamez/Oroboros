// Two accumulators over a struct-of-arrays, on the native Java target.
// The Church-encoded point reduces away completely; the residual is two scalars.
use java

export fn centroid_x(xs ∈ Array(F64), ys ∈ Array(F64)) (F64)
    where len(xs) == len(ys) && java.`<`(len(xs), 2^16) && java.`>`(len(xs), 0) {
    loop ax = 0.0, ay = 0.0, i = 0 {
        java.`>=`(i, len(xs)) -> java.`f+`(ax, ay)
        else -> again(java.`f+`(ax, xs[i]), java.`f+`(ay, ys[i]), java.`+`(i, 1))
    }
}
