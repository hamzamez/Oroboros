; Two accumulators over a struct-of-arrays, on the native Java target.
; The Church-encoded point reduces away completely; the residual is two scalars.
(use java)
(export centroid-x)

(sig centroid-x ((xs (array f64)) (ys (array f64))) f64
  (where (and (= (len xs) (len ys))
              (java.< (len xs) 65536)
              (java.> (len xs) 0))))

(def centroid-x (fn (xs ys)
  (loop ((ax 0.0) (ay 0.0) (i 0))
    (java.>= i (len xs))  (java.f+ ax ay)
    else                  (again (java.f+ ax (xs i))
                                 (java.f+ ay (ys i))
                                 (java.+ i 1)))))
