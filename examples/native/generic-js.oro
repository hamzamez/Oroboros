// Gauntlet program 3 — one generic operation, two instantiations — on the
// NATIVE JavaScript target.
//
// The Go version of this file argued that the two instantiations reach genuinely
// different host functions — go.at-float64 over []float64 and go.at-string over
// []string. On JavaScript they reach THE SAME ONE. `js.at` indexes anything,
// because JS containers are untyped, so the element type is not what
// distinguishes the instantiations here.
//
// What still does is `combine`: `js.+` is an expression and the object update is
// a statement, so the two residuals have different shapes and neither is a
// specialisation of a shared body. The claim survives on the host that removes
// the easy half of the evidence.
use js
use js/String

fn reduce_over(n, get, combine, init) {
    loop acc = init, i = 0 {
        js.`>=`(i, n) -> acc
        else -> again(combine(acc, get(i)), js.`+`(i, 1))
    }
}

fn bump(o, w) { js.put(o, w, js.`+`(js.`??`(js.get(o, w), 0), 1)) }

fn sum_floats(a) { reduce_over(js.len(a), fn(i) { js.at(a, i) }, js.`+`, 0.0) }

fn tally_words(ws) { reduce_over(js.len(ws), fn(i) { js.at(ws, i) }, bump, js.object()) }
export fn sum_of(a ∈ Any) (Any) { sum_floats(a) }
export fn word_tally(text ∈ Any) (Any) { tally_words(String.fields(text)) }
