// Gauntlet program 5 — formatted output — on the NATIVE JavaScript target.
//
// The Tier 2 binding story: `fmt` on Go, `console` on JS. Both are one line in
// a target file and no compiler code, which is the claim.
//
// The effect discipline is the same on both hosts and for the same reason:
// `console.log` declares no `pure`, so its result — used zero times — cannot be
// dropped, and `seq` survives (effects.md §5).
use js
use js/console

// The language's table, each i as a double, and IEEE's dot product,
// round(F64) { … } (ADR 0086), where the host's `Float64Array`, `js.set` and
// `js.+` over `any` were.
fn fill(n) {
    var d := array { 0 : _ ∈ 0..n-1 }
    loop i = 0 { i >= n -> d; else -> { d[i] := round(F64, i); again(i + 1) } }
}

fn dot(a, b) {
    round(F64) {
        loop acc = 0, i = 0 {
            i >= len(a) -> acc
            else -> again(acc + a[i] * b[i], i + 1)
        }
    }
}

export fn main() {
    xs = fill(1000)
    console.log("report")
    console.log(len(xs))
    console.log(dot(xs, xs))
}
