; The gauntlet's `search`, on the NATIVE Go target.
;
; The portable form is examples/search.oro. This is the same three clauses; only
; the names moved. It is here because it is the gauntlet's one EARLY EXIT, and
; early exit is what ADR 0015 claimed `loop` bought over `fold-range` — a claim
; measured on the portable layer and not since re-checked on a native one.
;
; No `sig` refinement is needed. The first clause IS the bound: reaching the
; second means `i < go.len(a)` was false to fail, which is where the index
; obligation discharges from (refinements.md — the other half of Hoare logic).

(use go)

(export find-first)

(sig find-first ((a slice-float64) (k f64)) int)

(def find-first (fn (a k)
  (loop ((i 0))
    (go.>= i (go.len a))       -1
    (go.f> (go.at-float64 a i) k)  i
    else                       (again (go.+ i 1)))))
