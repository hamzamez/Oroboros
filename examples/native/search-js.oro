// The gauntlet's `search`, on the NATIVE JavaScript target.
//
// Three clauses, one early exit. The bound comes from the first clause being
// false, not from a declaration.
use js

export fn find_first(a ∈ Any, k ∈ Any) (Any) {
    loop i = 0 {
        js.`>=`(i, js.len(a)) -> -1
        js.`>`(js.at(a, i), k) -> i
        else -> again(js.`+`(i, 1))
    }
}
