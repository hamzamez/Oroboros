// THE CONFORMANCE CASE FOR `&&`, on Windows.
//
//   build -target=windows -o sc.exe examples/native/shortcircuit-win.oro
//
// The second operand divides by a divisor that is zero on the first iteration,
// and a division by zero is not a behaviour but a precondition (integers.md §5):
// `/` requires d != 0. `&&` is the language's `if` (ADR 0017), so the division
// is reached only on the arm where d != 0 holds, and that is what discharges the
// obligation: the program is accepted because it short-circuits, and would be
// refused if `&&` evaluated both sides.
//
// Prints 222 then 111, which is what shortcircuit-go.oro prints.
use win/print

fn small_ratio?(n, d) { d != 0 && n / d < 20 }

export fn main() {
    loop i = 0 {
        i >= 2 -> 0
        else -> { print.print_int(if small_ratio?(10, i) { 111 } else { 222 }); again(i + 1) }
    }
}
