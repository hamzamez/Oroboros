(use java)
(use java/Math)
(use java/System)
(use java/String)
(export sieve-count)
; A DECLARED RANGE, and on this host it decides the emitted index type.
; The loop's bound is `i*i >= n` and its step is `+i`, so
; indextype-2026-08-25's pattern cannot narrow it -- it wants a counter
; bounded by a length and stepping by +1. The interval analysis can, once
; `n` is bounded: it puts every operation in 2..1048576, which fits the
; host's own `int`, and the (int) cast at every access goes away.
(sig sieve-count ((n int)) int (where (and (<= 0 n) (< n 1048576))))

(def cross (fn (c i n)
  (loop ((j (java.* i i)))
    (java.< j n)  (seq (java.set-bool c j true) (again (java.+ j i)))
    else          c)))

(def sieve-count (fn (n)
  (let (java.new-bool n) (fn (c)
    (let (loop ((i 2))
           (java.>= (java.* i i) n)  c
           (java.at-bool c i)        (again (java.+ i 1))
           else                      (seq (cross c i n) (again (java.+ i 1))))
      (fn (done)
        (loop ((acc 0) (k 2))
          (java.>= k n)      acc
          (java.at-bool c k) (again acc (java.+ k 1))
          else               (again (java.+ acc 1) (java.+ k 1)))))))))
