// A sum crossing a boundary, which is the case where the tag has to be
// transmitted (docs/spec/sums.md). Inside a program a sum reduces away entirely;
// here `step` is exported, so the caller has to be told WHICH.
//
// `(sum result (ok int) (err int))` is Go's own `(T, error)` shape, and that is
// not a coincidence: a sum is Σ over a finite index set, so the value is a tag
// and a payload.
use go

set Result = 'ok(Int) ∪ 'err(Int)

// THE QUOTIENT NEEDS A SYMMETRIC DIVIDEND (integers.md §4a): |a / b| <= |a|
// with equality iff |b| = 1, so ℤ's quotient leaves the word only at
// -2^63 / -1. A dividend in -(2^63-1)..2^63-1 makes it total whatever b is;
// with `a ∈ Int` it was emitted as the host's `/`, answering -2^63 there.
export fn step(a ∈ -2^63+1..2^63-1, b ∈ Int) (Result) {
    case {
        b == 0 -> 'err(1)
        go.`>`(go.`%`(a, b), 0) -> 'err(2)
        else -> 'ok(go.`/`(a, b))
    }
}
