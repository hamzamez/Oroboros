// The gauntlet's first program on the LANGUAGE'S OWN data structure.
//
// examples/native/dot-go.oro needed six definitions -- vec, vlen, vindex,
// of-array, zip, sum -- because a table was not in the language and had to be
// hand-rolled out of closures. Four of them are gone: `(table n f)` IS the
// delayed vector, `len` is its domain bound, and indexing is APPLICATION.
//
// The bar is 485 ns (native-gauntlet-2026-08-20).
use go

// `vec`, `vlen`, `vindex` and `of-array` are GONE — the language has the table.
fn zip(g, a, b) { array { g(a[i], b[i]) : i ∈ 0..len(a)-1 } }

fn sum(v) {
    loop acc = 0.0, i = 0 {
        go.`>=`(i, len(v)) -> acc
        else -> again(go.`f+`(acc, v[i]), go.`+`(i, 1))
    }
}
export fn dot(a ∈ Array(F64), b ∈ Array(F64)) (F64) where len(a) == len(b) && go.`<`(len(a), 2^16) {
    sum(zip(go.`f*`, a, b))
}
