// The portable sieve on WINDOWS — the fourth target, and the one with no host
// compiler, no collector and no arrays.
//
// A table here is a pointer whose first eight bytes hold the length. That is
// eight bytes PER ELEMENT for a boolean sieve, against the one byte
// examples/native/sieve-win.oro uses via x64.movb — so this measures what the
// language's uniform representation costs where nothing hides it.
use x64
use win/fmt

fn cross(c linear, i, n) {
    loop j = x64.imul(i, i) { x64.setl(j, n) -> { c[j] := true; again(x64.add(j, i)) }; else -> () }
}

fn sieve(n) {
    var c := array { 0 : _ ∈ 0..n-1 }
    loop i = 2 {
        x64.setge(x64.imul(i, i), n) -> c
        c[i] -> again(x64.add(i, 1))
        else -> { cross(c, i, n); again(x64.add(i, 1)) }
    }
}
fn count_primes(n ∈ Int) (Int) where 0 <= n && n < (2^20) {
    c = sieve(n)
    loop acc = 0, k = 2 {
        x64.setge(k, n) -> acc
        c[k] -> again(acc, x64.add(k, 1))
        else -> again(x64.add(acc, 1), x64.add(k, 1))
    }
}

export fn main() {
    fmt.print_int(loop r = 0, t = 0 {
            x64.setge(t, 100) -> r
            else -> again(x64.add(r, count_primes(200000)), x64.add(t, 1))
        })
}
