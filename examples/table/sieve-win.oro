// The sieve on WINDOWS, the benchmark: 100 counts of the primes below 200,000.
//
//   build -target=windows -o sieve.exe examples/table/sieve-win.oro
//
// The same program as experiments/backend/sieve.oro, in the language's own
// names, with a print: a table is a pointer whose first eight bytes hold the
// length (docs/spec/llvm.md §4), and a table of booleans is a byte per element.
// gauntlet/windows/sieve.asm is the hand-written reference it is timed against
// (llvm-2026-11-02: 0.64 of its time).
use win/print

fn cross(c linear, i, n) {
    loop j = i * i { j < n -> { c[j] := true; again(j + i) }; else -> () }
}

fn sieve(n ∈ 0..2^20) {
    var c := array { false : _ ∈ 0..n-1 }
    loop i = 2 {
        i * i >= n -> c
        c[i] -> again(i + 1)
        else -> { cross(c, i, n); again(i + 1) }
    }
}

fn count_primes(n ∈ 0..2^20) (Int) {
    c = sieve(n)
    loop acc = 0, k = 2 {
        k >= n -> acc
        c[k] -> again(acc, k + 1)
        else -> again(acc + 1, k + 1)
    }
}

export fn main() {
    print.print_int(loop r = 0, t = 0 {
            t >= 100 -> r
            else -> again(r + count_primes(200000), t + 1)
        })
}
