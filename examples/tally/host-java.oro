; tally's six operations on the JVM -- `D_T`, target-system.md §6.2.
;
;   java gauntlet/stdlib/jdk/Dump.java > API
;   go run gauntlet/stdlib/jvm.go -api API -emit GEN
;   cp GEN/java-util-regex.oro TG/java/regex-gen.oro
;   cp GEN/java-lang.oro       TG/java/lang-gen.oro
;   go run ./cmd/build -target=java -targets "TG;targets" -o tally examples/tally/tally.oro

(provides java tally/host
  (use java/java-util-regex/Pattern as pt)
  (use java/java-util-regex/Matcher as mt)
  (use java/java-lang/String as js)
  (use java/java-lang/Long as jl)

  (def compile (p) (pt.compile p))
  ; A Matcher is STATEFUL -- `find` advances it -- so each question gets its own.
  (def hit?    (r s) (mt.find (pt.matcher r s)))
  ; A GROUP THAT TOOK NO PART IS `null` HERE AND "" ON GO. `(a)?b` on the line
  ; `b` matches with group 1 absent; Go's FindStringSubmatch gives "", the JVM's
  ; group(1) gives null, and the sort's compareTo threw a NullPointerException.
  ; The generated declaration types group2 as `string`, and Java's String is
  ; nullable — a claim the host does not keep. `start(1)` is -1 exactly when the
  ; group took no part, so the binding asks that first, with generated
  ; declarations only, and both hosts answer "".
  (def capture (r s) (let m (pt.matcher r s)
                       (if (mt.find m)
                           (if (>= (mt.groupCount m) 1)
                               (if (>= (mt.start2 m 1) 0) (mt.group2 m 1) "")
                               (mt.group m))
                           "")))
  (def cmp     (a b) (js.compareTo a b))
  ; split2 with a NEGATIVE limit, because `split` drops trailing empty strings
  ; and Go's Split does not: the same file would have a different number of
  ; lines on the two hosts.
  (def lines   (t) (js.split2 t "\n" (- 0 1)))
  (def show    (n) (jl.toString n)))
