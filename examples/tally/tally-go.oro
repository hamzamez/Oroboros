; tally, on Go -- the six operations, written over GENERATED declarations.
;
; Build with the survey's output as a project layer (see README):
;
;   go run gauntlet/stdlib/survey.go -emit GEN
;   cp GEN/regexp.oro  TG/go/regexp-gen.oro
;   cp GEN/strings.oro TG/go/strings-gen.oro
;   cp GEN/strconv.oro TG/go/strconv-gen.oro
;   go run ./cmd/build -target=go -targets "TG;targets" -o tally examples/tally/tally-go.oro

(use tally)
(use go/regexp as re)
(use go/regexp/Regexp as rx)
(use go/strings as str)
(use go/strconv as conv)

(export main)

(def host (values
  (fn (p) (re.MustCompile p))
  (fn (r s) (rx.MatchString r s))
  ; FindStringSubmatch is the whole match followed by every group, or empty.
  (fn (r s) (let (rx.FindStringSubmatch r s) (fn (m)
    (if (>= (len m) 2) (m 1) (if (>= (len m) 1) (m 0) "")))))
  (fn (a b) (str.Compare a b))
  (fn (t) (str.Split t "\n"))
  (fn (n) (conv.Itoa n))))

(def main (fn () (tally.run host)))
