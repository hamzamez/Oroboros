// Maps, append and slicing, using only Go's predeclared identifiers plus fmt.
//
// No `strings`, no `sort`, no `strconv` — everything here is usable with no
// import at all, which is what makes this a test of Go's *top level*.
use go/builtin as g
use go/fmt
use num/int

// Collatz stopping time, bounded: fold-range cannot loop until a condition, so
// the bound is a budget and the fold carries the running value.
fn collatz_steps(start, budget) {
    fold_range(start, budget,
        fn(v, step) {
            if int.le(v, 1) { v } else if int.eq(g.rem(v, 2), 0) { g.quo(v, 2) } else {
                int.add(int.mul(3, v), 1)
            }
        })
}

// Build a slice of the first n stopping values, by appending.
fn firsts(n) {
    fold_range(g.make_int(0), n,
        fn(acc, i) { g.append_int(acc, collatz_steps(int.add(i, 1), 200)) })
}

// Count how many landed on each value, in a map keyed by a literal string.
fn tally(s) {
    fold_range(g.make_map(), g.len(s),
        fn(m, i) { g.mset(m, "reached", int.add(g.mat(m, "reached"), g.iat(s, i))) })
}

export fn main() {
    s = firsts(30)
    fmt.println(g.len(s))
    fmt.println(g.iat(g.islice(s, 0, 5), 4))
    fmt.println(g.mat(tally(s), "reached"))
}
