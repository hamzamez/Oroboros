; Sieve of Eratosthenes, using only Go's predeclared identifiers plus fmt.
;
; The question this program exists to answer: can imperative array mutation be
; written at all? `bset` is a statement whose VALUE is its container, so a
; mutation threads through a fold the way an accumulator does, and the effect
; discipline pins the order.

(use go/builtin as g)
(use go/fmt as fmt)
(use num/int as int)

(export main)

; composite[i] = true once i has been crossed out.
(def cross-from (fn (composite i n)
  (fold-range composite n (fn (c j)
    (if (int.ge j (int.mul i i))
        (if (int.eq (g.rem j i) 0)
            (g.bset c j (g.true))
            c)
        c)))))

(def sieve (fn (n)
  (fold-range (g.make-bool n) n (fn (c i)
    (if (int.lt i 2) c
      (if (g.bat c i) c (cross-from c i n)))))))

(def count-primes (fn (n)
  (fold-range 0 n (fn (acc i)
    (if (int.lt i 2) acc
      (if (g.bat (sieve n) i) acc (int.add acc 1)))))))

(def main (fn () (fmt.println (count-primes 100))))
