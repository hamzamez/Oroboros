; The same sieve, with the inner loop's TRIP COUNT computed instead of tested.
;
;   for j := i*i; j < n; j += i     is     count = ceil((n - i*i) / i)
;                                          j     = i*i + k*i
;
; fold-range's bound has always been an arbitrary expression, so this needs no
; new primitive. The question is whether it recovers the complexity.

(use go/builtin as g)
(use go/fmt as fmt)
(use num/int as int)
(use num/f64 as f)

(export main)

; How many multiples of i lie in [i*i, n).
(def multiples (fn (i n)
  (let (int.mul i i) (fn (start)
    (if (int.ge start n) 0
      (g.quo (int.sub (int.add n i) (int.add start 1)) i))))))

(def cross-from (fn (composite i n)
  (let (int.mul i i) (fn (start)
    (fold-range composite (multiples i n) (fn (c k)
      (g.bset c (int.add start (int.mul k i)) (g.true))))))))

; The OUTER loop only needs i up to sqrt(n): every composite below n has a
; factor there. Its trip count is computable too, so it needs no new primitive
; either — just f64.sqrt and an index shifted by 2.
(def isqrt (fn (n) (g.trunc-int (f.sqrt (f.of-int n)))))

(def sieve (fn (n)
  (fold-range (g.make-bool n) (int.sub (isqrt n) 1) (fn (c k)
    (let (int.add k 2) (fn (i)
      (if (g.bat c i) c (cross-from c i n))))))))

(def count-primes (fn (n)
  (let (sieve n) (fn (composite)
    (fold-range 0 n (fn (acc k)
      (if (int.lt k 2) acc
        (if (g.bat composite k) acc (int.add acc 1)))))))))

(def main (fn () (fmt.println (count-primes 20000))))
