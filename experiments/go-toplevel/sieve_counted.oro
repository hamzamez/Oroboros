// The same sieve, with the inner loop's TRIP COUNT computed instead of tested.
//
//   for j := i*i; j < n; j += i     is     count = ceil((n - i*i) / i)
//                                          j     = i*i + k*i
//
// fold-range's bound has always been an arbitrary expression, so this needs no
// new primitive. The question is whether it recovers the complexity.
use go/builtin as g
use go/fmt
use num/int
use num/f64 as f

// How many multiples of i lie in [i*i, n).
fn multiples(i, n) {
    start = int.mul(i, i)
    if int.ge(start, n) { 0 } else { g.quo(int.sub(int.add(n, i), int.add(start, 1)), i) }
}

fn cross_from(composite, i, n) {
    start = int.mul(i, i)
    fold_range(composite, multiples(i, n),
        fn(c, k) { g.bset(c, int.add(start, int.mul(k, i)), g.true()) })
}

// The OUTER loop only needs i up to sqrt(n): every composite below n has a
// factor there. Its trip count is computable too, so it needs no new primitive
// either — just f64.sqrt and an index shifted by 2.
fn isqrt(n) { g.trunc_int(f.sqrt(f.of_int(n))) }

fn sieve(n) {
    fold_range(g.make_bool(n), int.sub(isqrt(n), 1),
        fn(c, k) { i = int.add(k, 2); if g.bat(c, i) { c } else { cross_from(c, i, n) } })
}

fn count_primes(n) {
    composite = sieve(n)
    fold_range(0, n,
        fn(acc, k) {
            if int.lt(k, 2) { acc } else if g.bat(composite, k) { acc } else { int.add(acc, 1) }
        })
}

export fn main() { fmt.println(count_primes(20000)) }
