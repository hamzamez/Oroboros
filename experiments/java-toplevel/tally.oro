// Counting distinct values with NO dictionary.
//
// java.lang has no Map, no List, and nothing growable except StringBuilder —
// every collection lives in java.util and needs an import. So a tally must be
// written with two fixed-size parallel arrays and a linear scan, which is what
// this program is: the shape Java's top level forces.
//
// It is also a second demonstration of the missing early exit. The scan cannot
// stop when it finds the key, so every lookup costs the full capacity.
use java/array as a
use java/int as ji
use java/system as sys
use num/int

// Slot for key k in a linear-probed table of capacity cap: the first index
// whose key equals k, or the first empty one. Empty is 0; keys are 1-based.
fn slot(keys, cap, k) {
    fold_range(cap, cap,
        fn(best, i) {
            if int.lt(best, cap) { best } else if int.eq(a.iat(keys, i), k) {
                i
            } else if int.eq(a.iat(keys, i), 0) { i } else { best }
        })
}

// Tally i mod 97 over n values and report how many distinct keys landed. The
// scan cannot stop early, so every lookup costs the full capacity.
fn tally(n, cap) {
    keys = a.make_int(cap)
    fold_range(0, n,
        fn(acc, i) {
            k = int.add(ji.rem(i, 97), 1)
            s = slot(keys, cap, k)
            if int.ge(s, cap) { acc } else if int.eq(a.iat(keys, s), 0) {
                a.iset(keys, s, k)
                int.add(acc, 1)
            } else { acc }
        })
}

export fn main() { sys.println(tally(20000, 128)) }
