; The Go experiment's sieve, ported to JavaScript's top level, to check whether
; the loop penalty is a property of the LANGUAGE rather than of one host.
;
; Flags are 0.0/1.0 in a plain Array, because JS has no boolean array type and
; needs none.

(use js/array as a)
(use js/console as c)
(use js/int as ji)
(use num/int as int)
(use num/f64 as f)

(export main)

(def cross-from (fn (composite i n)
  (fold-range composite n (fn (arr j)
    (if (int.ge j (int.mul i i))
        (if (int.eq (ji.rem j i) 0) (a.set arr j 1.0) arr)
        arr)))))

(def sieve (fn (n)
  (fold-range (a.of-size n 0.0) n (fn (arr i)
    (if (int.lt i 2) arr
      (if (f.gt (a.at arr i) 0.0) arr (cross-from arr i n)))))))

(def count-primes (fn (n)
  (let (sieve n) (fn (composite)
    (fold-range 0 n (fn (acc k)
      (if (int.lt k 2) acc
        (if (f.gt (a.at composite k) 0.0) acc (int.add acc 1)))))))))

(def main (fn () (c.log (count-primes 20000))))
