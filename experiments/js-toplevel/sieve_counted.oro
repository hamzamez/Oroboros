// The counted encoding on JavaScript, to check the correction is not a Go
// artifact. Trip counts are computed; no new primitive is used.
use js/array as a
use js/console as c
use js/int as ji
use js/math as m
use num/int
use num/f64 as f

fn isqrt(n) { ji.of_f64(m.sqrt(f.of_int(n))) }

fn multiples(i, n) {
    start = int.mul(i, i)
    if int.ge(start, n) { 0 } else { ji.quo(int.sub(int.add(n, i), int.add(start, 1)), i) }
}

fn cross_from(composite, i, n) {
    start = int.mul(i, i)
    fold_range(composite, multiples(i, n),
        fn(arr, k) { a.set(arr, int.add(start, int.mul(k, i)), 1.0) })
}

fn sieve(n) {
    fold_range(a.of_size(n, 0.0), int.sub(isqrt(n), 1),
        fn(arr, k) {
            i = int.add(k, 2)
            if f.gt(a.at(arr, i), 0.0) { arr } else { cross_from(arr, i, n) }
        })
}

fn count_primes(n) {
    composite = sieve(n)
    fold_range(0, n,
        fn(acc, k) {
            if int.lt(k, 2) { acc } else if f.gt(a.at(composite, k), 0.0) { acc } else {
                int.add(acc, 1)
            }
        })
}

export fn main() { c.log(count_primes(20000)) }
