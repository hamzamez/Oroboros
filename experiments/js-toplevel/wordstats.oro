// Text statistics, using only what Node and the browser both provide with no
// import: String methods, Array methods, a null-prototype object, Math, JSON
// and console.
//
// Deliberately NON-PORTABLE. `(use js/string)` will not resolve on the Go or
// Java targets, and the covering check says so.
use js/string as s
use js/array as a
use js/object as o
use js/math as m
use js/json
use js/console as c
use num/int
use num/f64 as f

// The longest word. A max-scan, which is a fold — no early exit needed here.
fn longest(ws) {
    fold_range("", slen(ws),
        fn(best, i) { w = sat(ws, i); if int.gt(s.len(w), s.len(best)) { w } else { best } })
}

// Total characters, as a fold over the word list.
fn total_chars(ws) { fold_range(0, slen(ws), fn(acc, i) { int.add(acc, s.len(sat(ws, i))) }) }

// A frequency table keyed by first letter, built by mutating a null-prototype
// object — the representation baseline R4 measured as 3.25x faster than Map.
fn by_initial(ws) {
    fold_range(o.empty(), slen(ws),
        fn(d, i) { k = s.lower(s.char_at(sat(ws, i), 0)); o.set(d, k, f.add(o.get(d, k), 1.0)) })
}

export fn main() {
    ws = split_words("the quick brown fox jumps over the lazy dog")
    c.log(s.concat("words: ", js_num(slen(ws))))
    c.log(s.concat("longest: ", longest(ws)))
    c.log(s.concat("chars: ", js_num(total_chars(ws))))
    c.log(json.stringify(by_initial(ws)))
}

// Number to string, via the global String.
use js/global as g
fn js_num(n) { g.to_string(n) }
