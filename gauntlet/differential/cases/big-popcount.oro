// KERNIGHAN'S POPCOUNT ABOVE THE WORD, examples/big/popcount.oro's: x & (x − 1)
// clears the lowest set bit. 3^1000 has 758 ones; the Mersenne prime
// 2^4423 − 1 has 4423; 0 has none, 3^0 = 1 one, 3^4999 has 3999 of 7924 bits,
// and the xor of 2^4423 − 1 and 2^5000 − 1 is the 577 ones between them.
//
// prints: string
// inputs: 0 1 2 3 4 5
// expect: 758 4423 0 1 3999 577
fn ones(v ∈ Nat) (Nat) {
    loop x = v, c = 0 { x == 0 -> c; else -> again(x & (x - 1), c + 1) }
}

// 3^n
fn pow3(n ∈ 0..5000) (Nat) {
    loop p = 1, i = 0 { i >= n -> p; else -> again(p * 3, i + 1) }
}

export fn calc(k ∈ 0..5) (Nat) {
    m ∈ Nat = (1 << 4423) - 1
    t ∈ Nat = (1 << 5000) - 1
    case {
        k == 0 -> ones(pow3(1000))
        k == 1 -> ones(m)
        k == 2 -> ones(0)
        k == 3 -> ones(pow3(0))
        k == 4 -> ones(pow3(4999))
        else -> ones(m ⊕ t)
    }
}

fn run(k) { big_str(calc(k)) }
