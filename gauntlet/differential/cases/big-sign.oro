; A SIGNED RANGE ABOVE THE WORD, AND ITS EDGE (ADR 0029).
;
; `(int (- 0 (pow 2 200)) (pow 2 200))` denotes (-2^201, 2^201): the least set
; containing the declaration that a sign and a bit length decide. So -2^200 and
; -(2^201 - 1) are values, and -2^201 is not.
;
; Before ADR 0029 each host enforced its own set. Go's `BitLen` admitted exactly
; this one; Java's `bitLength` is two's complement and admitted -2^201 too,
; printing a third answer where Go trapped; JavaScript's shift and the fixed
; limbs refused every negative value, so the first answer already trapped.
; Four representations, three outcomes, from one legal program.
;
; skip: windows
;
; windows is skipped for a CAPABILITY: fixed limbs hold a magnitude, so a signed
; range above the word is refused there at compile time (ADR 0029, decision 4),
; and the target has no bignum to take it to. The same reason is why this case
; is not `big-repr: both`: on a target with a bignum, a signed program takes it.

; inputs: 0 1 2
; prints: string
; expect: -1606938044258990275541962092341162602522202993782792835301376 -3213876088517980551083924184682325205044405987565585670602751 trap

(export calc)

(sig calc ((n (int 0 2))) (int (- 0 (pow 2 200)) (pow 2 200)))

(def calc (n)
  (let p 1606938044258990275541962092341162602522202993782792835301376
       a (- 0 p)
       b (if (= n 0) 0 (if (= n 1) (- p 1) p))
    (- a b)))

(def run (n) (big-str (calc n)))
