// A CELL FLOWS THROUGH A CASE'S ARMS: an arm runs once, now, so the state
// enters it as it enters a let (spec/local.md §3).
// expect: 0 0 4 6
// inputs: 0 1 3 5
// pick gives (yes n) above 2 and no otherwise; the cell starts at 1 and becomes
// 1 + n or 0.
set Choice(T) = 'yes(T) ∪ 'no
fn pick(n) { if n > 2 { 'yes(n) } else { 'no } }
fn run(n) {
    var c := 1
    case pick(n) { 'yes(v) -> { c := c + v }; 'no -> { c := 0 } }
    c
}
