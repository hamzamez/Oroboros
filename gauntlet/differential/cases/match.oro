// `match` — reader sugar over `loop`, so the guards, the bindings and `again`
// expect: 0 0 0 0 0 0 1 1 2
// all have to survive to four backends identically.
//
// A bare-name scrutinee BECOMES the loop variable (match.md §4). With fresh
// variables a clause body reading `i` would see the value the loop started from
// while `again` advanced a hidden one, and every iteration after the first would
// read a stale value — a program that looks right.
fn run(n) {
    loop s1 = 0, n = n, c = 0 {
        n == 0 -> c
        s1 == 0 && n >= 10 -> again(1, n - 10, c + 1)
        n >= 10 -> again(0, n - 10, c)
        true -> again(0, 0, c)
        else -> 0
    }
}
