; THE UNIT, (tuple), and 1 + E (data.md §3.6, errors.md §3).
;
; `save` succeeds with nothing on an even input: (result (tuple) int), whose
; success payload is the terminal object and carries no information. `try`
; binds it with a pattern that binds nothing, `(result.ok _)`, inside a `seq`,
; where `_` was once captured by seq's own binder (unit-2026-10-06). Reduction
; removes the sum and the unit with it: what runs is the host's own tests.
;
; inputs: 0 1 2 3 4 7
; expect: 1 -1 1 -3 1 -7
(use result)

(def save (n)
  (if (= (% n 2) 0) (result.ok (tuple)) (result.err n)))

(def run (n)
  (seq (+ n 0)
       (case (try (result.ok _) (save n) (save (+ n 2)))
         (result.ok _)  1
         (result.err e) (- 0 e))))
