// ACCEPTANCE: encoding/binary's varint half, declared BY HAND
// (targets/go/encoding/binary.oro), every value the program COMPUTED.
//
// Each section is a LAW of the code (strconv-2026-09-22 §4), and the host is the
// oracle: the expected output is binaryReference in tooling_test.go.
//
//   code        C⁻¹ ∘ C = id on U, at its ends and at every length boundary, and
//               |C(x)| = max(1, ⌈bitlen(x)/7⌉) — the count the host returns
//   zigzag      the same through z, at both ends of the signed word
//   prefix      appended codewords: the first parses alone, whatever follows it
//   sum         the count's three cases — read, ended, overflowed — in its sign
//   stream      C⁻¹ from an io.ByteReader
//   native      a decoded uint64 computed with, in a machine word
use go
use go/encoding/binary as bin
use go/strings as gstr
use go/fmt
use go/os as gos
use result

// C into a buffer of MaxVarintLen64, then C⁻¹ on the array the build returns —
// a buffer the host may write is not handed to a reader while it is one.
fn code_one(x) {
    enc = { var b := array { 0 : _ ∈ 0..9 }; n = bin.PutUvarint(b, x); fmt.Println(n); b }
    (y, m) = bin.Uvarint(enc)
    fmt.Println(x == y)
    fmt.Println(m)
    fmt.Println(enc)
}

fn code() {
    code_one(0)
    code_one(127)
    code_one(128)
    code_one(16383)
    code_one(16384)
    code_one((2^63-1) - 0)
    code_one((2^63-1) + 1)
    code_one((2^64-1) - 0)
}

fn zig_one(x) {
    enc = { var b := array { 0 : _ ∈ 0..9 }; n = bin.PutVarint(b, x); fmt.Println(n); b }
    (y, m) = bin.Varint(enc)
    fmt.Println(x == y)
    fmt.Println(m)
    fmt.Println(enc)
}

fn zigzag() {
    zig_one(0)
    zig_one(-1)
    zig_one(1)
    zig_one(-64)
    zig_one(64)
    zig_one(2^63-1)
    zig_one(-9223372036854775807 - 1)
}

// Two codewords in one buffer: the first is read alone, and the count says
// where the second begins.
fn prefix() {
    two = {
        var b := array { 0 : _ ∈ 0..-1 }
        bin.AppendUvarint(b, 300)
        bin.AppendVarint(b, -3)
        b
    }
    (x, n) = bin.Uvarint(two)
    fmt.Println(two)
    fmt.Println(x)
    fmt.Println(n)
}

fn sum() {
    { (x, n) = bin.Uvarint(array { 128, 128 }); fmt.Println(x); fmt.Println(n) }
    {
        (x, n) = bin.Uvarint(array { 128, 128, 128, 128, 128, 128, 128, 128, 128, 2 })
        fmt.Println(x)
        fmt.Println(n)
    }
    {
        (x, n) = bin.Uvarint(array { 128, 128, 128, 128, 128, 128, 128, 128, 128, 128, 1 })
        fmt.Println(x)
        fmt.Println(n)
    }
    (x, n) = bin.Uvarint(array { 255, 255, 255, 255, 255, 255, 255, 255, 255, 1 })
    fmt.Println(x)
    fmt.Println(n)
}

// "\u{AC}\u{2}" is the bytes C2 AC 02 in UTF-8, which read as a uvarint are
// 0x42 + 0x2C·2^7 + 2·2^14 = 38466 — one ReadByte at a time, from a reader the
// generated strings file supplies (*strings.Reader ≤ io.ByteReader, an edge the
// survey checked against the host).
fn stream() {
    // ReadUvarint is a SUM (spec/errors.md §4): its value means nothing beside an
    // error, so a `case` binds it only on success.
    case bin.ReadUvarint(gstr.NewReader("\u{AC}\u{2}")) {
        result.'ok(x) -> { fmt.Println(x); fmt.Println(true) }
        result.'err(e) -> { fmt.Println(e); fmt.Println(false) }
    }
    case bin.ReadVarint(gstr.NewReader("\u{3}")) {
        result.'ok(x) -> { fmt.Println(x); fmt.Println(true) }
        result.'err(e) -> { fmt.Println(e); fmt.Println(false) }
    }
}

// The top of U decoded, then halved and reduced — native uint64 arithmetic on a
// host result, which under ADR 0012 could only have been printed.
fn native() {
    enc = { var b := array { 0 : _ ∈ 0..9 }; n = bin.PutUvarint(b, 2^64-1); b }
    (y, m) = bin.Uvarint(enc)
    fmt.Println(y / 2)
    fmt.Println(y % 1000)
    fmt.Println(y / 4 + m)
}

export fn main() {
    code()
    zigzag()
    prefix()
    sum()
    stream()
    native()
}
