// ACCEPTANCE: a program reaches an ecosystem's OBJECTS, not just its functions.
//
// gostdlib-2026-09-06's honest statement was that *"the parasite model reaches an
// ecosystem's FUNCTIONS and reaches its OBJECTS only as far as some constructor
// happens to be declarable"* — and 3,098 of Go's 4,932 callable names are
// methods. This is the first program to call one.
//
// Every declaration it uses is GENERATED by `gauntlet/stdlib/survey.go`, which is
// the point: a percentage that does not build is a claim. The chain is
//
//   os.Open        a constructor returning `(*File, error)` — declarable only
//                  since multiresult-2026-09-06, and the reason `*os.File` is in
//                  the obtainable-type fixed point at all
//   (*File).Read   a METHOD, so the receiver is argument 0 — the convention
//                  Win32's HANDLE already used, arriving on a host that has
//                  objects
//   (*File).Close  the same, discarded with `seq`
//
// and the answer is the number of bytes read, which is `head -c 64` of the file.
//
// THE BUFFER IS THE INTERESTING PART. `build` zero-fills and nothing here stores
// into it, so the syntactic element inference correctly has nothing to say and
// the buffer came out `[]int` — which `(*os.File).Read` does not take. A buffer
// nobody writes to takes its element type from the host call it is passed to,
// because the host is the thing that writes it (emit/target.go, `declaredElem`).
//
// `err-nil` comes from `go` in `targets/`, not from the generated file: Go's
// `os` package has no such function, and testing `err != nil` is a fact about the
// target rather than about a package (it moved there from go/os in
// gotarget-2026-09-30).
use go
use go/os as gos
use go/os/File
use io

export fn main() {
    (f, e1) = gos.Open("go.mod")
    if go.err_nil(e1) {
        var b := array { 0 : _ ∈ 0..63 }
        (n, e2) = File.Read(f, b)
        File.Close(f)
        if go.err_nil(e2) { io.print_int(n) } else { io.print_int(0) }
    } else { io.print_int(0) }
}
