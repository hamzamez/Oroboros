; ACCEPTANCE: unicode/utf8, THE WHOLE PACKAGE, declared BY HAND — every function
; and every constant, each called with a value the program COMPUTED.
;
; Computed rather than literal, because a Go untyped constant converts silently:
; a program made of literals could not fail on a mistyped parameter, and the
; first version of these declarations had exactly that mistake
; (gostd-utf8-2026-09-13 §1).
;
; The expected output is computed by hand-written Go calling the real package in
; the same order (utf8Reference in tooling_test.go), so the host is the oracle.
;
; What the declarations now let this program say, which the generated ones did
; not (host-buffers.md):
;   - EncodeRune hands its buffer back, so the program prints the COUNT and the
;     BYTES — before, a buffer handed to the call was consumed and the bytes lost;
;   - AppendRune takes and returns a BUFFER, so the accumulator is threaded
;     through the loop and cannot alias — before, it took an immutable array and
;     two appends to one value could share its capacity.

(use go/unicode-utf8 as u)
(use go/fmt as fmt)
(use os)

(export main)

; One rune: its encoded length, whether it is a scalar value, and what EncodeRune
; writes into a four-byte buffer — the count, then the buffer it handed back.
(def each-rune (r)
  (seq (fmt.Println (u.RuneLen r))
       (fmt.Println (u.ValidRune r))
       (fmt.Println (build 4 (fn (b)
         ((u.EncodeRune b r) (fn (b2 n) (seq (fmt.Println n) b2))))))))

; A decoded rune and its width, and then their SUM, which is the witness that a
; range result is received into the language's integer (gostd-utf8-2026-09-13 §1)
; — and, with the declared ranges, a sum the analysis now proves in the window.
(def pair (r n) (seq (fmt.Println r) (fmt.Println n) (fmt.Println (+ r n))))

(def over-bytes (acc)
  (seq (fmt.Println acc)
       (fmt.Println (u.RuneCount acc))
       (fmt.Println (u.Valid acc))
       (fmt.Println (u.FullRune acc))
       ((u.DecodeRune acc) (fn (r n) (pair r n)))
       ((u.DecodeLastRune acc) (fn (r n) (pair r n)))
       (loop ((j 0) (c 0))
         (>= j (len acc)) (fmt.Println c)
         else (again (+ j 1) (if (u.RuneStart (acc j)) (+ c 1) c)))))

(def over-string (s)
  (seq (fmt.Println (u.RuneCountInString s))
       (fmt.Println (u.ValidString s))
       (fmt.Println (u.FullRuneInString s))
       ((u.DecodeRuneInString s) (fn (r n) (pair r n)))
       ((u.DecodeLastRuneInString s) (fn (r n) (pair r n)))))

; A truncated four-byte sequence: not valid UTF-8, and no string literal can
; denote it, because a literal denotes scalar values (string-literals.md).
(def invalid ()
  (let bad (build 3 (fn (b) (set (set (set b 0 240) 1 159) 2 153)))
    (seq (fmt.Println (u.FullRune bad))
         (fmt.Println (u.Valid bad))
         (fmt.Println (u.RuneCount bad))
         ((u.DecodeRune bad) (fn (r n) (pair r n)))
         (fmt.Println (u.ValidString (os.text-of bad)))
         (fmt.Println (u.FullRuneInString (os.text-of bad)))
         (fmt.Println (u.RuneCountInString (os.text-of bad))))))

(def constants ()
  (seq (fmt.Println (u.MaxRune))
       (fmt.Println (u.RuneError))
       (fmt.Println (u.RuneSelf))
       (fmt.Println (u.UTFMax))
       (fmt.Println (u.ValidRune (+ (u.MaxRune) 1)))
       (fmt.Println (u.RuneLen (u.RuneError)))))

; The accumulator is a BUFFER from start to finish: born with one byte, extended
; by AppendRune once per rune, and frozen on the way out of `build` into the
; immutable text the readers see.
(def main ()
  (let runes (array 104 233 26085 128578 -1 55296 1114112)
       text  (build 1 (fn (b)
               (loop ((i 0) (acc (set b 0 104)))
                 (>= i (len runes)) acc
                 else (seq (each-rune (runes i))
                           (again (+ i 1) (u.AppendRune acc (runes i)))))))
    (seq (over-bytes text)
           (over-string (os.text-of text))
           (invalid)
           (constants))))
