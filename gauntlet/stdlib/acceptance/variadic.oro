; ACCEPTANCE: A VARIADIC OVER ONE TYPE IS A FUNCTION OF A TABLE
; (variadic-2026-10-08, strings.oro's and io.oro's headers).
;
; Go's ...T is the free monoid on T, a list of any length. Inside the function
; its value is a []T, and Go's own spread f(s...) passes one unchanged, so each
; declaration here is ONE function of a table, spread into the call: every
; length at once, the empty one included, and no copy at the call.
;
;   strings.NewReplacer  the pairs (oldᵢ, newᵢ), flattened, an even count: a
;                        precondition, discharged here by evaluation on literals
;   io.MultiReader       the concatenation of streams; none is the empty stream
;   io.MultiWriter       the fan-out of a write to every writer, in order
;
; The order of the pairs matters, and Go's answer says how: the first pair that
; matches wins, so (a→1, aa→2) turns "aaa" into "111" and (aa→2, a→1) into "21".
; A table of writers is written at the call, so it is built at the declared
; element, io.Writer: Go's slices are not covariant (io.oro's header).

(use go)
(use result)
(use go/os as gos)
(use go/io as gio)
(use go/strings as strings)
(use go/strings/Replacer as Replacer)
(use go/fmt as fmt)

(export main)

(def ok? (r) (case r (result.ok u) true (result.err e) false))

(def replacing ()
  (let esc (strings.NewReplacer (array "&" "&amp;" "<" "&lt;" ">" "&gt;"))
    (seq (fmt.Println (Replacer.Replace esc "a<b & c>d"))
         (fmt.Println (Replacer.Replace (strings.NewReplacer (array "a" "1" "aa" "2")) "aaa"))
         (fmt.Println (Replacer.Replace (strings.NewReplacer (array "aa" "2" "a" "1")) "aaa"))
         (fmt.Println (Replacer.Replace (strings.NewReplacer (array)) "unchanged"))
         ((Replacer.WriteString esc (gos.Stdout) "x<y\n") (fn (n e)
           (fmt.Println2 n (ok? e)))))))

(def streams ()
  (seq ((gio.ReadAll (gio.MultiReader (array (strings.NewReader "con") (strings.NewReader "cat"))))
        (fn (b e) (fmt.Println2 (go.string-of-bytes b) (ok? e))))
       ((gio.ReadAll (gio.MultiReader (array))) (fn (b e)
         (fmt.Println2 (len b) (ok? e))))
       ((gio.WriteString (gio.MultiWriter (array (gos.Stdout) (gos.Stdout))) "twice\n") (fn (n e)
         (fmt.Println2 n (ok? e))))))

(def main ()
  (seq (replacing) (streams) 0))
