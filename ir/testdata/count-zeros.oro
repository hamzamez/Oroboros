// The witness of docs/spec/ir.md §9.4: every read of b is proven, by i < 10 and
// len b >= 10, and nothing relates len b to len a. Re-slicing b to len a before
// the loop panics when len a > len b, on a legal program whose answer is 10.
// The IR's rewrite (L13) needs len a <= len b assumed, and must not fire here.
use go

export fn count_zeros(a ∈ Array(Int), b ∈ Array(Int)) (Int)
    where go.`<`(len(a), 2^16) && go.`>=`(len(b), 10) {
    loop i = 0 {
        go.`>=`(i, len(a)) -> i
        go.`>=`(i, 10) -> i
        go.`!=`(b[i], 0) -> i
        else -> again(go.`+`(i, 1))
    }
}
