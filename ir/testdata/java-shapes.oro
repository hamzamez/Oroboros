// Shapes the IR's Java printer must get right (ir/java/java_test.go).
use java

// A loop that SWAPS two parameters: a cycle in the back edge's parallel move,
// which Java, having no tuple assignment, must break with a temporary.
export fn swap_sum(n ∈ 0..1000) (Int) {
    loop a = 1, b = 2, i = 0 {
        java.`>=`(i, n) -> java.`+`(a, java.`*`(10, b))
        else -> again(b, a, java.`+`(i, 1))
    }
}

// The scalar ρ: n lies within Java's `int` and n·n does not, so the product is
// a `long` and is COMPUTED in one — `(long) n * n`. In `int` it wraps:
// 100000·100000 is 1410065408 there, and 10000000000 in ℤ.
export fn square(n ∈ 0..100000) (Int) { java.`*`(n, n) }

// An index proven below 2³¹ is Java's `int`, so no access takes a cast
// (1.04–1.45× against hand-written, native-java-2026-08-25).
// `last` is the last element read before n.
export fn last(a ∈ Array(0..1000), n ∈ 0..1000) (Int) where java.`<=`(n, len(a)) {
    loop i = 0, s = 0 { java.`>=`(i, n) -> s; else -> again(java.`+`(i, 1), a[i]) }
}
