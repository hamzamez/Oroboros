// The gauntlet's dot as JavaScript's host computed it before ADR 0086: `js.+` and
// `js.*` over `any`, kept as a fixture for TestOverloadedOperatorsAreDecidedByTheirOperands,
// which needs one overloaded host operator meeting both an integer and a double.
// The gauntlet's own dot is examples/native/dot.oro.
use js

// The equality is what makes `(js.at q i)` provable; the bound is what lets the
// interval analysis prove the loop terminates.
fn vec(n, f) { fn(sel) { sel(n, f) } }
fn vlen(v) { v(fn(n, f) { n }) }
fn vindex(v, i) { v(fn(n, f) { f })(i) }
fn of_array(a) { vec(js.len(a), fn(i) { js.at(a, i) }) }

fn zip(g, a, b) { vec(vlen(a), fn(i) { g(vindex(a, i), vindex(b, i)) }) }

fn sum(v) {
    loop acc = 0.0, i = 0 {
        js.`>=`(i, vlen(v)) -> acc
        else -> again(js.`+`(acc, vindex(v, i)), js.`+`(i, 1))
    }
}
export fn dot(a ∈ Any, b ∈ Any) (Any)
    where js.`===`(js.len(a), js.len(b)) && js.`<`(js.len(a), 2^16) {
    sum(zip(js.`*`, of_array(a), of_array(b)))
}
