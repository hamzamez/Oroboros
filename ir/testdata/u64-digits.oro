// THE UNSIGNED WORD IN A LOOP, for the interval domain's u64 rules (irstep4c-2026-09-26):
// gauntlet/differential/cases/u64-digits.oro with run exported. digitsum's v is
// selected into U, so its guard is u64= and its step u64/.
fn near_top(n ∈ 0..100) (0..2^64-1) { (2^64-1) - n }

fn digitsum(x ∈ 0..2^64-1) (Int) {
    loop v = x, s = 0 { v == 0 -> s; else -> again(v / 10, s + v % 10) }
}

export fn run(n ∈ 0..100) (Int) { digitsum(near_top(n)) }
