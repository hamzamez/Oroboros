// Shapes the IR's x86 printer must get right (ir/x86/x86_test.go).
use x64

// RULE R: a 64-limb buffer rebuilt on every iteration, reading the old one
// while writing the spare. The swap at the continue reads the parameter, so
// the parameter may not share a register with the new buffer (big-limbs).
fn at(t, i) { if i < 0 { 0 } else if i >= len(t) { 0 } else { t[i] } }
fn bn_of(n, v) {
    var b := array { 0 : _ ∈ 0..n-1 }
    loop i = 0, r = v { i >= n -> b; else -> { b[i] := r % (2^24); again(i + 1, r / (2^24)) } }
}
fn bn_mul_small(n, a, k) {
    var o := array { 0 : _ ∈ 0..n-1 }
    loop i = 0, c = 0 {
        i >= n -> o
        else -> { t = at(a, i) * k + c; o[i] := t % (2^24); again(i + 1, t / (2^24)) }
    }
}
export fn fact_limb(k ∈ 0..63) (Int) {
    at(loop acc = bn_of(64, 1), i = 2 {
            i > 30 -> acc
            else -> again(bn_mul_small(64, acc, i), i + 1)
        }, k)
}

// A MAP, which is open addressing over a build buffer on this target.
export fn count_keys(n ∈ 0..8) (Int) {
    m = { var m := map(8); loop i = 0 { i >= n -> m; else -> { m[i] := 1; again(i + 1) } } }
    len(m)
}

// A COMPUTED SIZE: the length header is written after the allocator returns,
// so the size may not share a register with the buffer (map-len).
export fn sized(n ∈ 1..100) (Int) {
    t = { var b := array { 0 : _ ∈ 0..n * 3-1 }; b[0] := n; b }
    len(t) + t[0]
}
