// io, on windows — the console at the two types every host agrees on, over
// Win32's WriteFile to standard output (ADR 0112). The other cells are a host
// statement each; Win32's output primitive takes bytes, so each name here is a
// short program, as lib/win/print's are, which these reuse.
//
// A string is its UTF-8 bytes on this target, so it is written as it is; an
// integer is win/print's render, its digits and a newline. Each name's value is
// its argument, as a host statement's is (plan's alias).
provides win32 io {
    use win/print
    use windows/fileapi
    use windows/minwindef
    use windows/processenv
    use llvm/str as str

    fn print_line(s ∈ String) (String) {
        ignore(print.print_str(s))
        s
    }

    // the same without the newline: the bytes alone, at most one DWORD's count
    fn print(s ∈ String) (String) {
        u = str.utf8(s)
        if len(u) <= 2^32 - 1 {
            (w, r) = fileapi.WriteFile(processenv.GetStdHandle(4294967285), u)
            ignore(r)
        }
        s
    }

    // PRINT_INT IS OVER ℤ (integers-boundary §3), and on this layer it is
    // win/print's: inside the words its field written straight to the handle,
    // one function the compiler keeps (ADR 0113), and above them `decimal`.
    // print_line(decimal(n)) is the same text, `decimal` of a word being
    // llvm/lang's render, a realization copied into every call.
    fn print_int(n ∈ Int) (Int) {
        ignore(print.print_int(n))
        n
    }
}
