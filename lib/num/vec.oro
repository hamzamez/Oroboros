// The delayed-vector library, in its own file.
//
// A file whose (module …) path matches its location on the search path is
// loadable by `(use num/vec)` from anywhere. Nothing in the reducer knows: by
// the time Load returns, every name here is fully qualified and this file is
// indistinguishable from definitions written inline (modules.md §5, R1).
//
// A vector is a length paired with an index function. It has no runtime
// existence and reduces away entirely.
use num/f64

// A signature is a claim, checked against BOTH this definition and any target
// that provides the name natively. blas provides num/vec.dot as cblas_ddot; that
// declaration and this one are compared against the same statement, and no host
// compiler ever sees both.
fn vec(n, f) { fn(sel) { sel(n, f) } }
fn vlen(v) { v(fn(n, f) { n }) }
fn vindex(v, i) { v(fn(n, f) { f })(i) }
fn of_array(a) { vec(alen(a), fn(i) { aindex(a, i) }) }

fn zip(g, a, b) { vec(vlen(a), fn(i) { g(vindex(a, i), vindex(b, i)) }) }
fn sum(v) { fold_range(0.0, vlen(v), fn(acc, i) { f64.add(acc, vindex(v, i)) }) }
fn dot(a ∈ vec_f64, b ∈ vec_f64) (F64) { sum(zip(f64.mul, of_array(a), of_array(b))) }
fn materialize(v ∈ Any) (vec_f64) {
    // The one place a delayed vector becomes a real array. Materialize at a
    // BOUNDARY -- handing an array to a host function, or returning one. Doing it in
    // the interior costs the 13x the stencil benchmark measured, and that cost is
    // the point (construction.md 6).
    make_vec(vlen(v), fn(i) { vindex(v, i) })
}
