; os, on Go — the LIBRARY layer, not the target's.
;
; See `lib/os/README` for what this module is. In one line: `go/os` names Go's
; `os` package and claims nothing beyond that host; `os` names a `Σ` several
; targets share, and this file is Go's cell of it.
;
; `(provides T M decl…)` is exactly `(target T (module M decl…))` written where
; the library lives — a target FRAGMENT, and target-system.md §7.2 already says
; a target is the glue of its fragments. It is the LOWEST layer, because a
; library's opinion about a host loses to that host's own files.
;
; THE TEMPLATES REPEAT `targets/go/os.oro`'s, AND THAT IS TWO CLAIMS RATHER THAN
; ONE FACT WRITTEN TWICE. `go/os.ReadFile` is a binding to Go's `os.ReadFile`
; and is answerable to Go's documentation. `os.ReadFile` is a portable name
; answerable to the other targets' cells — and if Go's package changed shape,
; one of the two would move and the other would not. modules.md §6 shows this
; exact arrangement and calls it complete.

(provides go os
  (sig ReadFile ((path string)) (tuple (array (int 0 255)) error) (host expr
      "os.ReadFile(%s)" (import "os")))

  (sig WriteFile ((path string) (data (array (int 0 255))) (perm int)) error (host expr
      "os.WriteFile(%s, %s, os.FileMode(%s))" (import "os")))

  ; The discriminator that totalises the pair above. `nil` is not a value this
  ; language has, so it is a primitive rather than something derived.
  (sig err-nil ((e error)) bool pure (host expr "%s == nil"))

  ; Bytes to text, ONCE, at the boundary. `string-of` is η over SCALARS, so a
  ; raw UTF-8 byte through it would become U+00C3; the decode has to see the
  ; whole sequence (string-operations.md §5).
  ;
  ; IT IS d, THE SAME FUNCTION ON EVERY HOST (ADR 0030): the Unicode Standard's
  ; maximal-subpart substitution, which is what JavaScript's TextDecoder does.
  ; Go's `string(b)` kept invalid bytes — a value outside Σ* typed `string` —
  ; and Go's own `range` decode gives one U+FFFD per bad byte, not per maximal
  ; subpart, so d is written out. Valid input, the common case, takes the fast
  ; path: d is the identity there.
  (sig text-of ((b (array (int 0 255)))) string pure
    (host expr "func(s string) string { if utf8.ValidString(s) { return s }; b := make([]byte, 0, len(s)+8); for i := 0; i < len(s); { c := s[i]; if c < 0x80 { b = append(b, c); i++; continue }; n, lo, hi := 0, byte(0x80), byte(0xBF); switch { case c >= 0xC2 && c <= 0xDF: n = 1; case c == 0xE0: n, lo = 2, 0xA0; case c == 0xED: n, hi = 2, 0x9F; case c >= 0xE1 && c <= 0xEF: n = 2; case c == 0xF0: n, lo = 3, 0x90; case c == 0xF4: n, hi = 3, 0x8F; case c >= 0xF1 && c <= 0xF3: n = 3 }; j := i + 1; ok := n > 0; for k := 0; ok && k < n; k++ { if j >= len(s) || s[j] < lo || s[j] > hi { ok = false; break }; j++; lo, hi = 0x80, 0xBF }; if ok { b = append(b, s[i:j]...) } else { b = append(b, \"\\uFFFD\"...) }; i = j }; return string(b) }(string(%s))" (import "unicode/utf8")))

  ; The environment, so a program can be told what to open. The OS's strings
  ; are bytes on Unix, so each is decoded by d as it enters — what Node and the
  ; JVM already do to theirs. The loop alone, with no `utf8` fast path: a
  ; template names one package, and this is called once.
  (sig Args () (array string) (host expr "func() []string { d := func(s string) string { b := make([]byte, 0, len(s)+8); for i := 0; i < len(s); { c := s[i]; if c < 0x80 { b = append(b, c); i++; continue }; n, lo, hi := 0, byte(0x80), byte(0xBF); switch { case c >= 0xC2 && c <= 0xDF: n = 1; case c == 0xE0: n, lo = 2, 0xA0; case c == 0xED: n, hi = 2, 0x9F; case c >= 0xE1 && c <= 0xEF: n = 2; case c == 0xF0: n, lo = 3, 0x90; case c == 0xF4: n, hi = 3, 0x8F; case c >= 0xF1 && c <= 0xF3: n = 3 }; j := i + 1; ok := n > 0; for k := 0; ok && k < n; k++ { if j >= len(s) || s[j] < lo || s[j] > hi { ok = false; break }; j++; lo, hi = 0x80, 0xBF }; if ok { b = append(b, s[i:j]...) } else { b = append(b, \"\\uFFFD\"...) }; i = j }; return string(b) }; a := make([]string, len(os.Args)); for i, s := range os.Args { a[i] = d(s) }; return a }()" (import "os")))
  (sig Getenv ((k string)) string pure (host expr "func(s string) string { b := make([]byte, 0, len(s)+8); for i := 0; i < len(s); { c := s[i]; if c < 0x80 { b = append(b, c); i++; continue }; n, lo, hi := 0, byte(0x80), byte(0xBF); switch { case c >= 0xC2 && c <= 0xDF: n = 1; case c == 0xE0: n, lo = 2, 0xA0; case c == 0xED: n, hi = 2, 0x9F; case c >= 0xE1 && c <= 0xEF: n = 2; case c == 0xF0: n, lo = 3, 0x90; case c == 0xF4: n, hi = 3, 0x8F; case c >= 0xF1 && c <= 0xF3: n = 3 }; j := i + 1; ok := n > 0; for k := 0; ok && k < n; k++ { if j >= len(s) || s[j] < lo || s[j] > hi { ok = false; break }; j++; lo, hi = 0x80, 0xBF }; if ok { b = append(b, s[i:j]...) } else { b = append(b, \"\\uFFFD\"...) }; i = j }; return string(b) }(os.Getenv(%s))" (import "os"))))
