// os, on the JVM — the LIBRARY layer, not the target's.
//
// TOTALISATION, ON THE HOST WHERE FAILURE IS IN THE TYPES. See `lib/os/js.oro`
// for the algebra; the short form is that a fallible call is a partial map and a
// partial map is a total one into a coproduct, no host gives that coproduct, and
// so a cell declares the CALL that produces the pair and the DISCRIMINATOR that
// reads it.
//
// Java's checked exceptions make no difference to us and that is worth saying:
// `throws IOException` is a demand on the CALLER's syntax, and the caller here is
// a template, which catches. The type system that makes this host's failures
// loudest is the one that costs us the least. (`error` is `Exception` on this
// target and is declared in `targets/java/java.oro`, because how a host spells an
// error value is a fact about the target rather than about any package.)
//
// A FILE'S BYTES ARE Files.readAllBytes' OWN byte[] (ADR 0083). The JVM's byte
// is signed, and until ADR 0083 0..255 was a short[] here (elemwidth-2026-08-27),
// so this cell widened every file on the way in and narrowed it on the way out,
// a copy each. A byte holds 0..255 under a second reading, `b & 0xFF`, which the
// printer applies at every index (targets/java/java.oro), so the array the host
// returns is the table, and nothing is copied.
provides java os/host {
    // THIS IS os/host, ONE HOST'S CELL (oskinds-2026-10-06). `os` itself is a
    // library module, lib/os.oro, one definition over every host: each portable
    // call is (id + h) ∘ this cell's call, with h the classification written once
    // there over the three predicates below. A fallible call's result is a value of
    // lib/result's sum, read off the host through `error`'s niche (errors.md §4).
    use result
    // `%r0` and `%r1` are the DESTINATIONS. A `try`/`catch` is a statement and not
    // an expression yielding a pair, so a host that signals failure out of band has
    // to be given somewhere to put its two values — the second of the format's two
    // multi-result shapes, and the one every throwing host needs. The emitter
    // declares them and javac's definite-assignment check then enforces that every
    // arm writes every one.
    //
    // `$oroB`/`$oroI`/`$oroE` are scoped to the `try` block and are spelled so they
    // cannot collide with an emitted local: Java forbids shadowing one, and
    // `javaMangle` never produces a name starting with `$oro`.
    fn ReadFile(path ∈ String) (r ∈ result.Result(Array(0..255), error)) {
        host expr "try { ${r}0 = Files.readAllBytes(Path.of(${path})); ${r}1 = null; } catch (Exception $oroE) { ${r}0 = null; ${r}1 = $oroE; }" import "java.nio.file.*"
    }

    // Put on the store (lib/os/go.oro). The holes are filled in the ARGUMENT
    // order, so the path is named first: this template once named the data
    // first, took the path as a short[], and never compiled. `Files.write`
    // creates with 0666 before the umask, as the other two hosts do.
    fn WriteFile(path ∈ String, data ∈ Array(0..255)) (r ∈ result.Result((), error)) {
        host expr "try { final Path $oroP = Path.of(${path}); Files.write($oroP, ${data}); ${r}0 = null; } catch (Exception $oroE) { ${r}0 = $oroE; }" import "java.nio.file.*"
    }

    // Read at an offset (lib/os/go.oro): RandomAccessFile, read until the buffer
    // is full or the file ends, since one read may return fewer bytes.
    // The count is an int: a Java array's length is below 2^31.
    fn ReadAt(path ∈ String, off ∈ Nat, b ∈ Array(0..255) linear) (n ∈ 0..2^31-1, r ∈ result.Result((), error))
        ensure n <= len(b') && len(b') == len(b) {
        host expr "try (java.io.RandomAccessFile $oroF = new java.io.RandomAccessFile(${path}, \"r\")) { $oroF.seek(${off}); int $oroN = 0; while ($oroN < ${b}.length) { int $oroK = $oroF.read(${b}, $oroN, ${b}.length - $oroN); if ($oroK < 0) break; $oroN += $oroK; } ${n} = $oroN; ${r} = null; } catch (Exception $oroE) { ${n} = 0; ${r} = $oroE; }"
    }

    // The discriminator.
    // THE KINDS' PREDICATES: java.nio.file's exception classes for io/fs's three
    // sentinels.
    fn not_found?(e ∈ error) (Bool) pure {
        host expr "(${e} instanceof java.nio.file.NoSuchFileException)"
    }
    fn exists?(e ∈ error) (Bool) pure {
        host expr "(${e} instanceof java.nio.file.FileAlreadyExistsException)"
    }
    fn permission?(e ∈ error) (Bool) pure {
        host expr "(${e} instanceof java.nio.file.AccessDeniedException)"
    }

    // Bytes to text, ONCE, at the boundary.
    //
    // A LAMBDA APPLIED AT THE CALL SITE, and not because it reads well: `%s` is an
    // arbitrary expression — `(text-of (format src))` is the real call — and every
    // array-narrowing form Java has that is an EXPRESSION mentions its operand
    // twice. Once bound to a parameter it is evaluated once. This is callbacks.md
    // tier 1 exactly: the lambda never becomes a value in our residual, the host
    // closes over it, and C2 inlines it.
    //
    // IT IS d (ADR 0030), the Unicode Standard's maximal-subpart substitution, as
    // on every host. `new String(b, UTF_8)` is d except on an ENCODED SURROGATE:
    // `ED A0 80` gives one U+FFFD there and three under d, which is what
    // JavaScript's TextDecoder gives (measured). So the lenient decoder runs
    // first, and its answer is kept exactly when it contains no U+FFFD: it emits
    // one for every ill-formed sequence, and on valid input it IS d, so no U+FFFD
    // means valid input and d's answer. Otherwise — ill-formed input, or a U+FFFD
    // the input really held — d is written out. (The strict decoder was the first
    // fast path; it lacks the lenient one's ASCII intrinsic and cost 3.6× on 1 KB
    // of ASCII, measured.)
    fn text_of(b ∈ Array(0..255)) (String) pure {
        host expr "((java.util.function.Function<byte[],String>) ($oroA) -> { final byte[] $oroB = $oroA; final String $oroT = new String($oroB, StandardCharsets.UTF_8); if ($oroT.indexOf('\\uFFFD') < 0) return $oroT; { final StringBuilder $oroS = new StringBuilder(); final int $oroN = $oroB.length; for (int $oroI = 0; $oroI < $oroN; ) { final int $oroC = $oroB[$oroI] & 0xFF; if ($oroC < 0x80) { $oroS.append((char) $oroC); $oroI++; continue; } int $oroK = 0, $oroLo = 0x80, $oroHi = 0xBF; if ($oroC >= 0xC2 && $oroC <= 0xDF) $oroK = 1; else if ($oroC == 0xE0) { $oroK = 2; $oroLo = 0xA0; } else if ($oroC == 0xED) { $oroK = 2; $oroHi = 0x9F; } else if ($oroC >= 0xE1 && $oroC <= 0xEF) $oroK = 2; else if ($oroC == 0xF0) { $oroK = 3; $oroLo = 0x90; } else if ($oroC == 0xF4) { $oroK = 3; $oroHi = 0x8F; } else if ($oroC >= 0xF1 && $oroC <= 0xF3) $oroK = 3; int $oroJ = $oroI + 1; int $oroCp = $oroC & (0x3F >> $oroK); boolean $oroOk = $oroK > 0; for (int $oroM = 0; $oroOk && $oroM < $oroK; $oroM++) { if ($oroJ >= $oroN) { $oroOk = false; break; } final int $oroD = $oroB[$oroJ] & 0xFF; if ($oroD < $oroLo || $oroD > $oroHi) { $oroOk = false; break; } $oroCp = ($oroCp << 6) | ($oroD & 0x3F); $oroJ++; $oroLo = 0x80; $oroHi = 0xBF; } if ($oroOk) $oroS.appendCodePoint($oroCp); else $oroS.append('\\uFFFD'); $oroI = $oroJ; } return $oroS.toString(); } }).apply(${b})" import "java.nio.charset.StandardCharsets"
    }

    // THE COMMAND LINE IS THE ONE THING A JVM PROGRAM CANNOT ASK FOR. Go has
    // `os.Args` and Node has `process.argv`; the JVM hands its arguments to `main`
    // and offers no global, so this is the only declaration in the repository whose
    // implementation needs the program's LAYOUT to cooperate — `oroArgs` is emitted
    // by the Java program writer, and only when something reads it.
    fn Args() (Array(String)) { host expr "oroArgs" }
    // Impure, as on every host: a read of the environment (lib/os/go.oro). The
    // JVM's environment is fixed for the process, so here the bit is the
    // interface's, not the host's.
    fn Getenv(k ∈ String) (String) { host expr "System.getenv().getOrDefault(${k}, \"\")" }
}
