// os, on windows — the LIBRARY layer, and the first cell written in J (ADR 0112).
//
// Every other cell is one host template a name: Go's os.ReadFile, Node's
// readFileSync, the JVM's Files. Win32 has no call that reads a file by its
// path. Its files are handles, so each name here is a short program over
// kernel32, a term over the host's operations (ADR 0089), checked as a program
// is.
//
// THE FAILURE IS A TERM. Go's (T, error) is T × (1 + E), read through a niche
// of its error type. Win32 has none: each function names its sentinel
// (INVALID_HANDLE_VALUE, FALSE) and the reason is a second read, GetLastError.
// The retraction r(b, e) = err e if b is the sentinel, else ok b, is written
// where each call is, and the effect discipline keeps GetLastError right
// after the call it explains (ADR 0010), which is Win32's contract. `error` is
// the set of DWORDs (targets/windows/windows.oro); the failure is the
// sentinel's, so 0 is a code like any other.
//
// AN OUT-PARAMETER IS A CELL (ADR 0048): GetFileSizeEx's size and ReadFile's
// count come back through `out S`, an alloca the printer allocates.
provides windows os/host {
    use result
    use llvm
    use windows/kernel32

    // Win32's constants are written where they are used, named in a comment:
    // a fragment holds declarations only. The codes this cell answers itself
    // are ERROR_NOT_ENOUGH_MEMORY (8) for a file past the largest table and
    // ERROR_INVALID_NAME (123) for a path holding a NUL, which names no file.

    // EACH NAME BUILDS ITS SUM ONCE, AT ITS TAIL, as a host cell's retraction
    // does (errors.md §4.2): the raw steps compute (value, code) over handles
    // and integers, code 0 for success, and `if code != 0 { 'err(code) } else
    // { 'ok(value) }` is the one constructor site. Case-of-case copies a
    // consumer into each site of a sum, so sums built in every arm of nested
    // branches multiplied the program (roundtrip.oro passed the reducer's
    // fuel); built once, a call costs what Go's retraction does.

    // a failure's code: Win32's, or ERROR_GEN_FAILURE (31) when a failing call
    // set none, so that 0 means success
    fn failed(c ∈ error) (1..2^32-1) { if c == 0 { 31 } else { c } }

    // OPEN, the first partial step: a handle and 0, or a code. A path holding
    // a NUL names no file (Go answers EINVAL), ERROR_INVALID_NAME (123); a C
    // string is the kernel of ν (ADR 0091), and the guard decides it.
    fn open(path ∈ String, a ∈ 0..2^32-1, d ∈ 0..2^32-1) {
        // a join point: the branches below give one value, and what
        // follows the call is written once, after the loop (ADR 0031)
        loop once = 0 {
            else -> {
                if nulfree(path) {
                    h = kernel32.CreateFileA(path, a, 1, llvm.null(), d, 128, llvm.null()) // FILE_SHARE_READ, FILE_ATTRIBUTE_NORMAL
                    if llvm.address(h) == -1 { (h, failed(kernel32.GetLastError())) } else { (h, 0) }
                } else {
                    (llvm.null(), 123)
                }
    
            }
        }
    }

    // GET ON THE STORE F : Path ⇀ B*: open ; size ; read until full or 0 ;
    // close, a Kleisli composite in A + E whose finalizer closes what it opened.
    fn ReadFile(path ∈ String) (result.Result(Array(0..255), error)) {
        (b, c) = readfile(path)
        if c != 0 { result.'err(c) } else { result.'ok(b) }
    }
    fn readfile(path ∈ String) {
        // a join point: the branches below give one value, and what
        // follows the call is written once, after the loop (ADR 0031)
        loop once = 0 {
            else -> {
                (h, c) = open(path, 2147483648, 3) // GENERIC_READ, OPEN_EXISTING
                case {
                    c != 0 -> (alloc(array { 0 : _ ∈ 0..-1 }), c)
                    else -> {
                        (sz, ok) = kernel32.GetFileSizeEx(h, out kernel32.LARGE_INTEGER)
                        case {
                            ok == 0 -> { e = failed(kernel32.GetLastError()); ignore(kernel32.CloseHandle(h)); (alloc(array { 0 : _ ∈ 0..-1 }), e) }
                            // ERROR_NOT_ENOUGH_MEMORY: past the largest table this cell reads
                            sz < 0 || sz > 2^40 -> { ignore(kernel32.CloseHandle(h)); (alloc(array { 0 : _ ∈ 0..-1 }), 8) }
                            else -> {
                                (b, m, e) = readall(h, sz)
                                ignore(kernel32.CloseHandle(h))
                                // the file shrank while it was read: its first m bytes
                                // m ≤ len(b) is readinto's result relation, which a call of it
                        // as a function does not carry (its `ensure` waits on P3's
                        // relational results, ADR 0113): stated here, the identity
                        m1 = if m > len(b) { len(b) } else if m < 0 { 0 } else { m }
                        t = if m1 >= len(b) { b } else { alloc(array { b[i] : i ∈ 0..m1 - 1 }) }
                                (t, e)
                            }
                        }
                    }
                }
    
            }
        }
    }

    // read* : the table of sz bytes filled from h, until it is full or a read
    // answers 0 bytes (the file shrank), with how many were read and the
    // failure's code, 0 if none.
    fn readall(h ∈ ptr, sz ∈ 0..2^40) {
        var b := array { 0 : _ ∈ 0..sz - 1 }
        (m, e) = readinto(h, b)
        (b, m, e)
    }

    // read* into a table the caller lends, from h's position: how many bytes,
    // and the failure's code, 0 if none. A synchronous read of a file returns
    // fewer bytes than asked only at its end; one asks at most 2^30. The last
    // read's outcome is carried to the next round, where the clauses decide it:
    // its count (0 ends the file) and its failure's code, read right after the
    // call. A failure that set no code is ERROR_GEN_FAILURE (31).
    // Its count is at most len(b) (k ≤ n ≤ len(b) − lo, a relation); the
    // intervals prove lo + k ≤ 2^47 + 2^30, so the claim is 0..2^48.
    fn readinto(h ∈ ptr, b ∈ Array(0..255) linear) (0..2^48 × error) {
        loop lo = 0, got = 1, e = 0 {
            e != 0 -> (lo, e)
            got == 0 || lo >= len(b) -> (lo, 0)
            else -> {
                // len(b) − lo ≥ 1 under the clause before; its lower end is a
                // relation the intervals lose across the loop, stated here
                rest = len(b) - lo
                n = if rest > 1073741824 { 1073741824 } else if rest < 1 { 0 } else { rest }
                (g, r) = kernel32.ReadFile(h, b, lo, n, out kernel32.DWORD)
                c = if r == 0 { failed(kernel32.GetLastError()) } else { 0 }
                k = if g > n { n } else { g }
                again(lo + k, k, c)
            }
        }
    }

    // PUT ON THE STORE: create or truncate (CREATE_ALWAYS), write until all of
    // data is written, close. After it succeeds, ReadFile gives data (put-get).
    fn WriteFile(path ∈ String, data ∈ Array(0..255)) (result.Result((), error)) {
        c = writefile(path, data)
        if c != 0 { result.'err(c) } else { result.'ok(()) }
    }
    fn writefile(path ∈ String, data ∈ Array(0..255)) {
        // a join point: the branches below give one value, and what
        // follows the call is written once, after the loop (ADR 0031)
        loop once = 0 {
            else -> {
                (h, c) = open(path, 1073741824, 2) // GENERIC_WRITE, CREATE_ALWAYS
                case {
                    c != 0 -> c
                    else -> {
                        e = writeall(h, data)
                        k = kernel32.CloseHandle(h)
                        case {
                            e != 0 -> e
                            k == 0 -> failed(kernel32.GetLastError())
                            else -> 0
                        }
                    }
                }
    
            }
        }
    }

    // write* : data to h, at most 2^30 bytes a call; a call that writes none
    // and reports no failure is ERROR_WRITE_FAULT (29), so the loop ends.
    fn writeall(h ∈ ptr, data ∈ Array(0..255)) {
        loop lo = 0, put = 1, e = 0 {
            e != 0 -> e
            lo >= len(data) -> 0
            put == 0 -> 29
            else -> {
                rest = len(data) - lo
                n = if rest > 1073741824 { 1073741824 } else if rest < 1 { 0 } else { rest }
                (p, r) = kernel32.WriteFile(h, data, lo, n, out kernel32.DWORD)
                c = if r == 0 { failed(kernel32.GetLastError()) } else { 0 }
                k = if p > n { n } else { p }
                again(lo + k, k, c)
            }
        }
    }

    // READ AT AN OFFSET into a region the caller lends (pread): open, move the
    // file's position to off (SetFilePointerEx, FILE_BEGIN), read* into b,
    // close. A file that ends first is a shorter n, no failure. A position
    // is a LARGE_INTEGER, so the domain is off ≤ 2^62: an offset that may pass
    // it is refused here, where the other hosts take any Nat. The other cells
    // state `ensure n <= len(b')`, a host template's only way to say it; this
    // body is inlined at its calls, where n = min(m, len b) proves it.
    //
    // THE SUM IS BUILT ONCE, AT THE TAIL, as a host call's retraction builds it
    // (errors.md §4.2): the raw outcome (n, code) crosses the joins, two
    // integers, and `case` meets the sum by case-of-case where it is used.
    fn ReadAt(path ∈ String, off ∈ 0..2^62, b ∈ Array(0..255) linear) (0..2^62 × result.Result((), error)) {
        (n, c) = readat(path, off, b)
        (n, if c != 0 { result.'err(c) } else { result.'ok(()) })
    }
    fn readat(path ∈ String, off ∈ 0..2^62, b ∈ Array(0..255) linear) (0..2^62 × error) {
        // a join point: the branches below give one value, and what
        // follows the call is written once, after the loop (ADR 0031)
        loop once = 0 {
            else -> {
                if nulfree(path) {
                    h = kernel32.CreateFileA(path, 2147483648, 1, llvm.null(), 3, 128, llvm.null()) // GENERIC_READ, OPEN_EXISTING
                    case {
                        llvm.address(h) == -1 -> (0, failed(kernel32.GetLastError()))
                        else -> {
                            s = kernel32.SetFilePointerEx(h, off, llvm.null(), 0) // FILE_BEGIN
                            case {
                                s == 0 -> { e = failed(kernel32.GetLastError()); ignore(kernel32.CloseHandle(h)); (0, e) }
                                else -> {
                                    (m, e) = readinto(h, b)
                                    ignore(kernel32.CloseHandle(h))
                                    (if m > len(b) { len(b) } else if m < 0 { 0 } else { m }, e)
                                }
                            }
                        }
                    }
                } else {
                    (0, 123) // ERROR_INVALID_NAME
                }
    
            }
        }
    }

    // THE KINDS' PREDICATES, h's host half: Go-on-Windows' own map
    // (syscall.Errno.Is), so a failure lands in the kind Go gives it there.
    fn not_found?(e ∈ error) (Bool) { e == 2 || e == 3 || e == 53 }
    fn exists?(e ∈ error) (Bool) { e == 80 || e == 183 || e == 145 }
    fn permission?(e ∈ error) (Bool) { e == 5 }

    // THE COMMAND LINE: GetCommandLineA's C string, its bytes copied into a
    // table (lstrlenA, RtlMoveMemory), split by Go-on-Windows' own rule
    // (os.commandLineToArgv), each argument then text by d, as Go's are.
    fn Args() (Array(String)) {
        p = kernel32.GetCommandLineA()
        n0 = kernel32.lstrlenA(p)
        // a command line is at most 32,767 bytes (CreateProcess's limit)
        n = if n0 < 0 { 0 } else if n0 > 32767 { 32767 } else { n0 }
        cmd = {
            var c := array { 0 : _ ∈ 0..n }
            ignore(kernel32.lstrcpynA(c, p, n + 1))
            c
        }
        (o, ends, na) = argv(cmd, n)
        alloc(array { text_of(slice(o, arg_lo(ends, j), arg_hi(ends, j))) : j ∈ 0..na - 1 })
    }
    fn arg_lo(ends, j) { if j < 1 || j > len(ends) { 0 } else { ends[j - 1] } }
    fn arg_hi(ends, j) { if j < 0 || j >= len(ends) { 0 } else { ends[j] } }
    // o[a, b) as a fresh table: argv's ends are nondecreasing in [0, len o],
    // an invariant of its writes the intervals do not keep, so each read is
    // total, 0 off the table, the identity under the invariant
    fn slice(o ∈ Array(0..255), a, b) {
        d = b - a
        n = if d < 0 { 0 } else if d > len(o) { len(o) } else { d }
        alloc(array { at(o, a + t) : t ∈ 0..n - 1 })
    }
    fn at(o ∈ Array(0..255), i) { if i < 0 || i >= len(o) { 0 } else { o[i] } }

    // argv as a Mealy machine over the command line's bytes (Go's readNextArg):
    // q whether inside quotes, ns the backslashes pending, inarg whether an
    // argument has begun. Every byte of an argument is written as it comes,
    // backslashes too, so a quote after ns of them keeps ns/2 by moving k back
    // (they are all one byte); an even ns makes the quote a toggle, `""` inside
    // quotes a literal quote that leaves them (the rule prior to 2008), an odd
    // ns a literal quote. White space outside quotes ends an argument: its end
    // is recorded in `ends`, and the arguments are contiguous in o.
    fn argv(b ∈ Array(0..255), n0) {
        n = if n0 > len(b) { len(b) } else if n0 < 0 { 0 } else { n0 }
        var o := array { 0 : _ ∈ 0..n }
        var ends := array { 0 : _ ∈ 0..n }
        loop i = 0, k = 0, q = 0, ns = 0, inarg = 0, na = 0 {
            i >= n && inarg == 1 -> { ends[na] := k; (o, ends, na + 1) }
            i >= n -> (o, ends, na)
            b[i] == 92 -> { o[k] := 92; again(i + 1, k + 1, q, ns + 1, 1, na) }
            b[i] == 34 && ns % 2 == 1 -> {
                o[k - ns + ns / 2] := 34
                again(i + 1, k - ns + ns / 2 + 1, q, 0, 1, na)
            }
            b[i] == 34 && q == 1 && i + 1 < n && b[i + 1] == 34 -> {
                o[k - ns + ns / 2] := 34
                again(i + 2, k - ns + ns / 2 + 1, 0, 0, 1, na)
            }
            b[i] == 34 -> again(i + 1, k - ns + ns / 2, 1 - q, 0, 1, na)
            (b[i] == 32 || b[i] == 9) && q == 0 && inarg == 1 -> { ends[na] := k; again(i + 1, k, 0, 0, 0, na + 1) }
            (b[i] == 32 || b[i] == 9) && q == 0 -> again(i + 1, k, 0, 0, 0, na)
            else -> { o[k] := b[i]; again(i + 1, k + 1, q, 0, 1, na) }
        }
    }

    // A READ OF THE ENVIRONMENT, absent ↦ "": GetEnvironmentVariableA answers
    // the length when the value fits, the size it needs (with its NUL) when not,
    // 0 when absent or empty. A value is at most 32,767 bytes (Win32's limit),
    // and the environment may change between two calls, so a value that grew
    // is asked again, a bounded number of times. A name holding a NUL names no
    // variable.
    fn Getenv(k ∈ String) (String) {
        // a join point: the arms below give one string (ADR 0031)
        loop once = 0 {
            else -> {
                if nulfree(k) {
                    (b, r) = fetch(k, 256)
                    case {
                        r == 0 -> ""
                        r < 256 -> text_of(prefix(b, r))
                        // it needs r bytes with its NUL; asked again at that size
                        r > 32768 -> ""
                        else -> {
                            (b2, r2) = fetch(k, r)
                            if r2 == 0 || r2 >= r { "" } else { text_of(prefix(b2, r2)) }
                        }
                    }
                } else {
                    ""
                }
            }
        }
    }
    // one call, into a fresh table of m bytes; its name a C string, which the
    // caller's guard decides
    fn fetch(k ∈ String, m ∈ 1..32768) where nulfree(k) {
        var v := array { 0 : _ ∈ 0..m - 1 }
        g = kernel32.GetEnvironmentVariableA(k, v, m)
        (v, g)
    }
    fn prefix(b ∈ Array(0..255), r) {
        m = if r > len(b) { len(b) } else if r < 0 { 0 } else { r }
        alloc(array { b[i] : i ∈ 0..m - 1 })
    }

    // BYTES TO TEXT, d = ι_V ∘ r (ADR 0112, strings.md §11): Σ* is held here as
    // its UTF-8, so valid input IS its text, and ill-formed input is repaired,
    // each maximal ill-formed subpart replaced by U+FFFD's bytes, then included.
    // The repair's guard is false only for a wrong repair.
    fn text_of(b ∈ Array(0..255)) (String) {
        if utf8_valid(b) {
            utf8_text(b)
        } else {
            r = repair(b)
            if utf8_valid(r) { utf8_text(r) } else { abandon("os.text_of: the repair left an ill-formed subpart") }
        }
    }

    // r : B* → V, the maximal-subpart substitution (Unicode §3.9, Table 3-7), a
    // Mealy machine over the bytes: s is where the current sequence began and
    // (m, lo, hi) the continuation bytes it still owes and the next one's range.
    // A sequence's bytes are written as they arrive, at k + (i − s), and k moves
    // past them only when it completes; a sequence that cannot complete is
    // overwritten by EF BF BD, and the byte that broke it is read again. Each
    // input byte writes at most three, so 3n + 4 bytes hold the output.
    //
    // k ≤ 3i ≤ 3n is the output's invariant, linear but no difference, which
    // the intervals do not keep: each store is guarded by its index's range,
    // the identity on every path the invariant allows, and so is the prefix's
    // length. Past ⌊(2^47 − 13)/3⌋ input bytes the output cannot be held (the
    // bound one more was off by one, found under the contract, ADR 0113).
    fn repair(b ∈ Array(0..255)) {
        n = len(b)
        case {
            n > 46912496118438 -> abandon("out of memory: text longer than the largest table")
            else -> {
                (o, k) = {
                    var o := array { 0 : _ ∈ 0..3 * n + 3 }
                    loop i = 0, k = 0, s = 0, m = 0, lo = 128, hi = 191 {
                        // k ≤ 3i < len(o): never taken, the invariant as a guard
                        k >= len(o) || k < 0 -> (o, k)
                        // the input ends: a sequence still owed bytes is one U+FFFD
                        i >= n && m > 0 -> { put(o, k, 239); put(o, k + 1, 191); put(o, k + 2, 189); (o, k + 3) }
                        i >= n -> (o, k)
                        m > 0 && (b[i] < lo || b[i] > hi) -> {
                            put(o, k, 239); put(o, k + 1, 191); put(o, k + 2, 189)
                            again(i, k + 3, i, 0, 128, 191)
                        }
                        m == 1 -> { put(o, k + i - s, b[i]); again(i + 1, k + i - s + 1, i + 1, 0, 128, 191) }
                        m > 1 -> { put(o, k + i - s, b[i]); again(i + 1, k, s, m - 1, 128, 191) }
                        b[i] < 128 -> { put(o, k, b[i]); again(i + 1, k + 1, i + 1, 0, 128, 191) }
                        b[i] >= 194 && b[i] < 224 -> { put(o, k, b[i]); again(i + 1, k, i, 1, 128, 191) }
                        b[i] == 224 -> { put(o, k, b[i]); again(i + 1, k, i, 2, 160, 191) }
                        b[i] == 237 -> { put(o, k, b[i]); again(i + 1, k, i, 2, 128, 159) }
                        b[i] > 224 && b[i] < 240 -> { put(o, k, b[i]); again(i + 1, k, i, 2, 128, 191) }
                        b[i] == 240 -> { put(o, k, b[i]); again(i + 1, k, i, 3, 144, 191) }
                        b[i] > 240 && b[i] < 244 -> { put(o, k, b[i]); again(i + 1, k, i, 3, 128, 191) }
                        b[i] == 244 -> { put(o, k, b[i]); again(i + 1, k, i, 3, 128, 143) }
                        else -> {
                            put(o, k, 239); put(o, k + 1, 191); put(o, k + 2, 189)
                            again(i + 1, k + 3, i + 1, 0, 128, 191)
                        }
                    }
                }
                m = if k < 0 { 0 } else if k > len(o) { len(o) } else { k }
                alloc(array { o[i] : i ∈ 0..m - 1 })
            }
        }
    }
    fn put(o ∈ Array(0..255) linear, i, v ∈ 0..255) { if i >= 0 && i < len(o) { o[i] := v } else { () } }
}
