// PRINTING ON WIN32, WRITTEN IN THE LANGUAGE'S OPERATORS (ADR 0080 item 5),
// for the LLVM-printed Windows target.
//
//   (use win/print)
//   print.print_int(2262)   print.print_str("primes:")
//
// Win32's output primitive is WriteFile, which takes bytes; turning 2262 into
// the four bytes "2262" is a program, and this is it: a remainder, a quotient
// and a byte store per digit, into a table of the language's own, written from
// its end. lib/win/fmt.oro is the same program for the MASM target, written in
// x86's mnemonics over the target's one scratch buffer; it retires with that
// target, and this one takes its name.
//
// Nothing here names an instruction. The buffer is a language buffer, its
// indices obligations the decision proves, and the bytes written are the
// segment WriteFile's `where` keeps inside it.
use windows/fileapi
use windows/minwindef
use windows/processenv
use llvm/str as str

// WRITES b[lo, lo + n) to standard output (-11), answering whether it was
// written. WriteFile's domain is a segment inside the table and a DWORD count;
// outside it nothing is written and the answer is false, so `write` is total.
fn write(b ∈ Array(0..255), lo, n) (Bool) {
    case {
        lo < 0 || n < 0 || n > 2^32 - 1 || lo + n > len(b) -> false
        else -> {
            (w, r) = fileapi.WriteFile(processenv.GetStdHandle(4294967285), b, lo, n, out minwindef.DWORD)
            r != 0
        }
    }
}

// A STRING AND A NEWLINE. A string is its UTF-8 bytes on this target, so the
// bytes are written as they are.
pub export fn print_str(s) (Bool) {
    u = str.utf8(s)
    write(u, 0, len(u))
    write(array { 10 }, 0, 1)
}

// AN INTEGER IN DECIMAL, AND A NEWLINE: render : ℤ → Σ*, render(n) = the sign
// of n and the digits of |n|, defined on every integer. The header claims ℤ,
// which has no end to enforce, so each call's facts choose the representation
// (ADR 0079): the signed word at most calls, the unsigned word at one whose
// value is in [0, 2⁶⁴) (a 64-bit hash), where the sign tests are decided false
// by the facts alone.
//
// The digits of |n| are produced least significant first, so they are stored
// backwards from the end of a 22-byte field, behind the newline at its end.
// A value of either word has at most 20 decimal digits (2⁶⁴ − 1 has 20), so the
// loop takes exactly 20 steps, k = 0 … 19, writing digit k at 20 − k, and `p`
// is the slot just before the most significant one: 19 − k for the last
// nonzero digit k, or 19 for n = 0. Every digit's index is linear in k, which
// the guard bounds, so each obligation is proven by the refinement layer as
// well as by the intervals: stopping when m reached 0 bounded the index only
// through the trip count, which the obligations at a call do not see
// (llvm-2026-11-02). The sign's slot p is proven by the invariant 0 <= p <= 19,
// which Houdini's templates give (0 <= v and the frame v <= z), where carrying
// the digit's own slot top = p + 1 needed 1 <= top, which no template states
// (a store owes its index since the book's finding 70). −2⁶³ has no negation in
// the word, and is its own clause; every other negative n is a sign and the
// digits of −n, at most 19.
pub fn print_int(n ∈ Int) (Bool) {
    case {
        n < -9223372036854775807 -> print_str("-9223372036854775808")
        else -> {
            (b, start) = {
                var b := array { 0 : _ ∈ 0..21 }
                b[21] := 10
                loop m = if n < 0 { 0 - n } else { n }, k = 0, p = 19 {
                    k > 19 && n < 0 -> { b[p] := 45; (b, p) }
                    k > 19 -> (b, p + 1)
                    else -> {
                        b[20 - k] := 48 + m % 10
                        again(m / 10, k + 1, if m > 0 { 19 - k } else { p })
                    }
                }
            }
            write(b, start, 22 - start)
        }
    }
}
