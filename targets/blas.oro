; A target that provides `dot` natively — the "compiling up" half of ADR 0002.
;
; It differs from targets/go.oro by ONE line. That line is the entire distinction
; between emitting a BLAS call and emitting a loop.

(target blas
  (type f64     "double")
  (type int     "int")
  (type vec-f64 "double*")

  (module num/f64
    (prim add (f64 f64) f64 expr "%s + %s" pure)
    (prim mul (f64 f64) f64 expr "%s * %s" pure))

  (prim alen   (vec-f64) int      expr "%s.n"    pure)
  (prim aindex (vec-f64 int) f64  expr "%s[%s]"  pure)

  (prim dot (vec-f64 vec-f64) f64 expr "cblas_ddot(%s.n, %s, 1, %s, 1)" pure)

  ; The same capability, declared as a member of a MODULE. A target provides
  ; whatever subset of a module it happens to have natively (modules.md §4), and
  ; the name it declares is the fully qualified one, so that P_T and the
  ; library's definitions key the same namespace — R1.
  (module num/vec
    (prim dot (vec-f64 vec-f64) f64 expr "cblas_ddot(%s.n, %s, 1, %s, 1)" pure))


  ; The four the BACKEND implements. No types: fold-range is
  ; A x int x ((A,int) -> A) -> A, which a monomorphic table cannot express,
  ; and writing one was a false statement (target-files.md §4).
  (structural let         let   pure)
  (structural loop        iterate pure)
  (structural fold-range  loop  pure)
  (structural fold-range2 loop2 pure)
  (structural make-vec     build pure))
