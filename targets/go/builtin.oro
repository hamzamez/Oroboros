; Go's predeclared identifiers and operators, under Go's own names.
;
;   (use go)
;   (go.+ x y)   (go./ a b)   (go.len s)   (go.delete m k)
;
; Nothing here is portable and nothing here claims to be. `go./` on ints
; truncates toward zero and panics on division by zero; `go.+` wraps at the
; width of its type. That is Go, and a program using it is a Go program.
;
; Where a Go name is polymorphic and our type table is not, the name is
; suffixed with the type it operates on — `go.at-float64`, `go.make-int`. Those
; suffixes are the type language's limitation showing through, and they are the
; main thing this experiment found. See docs/spec/target-native.md.

(target go
  ; ═══ HOW WIDE A SHIFT IS EXACT HERE
  ;
  ; `x / 2^k` on a SIGNED value is not a shift -- truncation toward zero needs
  ; a rounding correction -- so the compiler rewrites it into one wherever it
  ; can PROVE the dividend is non-negative and fits this many bits. Worth
  ; **2.39x** on our fixed-limb factorial (shiftdiv-2026-09-03).
  ;
  ; This does NOT promote bitwise operators to the language, and integers.md
  ; §0a's reason for keeping them out stands. It lets the COMPILER use this
  ; host's own shift where it has proved the rewrite changes no answer.
  ;
  ; Go's `>>` on an `int` is a 64-bit arithmetic shift, exact on every value
  ; the language can hold.
  (repr shift 63)

  (module go
    ; ---- arithmetic. One declaration per Go type, because the type language
    ; cannot say "any numeric T".
    ; The plain operators, and the CHECKED forms a declared range selects when
    ; the compiler cannot prove the result stays in the window (sct-2026-08-19).
    ;
    ; Go has NO overflow intrinsic — which is why overflow-2026-08-19 measured it
    ; at 2.61x against Java's 1.31x. The check is written as a func literal
    ; called immediately, so each operand appears ONCE and Go's inliner sees
    ; straight-line code. No runtime, no prelude, no support library.
    (sig +   (int int) int  pure             (host expr "%s + %s" (checked add-exact)))
    (sig -   (int int) int  pure             (host expr "%s - %s" (checked sub-exact)))
    (sig *   (int int) int  pure             (host expr "%s * %s" (checked mul-exact)))
    (sig add-exact (int int) int pure (host expr
        "func(a, b int) int { t := a + b; if (t > a) != (b > 0) { panic(\"int overflow\") }; return t }(%s, %s)"))
    (sig sub-exact (int int) int pure (host expr
        "func(a, b int) int { t := a - b; if (t < a) != (b > 0) { panic(\"int overflow\") }; return t }(%s, %s)"))
    (sig mul-exact (int int) int pure (host expr
        "func(a, b int) int { t := a * b; if a != 0 && t/a != b { panic(\"int overflow\") }; return t }(%s, %s)"))
    ; A ZERO DIVISOR IS A PRECONDITION, NOT A BEHAVIOUR (integers.md §5). Go
    ; panics, Java throws, x86 raises #DE — and JavaScript returns Infinity and
    ; keeps going, which is why specifying a value would mean emulating one
    ; everywhere. `d != 0` is a DISJUNCTION, discharged by case split against
    ; the conjunctive fragment that already exists.
    (sig /   ((a int) (b int)) int  pure (where (!= b 0))     (host expr "%s / %s"))
    (sig %   ((a int) (b int)) int pure (where (!= b 0))     (host expr "%s %% %s"))
    (sig f+  (f64 f64) f64  pure (host expr "%s + %s"))
    (sig f-  (f64 f64) f64  pure (host expr "%s - %s"))
    (sig f*  (f64 f64) f64  pure (host expr "%s * %s"))
    (sig f/  (f64 f64) f64  pure (host expr "%s / %s"))

    ; ---- bitwise
    (sig &   (int int) int  pure (host expr "%s & %s"))
    (sig |   (int int) int  pure (host expr "%s | %s"))
    (sig ^   (int int) int  pure (host expr "%s ^ %s"))
    (sig &^  (int int) int pure (host expr "%s &^ %s"))
    (sig <<  (int int) int pure (host expr "%s << %s"))
    (sig >>  (int int) int pure (host expr "%s >> %s"))

    ; ---- comparison. Go's == is defined on every comparable type, which a
    ; monomorphic table cannot say, so `any` stands where Go is polymorphic.
    (sig ==  (any any) bool pure (host expr "%s == %s"))
    (sig !=  (any any) bool pure (host expr "%s != %s"))
    (sig <   (int int) bool  pure (host expr "%s < %s"))
    (sig <=  (int int) bool pure (host expr "%s <= %s"))
    (sig >   (int int) bool  pure (host expr "%s > %s"))
    (sig >=  (int int) bool pure (host expr "%s >= %s"))
    (sig f<  (f64 f64) bool  pure (host expr "%s < %s"))
    (sig f<= (f64 f64) bool pure (host expr "%s <= %s"))
    (sig f>  (f64 f64) bool  pure (host expr "%s > %s"))
    (sig f>= (f64 f64) bool pure (host expr "%s >= %s"))
    (sig s<  (string string) bool  pure   (host expr "%s < %s"))

    ; ---- boolean
    (sig &&  (bool bool) bool pure (host expr "%s && %s"))
    (sig ||  (bool bool) bool pure (host expr "%s || %s"))
    (sig !   (bool) bool      pure      (host expr "!%s"))

    ; ---- predeclared constants

    ; ---- predeclared functions
    (sig len (any) int pure (host expr "len(%s)"))
    (sig cap (any) int pure (host expr "cap(%s)"))
    (sig min (int int) int pure (host expr "min(%s, %s)"))
    (sig max (int int) int pure (host expr "max(%s, %s)"))

    ; append may write into the argument's backing array, so it is NOT pure.
    (sig append-int     (slice-int int) slice-int             (host expr "append(%s, %s)"))
    (sig append-float64 (slice-float64 f64) slice-float64 (host expr "append(%s, %s)"))
    (sig append-string  (slice-string string) slice-string    (host expr "append(%s, %s)"))

    ; make: the element type is part of Go's syntax, so one name per type. Each
    ; result is n long, a postcondition (theories.md §7.9, §8.4).
    (sig make-int ((n int)) slice-int (ensures (= (len result) n)) (host expr "make([]int, %s)"))
    (sig make-int64 ((n int)) slice-int64 (ensures (= (len result) n)) (host expr "make([]int64, %s)"))
    (sig make-float64 ((n int)) slice-float64 (ensures (= (len result) n)) (host expr "make([]float64, %s)"))
    (sig make-string ((n int)) slice-string (ensures (= (len result) n)) (host expr "make([]string, %s)"))
    (sig make-bool ((n int)) slice-bool (ensures (= (len result) n)) (host expr "make([]bool, %s)"))
    (sig make-map     () map-string-int (host expr "make(map[string]int)"))

    (sig copy-float64 (slice-float64 slice-float64) int       (host expr "copy(%s, %s)"))
    (sig clear-map    (map-string-int) map-string-int         (host stmt "clear(%s)"))
    (sig delete       (map-string-int string) map-string-int  (host stmt "delete(%s, %s)"))
    (sig panic        (any) any (host stmt "panic(%s)"))
    (sig print        (any) any (host stmt "print(%s)"))
    (sig println      (any) any (host stmt "println(%s)"))

    ; ---- indexing and slicing. Go's own, with Go's own panic outside bounds,
    ; which is why the refinement is carried rather than assumed.
    (sig at-int     ((v slice-int) (i int)) int pure index
      (where (go.&& (go.<= 0 i) (go.< i (go.len v))))         (host expr "%s[%s]"))
    (sig at-float64 ((v slice-float64) (i int)) f64 pure index
      (where (go.&& (go.<= 0 i) (go.< i (go.len v)))) (host expr "%s[%s]"))
    (sig at-string  ((v slice-string) (i int)) string pure index
      (where (go.&& (go.<= 0 i) (go.< i (go.len v))))   (host expr "%s[%s]"))
    (sig at-bool    ((v slice-bool) (i int)) bool pure index
      (where (go.&& (go.<= 0 i) (go.< i (go.len v))))       (host expr "%s[%s]"))
    (sig at-map     (map-string-int string) int pure         (host expr "%s[%s]"))

    (sig set-int ((c slice-int) (i int) (x int)) slice-int (ensures (= (len result) (len c))) (host stmt "%s[%s] = %s"))
    (sig set-float64 ((c slice-float64) (i int) (x f64)) slice-float64 (ensures (= (len result) (len c))) (host stmt "%s[%s] = %s"))
    (sig set-string ((c slice-string) (i int) (x string)) slice-string (ensures (= (len result) (len c))) (host stmt "%s[%s] = %s"))
    (sig set-bool ((c slice-bool) (i int) (x bool)) slice-bool (ensures (= (len result) (len c))) (host stmt "%s[%s] = %s"))
    ; NO length postcondition here, and the omission is the point. An array store leaves
    ; the length alone, so `set-float64` passes its container's length through;
    ; a map INSERT can add a key, so `len(m)` after is not `len(m)` before.
    ; The two read identically in Go and are opposite facts.
    (sig set-map (map-string-int string int) map-string-int (host stmt "%s[%s] = %s"))

    ; Go's fused increment. `m[k]++` is ONE mapassign returning a value pointer;
    ; `m[k] = m[k] + 1` is a mapaccess AND a mapassign — the same key hashed
    ; twice. The g4 derivation claimed that and never measured it; it is worth
    ; 1.21x (native-gauntlet-2026-08-20 §4).
    ;
    ; Declaring it is the parasite rule, not a special case: emit at the highest
    ; layer the target natively provides. And it is the OPPOSITE of Java, where
    ; the fused `merge` loses 2.6x to unfused getOrDefault+put — which is why
    ; this is a per-target declaration and not a principle (ADR 0008).
    (sig inc-map (map-string-int string) map-string-int (host stmt "%s[%s]++"))

    (sig slice-float64 (slice-float64 int int) slice-float64 pure (host expr "%s[%s:%s]"))
    (sig slice-string  (slice-string int int) slice-string pure   (host expr "%s[%s:%s]"))

    ; ---- conversions. Go spells these T(x); each is its own name here.
    (sig int-of-float64  (f64) int     pure       (host expr "int(%s)"))
    (sig float64-of-int  (int) f64 pure       (host expr "float64(%s)"))
    (sig string-of-bytes (slice-byte) string  pure (host expr "string(%s)"))
    (sig bytes-of-string (string) slice-byte  pure (host expr "[]byte(%s)"))))
