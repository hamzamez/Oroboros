// encoding/hex, DECLARED BY HAND. Every claim below was read off
// src/encoding/hex/hex.go in the Go 1.27 toolchain; the algebra is in
// gauntlet/results/hex-2026-09-14.md §1, and the kinds of claim are the ones
// unicode/utf8.oro makes (pure, buffer, range, where), plus one it did not need:
// a precondition that is LINEAR in two lengths.
//
// THE ALGEBRA IN FOUR LINES.
//   B = [0,255], D = "0123456789abcdef", A = D ∪ "ABCDEF".
//   H : B* → D* is the monoid homomorphism generated by h(b) = d(b/16) d(b%16),
//       so |H(x)| = 2|x|: length is a homomorphism into (ℕ,+) and H doubles it.
//   G : A* ⇀ B* is defined exactly on words of even length over A, and
//       G∘H = id (H is injective and G is a left inverse);
//       H∘G ≠ id but (H∘G)∘(H∘G) = H∘G — a PROJECTION onto lowercase.
//   Off its domain G is total on a PREFIX: it returns the longest run of whole
//   pairs before the first bad byte, with n ≤ ⌊|src|/2⌋, and an error.
//
// The generator still spells the host's types; gauntlet/stdlib/tooling_test.go
// checks every declaration here against them, in both modules, and that none is
// missing.
module go/encoding/hex {
    use result
    // THIS PACKAGE'S OWN SORT. `io`'s three live in targets/go/io.oro, because a
    // type has one owner and this file declaring them recorded no dependency
    // (declaration-surface.md §4.2).
    set InvalidByteError = host "hex.InvalidByteError"

    // ---------------------------------------------------------- lengths
    // EncodedLen is the ℤ-linear map n ↦ 2n on Go's `int`, which is this
    // target's word [−2^63, 2^63−1] (ADR 0026). The word is NOT closed under
    // doubling, so the result is Go's `int` exactly on the PREIMAGE of the word,
    // −2^62 ≤ n ≤ 2^62 − 1 — asymmetric because two's complement is. That is
    // Go's OWN overflow boundary: past it `hex.EncodedLen` wraps silently, and
    // this `where` is the one fact about the function Go leaves unchecked, which
    // the compiler now proves at every call. (Under ADR 0012's window it was
    // |n| ≤ 2^52 − 1, a precondition Go does not have.)
    //
    // THE MAP ITSELF IS THE `ensures`, since a comment carries no meaning (ADR
    // 0024): with it, a buffer sized `(hex.EncodedLen (len src))` — the size Go's
    // own documentation allocates — satisfies Encode's 2·len src ≤ len dst.
    // Without it the call was an atom nothing related to 2n, and that idiom was
    // refused (postconditions.md §5).
    fn EncodedLen(n ∈ Int) (r ∈ Int) pure
        where (-2^62) <= n && n <= (2^62-1)
        ensure r == 2 * n {
        host expr "hex.EncodedLen(${n})" import "encoding/hex"
    }

    // DecodedLen is x ↦ x/2, truncating, which the word IS closed under; `/`
    // truncates as Go's does, so the `ensures` is the law exactly, and the
    // fragment reads the quotient as an atom with its floor facts.
    fn DecodedLen(x ∈ Int) (r ∈ Int) pure
        ensure r == x / 2 {
        host expr "hex.DecodedLen(${x})" import "encoding/hex"
    }

    // ---------------------------------------------------------- H into a buffer
    // A WRITE-BORROW, B ⊸ B ⊗ int. The host writes dst[0 .. 2|src|) — it indexes
    // dst[j] and dst[j+1] for every source byte and checks nothing — so the
    // exact requirement is 2·len src ≤ len dst, which is LINEAR and therefore
    // stated exactly rather than conservatively. The count is always 2|src|
    // ("this value is always EncodedLen(len(src))"), and 2|src| ≤ len dst ≤
    // 2^63 − 1 with 2|src| even, so it is at most 2^63 − 2.
    fn Encode(dst ∈ Array(0..255) linear, src ∈ Array(0..255)) (n ∈ 0..9223372036854775806)
        where 2 * len(src) <= len(dst) ensure len(dst') == len(dst) && n == 2 * len(src) {
        host expr "hex.Encode(${dst}, ${src})" import "encoding/hex"
    }

    // CONSUME AND RETURN, B ⊸ B: appends H(src) to dst, growing it when it must
    // (slices.Grow), so dst is dead either way.
    fn AppendEncode(dst ∈ Array(0..255) linear, src ∈ Array(0..255)) (dst' ∈ buffer(0..255))
        ensure len(dst') == len(dst) + 2 * len(src) {
        host expr "hex.AppendEncode(${dst}, ${src})" import "encoding/hex"
    }

    // H to text. Allocates its own storage and writes nothing it was handed.
    fn EncodeToString(src ∈ Array(0..255)) (String) pure {
        host expr "hex.EncodeToString(${src})" import "encoding/hex"
    }

    // ---------------------------------------------------------- G
    // A WRITE-BORROW with a fallible result, B ⊸ B ⊗ int ⊗ error. The host writes
    // dst[i] for i < ⌊len src / 2⌋ and no further, so the exact requirement is
    // ⌊s/2⌋ ≤ d, which over the integers is s ≤ 2d + 1 — linear again. The count
    // is the number of whole pairs decoded before the first bad byte.
    fn Decode(dst ∈ Array(0..255) linear, src ∈ Array(0..255)) (n ∈ 0..2^62-1, r ∈ result.result((), error))
        where len(src) <= 2 * len(dst) + 1 ensure len(dst') == len(dst) {
        host expr "hex.Decode(${dst}, ${src})" import "encoding/hex"
    }

    // CONSUME AND RETURN with a fallible result: the decoded prefix is appended
    // either way.
    fn AppendDecode(dst ∈ Array(0..255) linear, src ∈ Array(0..255))
            (dst' ∈ buffer(0..255), r ∈ result.result((), error)) ensure len(dst') >= len(dst) {
        host expr "hex.AppendDecode(${dst}, ${src})" import "encoding/hex"
    }

    // G from text into fresh storage: the prefix it decoded, and the error.
    fn DecodeString(s ∈ bytestring) (Array(0..255) × result.result((), error)) pure {
        host expr "hex.DecodeString(${s})" import "encoding/hex"
    }

    // ---------------------------------------------------------- hexdump -C
    // A pure function of its bytes; the empty input gives "".
    fn Dump(data ∈ Array(0..255)) (String) pure {
        host expr "hex.Dump(${data})" import "encoding/hex"
    }

    // ---------------------------------------------------------- streams
    // NOT pure, though they write nothing yet: each call allocates a fresh
    // object with MUTABLE state (a buffer, a byte count, a closed flag), so two
    // calls are two objects and substituting one for the other is observable.
    // Generativity is an effect exactly when the generated thing can be told
    // apart, which is Pitts & Stark's ν-calculus (1993); DecodeString's fresh
    // slice cannot be, because the program only ever reads it.
    fn NewEncoder(w ∈ `go/io`.Writer) (`go/io`.Writer) {
        host expr "hex.NewEncoder(${w})" import "encoding/hex"
    }
    fn NewDecoder(r ∈ `go/io`.Reader) (`go/io`.Reader) {
        host expr "hex.NewDecoder(${r})" import "encoding/hex"
    }
    fn Dumper(w ∈ `go/io`.Writer) (`go/io`.WriteCloser) {
        host expr "hex.Dumper(${w})" import "encoding/hex"
    }

    // THE ERROR TYPE'S ONE METHOD, and it is written INSIDE its package: a child
    // module's path is its parent's followed by its own, so this is
    // `go/encoding/hex/InvalidByteError` (spec/target-files.md §1a). A child
    // named like a type in its parent IS that type's method set.
    module InvalidByteError {
        fn Error(self ∈ InvalidByteError) (String) pure {
            host expr "${self}.Error()" import "encoding/hex"
        }
    }
}
