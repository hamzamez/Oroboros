; Go's `fmt`: formatting and printing, under Go's names.
;
;   (use go/fmt)
;   (fmt.Println x)   (fmt.SprintfAll "%d of %d" (array i n))   ((fmt.Fprintln w x) (fn (n err) …))
;
; THE ALGEBRA, BEFORE THE NAMES. fmt is one function and four uses of it:
;
;   F : Format × Value* → B*        the formatting (Sprintf; Sprint is F with the
;                                   default verb, Sprintln with spaces and "\n")
;   Print  = write stdout ∘ F       Fprint = write w ∘ F       Errorf = error ∘ F
;   Append = (b ↦ b · F) on a buffer, B ⊸ B, as hex.AppendEncode
;
; Every one is VARIADIC over Go's `any`, f : Value* → B, and Go's `any` is the
; EMPTY INTERFACE, ∃X. X, a box holding a value and its type (go.oro, and
; spec/types.md §3.3). That is a type, as the language's `any` is not: ours is
; the absence of a claim, filled in at each call. So each function is declared
; twice, each declaration exact:
;
;   - UNDER GO'S NAME, ONE VALUE: the restriction f|Value¹, with the operand
;     `any`, filled in at the call, which Go boxes at its own call. 220 of the
;     corpus's 231 print calls pass one value, and they read `(fmt.Println x)`.
;   - UNDER NAME-All, ANY NUMBER: f itself, the free monoid Value* as a table of
;     boxes, `(array go.Value)`, spread into Go's call, `fmt.Println(v...)`, as
;     a variadic over one type is (strings.oro's NewReplacer). Every type held
;     as one host value enters a box (types.md §3.3), so `(array 42 "x" true)`
;     written at the call is Go's `[]any{42, "x", true}`; `-gcflags=-m` shows Go
;     treating it as its own call's table, which does not escape
;     (variadic-2026-10-08). The empty table is the empty call.
;
; The checker compares the first with the manifest's variadic at arity 1 and the
; second with its `...any` as a table (gauntlet/stdlib/tooling_test.go). The
; restrictions at 2 and 3, named B2 and B3, stood here until variadic-2026-10-08,
; with a wall at four operands.
;
; WHAT A BOX SHOWS: formatting through it sees the host value, so a verb that
; tells representations apart tells ours apart (`%x` on a table whose element
; width the compiler chose). Println's default verb does not. Tier 2.
;
; PRINT, PRINTLN AND PRINTF ARE STATEMENTS: their value is their first argument,
; and Go's (n int, err error) are discarded — the restriction composed with the
; projection that forgets them. So a failed write to standard output is not
; observable through them; a program that must see it writes with
; (fmt.Fprintln (os.Stdout) …), which hands the pair back.
;
; SPRINT'S RESULT IS THE HOST'S STRING (ADR 0030): a value may itself be host
; bytes and %s prints them raw. THE FORMAT IS THE HOST'S STRING TOO: Go reads
; any bytes as a format, and no result's claim depends on it being ours. It is
; pure: equal operands, equal strings, and strings compare by content.
;
; ERRORF IS NOT PURE, which it was declared until gotarget-2026-09-30. Each call
; allocates a new error, and Go's == on errors is identity: with e bound once,
; (== e e) is true, and with the call duplicated, (== (Errorf …) (Errorf …)) is
; false. Purity licenses duplication (ADR 0010), so a value with identity is
; not pure, which is why `alloc` and `build` are not either.
;
; APPEND CONSUMES ITS BUFFER AND RETURNS IT, B ⊸ B: b grown when it must, and
; dead either way, as hex.AppendEncode's.
;
; WHAT IS NOT DECLARED, and why:
;   - the SCAN family (Scan, Scanln, Scanf, Sscan…, Fscan…): each stores what it
;     reads through a pointer; out-parameters, I in gocoverage-2026-10-06, next;
;   - FormatString, and the Formatter, GoStringer and State interfaces, which
;     only a callback could implement.

(target go
  (module go/fmt
    (use result)
    (type Stringer (host "fmt.Stringer"))
    (module Stringer
      (sig String ((self Stringer)) bytestring (host expr "%s.String()")))

    ; ---------------------------------------------------------- to standard output
    (sig Print      ((a any)) any                                    (host stmt "fmt.Print(%s)" (import "fmt")))
    (sig PrintAll   ((a (array go.Value))) any                       (host stmt "fmt.Print(%s...)" (import "fmt")))
    (sig Println    ((a any)) any                                    (host stmt "fmt.Println(%s)" (import "fmt")))
    (sig PrintlnAll ((a (array go.Value))) any                       (host stmt "fmt.Println(%s...)" (import "fmt")))
    (sig Printf     ((format bytestring) (a any)) any                (host stmt "fmt.Printf(%s, %s)" (import "fmt")))
    (sig PrintfAll  ((format bytestring) (a (array go.Value))) any   (host stmt "fmt.Printf(%s, %s...)" (import "fmt")))

    ; ------------------------------------------------------------- to a string
    (sig Sprint      ((a any)) bytestring pure                                  (host expr "fmt.Sprint(%s)" (import "fmt")))
    (sig SprintAll   ((a (array go.Value))) bytestring pure                     (host expr "fmt.Sprint(%s...)" (import "fmt")))
    (sig Sprintln    ((a any)) bytestring pure                                  (host expr "fmt.Sprintln(%s)" (import "fmt")))
    (sig SprintlnAll ((a (array go.Value))) bytestring pure                     (host expr "fmt.Sprintln(%s...)" (import "fmt")))
    (sig Sprintf     ((format bytestring) (a any)) bytestring pure              (host expr "fmt.Sprintf(%s, %s)" (import "fmt")))
    (sig SprintfAll  ((format bytestring) (a (array go.Value))) bytestring pure (host expr "fmt.Sprintf(%s, %s...)" (import "fmt")))

    ; ------------------------------------------------------------- to a buffer
    (sig Append      ((b (buffer (int 0 255))) (a any)) (buffer (int 0 255))
      (host expr "fmt.Append(%s, %s)" (import "fmt")))
    (sig AppendAll   ((b (buffer (int 0 255))) (a (array go.Value))) (buffer (int 0 255))
      (host expr "fmt.Append(%s, %s...)" (import "fmt")))
    (sig Appendln    ((b (buffer (int 0 255))) (a any)) (buffer (int 0 255))
      (host expr "fmt.Appendln(%s, %s)" (import "fmt")))
    (sig AppendlnAll ((b (buffer (int 0 255))) (a (array go.Value))) (buffer (int 0 255))
      (host expr "fmt.Appendln(%s, %s...)" (import "fmt")))
    (sig Appendf     ((b (buffer (int 0 255))) (format bytestring) (a any)) (buffer (int 0 255))
      (host expr "fmt.Appendf(%s, %s, %s)" (import "fmt")))
    (sig AppendfAll  ((b (buffer (int 0 255))) (format bytestring) (a (array go.Value))) (buffer (int 0 255))
      (host expr "fmt.Appendf(%s, %s, %s...)" (import "fmt")))

    ; ------------------------------------------------------------- to a Writer
    ; The pair is handed back: n, the bytes written, and the write's error.
    (sig Fprint      ((w go/io.Writer) (a any)) (tuple (int 0 9223372036854775807) (result.result (tuple) error))
      (host expr "fmt.Fprint(%s, %s)" (import "fmt")))
    (sig FprintAll   ((w go/io.Writer) (a (array go.Value))) (tuple (int 0 9223372036854775807) (result.result (tuple) error))
      (host expr "fmt.Fprint(%s, %s...)" (import "fmt")))
    (sig Fprintln    ((w go/io.Writer) (a any)) (tuple (int 0 9223372036854775807) (result.result (tuple) error))
      (host expr "fmt.Fprintln(%s, %s)" (import "fmt")))
    (sig FprintlnAll ((w go/io.Writer) (a (array go.Value))) (tuple (int 0 9223372036854775807) (result.result (tuple) error))
      (host expr "fmt.Fprintln(%s, %s...)" (import "fmt")))
    (sig Fprintf     ((w go/io.Writer) (format bytestring) (a any)) (tuple (int 0 9223372036854775807) (result.result (tuple) error))
      (host expr "fmt.Fprintf(%s, %s, %s)" (import "fmt")))
    (sig FprintfAll  ((w go/io.Writer) (format bytestring) (a (array go.Value))) (tuple (int 0 9223372036854775807) (result.result (tuple) error))
      (host expr "fmt.Fprintf(%s, %s, %s...)" (import "fmt")))

    ; ------------------------------------------------------------------ errors
    ; Not pure: each call is a new error, and == on errors is identity.
    (sig Errorf    ((format bytestring) (a any)) error                (host expr "fmt.Errorf(%s, %s)" (import "fmt")))
    (sig ErrorfAll ((format bytestring) (a (array go.Value))) error   (host expr "fmt.Errorf(%s, %s...)" (import "fmt"))))

  ; A Builder's String is fmt.Stringer's method (Go's method set).
  (implements go/strings.Builder go/fmt.Stringer))
