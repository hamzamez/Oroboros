; The whole of Go's `fmt`, under Go's own names.
;
;   (use go/fmt)
;   (fmt.Println x)   (fmt.Sprintf "%d items" n)   (fmt.Errorf …)
;
; Names are Go's exactly, capital letters included — the reader keeps case and
; case never assigns meaning (core-0 §1.1), so `fmt.Println` is a name like any
; other and needs no translation table.
;
; This is the first target module written to cover a whole host package rather
; than the one function a program happened to need. What it could not express
; is the finding, and it is recorded in docs/spec/target-native.md:
;
;   - VARIADICS. Every Print/Sprint/Errorf in Go is `(a ...any)`. Our arity is
;     fixed, so each is declared at the arities programs use — 1, 2 and 3 — and
;     `Printf` with four operands cannot be called at all.
;   - MULTIPLE RETURNS. Fprintf returns (int, error) and Sscan returns
;     (int, error); both are declared for their first result only, so the error
;     is unreachable. That is the fourth demand for a product.
;   - io.Writer. Fprint* take one, and there is no way to name an interface, so
;     the whole F-family is absent.

(target go
  (module go/fmt
    ; ---- printing to stdout. Impure, and `stmt` because the value is a count
    ; nobody uses.
    (sig Println  (any) any         (host stmt "fmt.Println(%s)" (import "fmt")))
    (sig Println2 (any any) any     (host stmt "fmt.Println(%s, %s)" (import "fmt")))
    (sig Println3 (any any any) any (host stmt "fmt.Println(%s, %s, %s)" (import "fmt")))
    (sig Print    (any) any         (host stmt "fmt.Print(%s)" (import "fmt")))
    (sig Print2   (any any) any     (host stmt "fmt.Print(%s, %s)" (import "fmt")))
    (sig Printf   (string any) any  (host stmt "fmt.Printf(%s, %s)" (import "fmt")))
    (sig Printf2  (string any any) any     (host stmt "fmt.Printf(%s, %s, %s)" (import "fmt")))
    (sig Printf3  (string any any any) any (host stmt "fmt.Printf(%s, %s, %s, %s)" (import "fmt")))

    ; ---- formatting to a string. Pure: same operands, same string, no effect.
    ; The HOST's string (ADR 0030): an `any` argument may itself be host bytes,
    ; and `%s` prints a byte slice raw, so the result need not be valid UTF-8.
    (sig Sprint    (any) go.bytestring            pure             (host expr "fmt.Sprint(%s)" (import "fmt")))
    (sig Sprint2   (any any) go.bytestring        pure         (host expr "fmt.Sprint(%s, %s)" (import "fmt")))
    (sig Sprintln  (any) go.bytestring          pure             (host expr "fmt.Sprintln(%s)" (import "fmt")))
    (sig Sprintf   (string any) go.bytestring       pure      (host expr "fmt.Sprintf(%s, %s)" (import "fmt")))
    (sig Sprintf2  (string any any) go.bytestring   pure  (host expr "fmt.Sprintf(%s, %s, %s)" (import "fmt")))
    (sig Sprintf3  (string any any any) go.bytestring pure
                    (host expr "fmt.Sprintf(%s, %s, %s, %s)" (import "fmt")))

    ; ---- errors
    (sig Errorf   (string any) error     pure      (host expr "fmt.Errorf(%s, %s)" (import "fmt")))
    (sig Errorf2  (string any any) error pure  (host expr "fmt.Errorf(%s, %s, %s)" (import "fmt")))

    ; ---- scanning from stdin. Go returns (n, err); only n is reachable.
    (sig Scanln (any) int (host expr "func() int { n, _ := fmt.Scanln(%s); return n }()"
                   (import "fmt")))))
