; The Go target. NO PORTABILITY CLAIM.
;
; Every name here is Go's own name with Go's own semantics. `go.+` is Go's `+`,
; on Go's types, with Go's overflow. `go./` on integers truncates toward zero
; and panics on zero, because that is what Go does. Nothing is renamed to make
; three hosts agree, because nothing here claims they do.
;
; This file is the target's HEADER: types and the
; toolchain. The rest of the surface is one file per Go package, merged by
; LoadTarget — targets are directories (docs/spec/target-files.md).
;
; What the portable layer used to provide lives in targets/portable-go.oro,
; kept for the gauntlet. See docs/spec/portability-layer.md for what it cost.

(target go
  ; Go's own type names, except where our type language cannot spell them.
  ; It has NO CONSTRUCTORS: `[]T` is not a type applied to an argument, so each
  ; instantiation needs a name of its own. That is the first thing this target
  ; cannot say, and it is recorded rather than worked around.
  ; How this target spells an array of something. ONE declaration replaces an
  ; entry per element type — see docs/spec/tables.md §10.
  ; WHAT THIS TARGET CAN STORE AN INTEGER IN, narrowest first (ADR 0003).
  ; A range type selects the first one that CONTAINS it, and a table is the only
  ; place the width is consulted -- a value read out of a byte array is an
  ; integer everywhere it is used.
  (repr (int 0 255) (host "byte"))
  (repr (int -128 127) (host "int8"))
  (repr (int 0 65535) (host "uint16"))
  (repr (int -32768 32767) (host "int16"))
  (repr (int 0 4294967295) (host "uint32"))
  (repr (int -2147483648 2147483647) (host "int32"))

  (type (array A) (host "[]%s"))
  (type (map K V) (host "map[%s]%s"))

  (type int      (host "int"))
  (type int64    (host "int64"))
  (type f64  (host "float64"))
  (type string   (host "string"))
  (type bool     (host "bool"))
  (type byte     (host "byte"))
  (type rune     (host "rune"))
  (type error    (host "error"))
  (type any      (host "any"))

  ; ═══ GO'S INTEGER TYPES ARE RANGES — ADR 0003, said in the type language
  ;
  ; MANIFEST types: a definiens and no realization (theories.md §2 at the type
  ; level), so `int32` MEANS the interval and δ erases the name before anything
  ; downstream sees it. `int` and `int64` are deliberately absent and that is
  ; ADR 0012 rather than an omission: a range past the portable window would
  ; promote the value to arbitrary precision and stop it being the host's word,
  ; so they stay the language's `int`, which is what the `(type int …)` above
  ; realizes.
  (type int8   (int -128 127))
  (type int16  (int -32768 32767))
  (type int32  (int -2147483648 2147483647))
  (type uint8  (int 0 255))
  (type uint16 (int 0 65535))
  (type uint32 (int 0 4294967295))

  (type slice-int     (host "[]int"))
  (type slice-int64   (host "[]int64"))
  (type slice-float64 (host "[]float64"))
  (type slice-string  (host "[]string"))
  (type slice-bool    (host "[]bool"))
  (type slice-byte    (host "[]byte"))
  (type slice-any     (host "[]any"))
  (type map-string-int    (host "map[string]int"))
  (type map-string-string (host "map[string]string"))

  ; Restricting a container to a known length, so Go's own bounds-check
  ; elimination has a proof (bce-2026-08-15.md).
  (repr narrow (host "%s := %s[:%s]"))

  (build "go build -o %s %s")

  ; THE STRUCTURAL SET IS ZERO. `if`, `let` and `loop` are the LANGUAGE's and are
  ; injected into every target; declaring one is an error. The backend implements
  ; them, which is where an implementation belongs — a construct promoted to the
  ; language works on every target and the compiler finds the form.
  ;
  ; `fold-range` and `fold-range2` are absent because `loop` subsumes both
  ; (ADR 0015). `make-vec` is absent for two reasons: a `loop` over
  ; `go.make-float64` and `go.set-float64` emits the same `make` plus fill loop,
  ; and `make-vec` is hardcoded to the PORTABLE layer's type names — it produces
  ; `vec-f64` and demands `f64` elements, so on a target whose types are Go's it
  ; cannot be called at all.
  ;
  ; So a program here is: fn, def, module, literals, and let / if / loop.
)
