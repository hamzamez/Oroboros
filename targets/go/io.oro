// Go's `io`: byte streams, under Go's names.
//
//   (use go/io)
//   ((io.ReadAll r) (fn (bytes err) …))    ((io.Copy w r) (fn (n err) …))
//
// A module is a signature Σ = (S, Ω), its sorts and the operations over them. A
// type has ONE owner (theories.md §3.2): `io`'s interfaces are declared here and
// nowhere else, and an interface's method set is its COMPANION, the child module
// of its name (theories.md §3.3). `include` is inclusion of those theories: a
// WriteCloser has a Writer's operations and a Closer's.
//
// THE ALGEBRA, BEFORE THE NAMES. Every claim was read off src/io/io.go.
//
// - A READER is a stream consumed in pieces. Read p fills p[0, n) with
//   0 ≤ n ≤ len p, and n > 0 delivers bytes even when an error comes with them;
//   EOF is the one error that means the stream ended, not that it failed.
// - A WRITER writes b and reports n, with n < len b ⇒ err ≠ nil.
// - ReadFull fills EXACTLY len p or fails (ErrUnexpectedEOF after some bytes, EOF
//   after none); ReadAtLeast r p min reads until n ≥ min, and gives
//   ErrShortBuffer, not a panic, when min > len p. So neither needs a
//   precondition.
// - Copy w r is the fold of Read into Write until EOF, whose count is every byte
//   written and whose error is never EOF. CopyN w r n copies exactly n, or fails.
// - LimitReader, TeeReader and NopCloser are stream TRANSFORMERS: a Reader of at
//   most n bytes, a Reader that writes what it reads to w, a ReadCloser whose
//   Close does nothing.
// - Pipe is a synchronous channel: a Write blocks until Reads consume it.
// - MultiReader r₁ … rₙ is the CONCATENATION of streams, the monoid on readers
//   whose unit is the empty reader (n = 0 gives EOF at once): it reads r₁ to EOF,
//   then r₂, and so on. MultiWriter w₁ … wₙ is the FAN-OUT: each Write goes to
//   every wᵢ in order, and the first error stops it (ErrShortWrite on a short
//   count). Both are variadic over one type, ...Reader and ...Writer, the free
//   monoid on the interface, so each is ONE declaration over a table, spread
//   into Go's call (strings.oro's NewReplacer, variadic-2026-10-08). The table
//   is shared: Go copies it into its own (`make` and `copy`; MultiWriter builds a
//   new slice, flattening nested ones) and never writes it. A table of concrete
//   readers is NOT a table of Readers: Go's slices are not covariant, since a
//   pointer and an interface value are represented differently, so the element
//   conversion would be a copy. A table written at the call is built at the
//   declared element; one bound to a name keeps its elements' type, and is
//   refused here.
//
// EOF and the other errors are package VARIABLES, which the survey does not
// generate; they are declared here, as values, since a program tests
// `(go.== err (io.EOF))` — Go's == on two error values, identity.
//
// WHAT IS NOT DECLARED, of the 32 declarations the survey generates for io:
//   - CopyBuffer: its buffer is scratch the host may overwrite, a write-borrow
//     whose contents afterwards mean nothing; left until a program needs it;
//   - SectionReader and NewSectionReader, OffsetWriter and NewOffsetWriter,
//     LimitedReader's literal, and their 9 methods: they need ReaderAt and
//     WriterAt, not declared;
// And not surveyed at all: the interfaces' methods, which a generated file
// never declares. They are checked against the manifest's own interface lines
// instead (gauntlet/stdlib/tooling_test.go).
module go/io {
    use result
    // ---------------------------------------------------------------- the sorts
    set Reader = host "io.Reader"
    set Writer = host "io.Writer"
    set Closer = host "io.Closer"
    set ReadCloser = host "io.ReadCloser"
    set WriteCloser = host "io.WriteCloser"
    set ReadWriter = host "io.ReadWriter"
    set ByteReader = host "io.ByteReader"
    set ByteWriter = host "io.ByteWriter"
    set StringWriter = host "io.StringWriter"
    set PipeReader = host "*io.PipeReader"
    set PipeWriter = host "*io.PipeWriter"

    // ------------------------------------------------------ the interfaces' Ω
    // A write-borrow, B ⊸ B ⊗ int ⊗ error, as os's File.Read.
    module Reader {
        use result
        fn Read(self ∈ Reader, p ∈ Array(0..255) linear) (n ∈ 0..2^63-1, r ∈ result.result((), error))
                ensure n <= len(p') && len(p') == len(p) {
            host expr "${self}.Read(${p})"
        }
    }
    module Writer {
        use result
        fn Write(self ∈ Writer, p ∈ Array(0..255)) (0..2^63-1 × result.result((), error)) {
            host expr "${self}.Write(${p})"
        }
    }
    module Closer {
        use result
        fn Close(self ∈ Closer) (result.result((), error)) { host expr "${self}.Close()" }
    }
    module ReadCloser {
        include `go/io/Reader` `go/io/Closer`
    }
    module WriteCloser {
        include `go/io/Writer` `go/io/Closer`
    }
    module ReadWriter {
        include `go/io/Reader` `go/io/Writer`
    }
    module ByteReader {
        use result
        fn ReadByte(self ∈ ByteReader) (result.result(0..255, error)) {
            host expr "${self}.ReadByte()"
        }
    }
    module ByteWriter {
        use result
        fn WriteByte(self ∈ ByteWriter, c ∈ 0..255) (result.result((), error)) {
            host expr "${self}.WriteByte(uint8(${c}))"
        }
    }
    module StringWriter {
        use result
        fn WriteString(self ∈ StringWriter, s ∈ bytestring) (0..2^63-1 × result.result((), error)) {
            host expr "${self}.WriteString(${s})"
        }
    }

    // ------------------------------------------------------------- the errors
    fn EOF() (error) pure { host expr "io.EOF" import "io" }
    fn ErrUnexpectedEOF() (error) pure { host expr "io.ErrUnexpectedEOF" import "io" }
    fn ErrShortBuffer() (error) pure { host expr "io.ErrShortBuffer" import "io" }
    fn ErrShortWrite() (error) pure { host expr "io.ErrShortWrite" import "io" }
    fn ErrClosedPipe() (error) pure { host expr "io.ErrClosedPipe" import "io" }
    fn ErrNoProgress() (error) pure { host expr "io.ErrNoProgress" import "io" }
    // A Writer that accepts everything and keeps nothing.
    fn Discard() (Writer) pure { host expr "io.Discard" import "io" }

    // ---------------------------------------------------------------- whence
    SeekStart ∈ set { 0 } = host "io.SeekStart" import "io"
    SeekCurrent ∈ set { 1 } = host "io.SeekCurrent" import "io"
    SeekEnd ∈ set { 2 } = host "io.SeekEnd" import "io"

    // ------------------------------------------------------------ the folds
    // Copy's count is every byte written, never negative.
    fn Copy(dst ∈ Writer, src ∈ Reader) (0..2^63-1 × result.result((), error)) {
        host expr "io.Copy(${dst}, ${src})" import "io"
    }
    fn CopyN(dst ∈ Writer, src ∈ Reader, n ∈ -2^63..2^63-1) (0..2^63-1 × result.result((), error)) {
        host expr "io.CopyN(${dst}, ${src}, int64(${n}))" import "io"
    }
    fn ReadAll(r ∈ Reader) (Array(0..255) × result.result((), error)) {
        host expr "io.ReadAll(${r})" import "io"
    }
    // Write-borrows: the host fills buf and returns the count.
    fn ReadFull(r ∈ Reader, buf ∈ Array(0..255) linear) (n ∈ 0..2^63-1, e ∈ result.result((), error))
            ensure n <= len(buf') && len(buf') == len(buf) {
        host expr "io.ReadFull(${r}, ${buf})" import "io"
    }
    fn ReadAtLeast(r ∈ Reader, buf ∈ Array(0..255) linear, min ∈ Int)
            (n ∈ 0..2^63-1, e ∈ result.result((), error)) ensure n <= len(buf') && len(buf') == len(buf) {
        host expr "io.ReadAtLeast(${r}, ${buf}, ${min})" import "io"
    }
    fn WriteString(w ∈ Writer, s ∈ bytestring) (0..2^63-1 × result.result((), error)) {
        host expr "io.WriteString(${w}, ${s})" import "io"
    }

    // ------------------------------------------------------- the transformers
    // Spreads: the streams in a table (the header). Each returns a new stateful
    // stream, so neither is pure.
    fn MultiReader(readers ∈ Array(Reader)) (Reader) variadic {
        host expr "io.MultiReader(${readers}...)" import "io"
    }
    fn MultiWriter(writers ∈ Array(Writer)) (Writer) variadic {
        host expr "io.MultiWriter(${writers}...)" import "io"
    }
    fn LimitReader(r ∈ Reader, n ∈ -2^63..2^63-1) (Reader) {
        host expr "io.LimitReader(${r}, int64(${n}))" import "io"
    }
    fn TeeReader(r ∈ Reader, w ∈ Writer) (Reader) {
        host expr "io.TeeReader(${r}, ${w})" import "io"
    }
    fn NopCloser(r ∈ Reader) (ReadCloser) { host expr "io.NopCloser(${r})" import "io" }

    // ------------------------------------------------------------------ Pipe
    fn Pipe() (PipeReader × PipeWriter) { host expr "io.Pipe()" import "io" }
    module PipeReader {
        use result
        fn Read(self ∈ PipeReader, p ∈ Array(0..255) linear) (n ∈ 0..2^63-1, r ∈ result.result((), error))
                ensure n <= len(p') && len(p') == len(p) {
            host expr "${self}.Read(${p})" import "io"
        }
        fn Close(self ∈ PipeReader) (result.result((), error)) {
            host expr "${self}.Close()" import "io"
        }
        fn CloseWithError(self ∈ PipeReader, err ∈ error) (result.result((), error)) {
            host expr "${self}.CloseWithError(${err})" import "io"
        }
    }
    module PipeWriter {
        use result
        fn Write(self ∈ PipeWriter, b ∈ Array(0..255)) (0..2^63-1 × result.result((), error)) {
            host expr "${self}.Write(${b})" import "io"
        }
        fn Close(self ∈ PipeWriter) (result.result((), error)) {
            host expr "${self}.Close()" import "io"
        }
        fn CloseWithError(self ∈ PipeWriter, err ∈ error) (result.result((), error)) {
            host expr "${self}.CloseWithError(${err})" import "io"
        }
    }

    axiom PipeReader ⊆ `go/io`.Reader ∩ `go/io`.Closer ∩ `go/io`.ReadCloser
    axiom PipeWriter ⊆ `go/io`.Writer ∩ `go/io`.Closer ∩ `go/io`.WriteCloser
    axiom ReadCloser ⊆ `go/io`.Reader ∩ `go/io`.Closer
    axiom WriteCloser ⊆ `go/io`.Writer ∩ `go/io`.Closer
    axiom ReadWriter ⊆ `go/io`.Reader ∩ `go/io`.Writer
}
