; Go's `strings`, under Go's own names.
;
;   (use go/strings)
;   (strings.Fields text)   (strings.ToLower s)   (strings.Contains s sub)
;
; Written because gauntlet program 4 — word frequency — could not move to the
; native target without it. The native Go target had NO string surface at all:
; `builtin.oro` declares `s<` and `string-of-bytes` and nothing else, so a
; program that wanted to split text had to stay on the portable layer.
;
; The pass condition for g4 was never a number. It is that the Go output uses
; Go's own `map[string]int` and Go's own splitting, which is what this file is
; for (docs/gauntlet.md).
;
; What this package could NOT express, recorded rather than worked around:
;
;   - `strings.Cut` returns (before, after, found) — three results. The fourth,
;     fifth and sixth demand for a product; see target-native.md.
;   - `strings.Builder` is a mutable struct with methods. There is no way to
;     name a struct type or call a method, so the whole Builder API is absent
;     and `Join` is what replaces it.
;   - `SplitN`, `Replace` and friends taking a count are fine; the ones taking
;     a `func(rune) bool` — `FieldsFunc`, `TrimFunc`, `IndexFunc` — are not,
;     because a surviving lambda is an escaping closure (derivation s6, and
;     docs/spec/callbacks.md for what that does and does not cost) and the
;     core does not have one.
;
; `Fields` splits on runs of white space as defined by `unicode.IsSpace`. That
; is GO's definition, not a portable one, which is exactly the point of a
; target-native module: `split-words` on the portable layer passed every check
; for two months while returning different answers on different targets
; (primitives.md). Here there is no claim to break.

(target go
  (module go/strings
    ; ---- splitting and joining
    ; ---- the free monoid (string-operations.md §1)
    ;
    ; CONCATENATION is the monoid's operation and `""` its unit. Found by
    ; spelling, so this file says how Go does it and nothing in the compiler
    ; learns that Go spells it `+`.
    (sig concat (string string) string pure (host expr "%s + %s"))

    ; η : Scalar → Scalar*, the generator injection — the string of one scalar.
    ; With `concat` and `""` it builds any string, which is what "free" means.
    (sig string-of (int) string pure (host expr "string(rune(%s))"))

    (sig Fields   (string) slice-string      pure          (host expr "strings.Fields(%s)" (import "strings")))
    (sig Split    (string string) slice-string   pure   (host expr "strings.Split(%s, %s)" (import "strings")))
    (sig SplitN   (string string int) slice-string pure
                   (host expr "strings.SplitN(%s, %s, %s)" (import "strings")))
    (sig Join     (slice-string string) string    pure   (host expr "strings.Join(%s, %s)" (import "strings")))

    ; ---- searching. Index returns -1 when absent, which is a total function
    ; and needs no product.
    (sig Contains  (string string) bool  pure  (host expr "strings.Contains(%s, %s)" (import "strings")))
    (sig HasPrefix (string string) bool pure  (host expr "strings.HasPrefix(%s, %s)" (import "strings")))
    (sig HasSuffix (string string) bool pure  (host expr "strings.HasSuffix(%s, %s)" (import "strings")))
    (sig Index     (string string) int     pure   (host expr "strings.Index(%s, %s)" (import "strings")))
    (sig LastIndex (string string) int pure   (host expr "strings.LastIndex(%s, %s)" (import "strings")))
    (sig Count     (string string) int     pure   (host expr "strings.Count(%s, %s)" (import "strings")))
    (sig EqualFold (string string) bool pure  (host expr "strings.EqualFold(%s, %s)" (import "strings")))

    ; ---- transforming
    (sig ToLower   (string) string        pure         (host expr "strings.ToLower(%s)" (import "strings")))
    (sig ToUpper   (string) string        pure         (host expr "strings.ToUpper(%s)" (import "strings")))
    (sig ToTitle   (string) string        pure         (host expr "strings.ToTitle(%s)" (import "strings")))
    (sig TrimSpace (string) string      pure         (host expr "strings.TrimSpace(%s)" (import "strings")))
    (sig Trim      (string string) string       pure  (host expr "strings.Trim(%s, %s)" (import "strings")))
    (sig TrimLeft  (string string) string   pure  (host expr "strings.TrimLeft(%s, %s)" (import "strings")))
    (sig TrimRight (string string) string  pure  (host expr "strings.TrimRight(%s, %s)" (import "strings")))
    (sig TrimPrefix (string string) string pure (host expr "strings.TrimPrefix(%s, %s)" (import "strings")))
    (sig TrimSuffix (string string) string pure (host expr "strings.TrimSuffix(%s, %s)" (import "strings")))
    (sig Repeat    (string int) string     pure     (host expr "strings.Repeat(%s, %s)" (import "strings")))
    (sig Replace   (string string string int) string  pure
                    (host expr "strings.Replace(%s, %s, %s, %s)" (import "strings")))
    (sig ReplaceAll (string string string) string   pure
                    (host expr "strings.ReplaceAll(%s, %s, %s)" (import "strings")))

    ; ---- comparison. Go's Compare is -1/0/+1 and total.
    (sig Compare (string string) int pure (host expr "strings.Compare(%s, %s)" (import "strings")))))
