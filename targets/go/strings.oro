// Go's `strings`: functions on Go's strings, under Go's names.
//
//   (use go/strings)
//   (strings.Fields text)   ((strings.Cut s ":") (fn (before after found) …))
//
// THE ALGEBRA, BEFORE THE NAMES. A Go string is a byte sequence: the free
// monoid B* over bytes, with concatenation and "". Ours is Σ*, the free monoid
// over Unicode scalar values, held as its UTF-8 encoding V = enc(Σ*) ⊆ B*
// (ADR 0030). So every parameter here is the host's `bytestring`, and ours is
// accepted for nothing (`string ≤ bytestring`). A result is ours only where the
// host maps EVERY input into V, and that was measured, not assumed.
//
// - PREDICATES are subsets of B* × B*: Contains s t ⇔ ∃u v. s = u·t·v,
//   HasPrefix s p ⇔ ∃v. s = p·v, HasSuffix symmetrically. EqualFold is Unicode's
//   simple case folding, an equivalence relation.
// - INDEXES are byte offsets: Index s t = min { i : s[i, i+|t|) = t }, or −1.
//   So every index is in [−1, |s|] ⊆ [−1, 2^63 − 1], which is declared.
// - CUT is the factorisation s = before·sep·after at sep's first occurrence:
//   found ⇒ s = before ++ sep ++ after, and ¬found ⇒ (s, "", false). CutPrefix
//   and CutSuffix are the one-sided halves, CutLast the last occurrence.
// - SPLIT AND JOIN: Join (Split s sep) sep = s for sep ≠ "", so Split is a
//   section and Join its retraction. Fields splits on maximal runs of
//   unicode.IsSpace, which is GO's definition of space, and yields no empty field.
// - THE CASE MAPS ToLower, ToUpper, ToTitle and Title go through strings.Map,
//   which re-encodes an invalid byte as U+FFFD, so each is a map B* → V: its
//   result is ours, `string`. Measured on 1,011,155 inputs (every string of up to
//   three bytes over an alphabet of invalid and case-mapped bytes, and a million
//   random ones): no invalid output, where the control, TrimSpace, gave 832,506
//   (gotarget-2026-09-30). ToValidUTF8 s r is in V exactly when r is, so its
//   replacement is declared ours.
// - Everything else can hand back invalid bytes it was given — Trim cuts at a
//   byte, Split at a separator — so its result is the host's.
// - A REPLACER is a finite rewriting system: a list of pairs (oldᵢ, newᵢ),
//   applied left to right at each position, the first pair that matches
//   winning (Go's documentation), with no rewrite of what a rewrite produced.
//   NewReplacer takes the pairs FLATTENED, old₁ new₁ old₂ new₂ …, as a variadic,
//   ...string, which is the free monoid B** on strings: inside the function its
//   value is a []string, and Go's own spread f(s...) passes one unchanged. So
//   it is ONE declaration over a table, (array bytestring), every length at
//   once, and not a family of restrictions as fmt's ...any needs
//   (variadic-2026-10-08). The table is shared, not copied, and that is sound
//   because Go copies it and never writes it (`append([]string(nil),
//   oldnew...)`). Its precondition is the flattening's: an even count, or Go
//   panics. A Replacer is immutable after construction and has no declared
//   equality, so its construction and Replace are pure; WriteString is a write,
//   io.Writer's partial success.
// - A BUILDER is a monoid accumulator: after writes w₁ … wₙ, String() is
//   w₁·…·wₙ. It is a mutable host object, so its methods are impure and their
//   order is the program's order (ADR 0010). A READER is a cursor over a fixed
//   string: io.Reader's contract, 0 ≤ n ≤ len p.
//
// WHAT IS NOT DECLARED, of the 66 names the survey can declare:
//   - ToLowerSpecial, ToUpperSpecial, ToTitleSpecial take a unicode.SpecialCase,
//     and the only ones are package VARIABLES of `unicode` (TurkishCase), which
//     no file here declares yet;
// Not in the survey at all: the functions taking a func(rune) bool (FieldsFunc,
// TrimFunc, IndexFunc, Map, …), which are callbacks, tiers 1 and 2, not built.
module go/strings {
    set Builder = host "*strings.Builder"
    set Reader = host "*strings.Reader"
    set Replacer = host "*strings.Replacer"

    // ---------------------------------------------------------------- predicates
    fn Contains(s ∈ bytestring, substr ∈ bytestring) (Bool) pure {
        host expr "strings.Contains(${s}, ${substr})" import "strings"
    }
    fn ContainsAny(s ∈ bytestring, chars ∈ bytestring) (Bool) pure {
        host expr "strings.ContainsAny(${s}, ${chars})" import "strings"
    }
    fn ContainsRune(s ∈ bytestring, r ∈ -2^31..2^31-1) (Bool) pure {
        host expr "strings.ContainsRune(${s}, int32(${r}))" import "strings"
    }
    fn HasPrefix(s ∈ bytestring, prefix ∈ bytestring) (Bool) pure {
        host expr "strings.HasPrefix(${s}, ${prefix})" import "strings"
    }
    fn HasSuffix(s ∈ bytestring, suffix ∈ bytestring) (Bool) pure {
        host expr "strings.HasSuffix(${s}, ${suffix})" import "strings"
    }
    fn EqualFold(s ∈ bytestring, t ∈ bytestring) (Bool) pure {
        host expr "strings.EqualFold(${s}, ${t})" import "strings"
    }
    // Lexicographic order on bytes, as a sign: {−1, 0, 1}.
    fn Compare(a ∈ bytestring, b ∈ bytestring) (-1..1) pure {
        host expr "strings.Compare(${a}, ${b})" import "strings"
    }

    // ------------------------------------------------------------------ indexes
    // Byte offsets in [−1, |s|]; −1 is absence, so each is total.
    fn Index(s ∈ bytestring, substr ∈ bytestring) (-1..2^63-1) pure {
        host expr "strings.Index(${s}, ${substr})" import "strings"
    }
    fn IndexAny(s ∈ bytestring, chars ∈ bytestring) (-1..2^63-1) pure {
        host expr "strings.IndexAny(${s}, ${chars})" import "strings"
    }
    fn IndexByte(s ∈ bytestring, c ∈ 0..255) (-1..2^63-1) pure {
        host expr "strings.IndexByte(${s}, uint8(${c}))" import "strings"
    }
    fn IndexRune(s ∈ bytestring, r ∈ -2^31..2^31-1) (-1..2^63-1) pure {
        host expr "strings.IndexRune(${s}, int32(${r}))" import "strings"
    }
    fn LastIndex(s ∈ bytestring, substr ∈ bytestring) (-1..2^63-1) pure {
        host expr "strings.LastIndex(${s}, ${substr})" import "strings"
    }
    fn LastIndexAny(s ∈ bytestring, chars ∈ bytestring) (-1..2^63-1) pure {
        host expr "strings.LastIndexAny(${s}, ${chars})" import "strings"
    }
    fn LastIndexByte(s ∈ bytestring, c ∈ 0..255) (-1..2^63-1) pure {
        host expr "strings.LastIndexByte(${s}, uint8(${c}))" import "strings"
    }
    // Non-overlapping occurrences; of "" it is the rune count plus one.
    fn Count(s ∈ bytestring, substr ∈ bytestring) (0..2^63-1) pure {
        host expr "strings.Count(${s}, ${substr})" import "strings"
    }

    // -------------------------------------------------------------- factorising
    fn Cut(s ∈ bytestring, sep ∈ bytestring) (bytestring × bytestring × Bool) pure {
        host expr "strings.Cut(${s}, ${sep})" import "strings"
    }
    fn CutLast(s ∈ bytestring, sep ∈ bytestring) (bytestring × bytestring × Bool) pure {
        host expr "strings.CutLast(${s}, ${sep})" import "strings"
    }
    fn CutPrefix(s ∈ bytestring, prefix ∈ bytestring) (bytestring × Bool) pure {
        host expr "strings.CutPrefix(${s}, ${prefix})" import "strings"
    }
    fn CutSuffix(s ∈ bytestring, suffix ∈ bytestring) (bytestring × Bool) pure {
        host expr "strings.CutSuffix(${s}, ${suffix})" import "strings"
    }

    // --------------------------------------------------------- splitting, joining
    // SplitN's n: n > 0 at most n pieces, n = 0 none, n < 0 all. Every int is
    // meaningful, so there is no precondition.
    fn Split(s ∈ bytestring, sep ∈ bytestring) (Array(bytestring)) pure {
        host expr "strings.Split(${s}, ${sep})" import "strings"
    }
    fn SplitN(s ∈ bytestring, sep ∈ bytestring, n ∈ Int) (Array(bytestring)) pure {
        host expr "strings.SplitN(${s}, ${sep}, ${n})" import "strings"
    }
    fn SplitAfter(s ∈ bytestring, sep ∈ bytestring) (Array(bytestring)) pure {
        host expr "strings.SplitAfter(${s}, ${sep})" import "strings"
    }
    fn SplitAfterN(s ∈ bytestring, sep ∈ bytestring, n ∈ Int) (Array(bytestring)) pure {
        host expr "strings.SplitAfterN(${s}, ${sep}, ${n})" import "strings"
    }
    fn Fields(s ∈ bytestring) (Array(bytestring)) pure {
        host expr "strings.Fields(${s})" import "strings"
    }
    fn Join(elems ∈ Array(bytestring), sep ∈ bytestring) (bytestring) pure {
        host expr "strings.Join(${elems}, ${sep})" import "strings"
    }

    // --------------------------------------------------------------- the case maps
    // Maps B* → V (the header): the result is ours.
    fn ToLower(s ∈ bytestring) (String) pure { host expr "strings.ToLower(${s})" import "strings" }
    fn ToUpper(s ∈ bytestring) (String) pure { host expr "strings.ToUpper(${s})" import "strings" }
    fn ToTitle(s ∈ bytestring) (String) pure { host expr "strings.ToTitle(${s})" import "strings" }
    // Deprecated by Go (it does not handle Unicode punctuation), and still Go's.
    fn Title(s ∈ bytestring) (String) pure { host expr "strings.Title(${s})" import "strings" }
    fn ToValidUTF8(s ∈ bytestring, replacement ∈ String) (String) pure {
        host expr "strings.ToValidUTF8(${s}, ${replacement})" import "strings"
    }

    // ----------------------------------------------------------------- trimming
    fn TrimSpace(s ∈ bytestring) (bytestring) pure {
        host expr "strings.TrimSpace(${s})" import "strings"
    }
    fn Trim(s ∈ bytestring, cutset ∈ bytestring) (bytestring) pure {
        host expr "strings.Trim(${s}, ${cutset})" import "strings"
    }
    fn TrimLeft(s ∈ bytestring, cutset ∈ bytestring) (bytestring) pure {
        host expr "strings.TrimLeft(${s}, ${cutset})" import "strings"
    }
    fn TrimRight(s ∈ bytestring, cutset ∈ bytestring) (bytestring) pure {
        host expr "strings.TrimRight(${s}, ${cutset})" import "strings"
    }
    fn TrimPrefix(s ∈ bytestring, prefix ∈ bytestring) (bytestring) pure {
        host expr "strings.TrimPrefix(${s}, ${prefix})" import "strings"
    }
    fn TrimSuffix(s ∈ bytestring, suffix ∈ bytestring) (bytestring) pure {
        host expr "strings.TrimSuffix(${s}, ${suffix})" import "strings"
    }

    // -------------------------------------------------------------- rewriting
    // Repeat panics on a negative count, which is a precondition; it also panics
    // when |s|·count overflows an int, which is a product of two variables and
    // outside the linear fragment, so that half is named here and not checked.
    fn Repeat(s ∈ bytestring, count ∈ Int) (bytestring) pure
        where count >= 0 {
        host expr "strings.Repeat(${s}, ${count})" import "strings"
    }
    fn Replace(s ∈ bytestring, old ∈ bytestring, new ∈ bytestring, n ∈ Int) (bytestring) pure {
        host expr "strings.Replace(${s}, ${old}, ${new}, ${n})" import "strings"
    }
    fn ReplaceAll(s ∈ bytestring, old ∈ bytestring, new ∈ bytestring) (bytestring) pure {
        host expr "strings.ReplaceAll(${s}, ${old}, ${new})" import "strings"
    }
    // A copy: the identity on values, with fresh storage.
    fn Clone(s ∈ bytestring) (bytestring) pure { host expr "strings.Clone(${s})" import "strings" }

    // ------------------------------------------------------------- constructors
    fn NewReader(s ∈ bytestring) (Reader) { host expr "strings.NewReader(${s})" import "strings" }
    // A spread: the pairs, flattened, in a table (the header).
    fn NewReplacer(oldnew ∈ Array(bytestring)) (Replacer) pure variadic
        where len(oldnew) % 2 == 0 {
        host expr "strings.NewReplacer(${oldnew}...)" import "strings"
    }
    // A Builder's zero value is ready to use, and Go makes one with new(T) — a
    // construct, not a name, so the survey does not generate it.
    fn NewBuilder() (Builder) { host expr "new(strings.Builder)" import "strings" }

    // ------------------------------------------------------------------ Builder
    module Builder {
        use result
        fn Len(self ∈ Builder) (0..2^63-1) { host expr "${self}.Len()" import "strings" }
        fn Cap(self ∈ Builder) (0..2^63-1) { host expr "${self}.Cap()" import "strings" }
        // Grow panics on a negative n.
        fn Grow(self ∈ Builder, n ∈ Int) (Builder)
            where n >= 0 {
            host stmt "${self}.Grow(${n})" import "strings"
        }
        fn Reset(self ∈ Builder) (Builder) { host stmt "${self}.Reset()" import "strings" }
        // w₁·…·wₙ, as bytes: WriteByte can write any byte, so the host's string.
        fn String(self ∈ Builder) (bytestring) { host expr "${self}.String()" import "strings" }
        // The error is always nil and the count is what was written (Go's source),
        // so the honest error factor is 1: these four keep (option error), the
        // host's spelling of it, which may be ignored, where every other partial
        // success has the relevant 1 + E (spec/errors.md §4.3).
        fn Write(self ∈ Builder, p ∈ Array(0..255)) (0..2^63-1 × Option(error)) {
            host expr "${self}.Write(${p})" import "strings"
        }
        fn WriteByte(self ∈ Builder, c ∈ 0..255) (Option(error)) {
            host expr "${self}.WriteByte(uint8(${c}))" import "strings"
        }
        fn WriteRune(self ∈ Builder, r ∈ -2^31..2^31-1) (1..4 × Option(error)) {
            host expr "${self}.WriteRune(int32(${r}))" import "strings"
        }
        fn WriteString(self ∈ Builder, s ∈ bytestring) (0..2^63-1 × Option(error)) {
            host expr "${self}.WriteString(${s})" import "strings"
        }
    }

    // ------------------------------------------------------------------- Reader
    module Replacer {
        use result
        fn Replace(self ∈ Replacer, s ∈ bytestring) (bytestring) pure {
            host expr "${self}.Replace(${s})" import "strings"
        }
        fn WriteString(self ∈ Replacer, w ∈ `go/io`.Writer,
            s ∈ bytestring) (0..2^63-1 × result.result((), error)) {
            host expr "${self}.WriteString(${w}, ${s})" import "strings"
        }
    }

    module Reader {
        use result
        fn Len(self ∈ Reader) (0..2^63-1) { host expr "${self}.Len()" import "strings" }
        fn Size(self ∈ Reader) (0..2^63-1) { host expr "${self}.Size()" import "strings" }
        // Write-borrows, B ⊸ B ⊗ int ⊗ error, as os's File.Read.
        fn Read(self ∈ Reader, b ∈ Array(0..255) linear) (n ∈ 0..2^63-1, r ∈ result.result((), error))
                ensure n <= len(b') && len(b') == len(b) {
            host expr "${self}.Read(${b})" import "strings"
        }
        fn ReadAt(self ∈ Reader, b ∈ Array(0..255) linear, off ∈ -2^63..2^63-1)
                (n ∈ 0..2^63-1, r ∈ result.result((), error)) ensure n <= len(b') && len(b') == len(b) {
            host expr "${self}.ReadAt(${b}, int64(${off}))" import "strings"
        }
        fn ReadByte(self ∈ Reader) (result.result(0..255, error)) {
            host expr "${self}.ReadByte()" import "strings"
        }
        // A scalar value or U+FFFD, and its width, 0 at the end.
        fn ReadRune(self ∈ Reader) (result.result(0..1114111 × 0..4, error)) {
            host expr "${self}.ReadRune()" import "strings"
        }
        fn UnreadByte(self ∈ Reader) (result.result((), error)) {
            host expr "${self}.UnreadByte()" import "strings"
        }
        fn UnreadRune(self ∈ Reader) (result.result((), error)) {
            host expr "${self}.UnreadRune()" import "strings"
        }
        fn Reset(self ∈ Reader, s ∈ bytestring) (Reader) {
            host stmt "${self}.Reset(${s})" import "strings"
        }
        // whence is io.SeekStart, SeekCurrent or SeekEnd; anything else is an
        // error the host returns, not a panic, so no precondition.
        fn Seek(self ∈ Reader, offset ∈ -2^63..2^63-1,
            whence ∈ Int) (result.result(-2^63..2^63-1, error)) {
            host expr "${self}.Seek(int64(${offset}), ${whence})" import "strings"
        }
        fn WriteTo(self ∈ Reader, w ∈ `go/io`.Writer) (-2^63..2^63-1 × result.result((), error)) {
            host expr "${self}.WriteTo(${w})" import "strings"
        }
    }

    axiom Builder ⊆ `go/io`.Writer
    axiom Reader ⊆ `go/io`.Reader ∩ `go/io`.ByteReader
}
