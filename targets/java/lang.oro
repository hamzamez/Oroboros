// java.lang — the package auto-imported into every compilation unit — plus the
// operators, which belong to no package at all.
//
//   (use java)         →  (java.+ x y)   (java.% a b)   (java.instanceof v t)
//   (use java/Math)    →  (Math.abs x)          emits  Math.abs(x)
//   (use java/Integer) →  (Integer.parseInt s)  emits  Integer.parseInt(s)
//
// The static classes read EXACTLY as Java reads, because a static call and a
// qualified name have the same shape. Instance methods do not — `(String.length
// s)` emits `s.length()` — which is the same receiver-order loss JavaScript has.
// ═══ HOW WIDE A SHIFT IS EXACT HERE
//
// `x / 2^k` on a SIGNED value is not a shift -- truncation toward zero needs
// a rounding correction -- so the compiler rewrites it into one wherever it
// can PROVE the dividend is non-negative and fits this many bits. Worth
// **2.39x** on our fixed-limb factorial (shiftdiv-2026-09-03).
//
// This does NOT promote bitwise operators to the language, and integers.md
// §0a's reason for keeping them out stands. It lets the COMPILER use this
// host's own shift where it has proved the rewrite changes no answer.
//
// our `int` is Java's `long`, and `>>` on one is a 64-bit arithmetic shift.
repr shift 63

// ═══ WHERE THIS HOST'S OPERATORS WRAP (ADR 0082 item 3): at 64 bits, two's
// complement, so a term under `mod 2^n`, n ≤ 64, is computed in them, fused.
repr wrap 64

module java {
    // ---- THE CRASH (spec/errors.md §8, §9): crash : E → 0, ending the process
    // with the reason. The language's `abandon`, found by spelling; it never
    // returns, so the IR ends its region with `unreachable`, and nothing is
    // printed after the throw, which Java would refuse as unreachable.
    fn abandon(why ∈ String) (Any) { host stmt "throw new IllegalStateException(${why})" }

    // ---- arithmetic on long, which is our `int`
    // The plain operators, and the CHECKED forms a declared range selects when
    // the compiler cannot prove the result stays in the portable window
    // (sct-2026-08-19). The JVM has these as intrinsics — Math.addExact compiles
    // to an add and a jump-on-overflow — which is why overflow-2026-08-19
    // measured Java at 1.31x where Go pays 2.61x and JavaScript 3.74x.
    // ---- the free monoid (string-operations.md §1)
    //
    // CONCATENATION is the monoid's operation and `""` its unit. `String.concat`
    // rather than `+`, which the JVM compiles through StringConcatFactory: the
    // method names the operation plainly.
    fn concat(a ∈ String, b ∈ String) (String) pure { host expr "${a}.concat(${b})" }

    // η : Scalar → Scalar*, the generator injection — the string of one scalar.
    // `toChars` yields the surrogate PAIR above the BMP, which is UTF-16's
    // representation of that one scalar and not two of anything.
    // ITS DOMAIN IS Scalar = [0, D7FF] ∪ [E000, 10FFFF] (string-operations.md §7),
    // a disjunction, which the refinement layer decides by case split. Outside it
    // the hosts disagree observably — Go gives U+FFFD, JavaScript a lone
    // surrogate or a RangeError, Java an exception or a lone char — so the
    // language's operation states one domain on every target
    // (gotarget-2026-09-30).
    fn string_of(c ∈ Int) (String) pure
        where c >= 0 && c <= 1114111 && (c <= 55295 || c >= 57344) {
        host expr "new String(Character.toChars((int) ${c}))"
    }

    fn `+`(a ∈ Int, b ∈ Int) (Int) pure { host expr "${a} + ${b}" checked addExact }
    fn `-`(a ∈ Int, b ∈ Int) (Int) pure { host expr "${a} - ${b}" checked subtractExact }
    fn `*`(a ∈ Int, b ∈ Int) (Int) pure { host expr "${a} * ${b}" checked multiplyExact }
    fn addExact(a ∈ Int, b ∈ Int) (Int) pure { host expr "Math.addExact(${a}, ${b})" }
    fn subtractExact(a ∈ Int, b ∈ Int) (Int) pure { host expr "Math.subtractExact(${a}, ${b})" }
    fn multiplyExact(a ∈ Int, b ∈ Int) (Int) pure { host expr "Math.multiplyExact(${a}, ${b})" }
    // A ZERO DIVISOR IS A PRECONDITION, NOT A BEHAVIOUR — integers.md §5.
    fn `/`(a ∈ Int, b ∈ Int) (Int) pure where `!=`(b, 0) { host expr "${a} / ${b}" }
    fn `%`(a ∈ Int, b ∈ Int) (Int) pure where `!=`(b, 0) { host expr "${a} % ${b}" }
    fn neg(a ∈ Int) (Int) pure { host expr "-${a}" }

    // ---- arithmetic on double
    fn `f+`(a ∈ F64, b ∈ F64) (F64) pure { host expr "${a} + ${b}" }
    fn f_(a ∈ F64, b ∈ F64) (F64) pure { host expr "${a} - ${b}" }
    fn `f*`(a ∈ F64, b ∈ F64) (F64) pure { host expr "${a} * ${b}" }
    fn `f/`(a ∈ F64, b ∈ F64) (F64) pure { host expr "${a} / ${b}" }

    // ---- bitwise, including Java's unsigned shift
    fn `&`(a ∈ Int, b ∈ Int) (Int) pure { host expr "${a} & ${b}" }
    fn `|`(a ∈ Int, b ∈ Int) (Int) pure { host expr "${a} | ${b}" }
    fn `^`(a ∈ Int, b ∈ Int) (Int) pure { host expr "${a} ^ ${b}" }
    fn `~`(a ∈ Int) (Int) pure { host expr "~${a}" }
    fn `<<`(a ∈ Int, b ∈ Int) (Int) pure where b >= 0 { host expr "${a} << ${b}" }
    fn `>>`(a ∈ Int, b ∈ Int) (Int) pure { host expr "${a} >> ${b}" }
    fn `>>>`(a ∈ Int, b ∈ Int) (Int) pure { host expr "${a} >>> ${b}" }

    // ---- THE LANGUAGE'S BOOLEAN OPERATIONS (ADR 0082). On a long, Java's `&`,
    // `|`, `^` and `~` are ℤ's 2-adic operations restricted to the word, and
    // `<<` is a·2ᵏ wherever the product is proven in the word (a count of 64 or
    // more with a non-zero a is never proven). Java masks a shift's count by 63
    // (JLS §15.19), so ⌊a/2ᵏ⌋ for k ≥ 64, which is a's sign, is `>> 63`: the
    // language's `>>` clamps the count. `Math.floorMod` is the Euclidean
    // remainder for a positive divisor.
    // A scalar the IR holds in an `int` (indextype) would have its count masked
    // by 31: the printer widens the operand first (ir/java's arith).
    fn sar(a ∈ Int, b ∈ Int) (Int) pure where b >= 0 { host expr "${a} >> Math.min(${b}, 63)" }
    fn emod(a ∈ Int, m ∈ Int) (Int) pure where m > 0 { host expr "Math.floorMod(${a}, ${m})" }

    // ---- comparison
    fn `<`(a ∈ Int, b ∈ Int) (Bool) pure { host expr "${a} < ${b}" }
    fn `<=`(a ∈ Int, b ∈ Int) (Bool) pure { host expr "${a} <= ${b}" }
    fn `>`(a ∈ Int, b ∈ Int) (Bool) pure { host expr "${a} > ${b}" }
    fn `>=`(a ∈ Int, b ∈ Int) (Bool) pure { host expr "${a} >= ${b}" }
    fn `==`(a ∈ Int, b ∈ Int) (Bool) pure { host expr "${a} == ${b}" }
    fn `!=`(a ∈ Int, b ∈ Int) (Bool) pure { host expr "${a} != ${b}" }
    fn `f<`(a ∈ F64, b ∈ F64) (Bool) pure { host expr "${a} < ${b}" }
    fn `f<=`(a ∈ F64, b ∈ F64) (Bool) pure { host expr "${a} <= ${b}" }
    fn `f>`(a ∈ F64, b ∈ F64) (Bool) pure { host expr "${a} > ${b}" }
    fn `f>=`(a ∈ F64, b ∈ F64) (Bool) pure { host expr "${a} >= ${b}" }

    // ---- boolean
    fn `&&`(a ∈ Bool, b ∈ Bool) (Bool) pure { host expr "${a} && ${b}" }
    fn `||`(a ∈ Bool, b ∈ Bool) (Bool) pure { host expr "${a} || ${b}" }
    fn `!`(a ∈ Bool) (Bool) pure { host expr "!${a}" }
    fn null() (Any) pure { host expr "null" }

    fn instanceof(a ∈ Any, b ∈ Any) (Bool) pure { host expr "${a} instanceof ${b}" }

    // ---- arrays. Language-level, so no import — and fixed-length, so nothing
    // to append to. One declaration per element type, because `T[]` is an atom.
    //
    // Every index carries `(int)`: our `int` is Java's `long`, and a Java array
    // index must be `int`. Free at run time, and unavoidable.
    fn new_long(n ∈ Int) (r ∈ long_array) ensure len(r) == n { host expr "new long[(int) ${n}]" }
    fn new_double(n ∈ Int) (r ∈ double_array)
        ensure len(r) == n {
        host expr "new double[(int) ${n}]"
    }
    fn new_bool(n ∈ Int) (r ∈ bool_array) ensure len(r) == n { host expr "new boolean[(int) ${n}]" }
    fn new_string(n ∈ Int) (r ∈ string_array)
        ensure len(r) == n {
        host expr "new String[(int) ${n}]"
    }

    fn len(a ∈ Any) (Int) pure { host expr "${a}.length" }

    fn at_long(v ∈ long_array, i ∈ Int) (Int) pure index
        where java.`&&`(java.`<=`(0, i), java.`<`(i, java.len(v))) {
        host expr "${v}[(int) ${i}]"
    }
    fn at_double(v ∈ double_array, i ∈ Int) (F64) pure index
        where java.`&&`(java.`<=`(0, i), java.`<`(i, java.len(v))) {
        host expr "${v}[(int) ${i}]"
    }
    fn at_bool(v ∈ bool_array, i ∈ Int) (Bool) pure index
        where java.`&&`(java.`<=`(0, i), java.`<`(i, java.len(v))) {
        host expr "${v}[(int) ${i}]"
    }
    fn at_string(v ∈ string_array, i ∈ Int) (String) pure index
        where java.`&&`(java.`<=`(0, i), java.`<`(i, java.len(v))) {
        host expr "${v}[(int) ${i}]"
    }

    fn set_long(c ∈ long_array, i ∈ Int, x ∈ Int) (r ∈ long_array)
        ensure len(r) == len(c) {
        host stmt "${c}[(int) ${i}] = ${x}"
    }
    fn set_double(c ∈ double_array, i ∈ Int, x ∈ F64) (r ∈ double_array)
        ensure len(r) == len(c) {
        host stmt "${c}[(int) ${i}] = ${x}"
    }
    fn set_bool(c ∈ bool_array, i ∈ Int, x ∈ Bool) (r ∈ bool_array)
        ensure len(r) == len(c) {
        host stmt "${c}[(int) ${i}] = ${x}"
    }
    fn set_string(c ∈ string_array, i ∈ Int, x ∈ String) (r ∈ string_array)
        ensure len(r) == len(c) {
        host stmt "${c}[(int) ${i}] = ${x}"
    }

    // ---- conversions. Java spells these (T) x or T.valueOf.
    fn int_of_f64(a ∈ F64) (Int) pure { host expr "(long) ${a}" }
    fn f64_of_int(a ∈ Int) (F64) pure { host expr "(double) ${a}" }
    fn jint_of_int(a ∈ Int) (jint) pure { host expr "(int) ${a}" }
}

module java/Math {
    fn abs(a ∈ F64) (F64) pure { host expr "Math.abs(${a})" }
    fn absl(a ∈ Int) (Int) pure { host expr "Math.abs(${a})" }
    fn sqrt(a ∈ F64) (F64) pure { host expr "Math.sqrt(${a})" }
    fn cbrt(a ∈ F64) (F64) pure { host expr "Math.cbrt(${a})" }
    fn pow(a ∈ F64, b ∈ F64) (F64) pure { host expr "Math.pow(${a}, ${b})" }
    fn exp(a ∈ F64) (F64) pure { host expr "Math.exp(${a})" }
    fn log(a ∈ F64) (F64) pure { host expr "Math.log(${a})" }
    fn log10(a ∈ F64) (F64) pure { host expr "Math.log10(${a})" }
    fn sin(a ∈ F64) (F64) pure { host expr "Math.sin(${a})" }
    fn cos(a ∈ F64) (F64) pure { host expr "Math.cos(${a})" }
    fn tan(a ∈ F64) (F64) pure { host expr "Math.tan(${a})" }
    fn atan2(a ∈ F64, b ∈ F64) (F64) pure { host expr "Math.atan2(${a}, ${b})" }
    fn hypot(a ∈ F64, b ∈ F64) (F64) pure { host expr "Math.hypot(${a}, ${b})" }
    fn floor(a ∈ F64) (F64) pure { host expr "Math.floor(${a})" }
    fn ceil(a ∈ F64) (F64) pure { host expr "Math.ceil(${a})" }
    fn round(a ∈ F64) (Int) pure { host expr "Math.round(${a})" }
    fn min(a ∈ Int, b ∈ Int) (Int) pure { host expr "Math.min(${a}, ${b})" }
    fn max(a ∈ Int, b ∈ Int) (Int) pure { host expr "Math.max(${a}, ${b})" }
    fn PI() (F64) pure { host expr "Math.PI" }
    fn E() (F64) pure { host expr "Math.E" }
    fn random() (F64) { host expr "Math.random()" }
}

module java/Integer {
    fn parseInt(a ∈ String) (jint) pure { host expr "Integer.parseInt(${a})" }
    fn toString(a ∈ jint) (String) pure { host expr "Integer.toString(${a})" }
    fn toBinaryString(a ∈ jint) (String) pure { host expr "Integer.toBinaryString(${a})" }
    fn toHexString(a ∈ jint) (String) pure { host expr "Integer.toHexString(${a})" }
    fn bitCount(a ∈ jint) (jint) pure { host expr "Integer.bitCount(${a})" }
    fn `MAX_VALUE`() (jint) pure { host expr "Integer.MAX_VALUE" }
    fn `MIN_VALUE`() (jint) pure { host expr "Integer.MIN_VALUE" }
}

module java/Long {
    fn parseLong(a ∈ String) (Int) pure { host expr "Long.parseLong(${a})" }
    fn toString(a ∈ Int) (String) pure { host expr "Long.toString(${a})" }
    fn bitCount(a ∈ Int) (jint) pure { host expr "Long.bitCount(${a})" }
    fn `MAX_VALUE`() (Int) pure { host expr "Long.MAX_VALUE" }
}

module java/Double {
    fn parseDouble(a ∈ String) (F64) pure { host expr "Double.parseDouble(${a})" }
    fn toString(a ∈ F64) (String) pure { host expr "Double.toString(${a})" }
    fn isNaN(a ∈ F64) (Bool) pure { host expr "Double.isNaN(${a})" }
    fn NaN() (F64) pure { host expr "Double.NaN" }
    fn `POSITIVE_INFINITY`() (F64) pure { host expr "Double.POSITIVE_INFINITY" }
}

// Instance methods on String. `(String.length s)` emits `s.length()`.
module java/String {
    fn length(a ∈ String) (Int) pure { host expr "${a}.length()" }
    fn charAt(a ∈ String, b ∈ Int) (char) pure { host expr "${a}.charAt((int) ${b})" }
    fn substring(a ∈ String, b ∈ Int, c ∈ Int) (String) pure {
        host expr "${a}.substring((int) ${b}, (int) ${c})"
    }
    fn indexOf(a ∈ String, b ∈ String) (Int) pure { host expr "${a}.indexOf(${b})" }
    fn contains(a ∈ String, b ∈ String) (Bool) pure { host expr "${a}.contains(${b})" }
    fn startsWith(a ∈ String, b ∈ String) (Bool) pure { host expr "${a}.startsWith(${b})" }
    fn endsWith(a ∈ String, b ∈ String) (Bool) pure { host expr "${a}.endsWith(${b})" }
    fn toUpperCase(a ∈ String) (String) pure { host expr "${a}.toUpperCase()" }
    fn toLowerCase(a ∈ String) (String) pure { host expr "${a}.toLowerCase()" }
    fn strip(a ∈ String) (String) pure { host expr "${a}.strip()" }
    fn repeat(a ∈ String, b ∈ Int) (String) pure { host expr "${a}.repeat((int) ${b})" }
    fn replace(a ∈ String, b ∈ String, c ∈ String) (String) pure {
        host expr "${a}.replace(${b}, ${c})"
    }
    fn split(a ∈ String, b ∈ String) (Array(String)) pure { host expr "${a}.split(${b})" }
    fn isEmpty(a ∈ String) (Bool) pure { host expr "${a}.isEmpty()" }
    // `==` on Strings compares references, which is why this exists.
    fn equals(a ∈ String, b ∈ String) (Bool) pure { host expr "${a}.equals(${b})" }
    fn compareTo(a ∈ String, b ∈ String) (Int) pure { host expr "${a}.compareTo(${b})" }
    fn concat(a ∈ String, b ∈ String) (String) pure { host expr "(${a} + ${b})" }
    fn valueOf(a ∈ Any) (String) pure { host expr "String.valueOf(${a})" }
    fn join(a ∈ String, b ∈ string_array) (String) pure { host expr "String.join(${a}, ${b})" }
}

module java/Character {
    fn isDigit(a ∈ char) (Bool) pure { host expr "Character.isDigit(${a})" }
    fn isLetter(a ∈ char) (Bool) pure { host expr "Character.isLetter(${a})" }
    fn isWhitespace(a ∈ char) (Bool) pure { host expr "Character.isWhitespace(${a})" }
    fn isUpperCase(a ∈ char) (Bool) pure { host expr "Character.isUpperCase(${a})" }
    fn toLowerCase(a ∈ char) (char) pure { host expr "Character.toLowerCase(${a})" }
    fn toUpperCase(a ∈ char) (char) pure { host expr "Character.toUpperCase(${a})" }
    fn code(a ∈ char) (Int) pure { host expr "(long) ${a}" }
}

// The ONLY growable container in java.lang, and it only holds text.
module java/StringBuilder {
    fn new() (strbuf) { host expr "new StringBuilder()" }
    fn append(a ∈ strbuf, b ∈ String) (strbuf) { host stmt "${a}.append(${b})" }
    fn appendInt(a ∈ strbuf, b ∈ Int) (strbuf) { host stmt "${a}.append(${b})" }
    fn appendChar(a ∈ strbuf, b ∈ char) (strbuf) { host stmt "${a}.append(${b})" }
    fn length(a ∈ strbuf) (Int) pure { host expr "${a}.length()" }
    fn toString(a ∈ strbuf) (String) pure { host expr "${a}.toString()" }
}

module java/System {
    fn out_println(a ∈ Any) (Any) { host stmt "System.out.println(${a})" }
    fn out_print(a ∈ Any) (Any) { host stmt "System.out.print(${a})" }
    fn err_println(a ∈ Any) (Any) { host stmt "System.err.println(${a})" }
    fn nanoTime() (Int) { host expr "System.nanoTime()" }
    fn currentTimeMillis() (Int) { host expr "System.currentTimeMillis()" }
    fn arraycopy(a ∈ double_array, b ∈ double_array, c ∈ Int) (double_array) {
        host stmt "System.arraycopy(${a}, 0, ${b}, 0, (int) ${c})"
    }
    fn exit(a ∈ Int) (Any) { host stmt "System.exit((int) ${a})" }
    fn getenv(a ∈ String) (String) { host expr "System.getenv(${a})" }
}

module java/Objects {
    fn equals(a ∈ Any, b ∈ Any) (Bool) pure { host expr "java.util.Objects.equals(${a}, ${b})" }
    fn hashCode(a ∈ Any) (jint) pure { host expr "java.util.Objects.hashCode(${a})" }
    fn toString(a ∈ Any) (String) pure { host expr "java.util.Objects.toString(${a})" }
}
