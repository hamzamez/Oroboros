; java.lang — the package auto-imported into every compilation unit — plus the
; operators, which belong to no package at all.
;
;   (use java)         →  (java.+ x y)   (java.% a b)   (java.instanceof v t)
;   (use java/Math)    →  (Math.abs x)          emits  Math.abs(x)
;   (use java/Integer) →  (Integer.parseInt s)  emits  Integer.parseInt(s)
;
; The static classes read EXACTLY as Java reads, because a static call and a
; qualified name have the same shape. Instance methods do not — `(String.length
; s)` emits `s.length()` — which is the same receiver-order loss JavaScript has.

(target java
  ; ═══ HOW WIDE A SHIFT IS EXACT HERE
  ;
  ; `x / 2^k` on a SIGNED value is not a shift -- truncation toward zero needs
  ; a rounding correction -- so the compiler rewrites it into one wherever it
  ; can PROVE the dividend is non-negative and fits this many bits. Worth
  ; **2.39x** on our fixed-limb factorial (shiftdiv-2026-09-03).
  ;
  ; This does NOT promote bitwise operators to the language, and integers.md
  ; §0a's reason for keeping them out stands. It lets the COMPILER use this
  ; host's own shift where it has proved the rewrite changes no answer.
  ;
  ; our `int` is Java's `long`, and `>>` on one is a 64-bit arithmetic shift.
  (repr shift 63)

  (module java
    ; ---- arithmetic on long, which is our `int`
    ; The plain operators, and the CHECKED forms a declared range selects when
    ; the compiler cannot prove the result stays in the portable window
    ; (sct-2026-08-19). The JVM has these as intrinsics — Math.addExact compiles
    ; to an add and a jump-on-overflow — which is why overflow-2026-08-19
    ; measured Java at 1.31x where Go pays 2.61x and JavaScript 3.74x.
    ; ---- the free monoid (string-operations.md §1)
    ;
    ; CONCATENATION is the monoid's operation and `""` its unit. `String.concat`
    ; rather than `+`, which the JVM compiles through StringConcatFactory: the
    ; method names the operation plainly.
    (sig concat (string string) string pure (host expr "%s.concat(%s)"))

    ; η : Scalar → Scalar*, the generator injection — the string of one scalar.
    ; `toChars` yields the surrogate PAIR above the BMP, which is UTF-16's
    ; representation of that one scalar and not two of anything.
    (sig string-of (int) string pure (host expr "new String(Character.toChars((int) %s))"))

    (sig +  (int int) int  pure (host expr "%s + %s" (checked addExact)))
    (sig -  (int int) int  pure (host expr "%s - %s" (checked subtractExact)))
    (sig *  (int int) int  pure (host expr "%s * %s" (checked multiplyExact)))
    (sig addExact      (int int) int      pure (host expr "Math.addExact(%s, %s)"))
    (sig subtractExact (int int) int pure (host expr "Math.subtractExact(%s, %s)"))
    (sig multiplyExact (int int) int pure (host expr "Math.multiplyExact(%s, %s)"))
    ; A ZERO DIVISOR IS A PRECONDITION, NOT A BEHAVIOUR — integers.md §5.
    (sig /  ((a int) (b int)) int  pure (where (!= b 0)) (host expr "%s / %s"))
    (sig %  ((a int) (b int)) int pure (where (!= b 0)) (host expr "%s %% %s"))
    (sig neg (int) int      pure    (host expr "-%s"))

    ; ---- arithmetic on double
    (sig f+ (f64 f64) f64 pure (host expr "%s + %s"))
    (sig f- (f64 f64) f64 pure (host expr "%s - %s"))
    (sig f* (f64 f64) f64 pure (host expr "%s * %s"))
    (sig f/ (f64 f64) f64 pure (host expr "%s / %s"))

    ; ---- bitwise, including Java's unsigned shift
    (sig &   (int int) int   pure (host expr "%s & %s"))
    (sig |   (int int) int   pure (host expr "%s | %s"))
    (sig ^   (int int) int   pure (host expr "%s ^ %s"))
    (sig ~   (int) int       pure     (host expr "~%s"))
    (sig <<  (int int) int  pure (host expr "%s << %s"))
    (sig >>  (int int) int  pure (host expr "%s >> %s"))
    (sig >>> (int int) int pure (host expr "%s >>> %s"))

    ; ---- comparison
    (sig <   (int int) bool  pure (host expr "%s < %s"))
    (sig <=  (int int) bool pure (host expr "%s <= %s"))
    (sig >   (int int) bool  pure (host expr "%s > %s"))
    (sig >=  (int int) bool pure (host expr "%s >= %s"))
    (sig ==  (int int) bool pure (host expr "%s == %s"))
    (sig !=  (int int) bool pure (host expr "%s != %s"))
    (sig f<  (f64 f64) bool  pure (host expr "%s < %s"))
    (sig f<= (f64 f64) bool pure (host expr "%s <= %s"))
    (sig f>  (f64 f64) bool  pure (host expr "%s > %s"))
    (sig f>= (f64 f64) bool pure (host expr "%s >= %s"))

    ; ---- boolean
    (sig &&  (bool bool) bool pure (host expr "%s && %s"))
    (sig ||  (bool bool) bool pure (host expr "%s || %s"))
    (sig !   (bool) bool      pure      (host expr "!%s"))
    (sig null  () any  pure  (host expr "null"))

    (sig instanceof (any any) bool pure (host expr "%s instanceof %s"))

    ; ---- arrays. Language-level, so no import — and fixed-length, so nothing
    ; to append to. One declaration per element type, because `T[]` is an atom.
    ;
    ; Every index carries `(int)`: our `int` is Java's `long`, and a Java array
    ; index must be `int`. Free at run time, and unavoidable.
    (sig new-long (int) long-array (length 0) (host expr "new long[(int) %s]"))
    (sig new-double (int) double-array (length 0) (host expr "new double[(int) %s]"))
    (sig new-bool (int) bool-array (length 0) (host expr "new boolean[(int) %s]"))
    (sig new-string (int) string-array (length 0) (host expr "new String[(int) %s]"))

    (sig len (any) int pure (host expr "%s.length"))

    (sig at-long   ((v long-array) (i int)) int pure index
      (where (java.&& (java.<= 0 i) (java.< i (java.len v))))      (host expr "%s[(int) %s]"))
    (sig at-double ((v double-array) (i int)) f64 pure index
      (where (java.&& (java.<= 0 i) (java.< i (java.len v))))    (host expr "%s[(int) %s]"))
    (sig at-bool   ((v bool-array) (i int)) bool pure index
      (where (java.&& (java.<= 0 i) (java.< i (java.len v))))     (host expr "%s[(int) %s]"))
    (sig at-string ((v string-array) (i int)) string pure index
      (where (java.&& (java.<= 0 i) (java.< i (java.len v)))) (host expr "%s[(int) %s]"))

    (sig set-long (long-array int int) long-array (length-of 0) (host stmt "%s[(int) %s] = %s"))
    (sig set-double (double-array int f64) double-array (length-of 0) (host stmt "%s[(int) %s] = %s"))
    (sig set-bool (bool-array int bool) bool-array (length-of 0) (host stmt "%s[(int) %s] = %s"))
    (sig set-string (string-array int string) string-array (length-of 0) (host stmt "%s[(int) %s] = %s"))

    ; ---- conversions. Java spells these (T) x or T.valueOf.
    (sig int-of-f64  (f64) int   pure    (host expr "(long) %s"))
    (sig f64-of-int  (int) f64 pure    (host expr "(double) %s"))
    (sig jint-of-int (int) jint    pure   (host expr "(int) %s")))

  (module java/Math
    (sig abs   (f64) f64      pure     (host expr "Math.abs(%s)"))
    (sig absl  (int) int      pure     (host expr "Math.abs(%s)"))
    (sig sqrt  (f64) f64     pure     (host expr "Math.sqrt(%s)"))
    (sig cbrt  (f64) f64     pure     (host expr "Math.cbrt(%s)"))
    (sig pow   (f64 f64) f64  pure (host expr "Math.pow(%s, %s)"))
    (sig exp   (f64) f64      pure     (host expr "Math.exp(%s)"))
    (sig log   (f64) f64      pure     (host expr "Math.log(%s)"))
    (sig log10 (f64) f64    pure     (host expr "Math.log10(%s)"))
    (sig sin   (f64) f64      pure     (host expr "Math.sin(%s)"))
    (sig cos   (f64) f64      pure     (host expr "Math.cos(%s)"))
    (sig tan   (f64) f64      pure     (host expr "Math.tan(%s)"))
    (sig atan2 (f64 f64) f64 pure (host expr "Math.atan2(%s, %s)"))
    (sig hypot (f64 f64) f64 pure (host expr "Math.hypot(%s, %s)"))
    (sig floor (f64) f64    pure     (host expr "Math.floor(%s)"))
    (sig ceil  (f64) f64     pure     (host expr "Math.ceil(%s)"))
    (sig round (f64) int    pure     (host expr "Math.round(%s)"))
    (sig min   (int int) int  pure (host expr "Math.min(%s, %s)"))
    (sig max   (int int) int  pure (host expr "Math.max(%s, %s)"))
    (sig PI    () f64           pure    (host expr "Math.PI"))
    (sig E     () f64            pure    (host expr "Math.E"))
    (sig random () f64   (host expr "Math.random()")))

  (module java/Integer
    (sig parseInt      (string) jint   pure  (host expr "Integer.parseInt(%s)"))
    (sig toString      (jint) string   pure  (host expr "Integer.toString(%s)"))
    (sig toBinaryString (jint) string pure (host expr "Integer.toBinaryString(%s)"))
    (sig toHexString   (jint) string pure  (host expr "Integer.toHexString(%s)"))
    (sig bitCount      (jint) jint   pure    (host expr "Integer.bitCount(%s)"))
    (sig MAX_VALUE     () jint      pure    (host expr "Integer.MAX_VALUE"))
    (sig MIN_VALUE     () jint      pure    (host expr "Integer.MIN_VALUE")))

  (module java/Long
    (sig parseLong (string) int pure (host expr "Long.parseLong(%s)"))
    (sig toString  (int) string  pure (host expr "Long.toString(%s)"))
    (sig bitCount  (int) jint  pure   (host expr "Long.bitCount(%s)"))
    (sig MAX_VALUE () int     pure   (host expr "Long.MAX_VALUE")))

  (module java/Double
    (sig parseDouble (string) f64 pure  (host expr "Double.parseDouble(%s)"))
    (sig toString    (f64) string    pure  (host expr "Double.toString(%s)"))
    (sig isNaN       (f64) bool       pure    (host expr "Double.isNaN(%s)"))
    (sig NaN         () f64             pure    (host expr "Double.NaN"))
    (sig POSITIVE_INFINITY () f64 pure (host expr "Double.POSITIVE_INFINITY")))

  ; Instance methods on String. `(String.length s)` emits `s.length()`.
  (module java/String
    (sig length     (string) int        pure         (host expr "%s.length()"))
    (sig charAt     (string int) char pure    (host expr "%s.charAt((int) %s)"))
    (sig substring  (string int int) string pure (host expr "%s.substring((int) %s, (int) %s)"))
    (sig indexOf    (string string) int     pure  (host expr "%s.indexOf(%s)"))
    (sig contains   (string string) bool    pure (host expr "%s.contains(%s)"))
    (sig startsWith (string string) bool  pure (host expr "%s.startsWith(%s)"))
    (sig endsWith   (string string) bool    pure (host expr "%s.endsWith(%s)"))
    (sig toUpperCase (string) string   pure     (host expr "%s.toUpperCase()"))
    (sig toLowerCase (string) string   pure     (host expr "%s.toLowerCase()"))
    (sig strip      (string) string         pure      (host expr "%s.strip()"))
    (sig repeat     (string int) string pure  (host expr "%s.repeat((int) %s)"))
    (sig replace    (string string string) string pure (host expr "%s.replace(%s, %s)"))
    (sig split      (string string) (array string) pure (host expr "%s.split(%s)"))
    (sig isEmpty    (string) bool       pure        (host expr "%s.isEmpty()"))
    ; `==` on Strings compares references, which is why this exists.
    (sig equals     (string string) bool      pure (host expr "%s.equals(%s)"))
    (sig compareTo  (string string) int   pure  (host expr "%s.compareTo(%s)"))
    (sig concat     (string string) string        pure (host expr "(%s + %s)"))
    (sig valueOf    (any) string pure         (host expr "String.valueOf(%s)"))
    (sig join       (string string-array) string pure (host expr "String.join(%s, %s)")))

  (module java/Character
    (sig isDigit      (char) bool      pure (host expr "Character.isDigit(%s)"))
    (sig isLetter     (char) bool     pure (host expr "Character.isLetter(%s)"))
    (sig isWhitespace (char) bool pure (host expr "Character.isWhitespace(%s)"))
    (sig isUpperCase  (char) bool  pure (host expr "Character.isUpperCase(%s)"))
    (sig toLowerCase  (char) char  pure (host expr "Character.toLowerCase(%s)"))
    (sig toUpperCase  (char) char  pure (host expr "Character.toUpperCase(%s)"))
    (sig code         (char) int                  pure  (host expr "(long) %s")))

  ; The ONLY growable container in java.lang, and it only holds text.
  (module java/StringBuilder
    (sig new       () strbuf          (host expr "new StringBuilder()"))
    (sig append    (strbuf string) strbuf (host stmt "%s.append(%s)"))
    (sig appendInt (strbuf int) strbuf    (host stmt "%s.append(%s)"))
    (sig appendChar (strbuf char) strbuf  (host stmt "%s.append(%s)"))
    (sig length    (strbuf) int   pure           (host expr "%s.length()"))
    (sig toString  (strbuf) string pure        (host expr "%s.toString()")))

  (module java/System
    (sig out-println (any) any  (host stmt "System.out.println(%s)"))
    (sig out-print   (any) any  (host stmt "System.out.print(%s)"))
    (sig err-println (any) any  (host stmt "System.err.println(%s)"))
    (sig nanoTime    () int (host expr "System.nanoTime()"))
    (sig currentTimeMillis () int (host expr "System.currentTimeMillis()"))
    (sig arraycopy   (double-array double-array int) double-array
                      (host stmt "System.arraycopy(%s, 0, %s, 0, (int) %s)"))
    (sig exit        (int) any  (host stmt "System.exit((int) %s)"))
    (sig getenv      (string) string (host expr "System.getenv(%s)")))

  (module java/Objects
    (sig equals   (any any) bool pure (host expr "java.util.Objects.equals(%s, %s)"))
    (sig hashCode (any) jint   pure     (host expr "java.util.Objects.hashCode(%s)"))
    (sig toString (any) string   pure   (host expr "java.util.Objects.toString(%s)"))))
