; java.util — the collections. Not java.lang, so it needs an import, but as
; much a part of the platform as anything else.
;
; This is where the type language hurts most on this host. Java's collections
; are GENERIC: `List<T>`, `Map<K,V>`. Our type language has no constructors, so
; each instantiation is an unrelated atom and needs its own name for every
; operation. `List<Long>` and `List<String>` share not one declaration.
;
; Declared here: List<Long>, List<String>, Map<String,Long>. Every other
; instantiation Java can express — and there are unboundedly many — is
; unreachable. Go needed one name per slice element type; Java needs one per
; (container, K, V) combination, which is the same limitation squared.

(target java
  (module java/List
    (sig newLong    () list-long        (host expr "new java.util.ArrayList<Long>()"))
    (sig newString  () list-string      (host expr "new java.util.ArrayList<String>()"))
    (sig addLong    (list-long int) list-long     (host stmt "%s.add(%s)"))
    (sig addString  (list-string string) list-string (host stmt "%s.add(%s)"))
    (sig getLong    (list-long int) int    pure     (host expr "%s.get((int) %s)"))
    (sig getString  (list-string int) string   pure (host expr "%s.get((int) %s)"))
    (sig setLong    (list-long int int) list-long (host stmt "%s.set((int) %s, %s)"))
    (sig sizeLong   (list-long) int           pure         (host expr "%s.size()"))
    (sig sizeString (list-string) int           pure       (host expr "%s.size()"))
    (sig containsLong (list-long int) bool     pure  (host expr "%s.contains(%s)"))
    (sig clearLong  (list-long) list-long   (host stmt "%s.clear()")))

  (module java/Map
    (sig new        () map-string-long  (host expr "new java.util.HashMap<String,Long>()"))
    ; BOTH FORMS ARE DECLARED, because the measurement that chose between them
    ; did not reproduce.
    ;
    ; Baseline R5 (2026-08-13) measured Java's fused `merge(k, 1, Integer::sum)`
    ; at 9,259,530 ns against `getOrDefault`+`put` at 3,577,103 — the unfused
    ; form winning by 2.6x, the opposite of Go's `m[k]++` — and this file
    ; declared only the unfused pair because of it.
    ;
    ; Re-measured on JDK 17.0.12 with R5's own functions, unchanged
    ; (native-java-2026-08-25): merge/getOr is **0.93x**, and with the `split`
    ; hoisted out of the timed region **0.84x**, consistent across three
    ; independent JVM processes. The fused form is 1.19x FASTER and the sign of
    ; the finding is reversed.
    ;
    ; Re-measured a THIRD time (maps-2026-08-30), with the split hoisted out and
    ; a time-budgeted harness: merge 1,261,935 ns against getOrDefault+put's
    ; 1,546,223 — the fused form 1.22x faster, agreeing with the second take.
    ; A number that has now failed to reproduce twice should stop being quoted;
    ; the honest statement is that the two forms are within ~20% on JDK 17 and
    ; the fused one is ahead.
    ;
    ; So both are declared and the program picks. ADR 0008's rule is unchanged
    ; and in fact reinforced — which granularity wins is a per-target
    ; MEASUREMENT — and this is what it looks like when the measurement moves.
    (sig get        (map-string-long string) int pure (host expr "%s.getOrDefault(%s, 0L)"))
    (sig merge      (map-string-long string) map-string-long
      (host stmt "%s.merge(%s, 1L, Long::sum)"))
    (sig put        (map-string-long string int) map-string-long (host stmt "%s.put(%s, %s)"))
    (sig containsKey (map-string-long string) bool pure (host expr "%s.containsKey(%s)"))
    (sig remove     (map-string-long string) map-string-long (host stmt "%s.remove(%s)"))
    (sig size       (map-string-long) int            pure   (host expr "%s.size()"))
    (sig clear      (map-string-long) map-string-long (host stmt "%s.clear()")))

  (module java/Arrays
    (sig sortLong    (long-array) long-array     (host stmt "java.util.Arrays.sort(%s)"))
    (sig sortDouble  (double-array) double-array (host stmt "java.util.Arrays.sort(%s)"))
    (sig fillLong    (long-array int) long-array (host stmt "java.util.Arrays.fill(%s, %s)"))
    (sig fillBool    (bool-array bool) bool-array (host stmt "java.util.Arrays.fill(%s, %s)"))
    (sig toStringLong (long-array) string pure (host expr "java.util.Arrays.toString(%s)"))
    (sig copyOfDouble (double-array int) double-array pure
                      (host expr "java.util.Arrays.copyOf(%s, (int) %s)"))
    (sig binarySearchLong (long-array int) int pure
                      (host expr "java.util.Arrays.binarySearch(%s, %s)"))))
