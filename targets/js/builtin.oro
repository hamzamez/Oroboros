; JavaScript's operators and global functions, under their own names.
;
;   (use js)
;   (js.+ x y)   (js.=== a b)   (js.?? a b)   (js.** x 2)   (js.typeof v)
;
; Note what is NOT here compared to Go's builtin.oro: no type suffixes. JS has
; one number type and untyped containers, so `js.at` indexes anything and
; `js.+` adds anything. The suffix explosion in the Go target was OUR type
; table showing through; here there is nothing left for it to show.

(target js
  (module js
    ; ---- arithmetic, declared on `any`.
    ;
    ; Not laziness. JavaScript has ONE number type; our language has two, `int`
    ; and `f64`, because that is what an integer and a float LITERAL type as.
    ; Declaring `js.+` on either would make `(js.+ i 1.5)` an error the host
    ; does not have; declaring both would reintroduce Go's suffix split for a
    ; reason belonging entirely to us. `any` demands nothing, so ONE name
    ; serves — at the price of no numeric checking on this target at all.
    (prim +   (any any) any expr "%s + %s"  pure)
    (prim -   (any any) any expr "%s - %s"  pure)
    (prim *   (any any) any expr "%s * %s"  pure)
    ; A ZERO DIVISOR IS A PRECONDITION, NOT A BEHAVIOUR — integers.md §5 — and
    ; THIS IS THE TARGET WHERE IT MATTERS MOST. Go panics, Java throws and x86
    ; raises #DE; JavaScript returns Infinity for `1/0` and NaN for `1%0` and
    ; keeps going, so the only thing standing between a program and a silently
    ; wrong answer is this obligation.
    (prim /   ((a any) (b any)) any expr "%s / %s"  pure (where (!= b 0)))

    ; INTEGER DIVISION, which this host does not have. `/` is FLOAT division
    ; here -- `7 / 2` is 3.5 -- where Go, Java and x86 all divide integers and
    ; truncate toward zero (integers.md §3).
    ;
    ; So the language's `/` resolves to THIS on JavaScript and to the plain `/`
    ; elsewhere, which is the parasite model doing exactly its job: the host
    ; that lacks the operation says how to get it, in its own file, and no other
    ; target learns that JavaScript is different.
    ;
    ; `Math.trunc` and not `| 0`: the bitwise form coerces to int32 and would
    ; silently wrap every value past 2^31, which is well inside ADR 0012's
    ; window. Exact for every integer the window admits.
    (prim idiv ((a any) (b any)) any expr "Math.trunc(%s / %s)" pure (where (!= b 0)))
    (prim %   ((a any) (b any)) any expr "%s %% %s" pure (where (!= b 0)))
    (prim **  (any any) any expr "%s ** %s" pure)
    (prim neg (any) any        expr "-%s"      pure)

    ; String concatenation is the SAME operator; with `any` operands, `js.+`
    ; already covers it. Nothing to add.

    ; ---- bitwise. These coerce to int32, which is a real semantic edge and
    ; exactly the sort of thing a portability claim would have to hide.
    ;
    ; MEASURED, and the numbers are worth having here rather than in a document
    ; (gauntlet/results/bitwise-2026-08-19.md):
    ;
    ;   (1<<40) | 0      Go/Java/x86 1099511627776    JS 0
    ;   3000000000 | 0   Go/Java/x86 3000000000       JS -1294967296
    ;   1 << 32          Go/Java/x86 4294967296       JS 1     (count masked by 31)
    ;
    ; Inside [-2^31, 2^31-1] all four hosts agree EXACTLY, and that boundary was
    ; measured rather than assumed. Outside it these silently return a different
    ; answer from every other target — no error, no warning, and nothing in the
    ; pipeline checks. A program using them has chosen JavaScript.
    ;
    ; `>>>` is worse than the others: it yields an UNSIGNED 32-bit result, so it
    ; escapes the window upward as well. Java's `>>>` is 64-bit and is a
    ; different function with the same spelling.
    (prim &    (any any) any expr "%s & %s"   pure)
    (prim |    (any any) any expr "%s | %s"   pure)
    (prim ^    (any any) any expr "%s ^ %s"   pure)
    (prim ~    (any) any        expr "~%s"       pure)
    (prim <<   (any any) any expr "%s << %s"  pure)
    (prim >>   (any any) any expr "%s >> %s"  pure)
    (prim >>>  (any any) any expr "%s >>> %s" pure)

    ; ---- comparison. Both equalities, because JS has both and they differ.
    (prim ===  (any any) bool expr "%s === %s" pure)
    (prim !==  (any any) bool expr "%s !== %s" pure)
    (prim ==   (any any) bool expr "%s == %s"  pure)
    (prim !=   (any any) bool expr "%s != %s"  pure)
    (prim <    (any any) bool expr "%s < %s"   pure)
    (prim <=   (any any) bool expr "%s <= %s"  pure)
    (prim >    (any any) bool expr "%s > %s"   pure)
    (prim >=   (any any) bool expr "%s >= %s"  pure)

    ; ---- logic and the nullish operators
    (prim &&  (any any) any     expr "%s && %s" pure)
    (prim ||  (any any) any     expr "%s || %s" pure)
    (prim !   (any) bool     expr "!%s"      pure)
    (prim ??  (any any) any     expr "%s ?? %s" pure)

    ; ---- literals JavaScript spells as keywords
    (prim null      (none) any     expr "null"      pure)
    (prim undefined (none) any     expr "undefined" pure)
    (prim NaN       (none) any  expr "NaN"       pure)
    (prim Infinity  (none) any  expr "Infinity"  pure)

    ; ---- operators that are keywords
    (prim typeof     (any) string      expr "typeof %s"        pure)
    (prim instanceof (any any) bool expr "%s instanceof %s" pure)
    (prim in         (string any) bool expr "%s in %s"      pure)
    (prim void       (any) any         expr "void %s"          pure)
    ; `delete` mutates, so it is not pure; its value is the object.
    (prim delete     (any string) any  stmt "delete %s[%s]")

    ; ---- global functions
    (prim parseInt   (string) any  expr "parseInt(%s, 10)" pure)
    (prim parseFloat (string) any  expr "parseFloat(%s)"   pure)
    (prim isNaN      (any) bool    expr "Number.isNaN(%s)" pure)
    (prim isFinite   (any) bool    expr "Number.isFinite(%s)" pure)
    (prim String     (any) string     expr "String(%s)"       pure)
    (prim Number     (any) any     expr "Number(%s)"       pure)
    (prim Boolean    (any) bool    expr "Boolean(%s)"      pure)
    (prim structuredClone (any) any   expr "structuredClone(%s)")

    ; ---- indexing and construction. ONE declaration each, covering every
    ; element type there is, because JavaScript containers are untyped. This is
    ; the clearest single contrast with targets/go/, which needs at-int,
    ; at-float64, at-string, at-bool and a `make` per type.
    (prim at     (any any) any     expr "%s[%s]"     pure index)
    ; NO `(length-of 0)` on `set`, and JavaScript is the reason the attribute
    ; had to be split in two. On Go, `c[i] = x` cannot change len(c) — an
    ; out-of-range store panics. On JavaScript `a[10] = x` on a three-element
    ; array EXTENDS IT to length 11, silently, and `a[10]` before that returns
    ; `undefined` rather than throwing (primitives.md §2). So a JS array store
    ; is a map insert, not an array store, and it claims no length.
    ;
    ; That is the same refusal `go.set-map` makes, arriving from the other
    ; direction: the two hosts spell the operation identically and disagree
    ; about whether it preserves a length.
    (prim set    (any any any) any stmt "%s[%s] = %s")
    (prim get    (any string) any     expr "%s[%s]"     pure)
    (prim put    (any string any) any stmt "%s[%s] = %s")
    (prim len    (any) any         expr "%s.length"  pure)
    ; `new Array(n)` and the typed arrays ARE n long. Declared `(length 0)`
    ; even though every argument here is typed `any` — which is exactly why the
    ; reading is declared rather than read off the argument's type.
    (prim Array  (any) any         expr "new Array(%s)"            (length 0))
    (prim ArrayFill (any any) any  expr "new Array(%s).fill(%s)"   (length 0))
    (prim Float64Array (any) any   expr "new Float64Array(%s)"     (length 0))
    (prim Int32Array   (any) any   expr "new Int32Array(%s)"       (length 0))
    ; A null-prototype object as a dictionary — baseline R4 measured Map at
    ; 3.25x slower for string keys.
    (prim object (none) any           expr "Object.create(null)")))
