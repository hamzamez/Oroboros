// JavaScript's operators and global functions, under their own names.
//
//   (use js)
//   (js.+ x y)   (js.=== a b)   (js.?? a b)   (js.** x 2)   (js.typeof v)
//
// Note what is NOT here compared to Go's builtin.oro: no type suffixes. JS has
// one number type and untyped containers, so `js.at` indexes anything and
// `js.+` adds anything. The suffix explosion in the Go target was OUR type
// table showing through; here there is nothing left for it to show.
// ═══ HOW WIDE A SHIFT IS EXACT HERE
//
// `x / 2^k` on a SIGNED value is not a shift -- truncation toward zero needs
// a rounding correction -- so the compiler rewrites it into one wherever it
// can PROVE the dividend is non-negative and fits this many bits. Worth
// **2.39x** on our fixed-limb factorial (shiftdiv-2026-09-03).
//
// This does NOT promote bitwise operators to the language, and integers.md
// §0a's reason for keeping them out stands. It lets the COMPILER use this
// host's own shift where it has proved the rewrite changes no answer.
//
// **31, not 63**, and this is the one place the four hosts disagree: V8
// coerces both operands of `>>` and `&` to int32, so the rewrite is sound
// here only below 2^31. Declaring the width rather than excluding the host
// is what lets a program whose values provably fit get it anyway.
repr shift 31

// ═══ WHERE THIS HOST'S OPERATORS WRAP (ADR 0082 item 3): JavaScript's `+` and
// `*` do not wrap at all, so it declares 32, the width of its int32 forms, and
// each fusable operation's wrapping form below (`add_wrap`). Each computes the
// signed 32-bit residue of ℤ's result for operands anywhere in its word: `| 0`
// and `Math.imul` apply ToInt32, which is π₃₂ˢ, first.
repr wrap 32

module js {
    // ---- THE CRASH (spec/errors.md §8, §9): crash : E → 0, ending the process
    // with the reason. The language's `abandon`, found by spelling; it never
    // returns, so the IR ends its region with `unreachable`.
    fn abandon(why ∈ String) (Any) { host stmt "throw new Error(${why})" }

    // ---- arithmetic, declared on `any`.
    //
    // Not laziness. JavaScript has ONE number type; our language has two, `int`
    // and `f64`, because that is what an integer and a float LITERAL type as.
    // Declaring `js.+` on either would make `(js.+ i 1.5)` an error the host
    // does not have; declaring both would reintroduce Go's suffix split for a
    // reason belonging entirely to us. `any` demands nothing, so ONE name
    // serves — at the price of no numeric checking on this target at all.
    // ---- the free monoid (string-operations.md §1)
    //
    // CONCATENATION is the monoid's operation and `""` its unit. V8 ropes it, so
    // it is O(1) amortised here where Go and the JVM copy — a difference in
    // PRICE and not in answer, which is what keeps it Tier 1.
    fn concat(a ∈ String, b ∈ String) (String) pure { host expr "${a} + ${b}" }

    // η : Scalar → Scalar*, the generator injection — the string of one scalar.
    // `fromCodePoint` and NOT `fromCharCode`, which takes a UTF-16 code unit and
    // would truncate every scalar above the BMP.
    // ITS DOMAIN IS Scalar = [0, D7FF] ∪ [E000, 10FFFF] (string-operations.md §7),
    // a disjunction, which the refinement layer decides by case split. Outside it
    // the hosts disagree observably — Go gives U+FFFD, JavaScript a lone
    // surrogate or a RangeError, Java an exception or a lone char — so the
    // language's operation states one domain on every target
    // (gotarget-2026-09-30).
    fn string_of(c ∈ Int) (String) pure
        where c >= 0 && c <= 1114111 && (c <= 55295 || c >= 57344) {
        host expr "String.fromCodePoint(${c})"
    }

    fn `+`(a ∈ Any, b ∈ Any) (Any) pure { host expr "${a} + ${b}" }
    fn `-`(a ∈ Any, b ∈ Any) (Any) pure { host expr "${a} - ${b}" }
    fn `*`(a ∈ Any, b ∈ Any) (Any) pure { host expr "${a} * ${b}" }
    // A ZERO DIVISOR IS A PRECONDITION, NOT A BEHAVIOUR — integers.md §5 — and
    // THIS IS THE TARGET WHERE IT MATTERS MOST. Go panics, Java throws and x86
    // raises #DE; JavaScript returns Infinity for `1/0` and NaN for `1%0` and
    // keeps going, so the only thing standing between a program and a silently
    // wrong answer is this obligation.
    fn `/`(a ∈ Any, b ∈ Any) (Any) pure where `!=`(b, 0) { host expr "${a} / ${b}" }

    // INTEGER DIVISION, which this host does not have. `/` is FLOAT division
    // here -- `7 / 2` is 3.5 -- where Go, Java and x86 all divide integers and
    // truncate toward zero (integers.md §3).
    //
    // So the language's `/` resolves to THIS on JavaScript and to the plain `/`
    // elsewhere, which is the parasite model doing exactly its job: the host
    // that lacks the operation says how to get it, in its own file, and no other
    // target learns that JavaScript is different.
    //
    // `Math.trunc` and not `| 0`: the bitwise form coerces to int32 and would
    // silently wrap every value past 2^31, which is well inside ADR 0012's
    // window. Exact for every integer the window admits.
    // The trailing `+ 0` is NEGATIVE ZERO, and it is not a nicety. `Math.trunc`
    // and `%` both yield `-0` on this host whenever the true result is zero and
    // the dividend is negative -- `-1 / 2` is `-0`, `-2 % 2` is `-0` -- where Go,
    // Java and x86 all give `0`. It compares equal to zero (`-0 === 0`), every
    // arithmetic operation normalises it, and `String(-0)` is `"0"`, so it hides
    // almost everywhere; `console.log` prints it as `-0`, so the SAME PROGRAM
    // printed 0 on three targets and -0 on one.
    //
    // `+ 0` maps `-0` to `0` and is the identity on every other value, including
    // every negative one: `-1 + 0` is `-1`. One addition, no branch.
    fn idiv(a ∈ Any, b ∈ Any) (Any) pure
        where `!=`(b, 0) {
        host expr "(Math.trunc(${a} / ${b}) + 0)"
    }
    fn irem(a ∈ Any, b ∈ Any) (Any) pure where `!=`(b, 0) { host expr "((${a} % ${b}) + 0)" }
    fn `%`(a ∈ Any, b ∈ Any) (Any) pure where `!=`(b, 0) { host expr "${a} % ${b}" }
    fn `**`(a ∈ Any, b ∈ Any) (Any) pure { host expr "${a} ** ${b}" }
    fn neg(a ∈ Any) (Any) pure { host expr "-${a}" }

    // String concatenation is the SAME operator; with `any` operands, `js.+`
    // already covers it. Nothing to add.
    // ---- bitwise. These coerce to int32, which is a real semantic edge and
    // exactly the sort of thing a portability claim would have to hide.
    //
    // MEASURED, and the numbers are worth having here rather than in a document
    // (gauntlet/results/bitwise-2026-08-19.md):
    //
    //   (1<<40) | 0      Go/Java/x86 1099511627776    JS 0
    //   3000000000 | 0   Go/Java/x86 3000000000       JS -1294967296
    //   1 << 32          Go/Java/x86 4294967296       JS 1     (count masked by 31)
    //
    // Inside [-2^31, 2^31-1] all four hosts agree EXACTLY, and that boundary was
    // measured rather than assumed. Outside it these silently return a different
    // answer from every other target — no error, no warning, and nothing in the
    // pipeline checks. A program using them has chosen JavaScript.
    //
    // `>>>` is worse than the others: it yields an UNSIGNED 32-bit result, so it
    // escapes the window upward as well. Java's `>>>` is 64-bit and is a
    // different function with the same spelling.
    fn `&`(a ∈ Any, b ∈ Any) (Any) pure { host expr "${a} & ${b}" }
    fn `|`(a ∈ Any, b ∈ Any) (Any) pure { host expr "${a} | ${b}" }
    fn `^`(a ∈ Any, b ∈ Any) (Any) pure { host expr "${a} ^ ${b}" }
    fn `~`(a ∈ Any) (Any) pure { host expr "~${a}" }
    fn `<<`(a ∈ Any, b ∈ Any) (Any) pure { host expr "${a} << ${b}" }
    fn `>>`(a ∈ Any, b ∈ Any) (Any) pure { host expr "${a} >> ${b}" }
    fn `>>>`(a ∈ Any, b ∈ Any) (Any) pure { host expr "${a} >>> ${b}" }

    // ---- THE LANGUAGE'S BOOLEAN OPERATIONS (ADR 0082), which JavaScript's
    // operators above are not. ToInt32 is π₃₂ˢ, and and, or and xor descend to
    // ℤ/2³², so `a & b` is π₃₂ˢ of the true and for any integer operands: it IS
    // the and wherever the result is proven in S₃₂, and `>>> 0` reads the same
    // bits unsigned wherever it is proven in U₃₂. Each realization's result set
    // says which; the IR picks by the proven result (ADR 0083 item 2), and a
    // result in neither is refused until the split is built (integers.md §0b).
    // not, the shifts and the remainder are exact on JavaScript's whole word:
    // −a − 1, a·2ᵏ and ⌊a/2ᵏ⌋ in doubles are exact on integers below 2⁵³, a count
    // past 64 cannot move a floor, and `+ 0` turns a −0 remainder into 0.
    fn and(a ∈ Int, b ∈ Int) (-2^31..2^31-1) pure { host expr "(${a} & ${b})" }
    fn and_u32(a ∈ Int, b ∈ Int) (0..2^32-1) pure { host expr "((${a} & ${b}) >>> 0)" }
    fn or(a ∈ Int, b ∈ Int) (-2^31..2^31-1) pure { host expr "(${a} | ${b})" }
    fn or_u32(a ∈ Int, b ∈ Int) (0..2^32-1) pure { host expr "((${a} | ${b}) >>> 0)" }
    fn xor(a ∈ Int, b ∈ Int) (-2^31..2^31-1) pure { host expr "(${a} ^ ${b})" }
    fn xor_u32(a ∈ Int, b ∈ Int) (0..2^32-1) pure { host expr "((${a} ^ ${b}) >>> 0)" }
    fn not(a ∈ Int) (Int) pure { host expr "(-(${a}) - 1)" }
    fn shl(a ∈ Int, b ∈ Int) (Int) pure where b >= 0 { host expr "(${a} * 2 ** ${b})" }
    fn sar(a ∈ Int, b ∈ Int) (Int) pure where b >= 0 { host expr "Math.floor(${a} / 2 ** Math.min(${b}, 64))" }
    // ⌊a/2ᵏ⌋ IN THE INT32 WINDOWS, chosen by the operands' facts (ADR 0083
    // item 2): ToUint32 is the identity on U₃₂ and `>>>` its floor by 2ᵏ, as
    // ToInt32 and `>>` are on S₃₂, for a count below 32, which JavaScript masks.
    fn sar_u32(a ∈ 0..2^32-1, b ∈ 0..31) (0..2^32-1) pure { host expr "(${a} >>> ${b})" }
    fn sar_s32(a ∈ -2^31..2^31-1, b ∈ 0..31) (-2^31..2^31-1) pure { host expr "(${a} >> ${b})" }
    fn add_wrap(a ∈ Int, b ∈ Int) (Int) pure { host expr "(((${a} | 0) + (${b} | 0)) | 0)" }
    fn sub_wrap(a ∈ Int, b ∈ Int) (Int) pure { host expr "(((${a} | 0) - (${b} | 0)) | 0)" }
    fn mul_wrap(a ∈ Int, b ∈ Int) (Int) pure { host expr "Math.imul(${a}, ${b})" }
    fn neg_wrap(a ∈ Int) (Int) pure { host expr "((-(${a} | 0)) | 0)" }
    fn not_wrap(a ∈ Int) (Int) pure { host expr "(~${a})" }
    fn shl_wrap(a ∈ Int, b ∈ Int) (Int) pure { host expr "(${a} << ${b})" }
    fn emod(a ∈ Int, m ∈ Int) (Int) pure where m > 0 {
        host expr "((a, m) => { const r = a % m; return r < 0 ? r + m : r + 0; })(${a}, ${m})"
    }

    // ---- comparison. Both equalities, because JS has both and they differ.
    fn `===`(a ∈ Any, b ∈ Any) (Bool) pure { host expr "${a} === ${b}" }
    fn `!==`(a ∈ Any, b ∈ Any) (Bool) pure { host expr "${a} !== ${b}" }
    fn `==`(a ∈ Any, b ∈ Any) (Bool) pure { host expr "${a} == ${b}" }
    fn `!=`(a ∈ Any, b ∈ Any) (Bool) pure { host expr "${a} != ${b}" }
    fn `<`(a ∈ Any, b ∈ Any) (Bool) pure { host expr "${a} < ${b}" }
    fn `<=`(a ∈ Any, b ∈ Any) (Bool) pure { host expr "${a} <= ${b}" }
    fn `>`(a ∈ Any, b ∈ Any) (Bool) pure { host expr "${a} > ${b}" }
    fn `>=`(a ∈ Any, b ∈ Any) (Bool) pure { host expr "${a} >= ${b}" }

    // ---- logic and the nullish operators
    fn `&&`(a ∈ Any, b ∈ Any) (Any) pure { host expr "${a} && ${b}" }
    fn `||`(a ∈ Any, b ∈ Any) (Any) pure { host expr "${a} || ${b}" }
    fn `!`(a ∈ Any) (Bool) pure { host expr "!${a}" }
    fn `??`(a ∈ Any, b ∈ Any) (Any) pure { host expr "${a} ?? ${b}" }

    // ---- literals JavaScript spells as keywords
    fn null() (Any) pure { host expr "null" }
    fn undefined() (Any) pure { host expr "undefined" }
    fn NaN() (Any) pure { host expr "NaN" }
    fn Infinity() (Any) pure { host expr "Infinity" }

    // ---- operators that are keywords
    fn typeof(a ∈ Any) (String) pure { host expr "typeof ${a}" }
    fn instanceof(a ∈ Any, b ∈ Any) (Bool) pure { host expr "${a} instanceof ${b}" }
    fn in(a ∈ String, b ∈ Any) (Bool) pure { host expr "${a} in ${b}" }
    fn void(a ∈ Any) (Any) pure { host expr "void ${a}" }
    // `delete` mutates, so it is not pure; its value is the object.
    fn delete(a ∈ Any, b ∈ String) (Any) { host stmt "delete ${a}[${b}]" }

    // ---- global functions
    fn parseInt(a ∈ String) (Any) pure { host expr "parseInt(${a}, 10)" }
    fn parseFloat(a ∈ String) (Any) pure { host expr "parseFloat(${a})" }
    fn isNaN(a ∈ Any) (Bool) pure { host expr "Number.isNaN(${a})" }
    fn isFinite(a ∈ Any) (Bool) pure { host expr "Number.isFinite(${a})" }
    fn String(a ∈ Any) (String) pure { host expr "String(${a})" }
    fn Number(a ∈ Any) (Any) pure { host expr "Number(${a})" }
    fn Boolean(a ∈ Any) (Bool) pure { host expr "Boolean(${a})" }
    fn structuredClone(a ∈ Any) (Any) { host expr "structuredClone(${a})" }

    // ---- indexing and construction. ONE declaration each, covering every
    // element type there is, because JavaScript containers are untyped. This is
    // the clearest single contrast with targets/go/, which needs at-int,
    // at-float64, at-string, at-bool and a `make` per type.
    fn at(a ∈ Any, b ∈ Any) (Any) pure index { host expr "${a}[${b}]" }
    // NO length postcondition on `set`, and JavaScript is the reason a count and
    // a pass-through had to be told apart. On Go, `c[i] = x` cannot change len(c) — an
    // out-of-range store panics. On JavaScript `a[10] = x` on a three-element
    // array EXTENDS IT to length 11, silently, and `a[10]` before that returns
    // `undefined` rather than throwing (primitives.md §2). So a JS array store
    // is a map insert, not an array store, and it claims no length.
    //
    // That is the same refusal `go.set-map` makes, arriving from the other
    // direction: the two hosts spell the operation identically and disagree
    // about whether it preserves a length.
    fn `set`(a ∈ Any, b ∈ Any, c ∈ Any) (Any) { host stmt "${a}[${b}] = ${c}" }
    fn get(a ∈ Any, b ∈ String) (Any) pure { host expr "${a}[${b}]" }
    fn put(a ∈ Any, b ∈ String, c ∈ Any) (Any) { host stmt "${a}[${b}] = ${c}" }
    fn len(a ∈ Any) (Any) pure { host expr "${a}.length" }
    // `new Array(n)` and the typed arrays ARE n long. Declared as a postcondition
    // even though every argument here is typed `any` — which is exactly why the
    // reading is declared rather than read off the argument's type.
    fn Array(n ∈ Any) (r ∈ Any) ensure len(r) == n { host expr "new Array(${n})" }
    fn ArrayFill(n ∈ Any, x ∈ Any) (r ∈ Any)
        ensure len(r) == n {
        host expr "new Array(${n}).fill(${x})"
    }
    fn Float64Array(n ∈ Any) (r ∈ Any) ensure len(r) == n { host expr "new Float64Array(${n})" }
    fn Int32Array(n ∈ Any) (r ∈ Any) ensure len(r) == n { host expr "new Int32Array(${n})" }
    // A null-prototype object as a dictionary — baseline R4 measured Map at
    // 3.25x slower for string keys.
    fn object() (Any) { host expr "Object.create(null)" }
}
