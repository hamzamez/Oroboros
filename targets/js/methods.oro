; Methods on values — Array, String, Map, Set.
;
; This is where the source STOPS reading like JavaScript, and the reason is
; worth naming precisely. JS spells a method call `receiver.method(args)`. We
; spell every call `(name args…)`, so the closest we get is
;
;   (Array.map a f)      emits   a.map(f)
;   (String.toUpperCase s) emits s.toUpperCase()
;
; The EMITTED code is exactly right — a template's first hole is the receiver,
; so nothing is lost at run time. What is lost is the reading order: the
; receiver moves from before the dot to after the paren. That is the one thing
; a Lisp surface cannot spell about a method-oriented host, and no amount of
; target-file work changes it.
;
; The higher-order half — map, filter, reduce, sort — is declared and CANNOT BE
; CALLED, because a bare abstraction is refused as an escaping closure — though see
; docs/spec/callbacks.md: a lambda written AT THE CALL SITE needs no function value
; and the host does the capture, so this is a missing template hole rather than a
; capability gap. That is
; deliberate and measured: js-toplevel-2026-08-18 puts those methods at 3.6x to
; 133x SLOWER than a loop, so the one thing this language cannot reach on this
; host is the one thing not worth reaching.

(target js
  (module js/Array
    (sig isArray  (any) bool    pure         (host expr "Array.isArray(%s)"))
    (sig from     (any) any       pure             (host expr "Array.from(%s)"))
    (sig of       (any) any         pure             (host expr "Array.of(%s)"))
    (sig slice    (any any any) any   pure (host expr "%s.slice(%s, %s)"))
    (sig concat   (any any) any        pure         (host expr "%s.concat(%s)"))
    (sig indexOf  (any any) any       pure      (host expr "%s.indexOf(%s)"))
    (sig lastIndexOf (any any) any   pure   (host expr "%s.lastIndexOf(%s)"))
    (sig includes (any any) bool      pure     (host expr "%s.includes(%s)"))
    (sig join     (any string) string          pure   (host expr "%s.join(%s)"))
    (sig push     (any any) any         (host stmt "%s.push(%s)"))
    (sig pop      (any) any             (host expr "%s.pop()"))
    (sig shift    (any) any             (host expr "%s.shift()"))
    (sig unshift  (any any) any         (host stmt "%s.unshift(%s)"))
    (sig reverse  (any) any             (host stmt "%s.reverse()"))
    (sig fill     (any any) any         (host stmt "%s.fill(%s)"))
    (sig flat     (any) any            pure             (host expr "%s.flat()"))

    ; Higher-order. Declared so the target is honest about what JS has; every
    ; one is unreachable, because passing a λ is an escaping closure.
    (sig map      (any any) any       pure    (host expr "%s.map(%s)"))
    (sig filter   (any any) any    pure    (host expr "%s.filter(%s)"))
    (sig reduce   (any any any) any pure (host expr "%s.reduce(%s, %s)"))
    (sig forEach  (any any) any    (host stmt "%s.forEach(%s)"))
    (sig some     (any any) bool     pure (host expr "%s.some(%s)"))
    (sig every    (any any) bool    pure (host expr "%s.every(%s)"))
    (sig find     (any any) any      pure    (host expr "%s.find(%s)"))
    (sig findIndex (any any) any pure (host expr "%s.findIndex(%s)"))
    (sig sort     (any any) any    (host stmt "%s.sort(%s)")))

  (module js/String
    (sig length      (string) any         pure         (host expr "%s.length"))
    (sig charAt      (string any) string            pure  (host expr "%s[%s]"))
    (sig charCodeAt  (string any) any pure  (host expr "%s.charCodeAt(%s)"))
    (sig codePointAt (string any) any pure  (host expr "%s.codePointAt(%s)"))
    (sig slice       (string any any) string pure (host expr "%s.slice(%s, %s)"))
    (sig substring   (string any any) string pure (host expr "%s.substring(%s, %s)"))
    (sig indexOf     (string string) any    pure  (host expr "%s.indexOf(%s)"))
    (sig includes    (string string) bool   pure (host expr "%s.includes(%s)"))
    (sig startsWith  (string string) bool pure (host expr "%s.startsWith(%s)"))
    (sig endsWith    (string string) bool   pure (host expr "%s.endsWith(%s)"))
    (sig toUpperCase (string) string  pure         (host expr "%s.toUpperCase()"))
    (sig toLowerCase (string) string  pure         (host expr "%s.toLowerCase()"))
    (sig trim        (string) string         pure         (host expr "%s.trim()"))
    (sig trimStart   (string) string    pure         (host expr "%s.trimStart()"))
    (sig trimEnd     (string) string      pure         (host expr "%s.trimEnd()"))
    (sig repeat      (string any) string     pure  (host expr "%s.repeat(%s)"))
    (sig padStart    (string any string) string pure (host expr "%s.padStart(%s, %s)"))
    (sig split       (string string) any      pure     (host expr "%s.split(%s)"))
    (sig replace     (string string string) string pure (host expr "%s.replace(%s, %s)"))
    (sig replaceAll  (string string string) string pure (host expr "%s.replaceAll(%s, %s)"))
    (sig concat      (string string) string     pure  (host expr "%s.concat(%s)"))
    (sig at          (string any) string         pure  (host expr "%s.at(%s)"))
    (sig fromCharCode (any) string pure        (host expr "String.fromCharCode(%s)"))
    ; Runs of non-whitespace — Go's strings.Fields semantics, spelled in JS.
    (sig fields      (string) any    pure (host expr "(%s.match(/\\S+/g) ?? [])")))

  (module js/Map
    (sig new    () any        (host expr "new Map()"))
    (sig get    (any any) any      pure     (host expr "%s.get(%s)"))
    (sig set    (any any any) any (host stmt "%s.set(%s, %s)"))
    (sig has    (any any) bool      pure (host expr "%s.has(%s)"))
    (sig delete (any any) bool (host stmt "%s.delete(%s)"))
    (sig size   (any) any         pure      (host expr "%s.size"))
    (sig clear  (any) any         (host stmt "%s.clear()")))

  (module js/Set
    (sig new    () any        (host expr "new Set()"))
    (sig add    (any any) any     (host stmt "%s.add(%s)"))
    (sig has    (any any) bool      pure (host expr "%s.has(%s)"))
    (sig delete (any any) bool (host stmt "%s.delete(%s)"))
    (sig size   (any) any         pure      (host expr "%s.size"))))
