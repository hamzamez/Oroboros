// Σ_LLVM, LLVM IR's own operations, AS THEY ARE (ADR 0080 item 7, ADR 0088,
// llvmsurvey-2026-10-27). Declared by hand, family by family. Each says what
// the instruction computes on i64, and its domain, the inputs where it is
// neither poison nor undefined, is its `where` or its parameters' sets: an
// obligation at every call, discharged by the IR or the program is refused. A
// primitive the language cannot state is a wall, brought to hamza, and is not
// declared.
//
//   (use llvm)   llvm.add(a, b)   llvm.sdiv(a, b)   llvm.shl(a, b)
//
// NOTHING HERE IS THE LANGUAGE. Which declaration computes the language's `+`
// or `<<` on this target is said by `realize` in windows.oro; where an
// instruction is not the language's operation on its whole domain (`shl` past
// 63, `srem` of −2⁶³ by −1), the realization is a form in lang.oro, and the
// instruction keeps its own domain here.
//
// THE FLAGS ARE THE PRINTER'S: `add` wraps, and `add nsw` is `add` on the
// inputs whose sum is in the word. Which inputs an instance has is a proof
// about it, which the IR holds and a declaration cannot (llvm.md §5).
module llvm {
    // ---- integer arithmetic on i64: the residue mod 2⁶⁴ of ℤ's result
    // (ADR 0082), so total; ℤ's own where the result is in the word.
    fn add(a ∈ Int, b ∈ Int) (Int) pure { host expr "add ${a}, ${b:v}" }
    fn sub(a ∈ Int, b ∈ Int) (Int) pure { host expr "sub ${a}, ${b:v}" }
    fn mul(a ∈ Int, b ∈ Int) (Int) pure { host expr "mul ${a}, ${b:v}" }

    // sdiv and srem truncate, as ℤ's `/` and `%` do (integers.md §3). Each is
    // undefined for a zero divisor and for −2⁶³ by −1 (LangRef): both are the
    // domain.
    fn sdiv(a ∈ Int, b ∈ Int) (Int) pure where ne(b, 0) && (ne(a, -2^63) || ne(b, -1)) {
        host expr "sdiv ${a}, ${b:v}"
    }
    fn srem(a ∈ Int, b ∈ Int) (Int) pure where ne(b, 0) && (ne(a, -2^63) || ne(b, -1)) {
        host expr "srem ${a}, ${b:v}"
    }
    // udiv and urem on ℕ ∩ S₆₄: for 0 ≤ a < 2⁶³ and b > 0, truncation is the
    // floor, so a / b = ⌊a/b⌋ and a % b = a mod b, and an i64 in [0, 2⁶³) has
    // the same bits read signed or unsigned. So they are ℤ's `/` and `%` on
    // this domain, with no sign to fix up: by 2^k, `lshr` and `and`.
    fn udiv_nat(a ∈ 0..2^63-1, b ∈ 1..2^63-1) (0..2^63-1) pure { host expr "udiv ${a}, ${b:v}" }
    fn urem_nat(a ∈ 0..2^63-1, b ∈ 1..2^63-1) (0..2^63-2) pure { host expr "urem ${a}, ${b:v}" }

    // ---- the bitwise operations: ℤ's own on the word (ADR 0082), total.
    fn and(a ∈ Int, b ∈ Int) (Int) pure { host expr "and ${a}, ${b:v}" }
    fn or(a ∈ Int, b ∈ Int) (Int) pure { host expr "or ${a}, ${b:v}" }
    fn xor(a ∈ Int, b ∈ Int) (Int) pure { host expr "xor ${a}, ${b:v}" }

    // ---- shifts: poison for a count of 64 or more (LangRef), so the count's
    // set is 0..63. `shl` is a·2ᵇ mod 2⁶⁴; `ashr` is ⌊a/2ᵇ⌋.
    fn shl(a ∈ Int, b ∈ 0..63) (Int) pure { host expr "shl ${a}, ${b:v}" }
    fn ashr(a ∈ Int, b ∈ 0..63) (Int) pure { host expr "ashr ${a}, ${b:v}" }

    // ---- the overflow intrinsics: W × W → W × 𝔹, (a, b) ↦ (s, o) with o
    // true exactly when ℤ's result leaves the word, and s ℤ's result where it
    // does not (the residue mod 2⁶⁴ where it does). Total; two results, which
    // LLVM answers as the aggregate {i64, i1}.
    fn sadd_with_overflow(a ∈ Int, b ∈ Int) (Int × Bool) pure {
        host expr "call {i64, i1} @llvm.sadd.with.overflow.i64(${a}, ${b})" import "declare {i64, i1} @llvm.sadd.with.overflow.i64(i64, i64)"
    }
    fn ssub_with_overflow(a ∈ Int, b ∈ Int) (Int × Bool) pure {
        host expr "call {i64, i1} @llvm.ssub.with.overflow.i64(${a}, ${b})" import "declare {i64, i1} @llvm.ssub.with.overflow.i64(i64, i64)"
    }
    fn smul_with_overflow(a ∈ Int, b ∈ Int) (Int × Bool) pure {
        host expr "call {i64, i1} @llvm.smul.with.overflow.i64(${a}, ${b})" import "declare {i64, i1} @llvm.smul.with.overflow.i64(i64, i64)"
    }

    // ---- the trap: 1 → ∅. It never returns (ADR 0090); impure, so it is
    // never moved or dropped.
    fn trap() (∅) { host stmt "call void @llvm.trap()" import "declare void @llvm.trap()" }

    // ---- comparisons: `icmp` with its signed predicates, the order on the
    // word read as two's complement.
    fn eq(a ∈ Int, b ∈ Int) (Bool) pure { host expr "icmp eq ${a}, ${b:v}" }
    fn ne(a ∈ Int, b ∈ Int) (Bool) pure { host expr "icmp ne ${a}, ${b:v}" }
    fn slt(a ∈ Int, b ∈ Int) (Bool) pure { host expr "icmp slt ${a}, ${b:v}" }
    fn sle(a ∈ Int, b ∈ Int) (Bool) pure { host expr "icmp sle ${a}, ${b:v}" }
    fn sgt(a ∈ Int, b ∈ Int) (Bool) pure { host expr "icmp sgt ${a}, ${b:v}" }
    fn sge(a ∈ Int, b ∈ Int) (Bool) pure { host expr "icmp sge ${a}, ${b:v}" }

    // ---- THE SAME INSTRUCTIONS READ UNSIGNED, on U₆₄ = [0, 2⁶⁴) (ADR 0083,
    // llvm.md §3a). i64 carries no sign, so the ring's and the bits' operations
    // are the instructions above under U's reading, ℤ/2⁶⁴'s, and ℤ's own where
    // the result is proven in U; order, the quotient, the remainder and the right
    // shift are U's own instructions. A value moves between S₆₄ and U₆₄ as its
    // bits, which is the integer on [0, 2⁶³).
    fn u_add(a ∈ u64, b ∈ u64) (u64) pure { host expr "add ${a}, ${b:v}" }
    fn u_sub(a ∈ u64, b ∈ u64) (u64) pure { host expr "sub ${a}, ${b:v}" }
    fn u_mul(a ∈ u64, b ∈ u64) (u64) pure { host expr "mul ${a}, ${b:v}" }
    // udiv and urem are undefined for a zero divisor, the one point of their domain.
    fn u_div(a ∈ u64, b ∈ u64) (u64) pure where `!=`(b, 0) { host expr "udiv ${a}, ${b:v}" }
    fn u_rem(a ∈ u64, b ∈ u64) (u64) pure where `!=`(b, 0) { host expr "urem ${a}, ${b:v}" }
    fn u_lt(a ∈ u64, b ∈ u64) (Bool) pure { host expr "icmp ult ${a}, ${b:v}" }
    fn u_le(a ∈ u64, b ∈ u64) (Bool) pure { host expr "icmp ule ${a}, ${b:v}" }
    fn u_gt(a ∈ u64, b ∈ u64) (Bool) pure { host expr "icmp ugt ${a}, ${b:v}" }
    fn u_ge(a ∈ u64, b ∈ u64) (Bool) pure { host expr "icmp uge ${a}, ${b:v}" }
    fn u_eq(a ∈ u64, b ∈ u64) (Bool) pure { host expr "icmp eq ${a}, ${b:v}" }
    fn u_and(a ∈ u64, b ∈ u64) (u64) pure { host expr "and ${a}, ${b:v}" }
    fn u_or(a ∈ u64, b ∈ u64) (u64) pure { host expr "or ${a}, ${b:v}" }
    fn u_xor(a ∈ u64, b ∈ u64) (u64) pure { host expr "xor ${a}, ${b:v}" }
    // shl and lshr are poison past a count of 63, their domain's end.
    fn u_shl(a ∈ u64, b ∈ 0..63) (u64) pure { host expr "shl ${a}, ${b:v}" }
    fn u_lshr(a ∈ u64, b ∈ 0..63) (u64) pure { host expr "lshr ${a}, ${b:v}" }
    // The bits, unchanged, under the other reading: the identity on [0, 2⁶³).
    fn u_of(x ∈ Int) (u64) pure { host expr "or ${x}, 0" }
    fn int_of_u(x ∈ u64) (Int) pure { host expr "or ${x}, 0" }

    // ---- THE ROUNDINGS ONTO F64 (ADR 0086, numbers.md §6.2, llvm.md §3b).
    // LLVM's default floating-point environment rounds to nearest, ties to
    // even, with traps disabled and the status flags not observed (LangRef,
    // "Floating-Point Environment"). There, `fadd`, `fsub`, `fmul` and `fdiv` on
    // `double` with no fast-math flag are IEEE 754 binary64's correctly
    // rounded operations (§4.3.1), and without `contract` no two of them
    // fuse: two roundings stay two instructions. Each `ensure` is the term the
    // instruction computes, on operands in F64 whose rounding is finite; that
    // finiteness and a divisor not zero are the rounding's own obligations,
    // decided where the program writes it, so ±∞, NaN and −0 are never made.
    fn fadd(a ∈ F64, b ∈ F64) (r ∈ F64) pure ensure r == round(F64, a + b) { host expr "fadd ${a}, ${b:v}" }
    fn fsub(a ∈ F64, b ∈ F64) (r ∈ F64) pure ensure r == round(F64, a - b) { host expr "fsub ${a}, ${b:v}" }
    fn fmul(a ∈ F64, b ∈ F64) (r ∈ F64) pure ensure r == round(F64, a * b) { host expr "fmul ${a}, ${b:v}" }
    fn fdiv(a ∈ F64, b ∈ F64) (r ∈ F64) pure ensure r == round(F64, a ÷ b) { host expr "fdiv ${a}, ${b:v}" }
    // An integer within ±2⁵³ is a double, so `sitofp` of it is exact: its
    // rounding is itself.
    fn fint(n ∈ -2^53..2^53) (r ∈ F64) pure ensure r == round(F64, n) { host expr "sitofp ${n} to double" }
    // N's order on F64 is IEEE's on finite doubles, which compares them as
    // reals (§5.11): `fcmp oeq` reads −0 = +0, as d does. With NaN not in F64,
    // an ordered predicate and its unordered twin agree on every pair; the
    // ordered one is false on NaN, so it claims nothing of a value F64 lacks.
    fn f_eq(a ∈ F64, b ∈ F64) (Bool) pure { host expr "fcmp oeq ${a}, ${b:v}" }
    fn f_lt(a ∈ F64, b ∈ F64) (Bool) pure { host expr "fcmp olt ${a}, ${b:v}" }
    fn f_le(a ∈ F64, b ∈ F64) (Bool) pure { host expr "fcmp ole ${a}, ${b:v}" }
    fn f_gt(a ∈ F64, b ∈ F64) (Bool) pure { host expr "fcmp ogt ${a}, ${b:v}" }
    fn f_ge(a ∈ F64, b ∈ F64) (Bool) pure { host expr "fcmp oge ${a}, ${b:v}" }

    // ---- the null pointer, LLVM's constant `null` of type ptr: 1 → ptr. It is
    // what Win32 takes where SAL says a pointer is `_opt_` or `_Reserved_`,
    // and the language cannot read through it (ADR 0084: no load without a
    // view). An instruction must name it, so it is the address null + 0.
    fn null() (ptr) pure { host expr "getelementptr i8, ptr null, i64 0" }
    // `icmp eq` on ptr against null: whether an allocator's answer is no region.
    fn is_null(p ∈ ptr) (Bool) pure { host expr "icmp eq ${p}, null" }
}
