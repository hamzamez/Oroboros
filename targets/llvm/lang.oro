// THE TARGET'S INTERPRETATION OF THE LANGUAGE WHERE NO SINGLE LLVM OPERATION
// IS IT (ADR 0088, 0089): each a derived operation, a term over the host's
// operations (instructions.oro, and os.oro's Σ_OS, ADR 0093), so
// ι : Σ_L → T(Σ_LLVM + Σ_OS) is a theory
// interpretation (Goguen and Burstall), written in the language, checked as a
// program is, and inlined by the IR for the operation it realizes
// (ir/realize.go).
//
// EACH TERM IS DEFINED AND AGREES WITH THE LANGUAGE ON THE OPERATION'S
// DOMAIN, its header that domain. DEFINED: every host operation in it is used
// inside its own domain, an obligation decided once against the header, as a
// program's are. AGREES: ⟦ι(f)⟧(x) = f(x), checked against ℤ's definition
// (ir/realize_test.go); a checked form agrees where f(x) is in the word and
// traps elsewhere. A term may rely on the site's own obligation, decided
// before it is substituted: `<<`'s answers 0 past a count of 63 because a·2ᵏ is
// in the word only for a = 0.
//
// Two host shapes make the checked forms terms (ADR 0090): a call into a
// PRODUCT, LLVM's overflow intrinsics answering W × 𝔹, taken apart by a tuple
// pattern; and a call into ∅, `llvm.trap` and Σ_OS's `exit`, which never
// return, so 0 → Y types the branch they end.
//
// LLVM computes a branch both ways and chooses with `select` where that is
// cheaper; that is LLVM's speculation, sound because each arm is defined
// where it is taken. Where the IR proves an instance inside an instruction's
// own domain, the instruction is chosen for it (`realize`'s later names) and
// no term is printed.
//
// THE ALLOCATOR IS A TERM too (ADR 0092): a table's storage is an operation of
// the IR, so ι reaches it, and its arithmetic is decided at the site. Its
// region, like the crash's write and exit, is the operating system's: Σ_OS,
// this layer's parameter, which an OS layer defines (ADR 0093).
module lang {
    use llvm
    use llvm/os as os
    use llvm/str as str

    // ¬ν (ADR 0091): no byte of the string is 0. Exact on UTF-8, where U+0000 is
    // the byte 0 and every byte of a longer sequence is at least 0x80, so
    // ν(s) = [0 ∈ utf8(s)].
    fn no_nul(s ∈ String) (Bool) {
        b = str.utf8(s)
        loop i = 0 { i >= len(b) -> true; b[i] == 0 -> false; else -> again(i + 1) }
    }

    // V'S AUTOMATON (ADR 0112, strings.md §11), Table 3-7: the state (k, lo,
    // hi), k continuation bytes still owed and the next one's range. b ∈ V iff
    // the bytes run from owing nothing back to owing nothing.
    fn v_accepts(b ∈ Array(0..255)) (Bool) {
        loop i = 0, k = 0, lo = 128, hi = 191 {
            i >= len(b) -> k == 0
            k > 0 && (b[i] < lo || b[i] > hi) -> false
            k > 0 -> again(i + 1, k - 1, 128, 191)
            b[i] < 128 -> again(i + 1, 0, 128, 191)
            b[i] < 194 -> false
            b[i] < 224 -> again(i + 1, 1, 128, 191)
            b[i] == 224 -> again(i + 1, 2, 160, 191)
            b[i] == 237 -> again(i + 1, 2, 128, 159)
            b[i] < 240 -> again(i + 1, 2, 128, 191)
            b[i] == 240 -> again(i + 1, 3, 144, 191)
            b[i] < 244 -> again(i + 1, 3, 128, 191)
            b[i] == 244 -> again(i + 1, 3, 128, 143)
            else -> false
        }
    }

    // ---- THE FREE MONOID Σ* ON THIS LAYER (strings-2026-11-16): a string is
    // the table of its UTF-8, ρ : Σ* ≅ V ⊂ B* (str.oro), so each of the
    // language's string operations is a table's, restricted to V, read back by
    // ρ⁻¹ = str.text. Each table is the allocator's, so it carries the zero
    // past its bytes, the C string's NUL, and is a table like any other to the
    // decision, the storage and the printer. These replace four functions
    // written as LLVM text the compiler could not read (ADR 0089).

    // η : Scalar → Σ*, the generator: a scalar's UTF-8, Table 3-7's rows, under
    // the scalars' domain, U+0000..U+10FFFF less the surrogates, which every
    // target states (Go's `string(rune(c))`). A realization is a term over the
    // host's operations (ADR 0089), so the digits base 64 are LLVM's `sdiv` and
    // `srem`, inside their domain (the divisors are powers of two, c ≥ 0, where
    // truncation is the floor). The bytes are computed, and V on
    // computed bytes needs a fact per position the decision does not keep, so a
    // guard of at most four of V's steps decides it; the agreement test runs
    // every scalar, so the arm that abandons is dead (TestEveryScalarEncodes).
    fn encode(c ∈ Int) (String) where c >= 0 && c <= 1114111 && (c <= 55295 || c >= 57344) {
        b = case {
            c < 128 -> alloc(array { c })
            c < 2048 -> alloc(array { 192 + llvm.sdiv(c, 64), 128 + llvm.srem(c, 64) })
            c < 65536 -> alloc(array { 224 + llvm.sdiv(c, 4096), 128 + llvm.srem(llvm.sdiv(c, 64), 64), 128 + llvm.srem(c, 64) })
            else -> alloc(array { 240 + llvm.sdiv(c, 262144), 128 + llvm.srem(llvm.sdiv(c, 4096), 64),
                128 + llvm.srem(llvm.sdiv(c, 64), 64), 128 + llvm.srem(c, 64) })
        }
        if utf8_valid(b) { str.text(b) } else { abandon("string_of: a scalar's UTF-8 is not valid UTF-8") }
    }

    // ·, the monoid's operation, on V: x·y, a rule over both tables. V is a
    // submonoid of B* (V = φ⁻¹(F) with F = {q₀}, q₀ initial: δ(q₀, xy) =
    // δ(δ(q₀, x), y) = q₀), so x·y ∈ V of x, y ∈ V, and the obligation is
    // decided by that theorem on the rule (emit/requires.go), with no pass.
    // Two strings each as long as a table may be have no table their length:
    // a join past os.max_len is exhaustion, as allocate's request past it is.
    fn cat(a ∈ String, b ∈ String) (String) {
        x = str.utf8(a)
        y = str.utf8(b)
        n = len(x) + len(y)
        case {
            n <= os.max_len() -> str.text(alloc(array { if k < len(x) { x[k] } else { y[k - len(x)] } : k ∈ 0..n - 1 }))
            else -> llvm.trap()
        }
    }

    // ι : (B₇)* ↪ Σ* (ADR 0095): the word b[lo, lo + n) as text, a copy of the
    // segment into a table of its own, ASCII's ρ⁻¹.
    fn ascii_of(b ∈ Array(0..127), lo ∈ 0..2^63-1, n ∈ 0..2^63-1) (String) where lo + n <= len(b) {
        str.text_ascii(alloc(array { b[lo + i] : i ∈ 0..n - 1 }))
    }

    // ι_V : V ↪ Σ* (ADR 0112): valid UTF-8 as text, a copy of the table, which
    // is b extensionally, so the copy is in V by b's own `where`. The copy is
    // the table's own storage for the string, not the NUL's, which every
    // table has: ι_V as the identity, b moved into its string, is the step
    // after this one (owed).
    fn text_v(b ∈ Array(0..255)) (String) where utf8_valid(b) {
        str.text(alloc(array { b[i] : i ∈ 0..len(b) - 1 }))
    }

    // ~a = a ⊕ (−1) = −a − 1, the complement: LLVM has no `not`.
    fn complement(a ∈ Int) (Int) { llvm.xor(a, -1) }

    // a·2ᵇ for every b ≥ 0. Past 63 the instruction is poison, and a·2ᵇ is in
    // the word only for a = 0, which `<<`'s obligation at the site makes it.
    fn shl(a ∈ Int, b ∈ Nat) (Int) { if b <= 63 { llvm.shl(a, b) } else { 0 } }

    // ON U₆₄ (llvm.md §3a): a·2ᵇ mod 2⁶⁴ and ⌊a/2ᵇ⌋ for every b ≥ 0, each 0
    // past 63, where the instruction is poison.
    fn u_shl(a ∈ u64, b ∈ Nat) (u64) { if b <= 63 { llvm.u_shl(a, b) } else { llvm.u_of(0) } }
    fn u_shr(a ∈ u64, b ∈ Nat) (u64) { if b <= 63 { llvm.u_lshr(a, b) } else { llvm.u_of(0) } }

    // ⌊a/2ᵇ⌋ for every b ≥ 0: past 63 it is 0 or −1, which is ⌊a/2⁶³⌋.
    fn ashr(a ∈ Int, b ∈ Nat) (Int) { if b <= 63 { llvm.ashr(a, b) } else { llvm.ashr(a, 63) } }

    // THE EUCLIDEAN REMAINDER for a positive divisor (ADR 0082): srem takes the
    // dividend's sign, and a negative one is moved up by m.
    fn emod(a ∈ Int, m ∈ Int) (Int) where m > 0 {
        r = llvm.srem(a, m)
        if r < 0 { r + m } else { r }
    }

    // ℤ'S TRUNCATING `%` AND `/` (integers.md §3) on every divisor but 0.
    // srem and sdiv are undefined for −2⁶³ by −1, so −1 is its own arm: a % −1
    // is 0, and a / −1 is −a, the language's `−`, so 2⁶³ is refused or trapped
    // at the site as any result outside the word is (ADR 0019).
    fn rem(a ∈ Int, b ∈ Int) (Int) where b != 0 { if b == -1 { 0 } else { llvm.srem(a, b) } }
    fn div(a ∈ Int, b ∈ Int) (Int) where b != 0 { if b == -1 { 0 - a } else { llvm.sdiv(a, b) } }

    // THE CHECKED ARITHMETIC (-checked, ADR 0019): f where ℤ's result is in the
    // word, a trap elsewhere. The overflow intrinsic answers both the value and
    // whether ℤ's result left the word.
    fn add_checked(a ∈ Int, b ∈ Int) (Int) { (s, o) = llvm.sadd_with_overflow(a, b); if o { llvm.trap() } else { s } }
    fn sub_checked(a ∈ Int, b ∈ Int) (Int) { (s, o) = llvm.ssub_with_overflow(a, b); if o { llvm.trap() } else { s } }
    fn mul_checked(a ∈ Int, b ∈ Int) (Int) { (s, o) = llvm.smul_with_overflow(a, b); if o { llvm.trap() } else { s } }

    // `<<` UNDER -checked: a·2ᵇ is in the word iff b ≤ 62 and the product a·2ᵇ
    // does not overflow, or a = 0, or b = 63 and a = −1, whose product is −2⁶³.
    fn shl_checked(a ∈ Int, b ∈ Nat) (Int) {
        case {
            b <= 62 -> { (s, o) = llvm.smul_with_overflow(a, llvm.shl(1, b)); if o { llvm.trap() } else { s } }
            a == 0 -> 0
            b == 63 && a == -1 -> -9223372036854775807 - 1
            else -> llvm.trap()
        }
    }

    // `/` UNDER -checked: the quotient where it is in the word, a trap at
    // −2⁶³ / −1, the one point where it is not: there 0 − a overflows.
    fn div_checked(a ∈ Int, b ∈ Int) (Int) where b != 0 {
        if b == -1 { (s, o) = llvm.ssub_with_overflow(0, a); if o { llvm.trap() } else { s } } else { llvm.sdiv(a, b) }
    }

    // THE FIXED-LIMB RUNG'S CARRY CHECK (emit/bignum.oro): 0 when handed 0, and
    // otherwise the crash with the bound's reason, the words every host's
    // `big-fit` and `trap-if` say (ADR 0029: the program's one set, enforced
    // with one outcome on every representation). crash : E → ∅, so the branch
    // is typed by its other arm (ADR 0090).
    fn trap_if(a ∈ Int) (Int) { if a == 0 { 0 } else { crash("bignum overflow: the declared range is too small") } }

    // THE CRASH (spec/errors.md §8): crash : E → ∅. The reason's bytes and a
    // newline to standard error, then exit status 1, every step Σ_OS's.
    fn crash(why ∈ String) (∅) {
        w = os.write_err(str.utf8(why))
        e = os.write_err(array { 10 })
        os.exit(1)
    }

    // ---- A TABLE'S REGION: its 8-byte length, its n elements of w bytes, and
    // ONE ZERO BYTE past them (strings-2026-11-16). The zero is what makes a
    // table of bytes a C string, x·0 with x its bytes: a string here is the
    // table of its UTF-8 (V ⊂ B*), so a string's NUL, which Win32's LPCSTR reads
    // (ADR 0091), is the allocator's, and making a string from bytes copies
    // nothing for it. b(n, w) = n·w + 9 is every term's size below, one
    // definition, so an allocation and its release ask one size.
    // n ≤ ⌊(2⁶³ − 9)/8⌋, allocate's own bound, so n·w + 9 is in the word
    fn bytes(n ∈ 0..1152921504606846974, w ∈ 1..8) (Nat) { n * w + 9 }

    // ---- RELEASE (ADR 0096): a table's storage given back at its death, the
    // inverse of `allocate`. n is len(t) and w its element width, so the region
    // is b(n, w) bytes, the size `allocate` asked `region` for; n ≤ 2⁴⁷ − 9 by
    // the address space (windows.oro's max_len), so the size is in the word.
    // ir.Release places the call, and the verifier's W11 checks it.
    fn release(t ∈ ptr, n ∈ 0..2^47-9, w ∈ 1..8) (Bool) { os.release(t, bytes(n, w)) }

    // REUSE (ADR 0096): release(p, b) followed by region(b) is the region p,
    // zeroed, up to its address, since nothing reaches p after its release
    // (W11). So an allocation handed a dead region's token of its own size
    // takes the token, zeroed, and allocates only when the token is null (a
    // loop's first iteration). ir.Reuse hands tokens only of equal size, and
    // W12 checks it.
    fn reuse(tok ∈ ptr, n ∈ 0..2^47-9, w ∈ 1..8) (ptr) {
        // b ≤ A_t is zero's precondition (ADR 0122 item 3), true of a dead
        // region, which `region` answered; the token carries no fact of its
        // size, so it is tested, the arm past it exhaustion (a missing proof)
        if llvm.is_null(tok) { allocate(n, w) } else {
            b = bytes(n, w)
            z = if b <= os.max_bytes() { os.zero(tok, b) } else { llvm.trap() }
            tok
        }
    }

    // A TOKEN GIVEN BACK (ADR 0096's reuse): on an iteration's arm that makes
    // no table of its size, the token it was handed is released, unless it is
    // null, so a token is consumed once on every path.
    fn discard(tok ∈ ptr, n ∈ 0..2^47-9, w ∈ 1..8) (Bool) {
        if llvm.is_null(tok) { true } else { release(tok, n, w) }
    }

    // ---- RENDERING (ADR 0095): render : ℤ → Σ*, the sign of n and the digits of
    // |n|, by Euclidean division, at the signed word's sort S; a value held as
    // limbs is the limb library's (ir/limbs.go), this layer having no bignum.
    // A realization is a term over the host's operations (ADR 0089), so the
    // quotient and remainder by 10 are LLVM's `sdiv` and `srem`, inside their
    // domain (10 is neither 0 nor −1) and ℤ's truncated division on S. A word
    // has at most 19 digits: digit k at 19 − k, `top` the most significant,
    // every index linear in k. −2⁶³ has no negation in the word and is its own
    // numeral; every other negative n is a sign and the digits of −n. The
    // digits are ASCII, so the text is ι of them, taken while b is live.
    fn render(n ∈ -2^63..2^63-1) (String) {
        case {
            n < -9223372036854775807 -> "-9223372036854775808"
            else -> {
                var b := array { 48 : _ ∈ 0..19 }
                loop m = if n < 0 { 0 - n } else { n }, k = 0, top = 19 {
                    k > 18 && n < 0 -> { b[top - 1] := 45; ascii(b, top - 1, 21 - top) }
                    k > 18 -> ascii(b, top, 20 - top)
                    else -> {
                        b[19 - k] := 48 + llvm.srem(m, 10)
                        again(llvm.sdiv(m, 10), k + 1, if m > 0 { 19 - k } else { top })
                    }
                }
            }
        }
    }

    // ---- MEMORY (ADR 0092): ι(alloc), alloc : ℕ × {1, 8} → Region, a table of
    // n elements of w bytes behind its 8-byte length, zero on creation, its
    // semantics. A request past what any address space holds is EXHAUSTION, as
    // a null answer is, so the term is total. The guard bounds n by the widest
    // element, n ≤ ⌊(2⁶³ − 9)/8⌋, so that n·w + 8 is inside the word for every
    // w ∈ 1..8 by the intervals alone; a request it turns away is above 2⁶⁰
    // elements, past x64's 2⁴⁷ bytes, exhaustion either way. The guard states
    // the whole domain, 0 ≤ n, so that the arm proves n·w + 8 from its own π
    // whatever facts the site has (a length a trapped operation computed).
    fn allocate(n ∈ Nat, w ∈ 1..8) (ptr) {
        case {
            // b ≤ A_t is region's precondition (ADR 0122 item 3): one name, so
            // the guard and the obligation are one atom; past it, exhaustion
            n >= 0 && n <= (2^63 - 9) / 8 -> {
                b = bytes(n, w)
                if b <= os.max_bytes() { os.region(b) } else { llvm.trap() }
            }
            else -> llvm.trap()
        }
    }

    // A TABLE BORN FULL (ADR 0084's U3, fill-2026-11-09): region = zero ∘ raw,
    // and when every element is written before any is read, the zero is a dead
    // store. So a rule, an array literal, and a build whose written-prefix
    // theorem holds (ir/fill.go) take a region with no zeroing, and a token
    // without it. No element store reaches the byte past the elements, so the
    // raw region's zero there is written here, one byte; a token of the same
    // size holds its predecessor's, untouched since.
    fn allocate_raw(n ∈ Nat, w ∈ 1..8) (ptr) {
        case {
            n >= 0 && n <= (2^63 - 9) / 8 -> {
                b = bytes(n, w)
                p = if b <= os.max_bytes() { os.region_raw(b) } else { llvm.trap() }
                // THE BYTE PAST THE ELEMENTS AT EITHER LAYOUT (ADR 0122's
                // windows32 finding): a table is asked at w and laid out at
                // b ∈ {1, w}, b final only after every pass (W15), so the zero
                // is written at n·w + 8 and at n + 8. Laid out at w, n + 8 is
                // among the elements, all written after (born full); laid out
                // at 1, it is the string's NUL, where the heap's byte was.
                z = llvm.store_zero(llvm.offset(p, n * w + 8))
                z1 = llvm.store_zero(llvm.offset(p, n + 8))
                p
            }
            else -> llvm.trap()
        }
    }
    fn reuse_raw(tok ∈ ptr, n ∈ 0..2^47-9, w ∈ 1..8) (ptr) {
        // its predecessor's elements overwrote n + 8 (laid out at w), so the
        // zero of the narrower layout is written again
        if llvm.is_null(tok) { allocate_raw(n, w) } else { z1 = llvm.store_zero(llvm.offset(tok, n + 8)); tok }
    }

    // A DEAD REGION SERVES A REQUEST OF ITS CLASS (R1d, ADR 0107): a token of k
    // elements of width w was a table of b(k, w) bytes, and release(p, b) ;
    // region(b') ≡ zero(p, b') whenever class(b') = class(b) (os.class, the
    // block's capacity). So it is taken when the classes agree, a longer
    // table included, and given back otherwise; the sizes are the run's,
    // compared here, where R1b's were equal by the facts.
    fn reuse_fit(tok ∈ ptr, k ∈ 0..2^47-9, n ∈ 0..2^47-9, w ∈ 1..8) (ptr) {
        case {
            llvm.is_null(tok) -> allocate(n, w)
            os.class(bytes(n, w)) == os.class(bytes(k, w)) -> {
                b = bytes(n, w)
                z = if b <= os.max_bytes() { os.zero(tok, b) } else { llvm.trap() }
                tok
            }
            else -> { r = release(tok, k, w); allocate(n, w) }
        }
    }
    fn reuse_fit_raw(tok ∈ ptr, k ∈ 0..2^47-9, n ∈ 0..2^47-9, w ∈ 1..8) (ptr) {
        case {
            llvm.is_null(tok) -> allocate_raw(n, w)
            // a shorter table's end falls inside its predecessor's elements
            os.class(bytes(n, w)) == os.class(bytes(k, w)) -> {
                z = llvm.store_zero(llvm.offset(tok, n * w + 8))
                z1 = llvm.store_zero(llvm.offset(tok, n + 8))
                tok
            }
            else -> { r = release(tok, k, w); allocate_raw(n, w) }
        }
    }

    // ---- THE MAP (ADR 0120). ρ_M takes a map of capacity c to the table t of
    // 3n cells, n = slots(c) = min{2ʲ ≥ 2c}: slot s holds the used flag t[3s],
    // the key t[3s + 1] and the value t[3s + 2]; its abstraction is
    // d(t) = {(t[3s + 1], t[3s + 2]) : t[3s] = 1}. Open addressing with linear
    // probing, hash k & (n − 1): n is a power of two, so the mask lands in
    // [0, n) for every k, negative ones too (ℤ's `&`, ADR 0082), and the load
    // factor is at most 1/2. Each term below is a homomorphism,
    // d(h(op(m))) = op(d(m)), substituted after the decision (ir/maps.go), so
    // the decision sees the map and not this table. A build zero-fills, so a
    // fresh table is the empty map: every used flag 0.

    // slots(c), total: a capacity past 2⁴⁵ asks for more than an address space
    // holds, and the allocator answers that with exhaustion, so n stops there.
    // n − c ≥ c is n ≥ 2c without forming 2c.
    fn map_slots(c ∈ Nat) (1..2^46) {
        loop n = 1 { n - c >= c || n >= 2^45 -> n; else -> again(n * 2) }
    }
    // the cell count, build-map's realization: build-map(c) is build(cells(c))
    fn map_cells(c ∈ Nat) (3..3 * 2^46) { 3 * map_slots(c) }
    // the slot count, read off the table: len(t) = 3n by construction. LLVM's
    // sdiv, whose domain a divisor of 3 decides (b ≠ 0, b ≠ −1), and for
    // len(t) ≥ 0 truncation is the floor
    fn map_n(t ∈ Array(Int)) (Int) { llvm.sdiv(len(t), 3) }
    // the slot for key k at probe distance i, in [0, n)
    fn map_slot(n ∈ 1..2^46, k ∈ Int, i ∈ 0..2^46) (Int) { llvm.and(llvm.and(k, n - 1) + i, n - 1) }
    // a cell, 0 off the table: the slot's mask is not linear, so the guard is
    // the read's proof (refinements.md §3a)
    fn map_at(t ∈ Array(Int), x ∈ Int) (Int) { if x < 0 || x >= len(t) { 0 } else { t[x] } }

    // FIND: the value cell of k, or −1 when k is absent. Linear probing leaves no
    // gap before a key it stored, so an empty slot ends the probe, and n probes
    // visit every slot. n ≤ 2⁴⁶ (map_slots makes at most 2⁴⁵), stated in the
    // probe's guard since a table's length has no upper bound here.
    fn map_find(t ∈ Array(Int), k ∈ Int) (-1..2^63-1) {
        n = map_n(t)
        loop i = 0 {
            i >= n || n < 1 || n > 2^46 -> -1
            map_at(t, 3 * map_slot(n, k, i)) == 0 -> -1
            map_at(t, 3 * map_slot(n, k, i) + 1) == k -> {
                x = 3 * map_slot(n, k, i) + 2
                if x >= 0 && x < len(t) { x } else { -1 }
            }
            else -> again(i + 1)
        }
    }

    // INSERT, m[k ↦ v]: the slot holding k is overwritten, or the first empty
    // one on k's probe claimed. A full table keeps m, which the capacity's
    // obligation (maps.md §6) makes unreachable. The table is lent and written
    // in place; every index is computed before the first store.
    fn map_put(t ∈ Array(Int) linear, k ∈ Int, v ∈ Int) {
        n = map_n(t)
        loop i = 0 {
            i >= n || n < 1 || n > 2^46 -> ()
            map_at(t, 3 * map_slot(n, k, i)) == 0 -> {
                u = 3 * map_slot(n, k, i)
                case {
                    u < 0 || u + 2 >= len(t) -> ()
                    else -> { t[u] := 1; t[u + 1] := k; t[u + 2] := v; () }
                }
            }
            map_at(t, 3 * map_slot(n, k, i) + 1) == k -> {
                x = 3 * map_slot(n, k, i) + 2
                case {
                    x < 0 || x >= len(t) -> ()
                    else -> { t[x] := v; () }
                }
            }
            else -> again(i + 1)
        }
    }

    // READ, m[k] : Option(V): the option's tag and payload, 1 and 0 when k is
    // absent, 0 and the value when present (the sum's encoding, ADR 0042).
    fn map_get(t ∈ Array(Int), k ∈ Int) {
        f = map_find(t, k)
        if f < 0 { (1, 0) } else { (0, map_at(t, f)) }
    }

    // |dom m|, the used flags counted
    fn map_size(t ∈ Array(Int)) (0..2^63-1) {
        n = map_n(t)
        loop c = 0, s = 0 {
            s >= n -> c
            else -> again(c + (if map_at(t, 3 * s) == 1 { 1 } else { 0 }), s + 1)
        }
    }

    // How many keys of m lie below k: with distinct keys, k's index in
    // ascending order.
    fn map_rank(t ∈ Array(Int), k ∈ Int) (0..2^63-1) {
        n = map_n(t)
        loop c = 0, s = 0 {
            s >= n -> c
            map_at(t, 3 * s) == 0 -> again(c, s + 1)
            else -> again(if map_at(t, 3 * s + 1) < k { c + 1 } else { c }, s + 1)
        }
    }

    // a store guarded by its table's domain, the identity off it
    fn map_w(o ∈ Array(Int) linear, i ∈ Int, v ∈ Int) { if i >= 0 && i < len(o) { o[i] := v } else { () } }

    // KEYS, ascending: a map's keys are distinct, so each key's sorted position
    // is its rank, written in one pass with no exchange. The rank is below
    // |dom m| = len(o), a count the refinement layer does not relate to the
    // loop, so the store is guarded (a missing proof, store-2026-11-16).
    fn map_keys(t ∈ Array(Int)) {
        cnt = map_size(t)
        n = map_n(t)
        var o := array { 0 : _ ∈ 0..cnt-1 }
        loop s = 0 {
            s >= n -> o
            map_at(t, 3 * s) == 0 -> again(s + 1)
            else -> { map_w(o, map_rank(t, map_at(t, 3 * s + 1)), map_at(t, 3 * s + 1)); again(s + 1) }
        }
    }

    // A LITERAL, map { k : v, … }: its capacity is its size (maps.md §6), its
    // table filled by one loop, so one probe site whatever its size.
    fn map_of(ks ∈ Array(Int), vs ∈ Array(Int)) {
        var t := array { 0 : _ ∈ 0..map_cells(len(ks)) - 1 }
        loop i = 0 {
            i >= len(ks) -> t
            else -> { map_put(t, ks[i], map_at(vs, i)); again(i + 1) }
        }
    }
}
