// Σ_OS, THE LAYER'S PARAMETER (ADR 0093): what ι's terms need from an operating
// system and no LLVM instruction computes. Seven operation symbols, each a
// header with no body: an OS layer that glues `llvm` defines each, under the
// same header, and a target that defines none of them is refused when it is
// loaded. Their contracts are what lang.oro's terms rely on, so they hold of
// every definition:
//
//   region     b fresh bytes, every one 0, or the trap (exhaustion): a table is
//              zero on creation (tables.md); never a null an access could reach
//   release    the region of b bytes at p, which `region` answered for b, given
//              back (ADR 0096): release ∘ region is the identity on the heap,
//              and nothing reads the region after
//   zero       the b bytes at p, a dead region of b bytes, made 0: then they are
//              what `region(b)` answers, up to the address (ADR 0096's reuse)
//   region_raw b fresh bytes of any contents, or the trap: region = zero ∘
//              region_raw, for a table every element of which is written before
//              any is read
//   class      the capacity class: class(b') = class(b) means a region answered
//              for b holds b' bytes and release(p, b') gives it back (R1d's
//              reuse by fit, ADR 0100, 0107): a reuse keeps the class, so it
//              stays the region's
//   write_err  the bytes to standard error, answering whether they were written
//   exit       the process ends with the code; it never returns (ADR 0090). The
//              codes are 0..255, those every host reports the same way.
module llvm/os {
    fn region(b ∈ 0..2^63-1) (ptr)
    fn release(p ∈ ptr, b ∈ 0..2^63-1) (Bool)
    fn zero(p ∈ ptr, b ∈ 0..2^63-1) (Bool)
    fn region_raw(b ∈ 0..2^63-1) (ptr)
    fn class(b ∈ 0..2^63-1) (-2^63..65536)
    fn write_err(b ∈ Array(0..255)) (Bool)
    fn exit(code ∈ 0..255) (∅)
}
