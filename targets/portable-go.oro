; The PORTABLE Go target — preserved, not current.
;
; Everything here that is not structural is a PORTABILITY LAYER: num/f64,
; num/int, logic, io, alen/aindex, dict-*, split-words. Those names are ours,
; not Go's, and each one is a claim that three hosts agree.
;
; targets/go/ is the current Go target and makes no such claim: it declares Go's
; own names under Go's own semantics. This file is kept because the gauntlet's
; seven programs are written against the portable layer and are the record of
; what parity was measured on. See docs/spec/portability-layer.md.
;
; Adding a host function means adding a line here — requirement 4, "adding a
; target's APIs is close to a file listing names".
;
; Kinds:
;   expr   an expression; `form` is a template with %s holes
;   stmt   a statement; the value of the term is argument 0
;   let    binds a value to a name and continues       — implemented in code
;   cond   a conditional                               — implemented in code
;   loop   a fold with one accumulator                 — implemented in code
;   loop2  a fold with two accumulators and a finisher — implemented in code
;
; Structural kinds are NAMED here and IMPLEMENTED in the backend: a loop binds
; variables and emits a header, and no template expresses that.
;
; `pure` licenses the reducer to copy, drop and reorder an application of this
; primitive. It DEFAULTS OFF: forgetting it costs speed, where forgetting the
; opposite marker would cost correctness silently (docs/spec/effects.md §3).

(target portable-go
  ; Which code generator compiles this target (target-system.md §1.1).
  (backend go)

  (type f64        (host "float64"))
  ; int64 rather than int: Go's `int` is 64-bit on our platforms but is not
  ; guaranteed to be, and docs/spec/arithmetic.md §4 fixes the portable range
  ; at 2^53 on the assumption of a 64-bit integer underneath.
  (type int        (host "int64"))
  (type bool       (host "bool"))
  (type vec-f64    (host "[]float64"))
  (type string     (host "string"))
  (type vec-string (host "[]string"))
  (type dict       (host "map[string]int"))

  ; `any` is the host's own escape hatch, needed only at a boundary where the
  ; host itself is polymorphic — fmt.Println takes ...any. Boxing here is the
  ; host's, not ours (g5 §7).
  (type any        (host "any"))

  ; ---- experiment: docs/spec/loops.md's sibling question, the go/builtin probe.
  ; Types Go's predeclared identifiers need. Each concrete instantiation needs
  ; its own name: the type language has no constructors, so `[]int` and
  ; `[]bool` are two unrelated atoms rather than one applied to two arguments.
  (type slice-int    (host "[]int64"))
  (type slice-bool   (host "[]bool"))
  (type map-str-int  (host "map[string]int64"))

  ; Restricting a container to a known length. Go gains bounds-check
  ; elimination from it; JS has no bounds checks and Java's arrays cannot be
  ; narrowed, so neither declares one and neither gets the transformation.
  (repr narrow (host "%s := %s[:%s]"))

  ; ---------------------------------------------------------------- arithmetic
  ;
  ; Qualified, because `add` meaning float addition was never written down
  ; anywhere and does not survive two numeric types — primitive names are
  ; unique keys (arithmetic.md §5).

  (module num/f64
    (sig add (f64 f64) f64  pure  (host expr "%s + %s"))
    (sig sub (f64 f64) f64  pure  (host expr "%s - %s"))
    (sig mul (f64 f64) f64  pure  (host expr "%s * %s"))
    ; f64 division is Tier 1: all three hosts agree on every case measured,
    ; including x/0 = +-Inf and 0/0 = NaN, with no trap anywhere. It is
    ; INTEGER division that diverges, and arithmetic.md 7 conflated them.
    (sig div (f64 f64) f64  pure  (host expr "%s / %s"))
    (sig lt  (f64 f64) bool  pure (host expr "%s < %s"))
    (sig le  (f64 f64) bool pure (host expr "%s <= %s"))
    (sig gt  (f64 f64) bool  pure (host expr "%s > %s"))
    (sig ge  (f64 f64) bool pure (host expr "%s >= %s"))
    ; IEEE-754, so this is NOT an equivalence relation — arithmetic.md §6.
    (sig eq  (f64 f64) bool pure (host expr "%s == %s"))
    (sig sqrt (f64) f64 pure (host expr "math.Sqrt(%s)" (import "math")))
    ; |x| agrees on all three hosts for every case, including -0.0 and NaN.
    (sig abs  (f64) f64  pure (host expr "math.Abs(%s)" (import "math"))))

  (module num/int
    (sig add (int int) int  pure  (host expr "%s + %s"))
    (sig sub (int int) int  pure  (host expr "%s - %s"))
    (sig mul (int int) int  pure  (host expr "%s * %s"))
    (sig lt  (int int) bool  pure (host expr "%s < %s"))
    (sig le  (int int) bool pure (host expr "%s <= %s"))
    (sig gt  (int int) bool  pure (host expr "%s > %s"))
    (sig ge  (int int) bool pure (host expr "%s >= %s"))
    (sig eq  (int int) bool pure (host expr "%s == %s")))

  ; int -> f64 is EXACTLY lossless inside the portable range, because that
  ; range is 2^53 precisely so an f64 holds every integer in it
  ; (arithmetic.md 4). The lossy direction, f64 -> int, is still absent:
  ; it needs a rounding decision and no program has asked.
  (module num/f64
    (sig of-int (int) f64 pure (host expr "float64(%s)")))

  (module logic
    (sig and (bool bool) bool pure (host expr "%s && %s"))
    (sig or  (bool bool) bool pure (host expr "%s || %s"))
    (sig not (bool)      bool      pure (host expr "!%s")))

  ; ---------------------------------------------------------------- the rest
  ; Not yet migrated into modules; arithmetic.md covered only the above.

  ; `index` says argument 0 is a container indexed by argument 1. It is what
  ; lets the backend narrow a slice to the loop count and hand Go's own
  ; bounds-check elimination a proof — worth 1.96x, see
  ; gauntlet/results/bce-2026-08-15.md.
  (sig alen   (vec-f64) int pure      (host expr "int64(len(%s))"))
  ; The bounds obligation, finally checkable. primitives.md 2 records that
  ; aindex is Tier 1 only WITHIN BOUNDS -- outside them Go panics, Java
  ; throws, and JavaScript silently returns undefined.
  (sig aindex ((v vec-f64) (i int)) f64 pure index
    (where (logic.and (int.le 0 i) (int.lt i (alen v)))) (host expr "%s[%s]"))

  ; The one primitive that lets a program CONSTRUCT data (construction.md).
  ; Structural because it allocates and fills, which no template expresses --
  ; and the fifth structural kind, which corrected the claim that the set was
  ; closed at four.
  (structural make-vec build pure)

  ; Go's fused increment: one mapassign_faststr, verified in baseline C3.
  (sig slen       (vec-string) int pure         (host expr "int64(len(%s))"))
  (sig sat        (vec-string int) string  pure index  (host expr "%s[%s]"))
  (sig split-words (string) vec-string pure     (host expr "strings.Fields(%s)" (import "strings")))
  (sig dict-empty () dict              (host expr "make(map[string]int)"))
  (sig dict-inc   (dict string) dict       (host stmt "%s[%s]++"))

  ; Tier 2. Go, JS and Java print the same float three different ways, so this
  ; carries no portability claim — effects.md §6.



  ; ------------------------------------------------- go/builtin (EXPERIMENT)
  ;
  ; Go's predeclared identifiers — the `builtin` pseudo-package, which is
  ; exactly "everything usable with no import". A program that uses this module
  ; is NON-PORTABLE by construction, and that is the point: ADR 0001 says
  ; portability is a property a program may or may not have, and this is the
  ; first module written to deliberately not have it.
  ;
  ; See experiments/go-toplevel/ for what this could and could not reach.

  (module go/builtin
    ; Predeclared functions that are polymorphic in Go. `any` demands nothing,
    ; so one declaration serves every argument type — at the cost of the checker
    ; learning nothing from them.
    (sig len (any) int pure (host expr "int64(len(%s))"))
    (sig cap (any) int pure (host expr "int64(cap(%s))"))

    ; Go 1.21's min/max. Monomorphic here because the result type must be named.
    (sig min-int (int int) int pure (host expr "min(%s, %s)"))
    (sig max-int (int int) int pure (host expr "max(%s, %s)"))

    ; NOT pure, and the reason is worth keeping: append may write into the
    ; argument's backing array when capacity allows, so copying, dropping or
    ; reordering it is observable. The effect discipline pins it for free.
    (sig append-int (slice-int int) slice-int (host expr "append(%s, %s)"))

    ; make. One per element type, because the type is part of the syntax.
    (sig make-int ((n int)) slice-int (ensures (= (len result) n)) (host expr "make([]int64, %s)"))
    (sig make-bool ((n int)) slice-bool (ensures (= (len result) n)) (host expr "make([]bool, %s)"))
    (sig make-map  () map-str-int (host expr "make(map[string]int64)"))

    ; Indexed read and write. The write is a `stmt` whose value is argument 0,
    ; so it yields the container back and threads through a fold.
    (sig iat  ((v slice-int) (i int)) int pure index
      (where (logic.and (int.le 0 i) (int.lt i (len v))))  (host expr "%s[%s]"))
    (sig bat  ((v slice-bool) (i int)) bool pure index
      (where (logic.and (int.le 0 i) (int.lt i (len v)))) (host expr "%s[%s]"))
    (sig iset (slice-int int int)   slice-int  (host stmt "%s[%s] = %s"))
    (sig bset (slice-bool int bool) slice-bool (host stmt "%s[%s] = %s"))

    ; Maps. Reading a missing key yields the zero value, which is Go's rule and
    ; is why no `ok` appears: the two-value form needs multi-value return.
    (sig mat (map-str-int string) int pure (host expr "%s[%s]"))
    (sig mset (map-str-int string int) map-str-int (host stmt "%s[%s] = %s"))
    (sig mdel (map-str-int string) map-str-int (host stmt "delete(%s, %s)"))

    ; Slicing.
    (sig islice (slice-int int int) slice-int pure (host expr "%s[%s:%s]"))

    ; Integer division and remainder. NOT in num/int, deliberately: the three
    ; hosts disagree on truncation and on division by zero (arithmetic.md 7),
    ; so this is Go's operator with Go's semantics and carries no portability
    ; claim at all. That is what a target-specific module is for.
    (sig quo (int int) int pure (host expr "%s / %s"))
    (sig rem (int int) int pure (host expr "%s %% %s"))

    ; f64 -> int. Absent from num/f64 because it needs a rounding DECISION and
    ; the three hosts differ; here it is simply Go's conversion, which truncates
    ; toward zero, with no portability claim. The sieve is the first program to
    ; ask (loops.md), and asking in a target module is how a non-portable need
    ; gets met without pushing a decision into the core.
    (sig trunc-int (f64) int pure (host expr "int64(%s)"))

    ; Go's predeclared constants. The core has no boolean literal
    ; (arithmetic.md 3), so without these the only way to write `true` was
    ; `(logic.not (int.lt 1 2))`. Declaring them is the parasite answer: Go
    ; provides them, so the target says so.

    ; Panic, and the two predeclared printers that need no import.
    (sig panic   (any) any (host stmt "panic(%s)"))
    (sig println (any) any (host stmt "println(%s)")))

  ; go/fmt — the one import a program needs to say anything.
  (module go/fmt
    (sig println (any) any (host stmt "fmt.Println(%s)" (import "fmt")))
    (sig print   (any) any (host stmt "fmt.Print(%s)" (import "fmt"))))

  (module io
    (sig print-line (any) any (host stmt "fmt.Println(%s)" (import "fmt"))))

  ; The host toolchain, as data. %s is the artifact, %s the source directory.
  (build "go build -o %s %s")

  ; The four the BACKEND implements. No types: fold-range is
  ; A x int x ((A,int) -> A) -> A, which a monomorphic table cannot express,
  ; and writing one was a false statement (target-files.md §4).
  (structural fold-range  loop  pure)
  (structural fold-range2 loop2 pure))
