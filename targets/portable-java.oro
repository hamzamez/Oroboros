; The PORTABLE Java target - preserved, not current. targets/java/ is the
; host-native one. See docs/spec/target-native.md.
;
; The Java target.
;
; The dictionary goes the OPPOSITE way from Go's. Baseline R5 measured Java's
; fused merge(k,1,Integer::sum) at 2.6x slower than getOrDefault+put, because it
; boxes and makes a functional call per entry. Go's fused idiom wins; Java's
; loses. Same capability, opposite idiom, one source — ADR 0008 made concrete.

(target portable-java
  ; Which code generator compiles this target (target-system.md §1.1).
  (backend java)

  (type f64        (host "double"))
  (type int        (host "long"))
  ; The word: long (ADR 0026).
  (repr (int -9223372036854775808 9223372036854775807) word)
  (type bool       (host "boolean"))
  (type vec-f64    (host "double[]"))
  (type string     (host "String"))
  (type vec-string (host "String[]"))
  (type dict       (host "HashMap<String,Integer>"))
  (type any        (host "Object"))

  ; ---- experiment: java.lang's top level. See experiments/java-toplevel/.
  (type vec-int    (host "long[]"))
  (type vec-bool   (host "boolean[]"))
  (type strbuf     (host "StringBuilder"))
  (type char       (host "char"))


  ; Java arrays carry .length, so alen and slen share a shape — unlike Go, where
  ; len() is a function.
  (module num/f64
    (sig add (f64 f64) f64  pure  (host expr "%s + %s"))
    (sig sub (f64 f64) f64  pure  (host expr "%s - %s"))
    (sig mul (f64 f64) f64  pure  (host expr "%s * %s"))
    ; f64 division is Tier 1: all three hosts agree on every case measured,
    ; including x/0 = +-Inf and 0/0 = NaN, with no trap anywhere. It is
    ; INTEGER division that diverges, and arithmetic.md 7 conflated them.
    (sig div (f64 f64) f64  pure  (host expr "%s / %s"))
    (sig lt  (f64 f64) bool  pure (host expr "%s < %s"))
    (sig le  (f64 f64) bool pure (host expr "%s <= %s"))
    (sig gt  (f64 f64) bool  pure (host expr "%s > %s"))
    (sig ge  (f64 f64) bool pure (host expr "%s >= %s"))
    (sig eq  (f64 f64) bool pure (host expr "%s == %s"))
    (sig sqrt (f64) f64 pure (host expr "Math.sqrt(%s)"))
    (sig abs  (f64) f64  pure (host expr "Math.abs(%s)")))

  ; long, never int: Java's int wraps at 2^31, INSIDE the portable range
  ; (arithmetic.md §4). Declaring it would be a silent miscompilation.
  (module num/int
    (sig add (int int) int  pure  (host expr "%s + %s"))
    (sig sub (int int) int  pure  (host expr "%s - %s"))
    (sig mul (int int) int  pure  (host expr "%s * %s"))
    (sig lt  (int int) bool  pure (host expr "%s < %s"))
    (sig le  (int int) bool pure (host expr "%s <= %s"))
    (sig gt  (int int) bool  pure (host expr "%s > %s"))
    (sig ge  (int int) bool pure (host expr "%s >= %s"))
    (sig eq  (int int) bool pure (host expr "%s == %s")))

  ; int -> f64 is EXACTLY lossless inside the portable range, because that
  ; range is 2^53 precisely so an f64 holds every integer in it
  ; (arithmetic.md 4). The lossy direction, f64 -> int, is still absent:
  ; it needs a rounding decision and no program has asked.
  (module num/f64
    (sig of-int (int) f64 pure (host expr "(double) %s")))

  (module logic
    (sig and (bool bool) bool pure (host expr "%s && %s"))
    (sig or  (bool bool) bool pure (host expr "%s || %s"))
    (sig not (bool)      bool      pure (host expr "!%s")))

  (sig alen   (vec-f64) int pure      (host expr "%s.length"))
  ; Java array indices are int, not long. This template said `%s[%s]` and
  ; compiled only because fold-range happens to declare its index variable
  ; as int; a `loop` variable is our `int`, which is long, and the same
  ; template then fails to compile. The cast is free at run time.
  (sig aindex ((v vec-f64) (i int)) f64 pure index
    (where (logic.and (int.le 0 i) (int.lt i (alen v)))) (host expr "%s[(int) %s]"))

  (sig slen        (vec-string) int pure        (host expr "%s.length"))
  (sig sat         (vec-string int) string    pure (host expr "%s[%s]"))
  ; Go's strings.Fields semantics. split() cannot express it: even with (?U),
  ; which DOES handle Unicode whitespace correctly, it still yields a leading
  ; empty field for leading whitespace and one empty field for the empty
  ; string. A matcher over runs of non-whitespace is exact on all ten
  ; conformance cases — docs/spec/primitives.md.
  (sig split-words (string) vec-string
    pure (host expr
      "java.util.regex.Pattern.compile(\"[^\\\\p{IsWhite_Space}]+\").matcher(%s).results().map(java.util.regex.MatchResult::group).toArray(String[]::new)"))
  (sig dict-empty  () dict             (host expr "new HashMap<String,Integer>()"
                                                   (import "java.util.HashMap")))
  (sig dict-inc    (dict string) dict      (host stmt "%s.put(%s, %s.getOrDefault(%s, 0) + 1)"))


  ; Tier 2 — effects.md §6. This is the target that disagrees most: println
  ; prints 1.0 where Go and JS print 1, and 1.0E8 where JS prints 100000000.



  ; ------------------------------------------ java.lang's top level (EXPERIMENT)
  ;
  ; Java's top level is exactly `java.lang`, the one package auto-imported into
  ; every compilation unit. What it contains is narrower than either Go's or
  ; JavaScript's, and what it LACKS is the finding: java.util holds every
  ; collection, so at the top level there is no map, no list, and nothing
  ; growable except StringBuilder.
  ;
  ; Arrays are language-level rather than library, so they need no import — but
  ; they are fixed-length, which is the same statement from the other side.

  (module java/math
    (sig floor (f64) f64 pure      (host expr "Math.floor(%s)"))
    (sig ceil  (f64) f64  pure      (host expr "Math.ceil(%s)"))
    (sig round (f64) int pure      (host expr "Math.round(%s)"))
    (sig abs   (f64) f64   pure      (host expr "Math.abs(%s)"))
    (sig sqrt  (f64) f64  pure      (host expr "Math.sqrt(%s)"))
    (sig pow   (f64 f64) f64 pure  (host expr "Math.pow(%s, %s)"))
    (sig min   (int int) int pure  (host expr "Math.min(%s, %s)"))
    (sig max   (int int) int pure  (host expr "Math.max(%s, %s)"))
    (sig log   (f64) f64   pure      (host expr "Math.log(%s)"))
    (sig pi    () f64        pure     (host expr "Math.PI"))
    ; Not pure: two calls, two answers. An `expr` that is not pure, which is
    ; the case that kills the "expr means pure" heuristic (effects.md 3).
    (sig random () f64    (host expr "Math.random()")))

  ; Integer arithmetic Java's way. NOT in num/int: the hosts disagree on
  ; truncation and on division by zero, which throws here and does not on JS.
  (module java/int
    (sig quo   (int int) int  pure    (host expr "%s / %s"))
    (sig rem   (int int) int pure    (host expr "%s %% %s"))
    (sig parse (string) int pure     (host expr "Long.parseLong(%s)"))
    (sig to-string (int) string  pure (host expr "Long.toString(%s)"))
    (sig to-binary (int) string pure (host expr "Long.toBinaryString(%s)"))
    (sig bit-count (int) int  pure    (host expr "Long.bitCount(%s)"))
    (sig max-value () int     pure   (host expr "Long.MAX_VALUE")))

  ; java.lang.String. Immutable, so everything here is pure.
  (module java/string
    (sig len       (string) int        pure            (host expr "%s.length()"))
    (sig char-at   (string int) char pure       (host expr "%s.charAt((int) %s)"))
    (sig substring (string int int) string pure (host expr "%s.substring((int) %s, (int) %s)"))
    (sig index-of  (string string) int     pure     (host expr "%s.indexOf(%s)"))
    (sig contains? (string string) bool    pure    (host expr "%s.contains(%s)"))
    (sig starts?   (string string) bool  pure    (host expr "%s.startsWith(%s)"))
    (sig upper     (string) string   pure         (host expr "%s.toUpperCase()"))
    (sig lower     (string) string   pure         (host expr "%s.toLowerCase()"))
    (sig trim      (string) string         pure         (host expr "%s.strip()"))
    (sig repeat    (string int) string pure     (host expr "%s.repeat((int) %s)"))
    (sig concat    (string string) string          pure  (host expr "(%s + %s)"))
    (sig eq        (string string) bool      pure    (host expr "%s.equals(%s)"))
    (sig of-char   (char) string pure           (host expr "String.valueOf(%s)")))

  (module java/char
    (sig digit?  (char) bool     pure (host expr "Character.isDigit(%s)"))
    (sig letter? (char) bool    pure (host expr "Character.isLetter(%s)"))
    (sig space?  (char) bool pure (host expr "Character.isWhitespace(%s)"))
    (sig lower   (char) char pure (host expr "Character.toLowerCase(%s)"))
    (sig code    (char) int                 pure  (host expr "(long) %s")))

  ; StringBuilder — the ONLY growable container in java.lang. A `stmt` whose
  ; value is its receiver, so it threads through a fold like an accumulator.
  (module java/strbuf
    (sig empty     () strbuf          (host expr "new StringBuilder()"))
    (sig add       (strbuf string) strbuf (host stmt "%s.append(%s)"))
    (sig add-char  (strbuf char) strbuf   (host stmt "%s.append(%s)"))
    (sig len       (strbuf) int     pure           (host expr "%s.length()"))
    (sig to-string (strbuf) string   pure        (host expr "%s.toString()")))

  ; Arrays. Language-level, so no import — and fixed-length, so no append.
  ; One declaration per element type, because the type language has no
  ; constructors: long[] and boolean[] are unrelated atoms.
  (module java/array
    (sig make-int ((n int)) vec-int (ensures (= (len result) n)) (host expr "new long[(int) %s]"))
    (sig make-bool ((n int)) vec-bool (ensures (= (len result) n)) (host expr "new boolean[(int) %s]"))
    (sig len        (any) int pure                 (host expr "%s.length"))
    (sig iat        (vec-int int) int  pure         (host expr "%s[(int) %s]"))
    (sig bat        (vec-bool int) bool  pure       (host expr "%s[(int) %s]"))
    (sig iset       (vec-int int int) vec-int (host stmt "%s[(int) %s] = %s"))
    (sig bset       (vec-bool int bool) vec-bool (host stmt "%s[(int) %s] = %s"))
    (sig copy       (vec-int vec-int int) vec-int
                     (host stmt "System.arraycopy(%s, 0, %s, 0, (int) %s)")))

  (module java/system
    (sig println (any) any  (host stmt "System.out.println(%s)"))
    (sig errorln (any) any  (host stmt "System.err.println(%s)"))
    (sig nanos   () int (host expr "System.nanoTime()")))

  (module java/bool)

  (module io
    (sig print-line (any) any (host stmt "System.out.println(%s)")))

  ; javac produces a class DIRECTORY, not a single file, so the artifact here
  ; is a directory you run with `java -cp DIR Main`. Three hosts, three notions
  ; of what a deliverable is -- build.md 3.
  ;
  ; -encoding UTF-8 is not optional: javac defaults to the platform charset.
  ; See strings.md 5.
  (build "javac -encoding UTF-8 -d %s Main.java")

  ; The four the BACKEND implements. No types: fold-range is
  ; A x int x ((A,int) -> A) -> A, which a monomorphic table cannot express,
  ; and writing one was a false statement (target-files.md §4).
  (structural make-vec    build pure)
  (structural fold-range  loop  pure)
  (structural fold-range2 loop2 pure))
