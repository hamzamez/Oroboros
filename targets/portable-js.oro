; The PORTABLE JavaScript target - preserved, not current. targets/js/ is the
; host-native one. See docs/spec/target-native.md.
;
; The JavaScript target.
;
; Note what is ABSENT: no (type …) declarations at all. JS is untyped, so the
; whole type layer that Go and Java need is simply missing here — which is the
; evidence that types belong to the backend rather than to the language
; (gauntlet/results/js-2026-08-14.md).
;
; Argument types are still written, because they document the primitive and a
; future checker could use them regardless of target. ~~They are never
; consulted.~~ That future arrived: docs/spec/types.md's checker reads them on
; EVERY target, so this file is type-checked with types it does not itself use.
; The js-toplevel experiment had a fold accumulator start at 0 where it needed
; "", and the checker caught it here — on the target with no type layer.
;
; `pure` is consulted, on every target, because it is not a type — it decides
; whether β may move the term (docs/spec/effects.md §3).

(target portable-js

  (module num/f64
    (prim add (f64 f64) f64  expr "%s + %s"  pure)
    (prim sub (f64 f64) f64  expr "%s - %s"  pure)
    (prim mul (f64 f64) f64  expr "%s * %s"  pure)
    ; f64 division is Tier 1: all three hosts agree on every case measured,
    ; including x/0 = +-Inf and 0/0 = NaN, with no trap anywhere. It is
    ; INTEGER division that diverges, and arithmetic.md 7 conflated them.
    (prim div (f64 f64) f64  expr "%s / %s"  pure)
    (prim lt  (f64 f64) bool expr "%s < %s"  pure)
    (prim le  (f64 f64) bool expr "%s <= %s" pure)
    (prim gt  (f64 f64) bool expr "%s > %s"  pure)
    (prim ge  (f64 f64) bool expr "%s >= %s" pure)
    (prim eq  (f64 f64) bool expr "%s === %s" pure)
    (prim sqrt (f64) f64 expr "Math.sqrt(%s)" pure)
    (prim abs  (f64) f64 expr "Math.abs(%s)"  pure))

  ; A JS Number IS the representation: nothing is emulated and nothing coerced.
  ; The portable range stops at 2^53 because of this target, not despite it
  ; (arithmetic.md §4).
  (module num/int
    (prim add (int int) int  expr "%s + %s"   pure)
    (prim sub (int int) int  expr "%s - %s"   pure)
    (prim mul (int int) int  expr "%s * %s"   pure)
    (prim lt  (int int) bool expr "%s < %s"   pure)
    (prim le  (int int) bool expr "%s <= %s"  pure)
    (prim gt  (int int) bool expr "%s > %s"   pure)
    (prim ge  (int int) bool expr "%s >= %s"  pure)
    (prim eq  (int int) bool expr "%s === %s" pure))

  ; int -> f64 is EXACTLY lossless inside the portable range, because that
  ; range is 2^53 precisely so an f64 holds every integer in it
  ; (arithmetic.md 4). The lossy direction, f64 -> int, is still absent:
  ; it needs a rounding decision and no program has asked.
  (module num/f64
    (prim of-int (int) f64 expr "%s" pure))

  (module logic
    (prim and (bool bool) bool expr "%s && %s" pure)
    (prim or  (bool bool) bool expr "%s || %s" pure)
    (prim not (bool)      bool expr "!%s"      pure))

  (prim alen   (vec-f64) int      expr "%s.length" pure)
  (prim aindex (vec-f64 int) f64  expr "%s[%s]"    pure)

  ; A null-prototype object, NOT Map. Baseline R4 measured Map at 3.25x slower
  ; for string keys, which refuted g4's original pass condition.
  (prim slen        (vec-string) int        expr "%s.length"    pure)
  (prim sat         (vec-string int) string expr "%s[%s]"       pure)
  ; Go's strings.Fields semantics: runs of non-whitespace, no empty fields.
    ; .split(" ") was WRONG on tabs, newlines, repeated and leading spaces --
    ; four of ten conformance cases. See docs/spec/primitives.md.
    (prim split-words (string) vec-string     expr "(%s.match(/\\S+/g) ?? [])" pure)
  (prim dict-empty  (none) dict             expr "Object.create(null)")
  (prim dict-inc    (dict string) dict      stmt "%s[%s] = (%s[%s] ?? 0) + 1")


  ; Tier 2 — effects.md §6. console.log prints 1 for 1.0 and 100000000 for 1e8,
  ; agreeing with Go on the first and with neither on the second.



  ; ------------------------------------ JavaScript's top level (EXPERIMENT)
  ;
  ; Everything reachable with no import and no require, in BOTH Node and the
  ; browser. Where Go's top level is a list of predeclared FUNCTIONS, JS's is
  ; mostly METHODS on values and STATICS on namespace objects — so the module
  ; names mirror how JavaScript organises itself rather than how Go does.
  ;
  ; A template puts the receiver in the first hole, so `%s.map(%s)` needs no
  ; new mechanism. See experiments/js-toplevel/.

  ; Free functions on the global object.
  (module js/global
    (prim parse-int    (string) int     expr "parseInt(%s, 10)"   pure)
    (prim parse-float  (string) f64     expr "parseFloat(%s)"     pure)
    (prim nan?         (f64) bool       expr "Number.isNaN(%s)"   pure)
    (prim finite?      (f64) bool       expr "Number.isFinite(%s)" pure)
    (prim integer?     (f64) bool       expr "Number.isInteger(%s)" pure)
    (prim to-number    (any) f64        expr "Number(%s)"         pure)
    (prim to-string    (any) string     expr "String(%s)"         pure)
    (prim truthy?      (any) bool       expr "Boolean(%s)"        pure)
    (prim nan          (none) f64       expr "NaN"                pure)
    (prim infinity     (none) f64       expr "Infinity"           pure))

  ; Math — every method is a static, so every one is a one-line declaration.
  (module js/math
    (prim floor  (f64) f64      expr "Math.floor(%s)" pure)
    (prim ceil   (f64) f64      expr "Math.ceil(%s)"  pure)
    (prim round  (f64) f64      expr "Math.round(%s)" pure)
    (prim trunc  (f64) f64      expr "Math.trunc(%s)" pure)
    (prim abs    (f64) f64      expr "Math.abs(%s)"   pure)
    (prim sqrt   (f64) f64      expr "Math.sqrt(%s)"  pure)
    (prim pow    (f64 f64) f64  expr "(%s ** %s)"     pure)
    (prim min    (f64 f64) f64  expr "Math.min(%s, %s)" pure)
    (prim max    (f64 f64) f64  expr "Math.max(%s, %s)" pure)
    (prim log    (f64) f64      expr "Math.log(%s)"   pure)
    (prim sin    (f64) f64      expr "Math.sin(%s)"   pure)
    (prim cos    (f64) f64      expr "Math.cos(%s)"   pure)
    (prim pi     (none) f64     expr "Math.PI"        pure)
    ; NOT pure: two calls give two answers, which is exactly what the effect
    ; discipline is for. `expr` kind, so the tempting `expr means pure`
    ; heuristic would have got this wrong (effects.md 3).
    (prim random (none) f64     expr "Math.random()"))

  ; Numbers are doubles, so integer division and remainder are Math.trunc and
  ; `%`. Not portable, hence not in num/int.
  (module js/int
    (prim quo (int int) int expr "Math.trunc(%s / %s)" pure)
    (prim rem (int int) int expr "(%s %% %s)"          pure)
    ; f64 -> int. Absent from num/f64 because it needs a rounding DECISION the
    ; hosts do not share; here it is simply truncation toward zero, with no
    ; portability claim. A JS Number is already the representation, so this
    ; costs nothing at runtime.
    (prim of-f64 (f64) int expr "Math.trunc(%s)" pure))

  ; Arrays. The receiver goes in the first hole.
  (module js/array
    (prim make       (int) vec-f64            expr "new Array(%s)")
    (prim of-size    (int f64) vec-f64        expr "new Array(%s).fill(%s)")
    (prim len        (vec-f64) int            expr "%s.length"       pure)
    (prim at         (vec-f64 int) f64        expr "%s[%s]"          pure index)
    (prim set        (vec-f64 int f64) vec-f64 stmt "%s[%s] = %s")
    (prim push       (vec-f64 f64) vec-f64    stmt "%s.push(%s)")
    (prim pop        (vec-f64) f64            expr "%s.pop()")
    (prim slice      (vec-f64 int int) vec-f64 expr "%s.slice(%s, %s)" pure)
    (prim concat     (vec-f64 vec-f64) vec-f64 expr "%s.concat(%s)"   pure)
    (prim index-of   (vec-f64 f64) int        expr "%s.indexOf(%s)"   pure)
    (prim includes?  (vec-f64 f64) bool       expr "%s.includes(%s)"  pure)
    (prim reverse    (vec-f64) vec-f64        stmt "%s.reverse()")
    (prim join       (vec-string string) string expr "%s.join(%s)"    pure)

    ; The higher-order half of JS's array API. Every one of these takes a
    ; FUNCTION, which is the experiment: can a lambda reach a host callback?
    (prim map        (vec-f64 any) vec-f64    expr "%s.map(%s)"       pure)
    (prim filter     (vec-f64 any) vec-f64    expr "%s.filter(%s)"    pure)
    (prim reduce     (vec-f64 any f64) f64    expr "%s.reduce(%s, %s)" pure)
    (prim some?      (vec-f64 any) bool       expr "%s.some(%s)"      pure)
    (prim find-index (vec-f64 any) int        expr "%s.findIndex(%s)" pure)
    (prim sort       (vec-f64 any) vec-f64    stmt "%s.sort(%s)"))

  ; Strings are immutable, so every method here is pure.
  (module js/string
    (prim len        (string) int             expr "%s.length"        pure)
    (prim char-at    (string int) string      expr "%s[%s]"           pure)
    (prim slice      (string int int) string  expr "%s.slice(%s, %s)" pure)
    (prim index-of   (string string) int      expr "%s.indexOf(%s)"   pure)
    (prim includes?  (string string) bool     expr "%s.includes(%s)"  pure)
    (prim starts?    (string string) bool     expr "%s.startsWith(%s)" pure)
    (prim upper      (string) string          expr "%s.toUpperCase()" pure)
    (prim lower      (string) string          expr "%s.toLowerCase()" pure)
    (prim trim       (string) string          expr "%s.trim()"        pure)
    (prim repeat     (string int) string      expr "%s.repeat(%s)"    pure)
    (prim split      (string string) vec-string expr "%s.split(%s)"   pure)
    (prim concat     (string string) string   expr "(%s + %s)"        pure)
    (prim code-at    (string int) int         expr "%s.charCodeAt(%s)" pure)
    (prim eq         (string string) bool     expr "%s === %s"        pure))

  ; A dictionary is a null-prototype object, per baseline R4.
  (module js/object
    (prim empty      (none) dict              expr "Object.create(null)")
    (prim get        (dict string) f64        expr "(%s[%s] ?? 0)"    pure)
    (prim set        (dict string f64) dict   stmt "%s[%s] = %s")
    (prim has?       (dict string) bool       expr "(%s in %s)"       pure)
    (prim del        (dict string) dict       stmt "delete %s[%s]")
    (prim keys       (dict) vec-string        expr "Object.keys(%s)"  pure))

  (module js/json
    (prim stringify  (any) string             expr "JSON.stringify(%s)" pure)
    (prim parse      (string) any             expr "JSON.parse(%s)"     pure))

  ; console exists in Node and in every browser, with no import.
  (module js/console
    (prim log   (any) any stmt "console.log(%s)")
    (prim error (any) any stmt "console.error(%s)"))

  (module io
    (prim print-line (any) any stmt "console.log(%s)"))

  ; JavaScript has no compile step: the emitted module IS the deliverable, so
  ; there is an artifact and only a syntax check for a build.
  (artifact "main.mjs")
  (build "node --check %s")

  ; The four the BACKEND implements. No types: fold-range is
  ; A x int x ((A,int) -> A) -> A, which a monomorphic table cannot express,
  ; and writing one was a false statement (target-files.md §4).
  (structural make-vec    build pure)
  (structural fold-range  loop  pure)
  (structural fold-range2 loop2 pure))
