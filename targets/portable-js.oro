; The PORTABLE JavaScript target - preserved, not current. targets/js/ is the
; host-native one. See docs/spec/target-native.md.
;
; The JavaScript target.
;
; Note what is ABSENT: no (type …) declarations at all. JS is untyped, so the
; whole type layer that Go and Java need is simply missing here — which is the
; evidence that types belong to the backend rather than to the language
; (gauntlet/results/js-2026-08-14.md).
;
; Argument types are still written, because they document the primitive and a
; future checker could use them regardless of target. ~~They are never
; consulted.~~ That future arrived: docs/spec/types.md's checker reads them on
; EVERY target, so this file is type-checked with types it does not itself use.
; The js-toplevel experiment had a fold accumulator start at 0 where it needed
; "", and the checker caught it here — on the target with no type layer.
;
; `pure` is consulted, on every target, because it is not a type — it decides
; whether β may move the term (docs/spec/effects.md §3).

(target portable-js
  ; Which code generator compiles this target (target-system.md §1.1).
  (backend js)


  (module num/f64
    (sig add (f64 f64) f64  pure  (host expr "%s + %s"))
    (sig sub (f64 f64) f64  pure  (host expr "%s - %s"))
    (sig mul (f64 f64) f64  pure  (host expr "%s * %s"))
    ; f64 division is Tier 1: all three hosts agree on every case measured,
    ; including x/0 = +-Inf and 0/0 = NaN, with no trap anywhere. It is
    ; INTEGER division that diverges, and arithmetic.md 7 conflated them.
    (sig div (f64 f64) f64  pure  (host expr "%s / %s"))
    (sig lt  (f64 f64) bool  pure (host expr "%s < %s"))
    (sig le  (f64 f64) bool pure (host expr "%s <= %s"))
    (sig gt  (f64 f64) bool  pure (host expr "%s > %s"))
    (sig ge  (f64 f64) bool pure (host expr "%s >= %s"))
    (sig eq  (f64 f64) bool pure (host expr "%s === %s"))
    (sig sqrt (f64) f64 pure (host expr "Math.sqrt(%s)"))
    (sig abs  (f64) f64  pure (host expr "Math.abs(%s)")))

  ; A JS Number IS the representation: nothing is emulated and nothing coerced.
  ; The portable range stops at 2^53 because of this target, not despite it
  ; (arithmetic.md §4).
  (module num/int
    (sig add (int int) int   pure  (host expr "%s + %s"))
    (sig sub (int int) int   pure  (host expr "%s - %s"))
    (sig mul (int int) int   pure  (host expr "%s * %s"))
    (sig lt  (int int) bool   pure (host expr "%s < %s"))
    (sig le  (int int) bool  pure (host expr "%s <= %s"))
    (sig gt  (int int) bool   pure (host expr "%s > %s"))
    (sig ge  (int int) bool  pure (host expr "%s >= %s"))
    (sig eq  (int int) bool pure (host expr "%s === %s")))

  ; int -> f64 is EXACTLY lossless inside the portable range, because that
  ; range is 2^53 precisely so an f64 holds every integer in it
  ; (arithmetic.md 4). The lossy direction, f64 -> int, is still absent:
  ; it needs a rounding decision and no program has asked.
  (module num/f64
    (sig of-int (int) f64 pure (host expr "%s")))

  (module logic
    (sig and (bool bool) bool pure (host expr "%s && %s"))
    (sig or  (bool bool) bool pure (host expr "%s || %s"))
    (sig not (bool)      bool      pure (host expr "!%s")))

  (sig alen   (vec-f64) int pure      (host expr "%s.length"))
  (sig aindex (vec-f64 int) f64    pure  (host expr "%s[%s]"))

  ; A null-prototype object, NOT Map. Baseline R4 measured Map at 3.25x slower
  ; for string keys, which refuted g4's original pass condition.
  (sig slen        (vec-string) int    pure        (host expr "%s.length"))
  (sig sat         (vec-string int) string       pure (host expr "%s[%s]"))
  ; Go's strings.Fields semantics: runs of non-whitespace, no empty fields.
    ; .split(" ") was WRONG on tabs, newlines, repeated and leading spaces --
    ; four of ten conformance cases. See docs/spec/primitives.md.
    (sig split-words (string) vec-string pure     (host expr "(%s.match(/\\S+/g) ?? [])"))
  (sig dict-empty  () dict             (host expr "Object.create(null)"))
  (sig dict-inc    (dict string) dict      (host stmt "%s[%s] = (%s[%s] ?? 0) + 1"))


  ; Tier 2 — effects.md §6. console.log prints 1 for 1.0 and 100000000 for 1e8,
  ; agreeing with Go on the first and with neither on the second.



  ; ------------------------------------ JavaScript's top level (EXPERIMENT)
  ;
  ; Everything reachable with no import and no require, in BOTH Node and the
  ; browser. Where Go's top level is a list of predeclared FUNCTIONS, JS's is
  ; mostly METHODS on values and STATICS on namespace objects — so the module
  ; names mirror how JavaScript organises itself rather than how Go does.
  ;
  ; A template puts the receiver in the first hole, so `%s.map(%s)` needs no
  ; new mechanism. See experiments/js-toplevel/.

  ; Free functions on the global object.
  (module js/global
    (sig parse-int    (string) int   pure     (host expr "parseInt(%s, 10)"))
    (sig parse-float  (string) f64     pure     (host expr "parseFloat(%s)"))
    (sig nan?         (f64) bool   pure       (host expr "Number.isNaN(%s)"))
    (sig finite?      (f64) bool pure       (host expr "Number.isFinite(%s)"))
    (sig integer?     (f64) bool pure       (host expr "Number.isInteger(%s)"))
    (sig to-number    (any) f64         pure        (host expr "Number(%s)"))
    (sig to-string    (any) string         pure     (host expr "String(%s)"))
    (sig truthy?      (any) bool        pure       (host expr "Boolean(%s)"))
    (sig nan          () f64                pure       (host expr "NaN"))
    (sig infinity     () f64           pure       (host expr "Infinity")))

  ; Math — every method is a static, so every one is a one-line declaration.
  (module js/math
    (sig floor  (f64) f64 pure      (host expr "Math.floor(%s)"))
    (sig ceil   (f64) f64  pure      (host expr "Math.ceil(%s)"))
    (sig round  (f64) f64 pure      (host expr "Math.round(%s)"))
    (sig trunc  (f64) f64 pure      (host expr "Math.trunc(%s)"))
    (sig abs    (f64) f64   pure      (host expr "Math.abs(%s)"))
    (sig sqrt   (f64) f64  pure      (host expr "Math.sqrt(%s)"))
    (sig pow    (f64 f64) f64     pure  (host expr "(%s ** %s)"))
    (sig min    (f64 f64) f64 pure  (host expr "Math.min(%s, %s)"))
    (sig max    (f64 f64) f64 pure  (host expr "Math.max(%s, %s)"))
    (sig log    (f64) f64   pure      (host expr "Math.log(%s)"))
    (sig sin    (f64) f64   pure      (host expr "Math.sin(%s)"))
    (sig cos    (f64) f64   pure      (host expr "Math.cos(%s)"))
    (sig pi     () f64        pure     (host expr "Math.PI"))
    ; NOT pure: two calls give two answers, which is exactly what the effect
    ; discipline is for. `expr` kind, so the tempting `expr means pure`
    ; heuristic would have got this wrong (effects.md 3).
    (sig random () f64     (host expr "Math.random()")))

  ; Numbers are doubles, so integer division and remainder are Math.trunc and
  ; `%`. Not portable, hence not in num/int.
  (module js/int
    (sig quo (int int) int pure (host expr "Math.trunc(%s / %s)"))
    (sig rem (int int) int          pure (host expr "(%s %% %s)"))
    ; f64 -> int. Absent from num/f64 because it needs a rounding DECISION the
    ; hosts do not share; here it is simply truncation toward zero, with no
    ; portability claim. A JS Number is already the representation, so this
    ; costs nothing at runtime.
    (sig of-f64 (f64) int pure (host expr "Math.trunc(%s)")))

  ; Arrays. The receiver goes in the first hole.
  (module js/array
    (sig make       (int) vec-f64            (host expr "new Array(%s)"))
    (sig of-size    (int f64) vec-f64        (host expr "new Array(%s).fill(%s)"))
    (sig len        (vec-f64) int       pure            (host expr "%s.length"))
    (sig at         (vec-f64 int) f64          pure index        (host expr "%s[%s]"))
    (sig set        (vec-f64 int f64) vec-f64 (host stmt "%s[%s] = %s"))
    (sig push       (vec-f64 f64) vec-f64    (host stmt "%s.push(%s)"))
    (sig pop        (vec-f64) f64            (host expr "%s.pop()"))
    (sig slice      (vec-f64 int int) vec-f64 pure (host expr "%s.slice(%s, %s)"))
    (sig concat     (vec-f64 vec-f64) vec-f64   pure (host expr "%s.concat(%s)"))
    (sig index-of   (vec-f64 f64) int   pure        (host expr "%s.indexOf(%s)"))
    (sig includes?  (vec-f64 f64) bool  pure       (host expr "%s.includes(%s)"))
    (sig reverse    (vec-f64) vec-f64        (host stmt "%s.reverse()"))
    (sig join       (vec-string string) string    pure (host expr "%s.join(%s)"))

    ; The higher-order half of JS's array API. Every one of these takes a
    ; FUNCTION, which is the experiment: can a lambda reach a host callback?
    (sig map        (vec-f64 any) vec-f64       pure    (host expr "%s.map(%s)"))
    (sig filter     (vec-f64 any) vec-f64    pure    (host expr "%s.filter(%s)"))
    (sig reduce     (vec-f64 any f64) f64 pure    (host expr "%s.reduce(%s, %s)"))
    (sig some?      (vec-f64 any) bool      pure       (host expr "%s.some(%s)"))
    (sig find-index (vec-f64 any) int pure        (host expr "%s.findIndex(%s)"))
    (sig sort       (vec-f64 any) vec-f64    (host stmt "%s.sort(%s)")))

  ; Strings are immutable, so every method here is pure.
  (module js/string
    (sig len        (string) int        pure             (host expr "%s.length"))
    (sig char-at    (string int) string           pure      (host expr "%s[%s]"))
    (sig slice      (string int int) string pure  (host expr "%s.slice(%s, %s)"))
    (sig index-of   (string string) int   pure      (host expr "%s.indexOf(%s)"))
    (sig includes?  (string string) bool  pure     (host expr "%s.includes(%s)"))
    (sig starts?    (string string) bool pure     (host expr "%s.startsWith(%s)"))
    (sig upper      (string) string pure          (host expr "%s.toUpperCase()"))
    (sig lower      (string) string pure          (host expr "%s.toLowerCase()"))
    (sig trim       (string) string        pure          (host expr "%s.trim()"))
    (sig repeat     (string int) string    pure      (host expr "%s.repeat(%s)"))
    (sig split      (string string) vec-string   pure (host expr "%s.split(%s)"))
    (sig concat     (string string) string        pure   (host expr "(%s + %s)"))
    (sig code-at    (string int) int pure         (host expr "%s.charCodeAt(%s)"))
    (sig eq         (string string) bool        pure     (host expr "%s === %s")))

  ; A dictionary is a null-prototype object, per baseline R4.
  (module js/object
    (sig empty      () dict              (host expr "Object.create(null)"))
    (sig get        (dict string) f64    pure        (host expr "(%s[%s] ?? 0)"))
    (sig set        (dict string f64) dict   (host stmt "%s[%s] = %s"))
    (sig has?       (dict string) bool       pure       (host expr "(%s in %s)"))
    (sig del        (dict string) dict       (host stmt "delete %s[%s]"))
    (sig keys       (dict) vec-string  pure        (host expr "Object.keys(%s)")))

  (module js/json
    (sig stringify  (any) string pure             (host expr "JSON.stringify(%s)"))
    (sig parse      (string) any     pure             (host expr "JSON.parse(%s)")))

  ; console exists in Node and in every browser, with no import.
  (module js/console
    (sig log   (any) any (host stmt "console.log(%s)"))
    (sig error (any) any (host stmt "console.error(%s)")))

  (module io
    (sig print-line (any) any (host stmt "console.log(%s)")))

  ; JavaScript has no compile step: the emitted module IS the deliverable, so
  ; there is an artifact and only a syntax check for a build.
  (artifact "main.mjs")
  (build "node --check %s")

  ; The four the BACKEND implements. No types: fold-range is
  ; A x int x ((A,int) -> A) -> A, which a monomorphic table cannot express,
  ; and writing one was a false statement (target-files.md §4).
  (structural make-vec    build pure)
  (structural fold-range  loop  pure)
  (structural fold-range2 loop2 pure))
