// targets/tutorial.oro, plus one native capability. Chapter 3 uses the pair to
// show the four cells: the same source, two targets, two normal forms.
//
// The normal form is a parameter (ADR 0002), so a *teaching* target is just
// another value of that parameter. This one is chosen so reduction stops
// exactly where a lesson wants it to:
//
//   - arithmetic is spelled `+ - * /`, unqualified, because a chapter about
//     `fn` should not also be a chapter about module paths;
//   - `f`, `g` and `h` are primitives, so "some function we know nothing about"
//     is a thing you can write and reduction will halt on it;
//   - `x`, `y`, `z` are primitives too, standing for "some value from outside".
//
// It emits nothing. There is no (build …) and no templates worth trusting —
// this target is for `oro`, which prints normal forms.
// The word (ADR 0026). This target emits nothing and only reduces, so the
// integers it computes are the compiler's own int64s, folded at compile time.
repr -2^63..2^63-1 word
set num = host "num"
set Bool = host "bool"

fn `+`(a ∈ num, b ∈ num) (num) pure { host expr "${a} + ${b}" }
fn `-`(a ∈ num, b ∈ num) (num) pure { host expr "${a} - ${b}" }
fn `*`(a ∈ num, b ∈ num) (num) pure { host expr "${a} * ${b}" }
fn `/`(a ∈ num, b ∈ num) (num) pure { host expr "${a} / ${b}" }
fn `<`(a ∈ num, b ∈ num) (Bool) pure { host expr "${a} < ${b}" }

// Opaque stand-ins. Reduction halts on these, which is the whole point:
// they let an example show a shape without showing an implementation.
fn f(a ∈ num) (num) pure { host expr "f(${a})" }
fn g(a ∈ num) (num) pure { host expr "g(${a})" }
fn h(a ∈ num, b ∈ num) (num) pure { host expr "h(${a}, ${b})" }
fn x() (num) pure { host expr "x" }
fn y() (num) pure { host expr "y" }
fn z() (num) pure { host expr "z" }

// A module the TARGET provides. `(use math/trig)` finds no file on the search
// path, and that is not an error — it is a module this target implements
// natively (chapter 3).
module math/trig {
    fn sin(a ∈ num) (num) pure { host expr "sin(${a})" }
    fn cos(a ∈ num) (num) pure { host expr "cos(${a})" }
}

// The ONE line that differs from targets/tutorial.oro. This target provides
// geometry.area itself, so the library definition of it is never unfolded.
module geometry {
    fn area(a ∈ num, b ∈ num) (num) pure { host expr "area(${a}, ${b})" }
}

// One impure primitive, so a lesson can show what β refuses to move.
fn shout(a ∈ num) (num) { host stmt "shout(${a})" }
fn whisper(a ∈ num) (num) { host stmt "whisper(${a})" }
fn tick() (num) { host stmt "tick()" }

structural fold_range `loop` pure
