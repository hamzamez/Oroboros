// fileapi.h (ADR 0126): FILES, by handle (ADR 0112). Each declaration is its
// prototype in the Windows SDK 10.0.26100.0, its sets the prototype's type
// names (ADR 0094), and its call derived by the C ABI on the triple
// (llvm.md §6a): `declare dllimport`, `trunc` in and `sext`/`zext` out, and
// `stdcall` x86_stdcallcc on i686 and nothing on x86-64.
//
//   use windows/fileapi
//   fileapi.WriteFile(h, b, lo, n, out minwindef.DWORD)
module windows/fileapi {
    use windows/minwindef
    use windows/winnt

    // CreateFileA(path, access, share, security, disposition, flags, template)
    // answers a HANDLE, INVALID_HANDLE_VALUE ((HANDLE)−1) on failure, the reason
    // in GetLastError. The path is a C string, read as UTF-8 under the
    // manifest's code page (ADR 0091).
    fn CreateFileA(p ∈ String, a ∈ minwindef.DWORD, s ∈ minwindef.DWORD, sa ∈ ptr, d ∈ minwindef.DWORD, f ∈ minwindef.DWORD, t ∈ winnt.HANDLE) (r ∈ winnt.HANDLE) where nulfree(p) {
        host expr call CreateFileA stdcall lib "kernel32"
    }

    // WRITES the region s to h: WriteFile(h, s, len(s), &written, NULL). The
    // region is one table, its address and length the table's projections
    // (ADR 0132), and a program passes b or b[lo:hi]; the count written is a
    // result (ADR 0131). Its domain is a length that is a DWORD; its answer a
    // BOOL, nonzero on success.
    //
    // WHAT THE LANGUAGE COULD NOT SAY ON MASM, IT SAYS HERE: the buffer was a
    // raw pointer there (`x64.lea` of the target's one scratch buffer); here it
    // is a language table, borrowed.
    fn WriteFile(h ∈ winnt.HANDLE, s ∈ Array(0..255)) (put ∈ minwindef.DWORD, r ∈ minwindef.BOOL) where len(s) <= 2^32-1 {
        host expr call WriteFile(h, s, len(s), &put, NULL) stdcall lib "kernel32"
    }

    // READS INTO the region s: ReadFile(h, s, len(s), &read, NULL), the count
    // read a result (ADR 0131). The table is lent, `linear`, so the write is the
    // caller's to see (ADR 0084), and a program passes b or b[lo:hi] (ADR 0132).
    // A synchronous read of a file returns fewer than len(s) only at its end.
    fn ReadFile(h ∈ winnt.HANDLE, s ∈ Array(0..255) linear) (got ∈ minwindef.DWORD, r ∈ minwindef.BOOL) where len(s) <= 2^32-1 {
        host expr call ReadFile(h, s, len(s), &got, NULL) stdcall lib "kernel32"
    }

    // GetFileSizeEx(h, &size): the size, a result the host writes through its
    // LARGE_INTEGER* (ADR 0131), and a BOOL.
    fn GetFileSizeEx(h ∈ winnt.HANDLE) (n ∈ winnt.LARGE_INTEGER, r ∈ minwindef.BOOL) { host expr call GetFileSizeEx(h, &n) stdcall lib "kernel32" }

    // GetFileSize(h, &high): the size's high DWORD, a result (ADR 0131), and
    // its low one; INVALID_FILE_SIZE (2³² − 1) with GetLastError nonzero on
    // failure.
    fn GetFileSize(h ∈ winnt.HANDLE) (hi ∈ minwindef.DWORD, r ∈ minwindef.DWORD) { host expr call GetFileSize(h, &hi) stdcall lib "kernel32" }

    // SetFilePointerEx(h, distance, &new, method): the LARGE_INTEGER by value,
    // eight bytes in one register on x86-64 and two stack slots on i686, as an
    // i64 is; the new position not asked for (null), FILE_BEGIN 0.
    fn SetFilePointerEx(h ∈ winnt.HANDLE, d ∈ winnt.LARGE_INTEGER, np ∈ ptr, m ∈ minwindef.DWORD) (r ∈ minwindef.BOOL) { host expr call SetFilePointerEx stdcall lib "kernel32" }

    // DWORD SetFilePointer(_In_ HANDLE hFile, _In_ LONG lDistanceToMove,
    // _Inout_opt_ PLONG lpDistanceToMoveHigh, _In_ DWORD dwMoveMethod): the
    // high half of the distance in, the high half of the new position out, a
    // cell (ADR 0048, _Inout_ by ADR 0131), the low half the result.
    fn SetFilePointer(h ∈ winnt.HANDLE, lo ∈ winnt.LONG, hi ∈ winnt.LONG inout, m ∈ minwindef.DWORD) (r ∈ minwindef.DWORD) { host expr call SetFilePointer(h, lo, &hi, m) stdcall lib "kernel32" }
}
