// sysinfoapi.h (ADR 0126): the system's information, each declaration its
// prototype in the Windows SDK 10.0.26100.0, its sets the prototype's type
// names.
module windows/sysinfoapi {
    use windows/minwinbase
    use windows/minwindef
    use windows/winnt

    // typedef struct _MEMORYSTATUSEX { DWORD dwLength; DWORD dwMemoryLoad;
    // DWORDLONG ullTotalPhys; … ullAvailExtendedVirtual; }: dwLength is the
    // struct's size, which the declaration determines (Theorem F), so the
    // record has no such label and the layout writes it.
    set MEMORYSTATUSEX = record {
        dwMemoryLoad ∈ minwindef.DWORD, ullTotalPhys ∈ winnt.DWORDLONG, ullAvailPhys ∈ winnt.DWORDLONG,
        ullTotalPageFile ∈ winnt.DWORDLONG, ullAvailPageFile ∈ winnt.DWORDLONG, ullTotalVirtual ∈ winnt.DWORDLONG,
        ullAvailVirtual ∈ winnt.DWORDLONG, ullAvailExtendedVirtual ∈ winnt.DWORDLONG
    }
    repr MEMORYSTATUSEX c(dwLength ∈ minwindef.DWORD = size, dwMemoryLoad, ullTotalPhys, ullAvailPhys,
        ullTotalPageFile, ullAvailPageFile, ullTotalVirtual, ullAvailVirtual, ullAvailExtendedVirtual)

    // void GetLocalTime(_Out_ LPSYSTEMTIME lpSystemTime): the local time, a
    // result the host fills (ADR 0131).
    fn GetLocalTime() (t ∈ minwinbase.SYSTEMTIME, u ∈ Bool) { host stmt call GetLocalTime(&t) stdcall lib "kernel32" }
    // BOOL GlobalMemoryStatusEx(_Out_ LPMEMORYSTATUSEX lpBuffer): the memory's
    // state, a result (ADR 0131), its dwLength the layout's.
    fn GlobalMemoryStatusEx() (m ∈ MEMORYSTATUSEX, r ∈ minwindef.BOOL) { host expr call GlobalMemoryStatusEx(&m) stdcall lib "kernel32" }
}
