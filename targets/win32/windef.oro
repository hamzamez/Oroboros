// windef.h, THE WINDOW SYSTEM'S HANDLES (ADR 0126), each a DECLARE_HANDLE
// in the Windows SDK 10.0.26100.0's shared/windef.h, so `ptr`; COLORREF,
// typedef DWORD COLORREF; and its structs, each a record set and its C layout,
// the definition's order (llvm.md §6b, ADR 0128).
module windows/windef {
    use windows/winnt

    set HWND = host "HWND__*"           // DECLARE_HANDLE(HWND), struct HWND__ * (ADR 0146)
    set HDC = host "HDC__*"             // DECLARE_HANDLE(HDC)
    set HMENU = host "HMENU__*"         // DECLARE_HANDLE(HMENU)
    set HBRUSH = host "HBRUSH__*"       // DECLARE_HANDLE(HBRUSH)
    set HICON = host "HICON__*"         // DECLARE_HANDLE(HICON)
    set HCURSOR = HICON                 // typedef HICON HCURSOR
    set COLORREF = 0..2^32-1
    // typedef struct tagRECT { LONG left; LONG top; LONG right; LONG bottom; } RECT
    set RECT = record { left ∈ winnt.LONG, top ∈ winnt.LONG, right ∈ winnt.LONG, bottom ∈ winnt.LONG }
    repr RECT c(left, top, right, bottom)
    // typedef struct tagPOINT { LONG x; LONG y; } POINT
    set POINT = record { x ∈ winnt.LONG, y ∈ winnt.LONG }
    repr POINT c(x, y)
}
