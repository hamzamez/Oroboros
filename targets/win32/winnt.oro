// winnt.h, THE NT TYPE NAMES (ADR 0126), each its typedef read off the
// Windows SDK 10.0.26100.0's um/winnt.h, a C integer type's name its whole
// value set; and RtlZeroMemory, which winnt.h writes as a macro over memset
// and kernel32 exports, forwarded to ntdll.
module windows/winnt {
    use windows/basetsd

    set HANDLE = ptr                    // typedef PVOID HANDLE
    set SHORT = -2^15..2^15-1           // typedef short SHORT
    set LONG = -2^31..2^31-1            // typedef long LONG
    set LONGLONG = -2^63..2^63-1        // typedef __int64 LONGLONG
    set ULONGLONG = 0..2^64-1           // typedef unsigned __int64 ULONGLONG
    set DWORDLONG = ULONGLONG           // typedef ULONGLONG DWORDLONG
    set LCID = 0..2^32-1                // typedef DWORD LCID
    // typedef union _LARGE_INTEGER { struct { DWORD LowPart; LONG HighPart; };
    // LONGLONG QuadPart; } LARGE_INTEGER: eight bytes, read as its QuadPart.
    set LARGE_INTEGER = LONGLONG

    // RtlZeroMemory(destination, length) writes length zero bytes. winnt.h's
    // macro is memset; kernel32's export of the name is a function, so no C
    // runtime's memset is linked.
    fn RtlZeroMemory(p ∈ ptr, n ∈ basetsd.SIZE_T) (Bool) { host stmt call "RtlZeroMemory" stdcall lib "kernel32" }
}
