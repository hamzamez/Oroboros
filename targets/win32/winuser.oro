// WinUser.h (ADR 0126): WINDOWS, MENUS AND MESSAGES, the 26 of TinyRetroPad's
// 37 user32 functions a program can call today (tinyretropad-2026-11-17), each
// its prototype in the Windows SDK 10.0.26100.0, its sets the prototype's type
// names. The other eleven take a record (MSG, RECT, PAINTSTRUCT, WNDCLASSA) or
// a callback (DLGPROC), or are variadic (wsprintfA): 6d's walls.
//
// A C STRING IS NEVER NULL here (ADR 0091): where the header lets a string be
// NULL (a window's name, a caption), a program passes one, and the null case
// waits on an optional C string. A pointer to a RECT the call ignores or reads
// as "the whole" when null (TrackPopupMenu, InvalidateRect) is `ptr`.
module windows/winuser {
    use windows/basetsd
    use windows/minwindef
    use windows/windef
    use windows/winnt

    // WINDOWS. CreateWindowExA(exstyle, class, name, style, x, y, w, h, parent,
    // menu, instance, param) answers the window or null; DestroyWindow ends one.
    fn CreateWindowExA(xs ∈ minwindef.DWORD, c ∈ String, t ∈ String, s ∈ minwindef.DWORD, x ∈ minwindef.INT, y ∈ minwindef.INT, w ∈ minwindef.INT, h ∈ minwindef.INT, p ∈ windef.HWND, m ∈ windef.HMENU, i ∈ minwindef.HINSTANCE, a ∈ ptr) (r ∈ windef.HWND) where nulfree(c) && nulfree(t) {
        host expr call CreateWindowExA stdcall lib "user32"
    }
    fn DestroyWindow(w ∈ windef.HWND) (r ∈ minwindef.BOOL) { host expr call DestroyWindow stdcall lib "user32" }

    // THE WINDOW PROCEDURE. typedef LRESULT (CALLBACK* WNDPROC)(HWND, UINT,
    // WPARAM, LPARAM): a named claim, the operators of that shape (ADR 0053),
    // and its C signature, CALLBACK being __stdcall (ADR 0133, llvm.md §6c).
    set WNDPROC = fn(h ∈ windef.HWND, m ∈ minwindef.UINT, w ∈ minwindef.WPARAM, l ∈ minwindef.LPARAM) (r ∈ minwindef.LRESULT)
    repr WNDPROC c(h, m, w, l) stdcall

    // WINDOW CLASSES. typedef struct tagWNDCLASSA { UINT style; WNDPROC
    // lpfnWndProc; int cbClsExtra; int cbWndExtra; HINSTANCE hInstance; HICON
    // hIcon; HCURSOR hCursor; HBRUSH hbrBackground; LPCSTR lpszMenuName; LPCSTR
    // lpszClassName; } WNDCLASSA. The window procedure is a function of ours
    // (ADR 0133), and the class menu 0, determined (Theorem F). lpszClassName
    // is a C string the call lends (Theorem P′), NUL-free by the declaration's
    // `where`.
    set WNDCLASSA = record {
        style ∈ minwindef.UINT, lpfnWndProc ∈ WNDPROC, cbClsExtra ∈ minwindef.INT, cbWndExtra ∈ minwindef.INT, hInstance ∈ minwindef.HINSTANCE,
        hIcon ∈ windef.HICON, hCursor ∈ windef.HCURSOR, hbrBackground ∈ windef.HBRUSH, lpszClassName ∈ String
    }
    repr WNDCLASSA c(style, lpfnWndProc, cbClsExtra, cbWndExtra, hInstance, hIcon, hCursor,
        hbrBackground, lpszMenuName ∈ ptr = 0, lpszClassName)
    // ATOM RegisterClassA(_In_ CONST WNDCLASSA *lpWndClass): a struct passed
    // `_In_`, a value (ADR 0084 P2), its const T* the call's &x, ref(wc)
    // (ADR 0130).
    fn RegisterClassA(wc ∈ WNDCLASSA) (r ∈ minwindef.ATOM) where nulfree(wc.lpszClassName) { host expr call RegisterClassA(&wc) stdcall lib "user32" }
    // BOOL UnregisterClassA(_In_ LPCSTR lpClassName, _In_opt_ HINSTANCE hInstance)
    fn UnregisterClassA(c ∈ String, i ∈ minwindef.HINSTANCE) (r ∈ minwindef.BOOL) where nulfree(c) { host expr call UnregisterClassA stdcall lib "user32" }
    // BOOL GetClientRect(_In_ HWND hWnd, _Out_ LPRECT lpRect): the window's
    // client area, a RECT the host fills, a result (ADR 0131).
    fn GetClientRect(w ∈ windef.HWND) (rc ∈ windef.RECT, r ∈ minwindef.BOOL) { host expr call GetClientRect(w, &rc) stdcall lib "user32" }
    // BOOL PtInRect(_In_ CONST RECT *lprc, _In_ POINT pt): the rectangle by
    // its address, ref(rc) (ADR 0130), the point BY VALUE (ADR 0129), its
    // eight bytes an i64 on x86-64 and on i686's stack.
    fn PtInRect(rc ∈ windef.RECT, pt ∈ windef.POINT) (r ∈ minwindef.BOOL) { host expr call PtInRect(&rc, pt) stdcall lib "user32" }
    // HWND GetDesktopWindow(VOID): the desktop's window, which every session has.
    fn GetDesktopWindow() (r ∈ windef.HWND) { host expr call GetDesktopWindow stdcall lib "user32" }
    fn ShowWindow(w ∈ windef.HWND, c ∈ minwindef.INT) (r ∈ minwindef.BOOL) { host expr call ShowWindow stdcall lib "user32" }
    fn SetWindowPos(w ∈ windef.HWND, after ∈ windef.HWND, x ∈ minwindef.INT, y ∈ minwindef.INT, cx ∈ minwindef.INT, cy ∈ minwindef.INT, f ∈ minwindef.UINT) (r ∈ minwindef.BOOL) { host expr call SetWindowPos stdcall lib "user32" }
    fn SetWindowTextA(w ∈ windef.HWND, t ∈ String) (r ∈ minwindef.BOOL) where nulfree(t) { host expr call SetWindowTextA stdcall lib "user32" }
    fn SetFocus(w ∈ windef.HWND) (r ∈ windef.HWND) { host expr call SetFocus stdcall lib "user32" }
    fn InvalidateRect(w ∈ windef.HWND, rc ∈ ptr, e ∈ minwindef.BOOL) (r ∈ minwindef.BOOL) { host expr call InvalidateRect stdcall lib "user32" }

    // MESSAGES. SendMessageA(window, message, wparam, lparam) answers the
    // window procedure's LRESULT; DefWindowProcA(…) is the default procedure's
    // answer to the same four. WPARAM, LPARAM and LRESULT are the data model's
    // (basetsd.h by way of minwindef.h).
    fn SendMessageA(w ∈ windef.HWND, m ∈ minwindef.UINT, wp ∈ minwindef.WPARAM, lp ∈ minwindef.LPARAM) (r ∈ minwindef.LRESULT) { host expr call SendMessageA stdcall lib "user32" }
    fn DefWindowProcA(w ∈ windef.HWND, m ∈ minwindef.UINT, wp ∈ minwindef.WPARAM, lp ∈ minwindef.LPARAM) (r ∈ minwindef.LRESULT) { host expr call DefWindowProcA stdcall lib "user32" }
    fn PostQuitMessage(c ∈ minwindef.INT) (Bool) { host stmt call PostQuitMessage stdcall lib "user32" }
    // BOOL PostMessageA(HWND, UINT, WPARAM, LPARAM): the message queued for the
    // window's thread, answered by its procedure when the loop dispatches it.
    fn PostMessageA(w ∈ windef.HWND, m ∈ minwindef.UINT, wp ∈ minwindef.WPARAM, lp ∈ minwindef.LPARAM) (r ∈ minwindef.BOOL) { host expr call PostMessageA stdcall lib "user32" }

    // THE MESSAGE LOOP. typedef struct tagMSG { HWND hwnd; UINT message; WPARAM
    // wParam; LPARAM lParam; DWORD time; POINT pt; } MSG (lPrivate is _MAC's).
    set MSG = record {
        hwnd ∈ windef.HWND, message ∈ minwindef.UINT, wParam ∈ minwindef.WPARAM, lParam ∈ minwindef.LPARAM,
        time ∈ minwindef.DWORD, pt ∈ windef.POINT
    }
    repr MSG c(hwnd, message, wParam, lParam, time, pt)
    // BOOL GetMessageA(_Out_ LPMSG lpMsg, _In_opt_ HWND hWnd, _In_ UINT
    // wMsgFilterMin, _In_ UINT wMsgFilterMax): the next message, a result
    // (ADR 0131); 0 for WM_QUIT, -1 on an error, nonzero otherwise. It
    // dispatches sent messages to the thread's procedures while it waits.
    fn GetMessageA(w ∈ windef.HWND, lo ∈ minwindef.UINT, hi ∈ minwindef.UINT) (msg ∈ MSG, r ∈ minwindef.BOOL) { host expr call GetMessageA(&msg, w, lo, hi) stdcall lib "user32" }
    // BOOL TranslateMessage(_In_ CONST MSG *lpMsg) and LRESULT
    // DispatchMessageA(_In_ CONST MSG *lpMsg): the message passed by its
    // const T*, &msg (ADR 0130); DispatchMessageA calls the window's procedure.
    fn TranslateMessage(msg ∈ MSG) (r ∈ minwindef.BOOL) { host expr call TranslateMessage(&msg) stdcall lib "user32" }
    fn DispatchMessageA(msg ∈ MSG) (r ∈ minwindef.LRESULT) { host expr call DispatchMessageA(&msg) stdcall lib "user32" }
    // BOOL IsDialogMessageA(_In_ HWND hDlg, _In_ LPMSG lpMsg): a modeless
    // dialog's message, dispatched to it when it is one, by &msg.
    fn IsDialogMessageA(d ∈ windef.HWND, msg ∈ MSG) (r ∈ minwindef.BOOL) { host expr call IsDialogMessageA(d, &msg) stdcall lib "user32" }
    // int FillRect(_In_ HDC hDC, _In_ CONST RECT *lprc, _In_ HBRUSH hbr): the
    // rectangle filled with the brush, by its const T*.
    fn FillRect(dc ∈ windef.HDC, rc ∈ windef.RECT, b ∈ windef.HBRUSH) (r ∈ minwindef.INT) { host expr call FillRect(dc, &rc, b) stdcall lib "user32" }
    fn RegisterWindowMessageA(s ∈ String) (r ∈ minwindef.UINT) where nulfree(s) { host expr call RegisterWindowMessageA stdcall lib "user32" }
    fn GetMessagePos() (r ∈ minwindef.DWORD) { host expr call GetMessagePos stdcall lib "user32" }

    // MENUS. A menu is a handle; CheckMenuItem answers the item's previous
    // check state (MF_CHECKED 8 or MF_UNCHECKED 0), or −1 as a DWORD, 2³² − 1,
    // when there is no such item.
    fn CreateMenu() (r ∈ windef.HMENU) { host expr call CreateMenu stdcall lib "user32" }
    fn CreatePopupMenu() (r ∈ windef.HMENU) { host expr call CreatePopupMenu stdcall lib "user32" }
    fn DestroyMenu(m ∈ windef.HMENU) (r ∈ minwindef.BOOL) { host expr call DestroyMenu stdcall lib "user32" }
    fn AppendMenuA(m ∈ windef.HMENU, f ∈ minwindef.UINT, id ∈ basetsd.UINT_PTR, t ∈ String) (r ∈ minwindef.BOOL) where nulfree(t) { host expr call AppendMenuA stdcall lib "user32" }
    fn CheckMenuItem(m ∈ windef.HMENU, id ∈ minwindef.UINT, c ∈ minwindef.UINT) (r ∈ minwindef.DWORD) { host expr call CheckMenuItem stdcall lib "user32" }
    fn GetMenu(w ∈ windef.HWND) (r ∈ windef.HMENU) { host expr call GetMenu stdcall lib "user32" }
    fn SetMenu(w ∈ windef.HWND, m ∈ windef.HMENU) (r ∈ minwindef.BOOL) { host expr call SetMenu stdcall lib "user32" }
    fn GetSystemMenu(w ∈ windef.HWND, revert ∈ minwindef.BOOL) (r ∈ windef.HMENU) { host expr call GetSystemMenu stdcall lib "user32" }
    fn TrackPopupMenu(m ∈ windef.HMENU, f ∈ minwindef.UINT, x ∈ minwindef.INT, y ∈ minwindef.INT, z ∈ minwindef.INT, w ∈ windef.HWND, rc ∈ ptr) (r ∈ minwindef.BOOL) { host expr call TrackPopupMenu stdcall lib "user32" }

    // DIALOGS AND THE REST. GetDlgItemInt's BOOL* is whether the text was a
    // number, a result (ADR 0131); EndDialog's result is an INT_PTR, the data
    // model's.
    fn GetDlgItemInt(d ∈ windef.HWND, id ∈ minwindef.INT, signed ∈ minwindef.BOOL) (ok ∈ minwindef.BOOL, r ∈ minwindef.UINT) { host expr call GetDlgItemInt(d, id, &ok, signed) stdcall lib "user32" }
    fn EndDialog(d ∈ windef.HWND, n ∈ basetsd.INT_PTR) (r ∈ minwindef.BOOL) { host expr call EndDialog stdcall lib "user32" }
    fn MessageBoxA(w ∈ windef.HWND, t ∈ String, c ∈ String, u ∈ minwindef.UINT) (r ∈ minwindef.INT) where nulfree(t) && nulfree(c) { host expr call MessageBoxA stdcall lib "user32" }
    fn GetKeyState(k ∈ minwindef.INT) (r ∈ winnt.SHORT) { host expr call GetKeyState stdcall lib "user32" }
    fn GetSysColorBrush(i ∈ minwindef.INT) (r ∈ windef.HBRUSH) { host expr call GetSysColorBrush stdcall lib "user32" }
}
