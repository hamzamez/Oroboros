// THE TARGET'S INTERPRETATION OF THE LANGUAGE WHERE NO SINGLE LLVM OPERATION
// IS IT (ADR 0088, 0089): each a derived operation, a term over llvm.oro's
// operations, so ι : Σ_L → T(Σ_LLVM) is a theory interpretation (Goguen and
// Burstall), written in the language, checked as a program is, and inlined
// by the IR for the operation it realizes (ir/realize.go).
//
// EACH TERM IS DEFINED AND AGREES WITH THE LANGUAGE ON THE OPERATION'S
// DOMAIN, its header that domain. DEFINED: every LLVM operation in it is used
// inside its own domain, an obligation decided once against the header, as a
// program's are. AGREES: ⟦ι(f)⟧(x) = f(x), checked against ℤ's definition
// (ir/realize_test.go). A term may rely on the site's own obligation, decided
// before it is substituted: `<<`'s answers 0 past a count of 63 because a·2ᵏ is
// in the word only for a = 0.
//
// LLVM computes the branch both ways and chooses with `select` where that is
// cheaper; that is LLVM's speculation, sound because each arm is defined
// where it is taken. Where the IR proves an instance inside an instruction's
// own domain, the instruction is chosen for it (`realize`'s later names) and
// no term is printed.
//
// THE TEMPLATES BELOW THE TERMS each wait on something the language cannot
// yet say on this target: a call with two results (LLVM's overflow
// intrinsics), a call that never returns (`llvm.trap`, ExitProcess), and a
// pointer as a value (the allocator's answer, ADR 0084's LLVM part).
module lang {
    use llvm

    // ~a = a ⊕ (−1) = −a − 1, the complement: LLVM has no `not`.
    fn complement(a ∈ Int) (Int) { llvm.xor(a, -1) }

    // a·2ᵇ for every b ≥ 0. Past 63 the instruction is poison, and a·2ᵇ is in
    // the word only for a = 0, which `<<`'s obligation at the site makes it.
    fn shl(a ∈ Int, b ∈ Nat) (Int) { if b <= 63 { llvm.shl(a, b) } else { 0 } }

    // ⌊a/2ᵇ⌋ for every b ≥ 0: past 63 it is 0 or −1, which is ⌊a/2⁶³⌋.
    fn ashr(a ∈ Int, b ∈ Nat) (Int) { if b <= 63 { llvm.ashr(a, b) } else { llvm.ashr(a, 63) } }

    // THE EUCLIDEAN REMAINDER for a positive divisor (ADR 0082): srem takes the
    // dividend's sign, and a negative one is moved up by m.
    fn emod(a ∈ Int, m ∈ Int) (Int) where m > 0 {
        r = llvm.srem(a, m)
        if r < 0 { r + m } else { r }
    }

    // ℤ'S TRUNCATING `%` AND `/` (integers.md §3) on every divisor but 0.
    // srem and sdiv are undefined for −2⁶³ by −1, so −1 is its own arm: a % −1
    // is 0, and a / −1 is −a, the language's `−`, so 2⁶³ is refused or trapped
    // at the site as any result outside the word is (ADR 0019).
    fn rem(a ∈ Int, b ∈ Int) (Int) where b != 0 { if b == -1 { 0 } else { llvm.srem(a, b) } }
    fn div(a ∈ Int, b ∈ Int) (Int) where b != 0 { if b == -1 { 0 - a } else { llvm.sdiv(a, b) } }

    // `<<` under -checked: a trap where a·2ᵇ leaves the word, which is a count
    // past 63 with a ≠ 0, or a shift that does not shift back to a.
    fn shl_checked(a ∈ Int, b ∈ Nat) (r ∈ Int) pure {
        host expr "%s${#} = shl ${a}, ${b:v}\n%c${#} = icmp ugt ${b}, 63\n%k${#} = ashr i64 %s${#}, ${b:v}\n%x${#} = icmp ne i64 %k${#}, ${a:v}\n%z${#} = icmp ne ${a}, 0\n%g${#} = and i1 %c${#}, %z${#}\n%f${#} = select i1 %c${#}, i1 %g${#}, i1 %x${#}\nbr i1 %f${#}, label %trap${#}, label %ok${#}\ntrap${#}:\ncall void @llvm.trap()\nunreachable\nok${#}:\n${r} = select i1 %c${#}, i64 0, i64 %s${#}" import "declare void @llvm.trap()"
    }

    // THE CHECKED ARITHMETIC (-checked, ADR 0019): the overflow intrinsic, and
    // a trap where it overflowed. The value is the intrinsic's, the exact one
    // wherever there was no trap.
    fn add_checked(a ∈ Int, b ∈ Int) (r ∈ Int) pure {
        host expr "%o${#} = call {i64, i1} @llvm.sadd.with.overflow.i64(${a}, ${b})\n${r} = extractvalue {i64, i1} %o${#}, 0\n%f${#} = extractvalue {i64, i1} %o${#}, 1\nbr i1 %f${#}, label %trap${#}, label %ok${#}\ntrap${#}:\ncall void @llvm.trap()\nunreachable\nok${#}:" import "declare {i64, i1} @llvm.sadd.with.overflow.i64(i64, i64)" "declare void @llvm.trap()"
    }
    fn sub_checked(a ∈ Int, b ∈ Int) (r ∈ Int) pure {
        host expr "%o${#} = call {i64, i1} @llvm.ssub.with.overflow.i64(${a}, ${b})\n${r} = extractvalue {i64, i1} %o${#}, 0\n%f${#} = extractvalue {i64, i1} %o${#}, 1\nbr i1 %f${#}, label %trap${#}, label %ok${#}\ntrap${#}:\ncall void @llvm.trap()\nunreachable\nok${#}:" import "declare {i64, i1} @llvm.ssub.with.overflow.i64(i64, i64)" "declare void @llvm.trap()"
    }
    fn mul_checked(a ∈ Int, b ∈ Int) (r ∈ Int) pure {
        host expr "%o${#} = call {i64, i1} @llvm.smul.with.overflow.i64(${a}, ${b})\n${r} = extractvalue {i64, i1} %o${#}, 0\n%f${#} = extractvalue {i64, i1} %o${#}, 1\nbr i1 %f${#}, label %trap${#}, label %ok${#}\ntrap${#}:\ncall void @llvm.trap()\nunreachable\nok${#}:" import "declare {i64, i1} @llvm.smul.with.overflow.i64(i64, i64)" "declare void @llvm.trap()"
    }

    // THE FIXED-LIMB RUNG'S CARRY CHECK (emit/bignum.oro): 0 when handed 0, a
    // trap otherwise. Impure: an operation that can end the program is never
    // moved or dropped.
    fn trap_if(a ∈ Int) (r ∈ Int) {
        host expr "%z${#} = icmp ne ${a}, 0\nbr i1 %z${#}, label %trap${#}, label %ok${#}\ntrap${#}:\ncall void @llvm.trap()\nunreachable\nok${#}:\n${r} = add i64 0, 0" import "declare void @llvm.trap()"
    }

    // ---- THE CRASH (spec/errors.md §8): crash : E → 0. The reason's bytes to
    // standard error (-12), a newline, and exit status 1, as on targets/windows.
    // It never returns, and the IR ends its region with `unreachable`.
    fn abandon(why ∈ String) (Any) {
        host stmt "%h${#} = call ptr @GetStdHandle(i32 -12)\n%l${#} = load i64, ${why}\n%n${#} = trunc i64 %l${#} to i32\n%p${#} = getelementptr inbounds i8, ${why}, i64 8\n%w${#} = call i32 @WriteFile(ptr %h${#}, ptr %p${#}, i32 %n${#}, ptr @__written, ptr null)\n%e${#} = call i32 @WriteFile(ptr %h${#}, ptr @__nl, i32 1, ptr @__written, ptr null)\ncall void @ExitProcess(i32 1)" import "declare dllimport ptr @GetStdHandle(i32)" "declare dllimport i32 @WriteFile(ptr, ptr, i32, ptr, ptr)" "declare dllimport void @ExitProcess(i32)" "@__written = internal global i32 0" "@__nl = private unnamed_addr constant i8 10"
    }

    // ---- MEMORY: `build`'s allocator (emit.FindAlloc), of kernel32's two, each
    // answering zeroed memory, so a table is zero on creation, its semantics.
    // CHOSEN BY SIZE, measured (llvm-2026-11-02): VirtualAlloc hands out pages
    // the system has already zeroed, where the heap's HEAP_ZERO_MEMORY (8)
    // clears every byte, which made the sieve's 200 KB table 10% slower; but it
    // reserves 64 KiB a call, which small tables in a loop would exhaust. So
    // VirtualAlloc (MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE) from 64 KiB, the
    // process heap below. A null answer, memory exhausted, is a trap: LLVM may
    // assume a pointer it loads through is not null, so an unchecked one would
    // be undefined.
    fn alloc(n ∈ 0..2^63-1) (ptr) {
        host expr "call ptr @oro.alloc(${n})" import "declare dllimport ptr @VirtualAlloc(ptr, i64, i32, i32)" "declare dllimport ptr @GetProcessHeap()" "declare dllimport ptr @HeapAlloc(ptr, i32, i64)" "declare void @llvm.trap()" "define internal ptr @oro.alloc(i64 %n) nounwind \"no-builtins\" {\nentry:\n  %big = icmp uge i64 %n, 65536\n  br i1 %big, label %virtual, label %heap\nvirtual:\n  %v = call ptr @VirtualAlloc(ptr null, i64 %n, i32 12288, i32 4)\n  br label %done\nheap:\n  %h = call ptr @GetProcessHeap()\n  %p = call ptr @HeapAlloc(ptr %h, i32 8, i64 %n)\n  br label %done\ndone:\n  %r = phi ptr [ %v, %virtual ], [ %p, %heap ]\n  %z = icmp eq ptr %r, null\n  br i1 %z, label %oom, label %ok\noom:\n  call void @llvm.trap()\n  unreachable\nok:\n  ret ptr %r\n}"
    }
}
