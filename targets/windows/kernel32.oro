// kernel32.dll, the Win32 functions this target's programs call, each declared
// by its PROTOTYPE (ADR 0094): `host expr call "F" stdcall`, the sets its C
// types, a narrow integer's full range, and its call derived by the C ABI on
// the triple (llvm.md §6a): `declare dllimport`, `trunc` in and `sext`/`zext`
// out, and `stdcall` x86_stdcallcc on i686 and nothing on x86-64.
//
//   (use windows/kernel32)
//   kernel32.GetStdHandle(4294967285)   kernel32.WriteFile(h, b, lo, n)
//
// WHAT THE LANGUAGE COULD NOT SAY ON MASM, IT SAYS HERE. WriteFile's buffer was
// a raw pointer there (`x64.lea` of the target's one scratch buffer); here it is
// a language table, borrowed, and the bytes written are its segment b[lo, lo+n).
// The out-parameter, the count written, is still the target's cell
// `@__written`: the language reads nothing from it.
module windows/kernel32 {
    // WIN32'S INTEGER TYPES, its own names for C's: an out-parameter's cell is
    // named by its type (ADR 0048, 0112), and a C integer's set is its full range.
    set DWORD = 0..2^32-1
    set LARGE_INTEGER = -2^63..2^63-1

    // A DWORD, so its full range: STD_INPUT_HANDLE, STD_OUTPUT_HANDLE and
    // STD_ERROR_HANDLE are ((DWORD)-10), ((DWORD)-11) and ((DWORD)-12), the
    // integers 4294967286, 4294967285 and 4294967284.
    fn GetStdHandle(n ∈ 0..2^32-1) (r ∈ ptr) { host expr call "GetStdHandle" stdcall }

    // WRITES b[lo, lo + n) to h, and answers whether Win32 reported success.
    // Win32's WriteFile(h, p, n, &written, NULL), with the buffer p the segment
    // of a table: its elements begin after the 8-byte length (llvm.md §4). Its
    // domain is the segment inside the table and a count that is a DWORD.
    fn WriteFile(h ∈ ptr, b ∈ Array(0..255), lo ∈ 0..2^63-1, n ∈ 0..2^32-1) (r ∈ Bool) where lo + n <= len(b) {
        host expr "%p${#} = getelementptr inbounds i8, ${b}, i64 8\n%q${#} = getelementptr inbounds i8, ptr %p${#}, ${lo}\n%n${#} = trunc ${n} to i32\n%w${#} = call i32 @WriteFile(${h}, ptr %q${#}, i32 %n${#}, ptr @__written, ptr null)\n${r} = icmp ne i32 %w${#}, 0" import "declare dllimport i32 @WriteFile(ptr, ptr, i32, ptr, ptr)" "@__written = internal global i32 0"
    }

    // THE CALLING THREAD'S LAST ERROR, a DWORD, so `zext` and its C range: the
    // same `declare` the Win32 survey writes for it, so the two never disagree.
    fn GetLastError() (r ∈ 0..2^32-1) { host expr call "GetLastError" stdcall }

    // MEMORY, as Win32 has it: VirtualAlloc(address, size, type, protection)
    // answers fresh zeroed pages or null, GetProcessHeap the process's heap, and
    // HeapAlloc(heap, flags, size) a block, zeroed with HEAP_ZERO_MEMORY (8), or
    // null. A SIZE_T is the word; a DWORD its C range, by `trunc`.
    fn VirtualAlloc(a ∈ ptr, n ∈ 0..2^63-1, t ∈ 0..2^32-1, p ∈ 0..2^32-1) (r ∈ ptr) { host expr call "VirtualAlloc" stdcall }
    fn GetProcessHeap() (r ∈ ptr) { host expr call "GetProcessHeap" stdcall }
    fn HeapAlloc(h ∈ ptr, f ∈ 0..2^32-1, n ∈ 0..2^63-1) (r ∈ ptr) { host expr call "HeapAlloc" stdcall }
    // AND THEIR INVERSES: VirtualFree(address, 0, MEM_RELEASE = 32768) releases
    // a whole reservation VirtualAlloc made, HeapFree(heap, flags, block) a
    // block HeapAlloc made. Each answers a BOOL, an int, by `sext`.
    fn VirtualFree(a ∈ ptr, n ∈ 0..2^63-1, t ∈ 0..2^32-1) (r ∈ -2^31..2^31-1) { host expr call "VirtualFree" stdcall }
    fn HeapFree(h ∈ ptr, f ∈ 0..2^32-1, p ∈ ptr) (r ∈ -2^31..2^31-1) { host expr call "HeapFree" stdcall }
    // HeapSize(heap, flags, block) the bytes a block HeapAlloc made holds for
    // its caller, or (SIZE_T)−1, the word's −1 (no block holds 2⁶³ bytes).
    fn HeapSize(h ∈ ptr, f ∈ 0..2^32-1, p ∈ ptr) (r ∈ -2^63..2^63-1) { host expr call "HeapSize" stdcall }
    // RtlZeroMemory(destination, length) writes length zero bytes; kernel32
    // forwards it to ntdll. A function, so no C runtime's memset is linked.
    fn RtlZeroMemory(p ∈ ptr, n ∈ 0..2^63-1) (Bool) { host stmt call "RtlZeroMemory" stdcall }

    // FILES, by handle (ADR 0112). CreateFileA(path, access, share, security,
    // disposition, flags, template) answers a HANDLE, INVALID_HANDLE_VALUE
    // ((HANDLE)−1) on failure, the reason in GetLastError. The path is a C
    // string, read as UTF-8 under the manifest's code page (ADR 0091).
    fn CreateFileA(p ∈ String, a ∈ 0..2^32-1, s ∈ 0..2^32-1, sa ∈ ptr, d ∈ 0..2^32-1, f ∈ 0..2^32-1, t ∈ ptr) (r ∈ ptr) where nulfree(p) {
        host expr call "CreateFileA" stdcall
    }
    // GetFileSizeEx(h, &size): a BOOL, and the size through its LARGE_INTEGER*,
    // an out-parameter, so a cell (ADR 0048).
    fn GetFileSizeEx(h ∈ ptr, n ∈ cell(LARGE_INTEGER)) (r ∈ -2^31..2^31-1) { host expr call "GetFileSizeEx" stdcall }
    // SetFilePointerEx(h, distance, &new, method): the LARGE_INTEGER by value,
    // the new position not asked for (null), FILE_BEGIN 0.
    fn SetFilePointerEx(h ∈ ptr, d ∈ -2^63..2^63-1, np ∈ ptr, m ∈ 0..2^32-1) (r ∈ -2^31..2^31-1) { host expr call "SetFilePointerEx" stdcall }
    fn CloseHandle(h ∈ ptr) (r ∈ -2^31..2^31-1) { host expr call "CloseHandle" stdcall }
    // READS n BYTES into b[lo, lo + n), the count read through its DWORD*, a
    // cell: ReadFile(h, p, n, &read, NULL), the buffer the segment's address,
    // which is no C type, so the host's operation is its template (ADR 0089). A
    // synchronous read of a file returns fewer than n only at its end.
    fn ReadFile(h ∈ ptr, b ∈ Array(0..255) linear, lo ∈ 0..2^63-1, n ∈ 0..2^32-1, got ∈ cell(DWORD)) (r ∈ -2^31..2^31-1) where lo + n <= len(b) {
        host expr "%p${#} = getelementptr inbounds i8, ${b}, i64 8\n%q${#} = getelementptr inbounds i8, ptr %p${#}, ${lo}\n%n${#} = trunc ${n} to i32\n%w${#} = call i32 @ReadFile(${h}, ptr %q${#}, i32 %n${#}, ${got}, ptr null)\n${r} = sext i32 %w${#} to i64" import "declare dllimport i32 @ReadFile(ptr, ptr, i32, ptr, ptr)"
    }
    // WRITES n BYTES of b[lo, lo + n), the count written through a cell.
    fn WriteFileC(h ∈ ptr, b ∈ Array(0..255), lo ∈ 0..2^63-1, n ∈ 0..2^32-1, put ∈ cell(DWORD)) (r ∈ -2^31..2^31-1) where lo + n <= len(b) {
        host expr "%p${#} = getelementptr inbounds i8, ${b}, i64 8\n%q${#} = getelementptr inbounds i8, ptr %p${#}, ${lo}\n%n${#} = trunc ${n} to i32\n%w${#} = call i32 @WriteFile(${h}, ptr %q${#}, i32 %n${#}, ${put}, ptr null)\n${r} = sext i32 %w${#} to i64" import "declare dllimport i32 @WriteFile(ptr, ptr, i32, ptr, ptr)"
    }
    // THE COMMAND LINE, a C string Win32 owns (the process's, never freed).
    fn GetCommandLineA() (r ∈ ptr) { host expr call "GetCommandLineA" stdcall }
    // GetEnvironmentVariableA(name, buffer, size): the length without the NUL
    // when it fits, the size it needs with the NUL when not, 0 when absent or
    // empty (ERROR_ENVVAR_NOT_FOUND 203 tells them apart).
    fn GetEnvironmentVariableA(k ∈ String, b ∈ Array(0..255) linear, n ∈ 0..2^32-1) (r ∈ 0..2^32-1) where nulfree(k) && n <= len(b) {
        host expr call "GetEnvironmentVariableA" stdcall
    }

    // A C STRING WIN32 OWNS, INTO OURS (ADR 0091's other half, ADR 0112):
    // lstrlenA(p) its length before the NUL, an int, and lstrcpynA(d, s, n) its
    // first n − 1 bytes and a NUL into a table the program lends (its elements'
    // address), answering d: a write-borrow with a result (ADR 0070), where a
    // void copy would be a statement over a buffer, which is not built. The
    // language reads nothing through s (ADR 0084).
    fn lstrlenA(p ∈ ptr) (r ∈ -2^31..2^31-1) { host expr call "lstrlenA" stdcall }
    fn lstrcpynA(d ∈ Array(0..255) linear, s ∈ ptr, n ∈ -2^31..2^31-1) (r ∈ ptr) where n >= 1 && n <= len(d) { host expr call "lstrcpynA" stdcall }

    // UINT → ∅: it ends the process, and never returns (ADR 0090).
    fn ExitProcess(a ∈ 0..2^32-1) (∅) { host expr call "ExitProcess" stdcall }
}
