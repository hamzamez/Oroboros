// kernel32.dll, the Win32 functions this target's programs call, each declared
// by its PROTOTYPE (ADR 0094): `host expr call "F" stdcall`, the sets its C
// types, a narrow integer's full range, and its call derived by the C ABI on
// the triple (llvm.md §6a): `declare dllimport`, `trunc` in and `sext`/`zext`
// out, and `stdcall` x86_stdcallcc on i686 and nothing on x86-64.
//
//   (use windows/kernel32)
//   kernel32.GetStdHandle(4294967285)   kernel32.WriteFile(h, b, lo, n)
//
// WHAT THE LANGUAGE COULD NOT SAY ON MASM, IT SAYS HERE. WriteFile's buffer was
// a raw pointer there (`x64.lea` of the target's one scratch buffer); here it is
// a language table, borrowed, and the bytes written are its segment b[lo, lo+n).
// The out-parameter, the count written, is still the target's cell
// `@__written`: the language reads nothing from it.
module windows/kernel32 {
    // A DWORD, so its full range: STD_INPUT_HANDLE, STD_OUTPUT_HANDLE and
    // STD_ERROR_HANDLE are ((DWORD)-10), ((DWORD)-11) and ((DWORD)-12), the
    // integers 4294967286, 4294967285 and 4294967284.
    fn GetStdHandle(n ∈ 0..2^32-1) (r ∈ ptr) { host expr call "GetStdHandle" stdcall }

    // WRITES b[lo, lo + n) to h, and answers whether Win32 reported success.
    // Win32's WriteFile(h, p, n, &written, NULL), with the buffer p the segment
    // of a table: its elements begin after the 8-byte length (llvm.md §4). Its
    // domain is the segment inside the table and a count that is a DWORD.
    fn WriteFile(h ∈ ptr, b ∈ Array(0..255), lo ∈ 0..2^63-1, n ∈ 0..2^32-1) (r ∈ Bool) where lo + n <= len(b) {
        host expr "%p${#} = getelementptr inbounds i8, ${b}, i64 8\n%q${#} = getelementptr inbounds i8, ptr %p${#}, ${lo}\n%n${#} = trunc ${n} to i32\n%w${#} = call i32 @WriteFile(${h}, ptr %q${#}, i32 %n${#}, ptr @__written, ptr null)\n${r} = icmp ne i32 %w${#}, 0" import "declare dllimport i32 @WriteFile(ptr, ptr, i32, ptr, ptr)" "@__written = internal global i32 0"
    }

    // THE CALLING THREAD'S LAST ERROR, a DWORD, so `zext` and its C range: the
    // same `declare` the Win32 survey writes for it, so the two never disagree.
    fn GetLastError() (r ∈ 0..2^32-1) { host expr call "GetLastError" stdcall }

    // MEMORY, as Win32 has it: VirtualAlloc(address, size, type, protection)
    // answers fresh zeroed pages or null, GetProcessHeap the process's heap, and
    // HeapAlloc(heap, flags, size) a block, zeroed with HEAP_ZERO_MEMORY (8), or
    // null. A SIZE_T is the word; a DWORD its C range, by `trunc`.
    fn VirtualAlloc(a ∈ ptr, n ∈ 0..2^63-1, t ∈ 0..2^32-1, p ∈ 0..2^32-1) (r ∈ ptr) { host expr call "VirtualAlloc" stdcall }
    fn GetProcessHeap() (r ∈ ptr) { host expr call "GetProcessHeap" stdcall }
    fn HeapAlloc(h ∈ ptr, f ∈ 0..2^32-1, n ∈ 0..2^63-1) (r ∈ ptr) { host expr call "HeapAlloc" stdcall }
    // AND THEIR INVERSES: VirtualFree(address, 0, MEM_RELEASE = 32768) releases
    // a whole reservation VirtualAlloc made, HeapFree(heap, flags, block) a
    // block HeapAlloc made. Each answers a BOOL, an int, by `sext`.
    fn VirtualFree(a ∈ ptr, n ∈ 0..2^63-1, t ∈ 0..2^32-1) (r ∈ -2^31..2^31-1) { host expr call "VirtualFree" stdcall }
    fn HeapFree(h ∈ ptr, f ∈ 0..2^32-1, p ∈ ptr) (r ∈ -2^31..2^31-1) { host expr call "HeapFree" stdcall }

    // UINT → ∅: it ends the process, and never returns (ADR 0090).
    fn ExitProcess(a ∈ 0..2^32-1) (∅) { host expr call "ExitProcess" stdcall }
}
