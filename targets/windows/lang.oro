// THE TARGET'S INTERPRETATION OF THE LANGUAGE WHERE NO SINGLE LLVM OPERATION
// IS IT (ADR 0088, 0089): each a derived operation, a term over the host's
// operations (llvm.oro, kernel32.oro), so ι : Σ_L → T(Σ_H) is a theory
// interpretation (Goguen and Burstall), written in the language, checked as a
// program is, and inlined by the IR for the operation it realizes
// (ir/realize.go).
//
// EACH TERM IS DEFINED AND AGREES WITH THE LANGUAGE ON THE OPERATION'S
// DOMAIN, its header that domain. DEFINED: every host operation in it is used
// inside its own domain, an obligation decided once against the header, as a
// program's are. AGREES: ⟦ι(f)⟧(x) = f(x), checked against ℤ's definition
// (ir/realize_test.go); a checked form agrees where f(x) is in the word and
// traps elsewhere. A term may rely on the site's own obligation, decided
// before it is substituted: `<<`'s answers 0 past a count of 63 because a·2ᵏ is
// in the word only for a = 0.
//
// Two host shapes make the checked forms terms (ADR 0090): a call into a
// PRODUCT, LLVM's overflow intrinsics answering W × 𝔹, taken apart by a tuple
// pattern; and a call into ∅, `llvm.trap` and ExitProcess, which never return,
// so 0 → Y types the branch they end.
//
// LLVM computes a branch both ways and chooses with `select` where that is
// cheaper; that is LLVM's speculation, sound because each arm is defined
// where it is taken. Where the IR proves an instance inside an instruction's
// own domain, the instruction is chosen for it (`realize`'s later names) and
// no term is printed.
//
// THE ALLOCATOR IS A TERM too (ADR 0092): a table's storage is an operation of
// the IR, so ι reaches it, and its arithmetic is decided at the site.
module lang {
    use llvm
    use windows/kernel32
    use win/str

    // ¬ν (ADR 0091): no byte of the string is 0. Exact on UTF-8, where U+0000 is
    // the byte 0 and every byte of a longer sequence is at least 0x80, so
    // ν(s) = [0 ∈ utf8(s)].
    fn no_nul(s ∈ String) (Bool) {
        b = str.utf8(s)
        loop i = 0 { i >= len(b) -> true; b[i] == 0 -> false; else -> again(i + 1) }
    }

    // ~a = a ⊕ (−1) = −a − 1, the complement: LLVM has no `not`.
    fn complement(a ∈ Int) (Int) { llvm.xor(a, -1) }

    // a·2ᵇ for every b ≥ 0. Past 63 the instruction is poison, and a·2ᵇ is in
    // the word only for a = 0, which `<<`'s obligation at the site makes it.
    fn shl(a ∈ Int, b ∈ Nat) (Int) { if b <= 63 { llvm.shl(a, b) } else { 0 } }

    // ⌊a/2ᵇ⌋ for every b ≥ 0: past 63 it is 0 or −1, which is ⌊a/2⁶³⌋.
    fn ashr(a ∈ Int, b ∈ Nat) (Int) { if b <= 63 { llvm.ashr(a, b) } else { llvm.ashr(a, 63) } }

    // THE EUCLIDEAN REMAINDER for a positive divisor (ADR 0082): srem takes the
    // dividend's sign, and a negative one is moved up by m.
    fn emod(a ∈ Int, m ∈ Int) (Int) where m > 0 {
        r = llvm.srem(a, m)
        if r < 0 { r + m } else { r }
    }

    // ℤ'S TRUNCATING `%` AND `/` (integers.md §3) on every divisor but 0.
    // srem and sdiv are undefined for −2⁶³ by −1, so −1 is its own arm: a % −1
    // is 0, and a / −1 is −a, the language's `−`, so 2⁶³ is refused or trapped
    // at the site as any result outside the word is (ADR 0019).
    fn rem(a ∈ Int, b ∈ Int) (Int) where b != 0 { if b == -1 { 0 } else { llvm.srem(a, b) } }
    fn div(a ∈ Int, b ∈ Int) (Int) where b != 0 { if b == -1 { 0 - a } else { llvm.sdiv(a, b) } }

    // THE CHECKED ARITHMETIC (-checked, ADR 0019): f where ℤ's result is in the
    // word, a trap elsewhere. The overflow intrinsic answers both the value and
    // whether ℤ's result left the word.
    fn add_checked(a ∈ Int, b ∈ Int) (Int) { (s, o) = llvm.sadd_with_overflow(a, b); if o { llvm.trap() } else { s } }
    fn sub_checked(a ∈ Int, b ∈ Int) (Int) { (s, o) = llvm.ssub_with_overflow(a, b); if o { llvm.trap() } else { s } }
    fn mul_checked(a ∈ Int, b ∈ Int) (Int) { (s, o) = llvm.smul_with_overflow(a, b); if o { llvm.trap() } else { s } }

    // `<<` UNDER -checked: a·2ᵇ is in the word iff b ≤ 62 and the product a·2ᵇ
    // does not overflow, or a = 0, or b = 63 and a = −1, whose product is −2⁶³.
    fn shl_checked(a ∈ Int, b ∈ Nat) (Int) {
        case {
            b <= 62 -> { (s, o) = llvm.smul_with_overflow(a, llvm.shl(1, b)); if o { llvm.trap() } else { s } }
            a == 0 -> 0
            b == 63 && a == -1 -> -9223372036854775807 - 1
            else -> llvm.trap()
        }
    }

    // `/` UNDER -checked: the quotient where it is in the word, a trap at
    // −2⁶³ / −1, the one point where it is not: there 0 − a overflows.
    fn div_checked(a ∈ Int, b ∈ Int) (Int) where b != 0 {
        if b == -1 { (s, o) = llvm.ssub_with_overflow(0, a); if o { llvm.trap() } else { s } } else { llvm.sdiv(a, b) }
    }

    // THE FIXED-LIMB RUNG'S CARRY CHECK (emit/bignum.oro): 0 when handed 0, a
    // trap otherwise.
    fn trap_if(a ∈ Int) (Int) { if a == 0 { 0 } else { llvm.trap() } }

    // THE CRASH (spec/errors.md §8): crash : E → ∅. The reason's bytes and a
    // newline to standard error (-12), then exit status 1, as on targets/windows.
    // A reason past one call's DWORD count is not written; the process ends
    // either way.
    fn crash(why ∈ String) (∅) {
        u = str.utf8(why)
        h = kernel32.GetStdHandle(-12)
        w = if len(u) <= 2^32 - 1 { kernel32.WriteFile(h, u, 0, len(u)) } else { false }
        e = kernel32.WriteFile(h, array { 10 }, 0, 1)
        kernel32.ExitProcess(1)
    }

    // ---- MEMORY (ADR 0092): ι(alloc), alloc : ℕ × {1, 8} → Region, a table of
    // n elements of w bytes behind its 8-byte length, zero on creation, its
    // semantics. A request past what any address space holds is EXHAUSTION, as
    // a null answer is, so the term is total. The guard bounds n by the widest
    // element, n ≤ ⌊(2⁶³ − 9)/8⌋, so that n·w + 8 is inside the word for every
    // w ∈ 1..8 by the intervals alone; a request it turns away is above 2⁶⁰
    // elements, past x64's 2⁴⁷ bytes, exhaustion either way. The guard states
    // the whole domain, 0 ≤ n, so that the arm proves n·w + 8 from its own π
    // whatever facts the site has (a length a trapped operation computed).
    fn allocate(n ∈ Nat, w ∈ 1..8) (ptr) {
        case {
            n >= 0 && n <= (2^63 - 9) / 8 -> region(n * w + 8)
            else -> llvm.trap()
        }
    }

    // A REGION OF b ZEROED BYTES, of kernel32's two allocators, CHOSEN BY SIZE,
    // measured (llvm-2026-11-02): VirtualAlloc hands out pages the system has
    // already zeroed, where the heap's HEAP_ZERO_MEMORY (8) clears every byte,
    // which made the sieve's 200 KB table 10% slower; but it reserves 64 KiB a
    // call, which small tables in a loop would exhaust. So VirtualAlloc
    // (MEM_COMMIT | MEM_RESERVE = 12288, PAGE_READWRITE = 4) from 64 KiB, the
    // process heap below. A null answer is exhaustion, the trap: LLVM may assume
    // a pointer it loads through is not null.
    fn region(b ∈ 0..2^63-1) (ptr) {
        p = if b >= 65536 { kernel32.VirtualAlloc(llvm.null(), b, 12288, 4) } else { kernel32.HeapAlloc(kernel32.GetProcessHeap(), 8, b) }
        if llvm.is_null(p) { llvm.trap() } else { p }
    }
}
