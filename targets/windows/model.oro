// THE DATA MODEL OF 64-BIT WINDOWS, LLP64 (ADR 0122 item 2): the C type names
// whose width it decides, as the sets a declaration's prototype states (ADR
// 0094). SIZE_T is 64 bits, held as the word's naturals, since a byte count
// is no unsigned-word value here; DWORD and the names both models agree on
// are the base's (targets/win32/kernel32.oro).
module windows/kernel32 {
    set SIZE_T = 0..2^63-1
}
