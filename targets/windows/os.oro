// THE VIEW Σ_OS → WIN32 (ADR 0093): the LLVM layer's seven headers
// (targets/llvm/os.oro), each defined here under the same header, over
// kernel32's functions as Win32 has them. Gluing checks the headers agree; each
// definition is checked as a program is, and meets its header's contract.
module llvm/os {
    use llvm
    use windows/kernel32

    // A REGION OF b ZEROED BYTES, of kernel32's two allocators, CHOSEN BY SIZE,
    // measured (llvm-2026-11-02): VirtualAlloc hands out pages the system has
    // already zeroed, where the heap's HEAP_ZERO_MEMORY (8) clears every byte,
    // which made the sieve's 200 KB table 10% slower; but it reserves 64 KiB a
    // call, which small tables in a loop would exhaust. So VirtualAlloc
    // (MEM_COMMIT | MEM_RESERVE = 12288, PAGE_READWRITE = 4) from 64 KiB, the
    // process heap below. A null answer is exhaustion, the trap: LLVM may assume
    // a pointer it loads through is not null.
    // THE LONGEST TABLE, windows.oro's `fact max_len`: x64's 2⁴⁷-byte user space
    // less a table's 8-byte length and its zero byte.
    fn max_len() (0..2^63-1) { 140737488355319 }

    fn region(b ∈ 0..2^63-1) (ptr) {
        p = if b >= 65536 { kernel32.VirtualAlloc(llvm.null(), b, 12288, 4) } else { kernel32.HeapAlloc(kernel32.GetProcessHeap(), 8, heapclass(b)) }
        if llvm.is_null(p) { llvm.trap() } else { p }
    }

    // THE HEAP'S SIZE CLASSES, segregated fits (Knowlton 1965; Wilson et al.
    // 1995): a heap request of b bytes takes c(b) = 2^⌈log₂ b⌉, at least 64. c is
    // monotone and idempotent, so a block freed at class c serves every later
    // request of class c from the heap's own free list, and internal
    // fragmentation is below 2×. A numeral one digit longer than the one just
    // freed is the same class, where an exact size never fits (measured cold:
    // the growing product's allocations 66–81 ms exact, 19 ms by class). c is a
    // case on b's thresholds, so its range is the decision's, the join of its
    // arms' constants.
    fn heapclass(b ∈ 0..65535) (64..65536) {
        case {
            b <= 64 -> 64
            b <= 128 -> 128
            b <= 256 -> 256
            b <= 512 -> 512
            b <= 1024 -> 1024
            b <= 2048 -> 2048
            b <= 4096 -> 4096
            b <= 8192 -> 8192
            b <= 16384 -> 16384
            b <= 32768 -> 32768
            else -> 65536
        }
    }

    // A REGION GIVEN BACK, by the rule `region` chose its allocator by, the size
    // alone: VirtualFree with MEM_RELEASE (32768) and size 0 from 64 KiB, which
    // releases the whole reservation, HeapFree on the process heap below. So
    // release ∘ region is the identity on the heap (ADR 0096).
    fn release(p ∈ ptr, b ∈ 0..2^63-1) (Bool) {
        r = if b >= 65536 { kernel32.VirtualFree(p, 0, 32768) } else { kernel32.HeapFree(kernel32.GetProcessHeap(), 0, p) }
        r != 0
    }

    // A REGION OF ANY CONTENTS, by `region`'s rule: VirtualAlloc's pages from
    // 64 KiB (zero anyway), the heap without HEAP_ZERO_MEMORY below, so
    // release ∘ region_raw is the identity on the heap too.
    fn region_raw(b ∈ 0..2^63-1) (ptr) {
        p = if b >= 65536 { kernel32.VirtualAlloc(llvm.null(), b, 12288, 4) } else { kernel32.HeapAlloc(kernel32.GetProcessHeap(), 0, heapclass(b)) }
        if llvm.is_null(p) { llvm.trap() } else { p }
    }

    // THE CAPACITY CLASS, the kernel of the block a request is answered with:
    // the heap's c(b), a power of two from 64, and VirtualAlloc's committed
    // pages, ⌈b/4096⌉, negated so that the two allocators' classes are
    // disjoint. Equal classes are one allocator and one capacity, at least
    // either request; HeapFree and VirtualFree with MEM_RELEASE free a whole
    // block whatever its size, so either request gives it back. ⌈b/4096⌉ is
    // ⌊(b − 1)/4096⌋ + 1, written so that no step leaves the word.
    fn class(b ∈ 0..2^63-1) (-2^63..65536) { if b >= 65536 { -1 - llvm.udiv_nat(b - 1, 4096) } else { heapclass(b) } }

    // A DEAD REGION MADE FRESH: its b bytes zero, as `region` answers them.
    fn zero(p ∈ ptr, b ∈ 0..2^63-1) (Bool) {
        z = kernel32.RtlZeroMemory(p, b)
        true
    }

    // THE BYTES TO STANDARD ERROR (-12). A table past one call's DWORD count is
    // not written, and the answer is false.
    fn write_err(b ∈ Array(0..255)) (Bool) {
        if len(b) <= 2^32 - 1 {
            (w, r) = kernel32.WriteFile(kernel32.GetStdHandle(4294967284), b, 0, len(b), out kernel32.DWORD)
            r != 0
        } else { false }
    }

    // ExitProcess ends every thread and the process; its UINT holds 0..255.
    fn exit(code ∈ 0..255) (∅) { kernel32.ExitProcess(code) }
}
