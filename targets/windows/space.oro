// THE ADDRESS SPACE OF 64-BIT WINDOWS (ADR 0122 item 3): Σ_OS's two bounds.
// A process's user space is 2⁴⁷ bytes; the longest table, of one-byte
// elements, takes n + 9 of them (its length and its zero byte), so n ≤ 2⁴⁷ − 9,
// windows.oro's `fact max_len`.
module llvm/os {
    fn max_bytes() (0..2^63-1) { 140737488355328 }
    fn max_len() (0..2^63-1) { 140737488355319 }
}
