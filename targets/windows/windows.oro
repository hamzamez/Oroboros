// THE WINDOWS TARGET (ADR 0039, 0080, 0093): the LLVM layer, T_LLVM[Σ_OS],
// instantiated by Win32. NO PORTABILITY CLAIM beyond the language's: Win32's
// own names are this target's.
//
//   glue llvm      Σ_LLVM, ι's terms and the representations (targets/llvm),
//                  glued: agreement required, nothing of it replaced
//   os.oro         the view Σ_OS → Win32: region, write_err and exit over
//                  kernel32, the definitions the layer's headers require
//   kernel32.oro   the Win32 functions programs call, as Win32 has them
//   strings.oro    the free monoid's helpers, which allocate from the heap
glue llvm

// THE TRIPLE (ADR 0093 item 5), what the printer writes: 64-bit Windows,
// MSVC's ABI. 32-bit Windows is `i686-pc-windows-msvc`, another member.
triple "x86_64-pc-windows-msvc"

// THE LINK LINE: kernel32 for everything this target calls, and no C runtime
// (llvm.md §2). A primitive that needs another library names it with `lib`.
link "kernel32"

// THE STRING MONOID on this target, its helpers the process heap's (strings.oro).
realize string_of = win/str.string_of
realize concat = win/str.concat

build "cmd /c .\\build.bat"
artifact "main.exe"
