// THE x86-64 INSTRUCTION SET'S OWN OPERATIONS (ADR 0103): what this triple has
// beyond LLVM's target-independent instructions, each declared as it is, its
// domain its `where`. 32-bit Windows is another member, with its own.
module llvm/isa {
    // DIVQ, THE 2-BY-1 DIVISION (Knuth's primitive, TAOCP 2 §4.3.1; Go's
    // bits.Div64): RDX:RAX = hi·2⁶⁴ + lo by a word d, the quotient in RAX and
    // the remainder in RDX. The quotient past 2⁶⁴ raises #DE, so hi < d is its
    // domain, unsigned (and so d ≠ 0): the double word asks it of a quotient the
    // decision proves in the unsigned word, which is the same condition
    // (llvm.md §3c). Stated there, not as a `where`, since no call site but the
    // printer's reaches it.
    fn udiv_2by1(lo ∈ u64, hi ∈ u64, d ∈ u64) (u64 × u64) pure {
        host expr "call { i64, i64 } asm \"divq $4\", \"={rax},={rdx},0,1,r,~{dirflag},~{fpsr},~{flags}\"(${lo}, ${hi}, ${d})"
    }

    // THE FULL ADDER, ADC AND SBB (ADR 0108; Knuth's A and S, TAOCP 2 §4.3.1):
    // φ(x + y + c) = ((x + y + c) mod 2⁶⁴, ⌊(x + y + c) / 2⁶⁴⌋) and φ(x − y − b)
    // = ((x − y − b) mod 2⁶⁴, [x − y − b < 0]), the carry or borrow kept in the
    // flag across a chain of them. LLVM's target-independent uadd.with.overflow
    // pair is not combined into adc (0.88 ns a digit, against 0.33; carry-2026-
    // 11-13), so the triple's own. The carry in is an i8 that the machine reads
    // as c ≠ 0, so c ∈ {0, 1} is its domain, which the printer reads off the
    // types (llvm.md §3d); stated there, as divq's, since no call site but the
    // printer's reaches it.
    fn add_carry(c ∈ 0..1, x ∈ u64, y ∈ u64) (0..1 × u64) pure {
        host expr "call { i8, i64 } @llvm.x86.addcarry.64(${c}, ${x}, ${y})" import "declare { i8, i64 } @llvm.x86.addcarry.64(i8, i64, i64)"
    }
    fn sub_borrow(b ∈ 0..1, x ∈ u64, y ∈ u64) (0..1 × u64) pure {
        host expr "call { i8, i64 } @llvm.x86.subborrow.64(${b}, ${x}, ${y})" import "declare { i8, i64 } @llvm.x86.subborrow.64(i8, i64, i64)"
    }
}
