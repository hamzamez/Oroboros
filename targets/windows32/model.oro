// THE DATA MODEL OF 32-BIT WINDOWS, ILP32 (ADR 0122 item 2, ADR 0126): the
// four names of basetsd.h's `#if defined(_WIN64)` branch, here its `#else`,
// the only ones whose definition reaches a pointer-width type, each its C
// type's whole value set. Every other Win32 type name is the base's, defined
// through these (targets/win32/basetsd.oro, minwindef.oro).
module windows/basetsd {
    set INT_PTR = -2^31..2^31-1
    set UINT_PTR = 0..2^32-1
    set LONG_PTR = -2^31..2^31-1
    set ULONG_PTR = 0..2^32-1
}
